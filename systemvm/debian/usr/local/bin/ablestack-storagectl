  python3 - <<'PY'
import glob
import json
import os
import shutil
import subprocess
import re
import socket
import sys
import time

sys.path.insert(0, "/usr/local/lib/ablestack-storage")
from volume_identity import (  # noqa: E402
    VolumeIdentityError,
    device_for_path,
    flatten_devices,
    flatten_mounts,
    resolve_volume_device,
)

def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as fp:
            return json.load(fp)
    except Exception:
        return default

SENSITIVE_KEYS = {
    "secrets",
    "secret",
    "password",
    "passwords",
    "key",
    "keys",
    "dhChapKey",
    "dhChapCtrlKey",
    "chapSecret",
    "mutualChapSecret",
}

def redact_sensitive(value):
    if isinstance(value, list):
        return [redact_sensitive(item) for item in value]
    if isinstance(value, dict):
        redacted = {}
        for key, item in value.items():
            lower_key = str(key).lower()
            if key in SENSITIVE_KEYS or "secret" in lower_key or "password" in lower_key or lower_key.endswith("key"):
                continue
            redacted[key] = redact_sensitive(item)
        return redacted
    return value

def run(args):
    try:
        return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=8)
    except Exception as exc:
        return type("Result", (), {"returncode": 1, "stdout": "", "stderr": str(exc)})()

def runtime_metadata():
    observed_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    boot_id = ""
    try:
        with open("/proc/sys/kernel/random/boot_id", "r", encoding="utf-8") as handle:
            boot_id = handle.read().strip()
    except Exception:
        pass
    return observed_at, boot_id

def storage_lsblk():
    result = run(["lsblk", "-J", "-b", "-o", "NAME,KNAME,PATH,TYPE,SIZE,FSTYPE,UUID,SERIAL,MOUNTPOINT"])
    if result.returncode != 0:
        return []
    try:
        return json.loads(result.stdout or "{}").get("blockdevices") or []
    except Exception:
        return []

def file_share_volume_runtime():
    observed_at, boot_id = runtime_metadata()
    snapshot = {
        "available": False,
        "observedAt": observed_at,
        "bootId": boot_id,
        "observations": [],
    }
    result = run(["findmnt", "-J", "-o", "SOURCE,TARGET,FSTYPE,FSROOT,OPTIONS"])
    if result.returncode != 0:
        snapshot["error"] = (result.stderr or "findmnt failed").strip()
        return snapshot
    try:
        payload = json.loads(result.stdout or "{}")
        if not isinstance(payload.get("filesystems"), list):
            raise ValueError("findmnt JSON does not contain a filesystems array")
        filesystems = flatten_mounts(payload.get("filesystems"))
    except Exception as exc:
        snapshot["error"] = str(exc)
        return snapshot
    blockdevices = storage_lsblk()
    flattened = flatten_devices(blockdevices)
    observations = []
    for mount in filesystems:
        target = str(mount.get("target") or "")
        match = re.fullmatch(r"/srv/ablestack-storage/volumes/([^/]+)", target.rstrip("/"))
        if not match:
            continue
        volume_uuid = match.group(1)
        source = str(mount.get("source") or "")
        observed = device_for_path(flattened, source)
        item = {
            "volumeUuid": volume_uuid,
            "volumeMountPath": target,
            "mountSource": source,
            "filesystem": mount.get("fstype") or (observed or {}).get("fstype"),
            "filesystemUuid": (observed or {}).get("uuid"),
            "observedDevicePath": (observed or {}).get("path") or source,
            "observedAt": observed_at,
            "bootId": boot_id,
        }
        try:
            resolved = resolve_volume_device(
                blockdevices,
                volume_uuid=volume_uuid,
                mount_source=source,
                allow_blank_size_fallback=False,
            )
            item.update({
                "observedDevicePath": resolved.get("devicePath"),
                "filesystem": resolved.get("filesystem") or item.get("filesystem"),
                "filesystemUuid": resolved.get("filesystemUuid") or item.get("filesystemUuid"),
                "matchedBy": resolved.get("matchedBy"),
                "mappingStatus": "EXACT",
            })
        except VolumeIdentityError as exc:
            item["mappingStatus"] = "AMBIGUOUS" if "Ambiguous" in str(exc) else ("STALE" if observed else "UNMAPPED")
            item["mappingError"] = str(exc)
        observations.append({key: value for key, value in item.items() if value not in (None, "")})
    snapshot["available"] = True
    snapshot["observations"] = observations
    return snapshot

def port_listening(port):
    if not shutil.which("ss"):
        return False
    result = run(["ss", "-H", "-lnt"])
    suffix = ":" + str(port)
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[3].endswith(suffix):
            return True
    return False

def collect_network_addresses():
    if not shutil.which("ip"):
        return []
    addresses = []
    seen = set()
    result = run(["ip", "-j", "-4", "addr", "show", "scope", "global"])
    if result.returncode == 0:
        try:
            for link in json.loads(result.stdout or "[]"):
                ifname = link.get("ifname")
                for item in link.get("addr_info", []) or []:
                    ipaddress = item.get("local")
                    prefix = item.get("prefixlen")
                    if not ipaddress or ipaddress in seen:
                        continue
                    seen.add(ipaddress)
                    flags = item.get("flags") or []
                    secondary = bool(item.get("secondary")) or "secondary" in flags
                    dynamic = bool(item.get("dynamic")) or "dynamic" in flags
                    entry = {
                        "interface": ifname,
                        "ipaddress": ipaddress,
                        "secondary": secondary,
                        "primary": not secondary,
                        "role": "secondary" if secondary else "primary",
                    }
                    if dynamic:
                        entry["dynamic"] = True
                    if prefix is not None:
                        entry["prefixlen"] = prefix
                        entry["cidr"] = f"{ipaddress}/{prefix}"
                    addresses.append(entry)
            return addresses
        except Exception:
            pass
    result = run(["ip", "-o", "-4", "addr", "show", "scope", "global"])
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        ifname = parts[1]
        cidr = parts[3]
        ipaddress = cidr.split("/", 1)[0]
        if not ipaddress or ipaddress in seen:
            continue
        seen.add(ipaddress)
        secondary = " secondary " in f" {line} "
        entry = {
            "interface": ifname,
            "ipaddress": ipaddress,
            "cidr": cidr,
            "secondary": secondary,
            "primary": not secondary,
            "role": "secondary" if secondary else "primary",
        }
        if " dynamic " in f" {line} ":
            entry["dynamic"] = True
        if "/" in cidr:
            try:
                entry["prefixlen"] = int(cidr.split("/", 1)[1])
            except Exception:
                pass
        addresses.append(entry)
    return addresses

def normalize_export_entry(entry):
    # exportfs escapes '=' in rendered option values. Keep runtime inventory JSON parse-safe.
    return str(entry or "").replace("\\=", "=")

def nvmeof_capabilities():
    base = "/sys/kernel/config/nvmet"
    host_root = os.path.join(base, "hosts")
    sample_host = "nqn.2014-08.org.nvmexpress:uuid:00000000-0000-0000-0000-000000000000"
    host_dir = os.path.join(host_root, sample_host)
    existed = os.path.exists(host_dir)
    result = {
        "kernel": run(["uname", "-r"]).stdout.strip(),
        "kernelTargetSupported": os.path.isdir(base),
        "configfsHostSupported": os.path.isdir(host_root),
        "dhChapSupported": False,
        "dhChapCtrlSupported": False,
    }
    if not result["kernelTargetSupported"]:
        result["reason"] = "missing nvmet configfs root"
        return result
    if not result["configfsHostSupported"]:
        result["reason"] = "missing nvmet hosts configfs root"
        return result
    try:
        os.makedirs(host_dir, exist_ok=True)
        result["dhChapSupported"] = os.path.exists(os.path.join(host_dir, "dhchap_key"))
        result["dhChapCtrlSupported"] = os.path.exists(os.path.join(host_dir, "dhchap_ctrl_key"))
        if not result["dhChapSupported"] or not result["dhChapCtrlSupported"]:
            result["reason"] = "missing nvmet host dhchap_key/dhchap_ctrl_key"
    except Exception as exc:
        result["reason"] = str(exc)
    finally:
        if not existed:
            try:
                os.rmdir(host_dir)
            except Exception:
                pass
    return result

def endpoint_listening(ip, port, timeout=1.0):
    deadline = time.time() + max(timeout, 0.5)
    candidate_ip = str(ip or "127.0.0.1").strip()
    if candidate_ip in ("0.0.0.0", "::"):
        candidate_ip = "127.0.0.1"
    last_error = ""
    while time.time() < deadline:
        try:
            with socket.create_connection((candidate_ip, int(port)), timeout=1.0):
                return True, ""
        except Exception as exc:
            last_error = str(exc)
            time.sleep(0.25)
    return False, last_error

def nfs_protocol_mode_from_content(content):
    if not content:
        return "V4_ONLY"
    for match in re.finditer(r"Protocols\s*=\s*([^;]+);", content, re.I):
        value = re.sub(r"\s+", "", match.group(1))
        if "3" in value and "4" in value:
            return "V3V4_DUAL"
        if value == "4":
            return "V4_ONLY"
    return "V4_ONLY"

def rpcbind_active():
    if not shutil.which("systemctl"):
        return False
    for unit in ("rpcbind.socket", "rpcbind.service"):
        try:
            result = subprocess.run(["systemctl", "is-active", "--quiet", unit],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if result.returncode == 0:
                return True
        except Exception:
            continue
    return False

exports = []
for path in sorted(glob.glob("/etc/exports.d/ablestack-*.exports")):
    try:
        with open(path, "r", encoding="utf-8") as fp:
            lines = [normalize_export_entry(line.strip()) for line in fp.readlines() if line.strip()]
    except Exception:
        lines = []
    exports.append({"file": os.path.basename(path), "entries": lines})

def config_value(block, key, default=None):
    match = re.search(r"\b" + re.escape(key) + r"\s*=\s*([^;]+);", block, re.I)
    return match.group(1).strip().strip('"') if match else default
def nfs_rendered_clients(export_block):
    clients = []
    for client_block in re.findall(r"CLIENT\s*\{([^{}]*)\}", export_block, re.S):
        clients.append({
            "clients": config_value(client_block, "Clients", ""),
            "access": config_value(client_block, "Access_Type"),
            "squash": config_value(client_block, "Squash", config_value(export_block.split("CLIENT", 1)[0], "Squash")),
            "anonUid": int(config_value(client_block, "Anonymous_uid", config_value(export_block.split("CLIENT", 1)[0], "Anonymous_uid", "65534"))),
            "anonGid": int(config_value(client_block, "Anonymous_gid", config_value(export_block.split("CLIENT", 1)[0], "Anonymous_gid", "65534"))),
        })
    return clients

ganesha_exports = []
for path in sorted(glob.glob("/etc/ganesha/ablestack-storage/*.conf")):
    item = {"file": os.path.basename(path), "entries": []}
    try:
        with open(path, "r", encoding="utf-8") as fp:
            content = fp.read()
        bind_match = re.search(r"Bind_addr\s*=\s*\"?([^\";\n]+)\"?", content)
        port_match = re.search(r"NFS_Port\s*=\s*(\d+)", content)
        protocol_mode = nfs_protocol_mode_from_content(content)
        item["listenIp"] = bind_match.group(1).strip() if bind_match else ""
        item["port"] = int(port_match.group(1)) if port_match else 2049
        item["protocolMode"] = protocol_mode
        pid_path = os.path.join("/run/ablestack-storage/ganesha", os.path.splitext(os.path.basename(path))[0] + ".pid")
        item["pidPath"] = pid_path
        if os.path.exists(pid_path):
            try:
                with open(pid_path, "r", encoding="utf-8") as pid_fp:
                    pid = int(pid_fp.read().strip())
                item["pid"] = pid
                item["processRunning"] = os.path.exists(f"/proc/{pid}")
            except Exception as exc:
                item["error"] = str(exc)
        item["listening"], listen_error = endpoint_listening(item.get("listenIp"), item["port"])
        if not item["listening"] and listen_error:
            item["error"] = listen_error
        for export_block in re.findall(r"EXPORT\s*\{(.*?)\n\}", content, re.S):
            pseudo = re.search(r"Pseudo\s*=\s*\"?([^\";\n]+)\"?", export_block)
            export_path = re.search(r"Path\s*=\s*\"?([^\";\n]+)\"?", export_block)
            export_protocol_mode = nfs_protocol_mode_from_content(export_block)
            clients = nfs_rendered_clients(export_block)
            item["entries"].append({
                "pseudo": pseudo.group(1).strip() if pseudo else "",
                "path": export_path.group(1).strip() if export_path else "",
                "protocolMode": export_protocol_mode,
                "clients": clients,
            })
        item["status"] = "active" if item.get("listening") else "inactive"
    except Exception as exc:
        item["error"] = str(exc)
        item["status"] = "error"
    ganesha_exports.append(item)

