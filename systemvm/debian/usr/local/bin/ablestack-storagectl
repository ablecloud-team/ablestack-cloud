        supported = supported and bool(number and int(number.group(1)) >= 2)
print(json.dumps({"success": bool(supported), "idMappingMode": mode, "ganeshaVersion": version.strip()[:256],
                  "status": "READY" if supported else "ID_MAPPING_UNSUPPORTED"}))
raise SystemExit(0 if supported else 1)
PYIDMAP
