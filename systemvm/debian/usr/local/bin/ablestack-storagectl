    os.replace(managed_temporary, managed_identity_path)
finally:
    if os.path.exists(managed_temporary):
        os.unlink(managed_temporary)
identity_apply_verified = True
# Remove only previously recorded controller identities after a verified reload.
for share_uuid, old_identity in managed_identities.items():
    if share_uuid in active_managed_identities:
        continue
    user, group = old_identity.get("managedUser"), old_identity.get("managedGroup")
    token = re.sub(r"[^a-fA-F0-9]", "", str(share_uuid))[:20].lower()
    if user != "sf_u_" + token or group != "sf_g_" + token:
        continue
    try:
        observed = pwd.getpwnam(user)
        if observed.pw_uid != old_identity.get("ownerUid") or observed.pw_gid != old_identity.get("ownerGid") or observed.pw_dir != "/nonexistent" or observed.pw_shell != "/usr/sbin/nologin":
            continue
        run(["userdel", user], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (KeyError, subprocess.CalledProcessError):
        pass
    try:
        if grp.getgrnam(group).gr_gid != old_identity.get("ownerGid"):
            continue
        run(["groupdel", group], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (KeyError, subprocess.CalledProcessError):
        pass
print(json.dumps({"success": True, "shares": len(payload.get("shares", [])), "quotas": len(quota_state), "adJoined": ad_joined, "netbiosName": netbios_name, "access": access_state, "runtimeEndpoints": runtime_endpoints, "runtimeReady": True}))
