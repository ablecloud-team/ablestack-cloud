        else:endpoints=[{"listenIp":str(ipaddress.ip_address(endpoint["listenIp"])),"port":int(endpoint["port"])}]
        if any(not 1<=endpoint["port"]<=65535 for endpoint in endpoints):raise ValueError("SERVICE listener port is invalid")
