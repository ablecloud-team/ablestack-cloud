      volume_attach_inspect "$payload" "resume"
    elif [[ "$subcommand" == "operation" && "$action" == "status" ]]; then
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for volume operation status."
        exit 2
      fi
      volume_operation_status "$payload"
    elif [[ "$subcommand" == "detach" && "$action" == "prepare" ]]; then
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for volume detach prepare."
        exit 2
      fi
      log_command "$command $subcommand $action" "$payload"
      volume_detach_prepare "$payload"
    elif [[ "$subcommand" == "rescan" ]]; then
      payload="${3:-}"
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for volume rescan."
        exit 2
      fi
      log_command "$command $subcommand" "$payload"
      volume_rescan "$payload"
    else
      emit_error "Unsupported volume operation: ${subcommand:-<empty>} ${action:-<empty>}"
      exit 2
    fi
    ;;
  posix)
    if [[ "$subcommand" != "directory" || -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable managed POSIX directory policy payload is required."
      exit 2
    fi
    log_command "$command $subcommand $action" "$payload"
    posix_directory_policy "$action" "$payload"
    ;;
  filesystem)
    payload="${3:-}"
    if [[ "$subcommand" != "resize" ]]; then
      emit_error "Unsupported filesystem operation: ${subcommand:-<empty>}"
      exit 2
    fi
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for filesystem resize."
      exit 2
    fi
    log_command "$command $subcommand" "$payload"
    filesystem_resize "$payload"
    ;;
  nfs)
    if [[ "$subcommand" == "capabilities" ]]; then
      ganesha_feature_capabilities
      exit 0
    elif [[ "$subcommand" == "idmapping" && "$action" == "preflight" ]]; then
      python3 - "$payload" <<'PYIDMAP'
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path
request = json.loads(Path(sys.argv[1]).read_text())
mode = str(request.get("idMappingMode") or "NAME_DOMAIN").upper()
binary = shutil.which("ganesha.nfsd")
version = ""
supported = mode in ("NAME_DOMAIN", "NUMERIC") and bool(binary)
if binary:
    result = subprocess.run([binary, "-v"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
    version = (result.stdout or "") + (result.stderr or "")
    number = re.search(r"\b[Vv]?(\d+)\.(\d+)", version)
    if mode == "NUMERIC":
        supported = supported and bool(number and int(number.group(1)) >= 2)
print(json.dumps({"success": bool(supported), "idMappingMode": mode, "ganeshaVersion": version.strip()[:256],
                  "status": "READY" if supported else "ID_MAPPING_UNSUPPORTED"}))
raise SystemExit(0 if supported else 1)
PYIDMAP
      exit 0
    elif [[ "$subcommand" != "export" || "$action" != "apply" ]]; then
