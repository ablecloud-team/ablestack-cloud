case "$command:$subcommand:$action" in
  operation:reservation:acquire|operation:reservation:renew|operation:reservation:release|operation:reservation:status|volume:operation:capabilities|smb:identity:inspect|smb:identity:local-source-status|smb:identity:current-review|smb:identity:current-verify|smb:endpoint-run:*|health:*|inventory:*|sessions:*|operation:verify:*|operation:observe:*|operation:resources:*|network:endpoints:inspect|operation:generation:render-boot-gate|operation:generation:render-status|operation:generation:render-maintenance-verify|operation:generation:render-root-identity-export-source|operation:generation:status|operation:generation:frozen|operation:generation:frozen-initial|posix:directory:inspect|posix:directory:plan|posix:directory:attest-plan|operation:maintenance:status|operation:maintenance:service-status|operation:maintenance:service-capabilities|operation:root-data:inspect|operation:writer-idle:*|volume:operation:status|nfs:idmapping:preflight|nfs:capabilities:*|identity:capsule:capabilities|identity:capsule:semantic-original|identity:domain:inspect|identity:principal:resolve|identity:domain:daemon-gate|identity:domain:semantic-local-guard|identity:domain:capabilities)
    ;;
  *)
    acquire_storage_writer_lock || exit $?
    ;;
