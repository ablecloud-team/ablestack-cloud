        if not re.match(r"^Got 1 replies\s",observed) or sids!=[public["ownedComputerSid"]]:
            raise ValueError("JOIN inverse computer was replaced or machine trust is unproven")
        spns=[]
        for principal in public["servicePrincipals"]:
