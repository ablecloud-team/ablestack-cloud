            raise ValueError("Joined AD RAW export requires typed SERVICE or ROOT AFTERSTOP source authority")
        if request.get("includePosixPolicyReceipts") is True:
            configuration=identity_command(("operation","generation","status"))
            if (configuration.get("generation",{}).get("instanceUuid")!=request["instanceUuid"]
                    or configuration.get("generation",{}).get("configurationSha256")!=configuration.get("configurationSha256")
                    or configuration.get("pendingOperationUuid") not in (None,request["operationUuid"])):
                raise ValueError("POSIX source receipt snapshot has a foreign native writer")
            records=PosixReceiptTransfer().collect(configuration["configurationDesiredState"]["posix-directory-policies.json"],request["instanceUuid"],
                                                  lambda value:identity_command(("posix","directory","inspect","/dev/stdin"),value))
    payload = collect(names, request.get("nvmeHosts") or [],ad_identity=ad_metadata,posix_policies=records)
    if records is not None:payload["sourceConfigurationSha256"]=configuration["configurationSha256"]
    if root_source is not None:
        # The latest source seven are authenticated inside AEAD, never trusted
        # from an outer caller snapshot on retained ROOT authorization.
        payload["rootSourceConfiguration"]=root_source["rootSourceConfiguration"]
        payload["sourceConfigurationSha256"]=root_source["sourceConfigurationSha256"]
        fresh=identity_command(("operation","generation","render-root-identity-export-source","/dev/stdin"),root_scope)
        if fresh!=root_source:raise ValueError("ROOT stopped source changed while RAW identity bytes were collected")
    if service_source is not None:
        payload["sourceConfigurationSha256"]=service_source["sourceConfigurationSha256"]
        fresh=identity_command(("operation","generation","render-service-identity-export-source","/dev/stdin"),service_scope)
        if fresh!=service_source:raise ValueError("SERVICE stopped source changed during RAW identity collection")
    validate_payload(payload)
    capsule=encrypt(payload,request["publicKey"],scope)
    service_reference=None
    if service_source is not None:
        service_reference=ServiceIdentityCipher().retain(request,capsule,service_source)
    reference=None
    if root_source is not None:
        reference=RootIdentityReference().retain(request,capsule,root_source["sourceConfigurationSha256"])
    print(json.dumps({"success":True,"capsule":capsule,"rootIdentityReference":reference,"serviceIdentityCheckpoint":service_reference},sort_keys=True))
elif action == "posix-attest":
    capsule_scope=RootIdentityReference().authorize(request,request["capsule"],identity_command(("operation","maintenance","status")))
    payload=decrypt(request["capsule"],request["credentialPrivateKey"],capsule_scope)
