"""Exact configfs CHAP writes; credentials never become subprocess arguments."""
import os
import json
from pathlib import Path
import re
import stat


def iscsi_auth_writer():
    if os.environ.get("ABLESTACK_STORAGE_WRITER_LOCK_FD") != "9":
        raise ValueError("iSCSI authentication requires its protected native writer")
    try:
        named=Path(os.environ.get("ABLESTACK_STORAGE_WRITER_LOCK_FILE","/run/ablestack-storage/desired-writer.lock"))
        opened=os.fstat(9);expected=named.lstat()
        if (not stat.S_ISREG(opened.st_mode) or opened.st_uid!=os.geteuid() or stat.S_IMODE(opened.st_mode)!=0o600
                or not stat.S_ISREG(expected.st_mode) or (opened.st_dev,opened.st_ino)!=(expected.st_dev,expected.st_ino)
                or Path("/proc/self/fd/9").resolve(strict=True)!=named.resolve(strict=True)):
            raise ValueError("iSCSI authentication writer identity changed")
        locks=Path("/proc/self/fdinfo/9").read_text()
        pattern=r"(?m)^lock:\s+[0-9]+:\s+FLOCK\s+ADVISORY\s+WRITE\s+[0-9]+\s+[0-9a-f]+:[0-9a-f]+:"+str(opened.st_ino)+r"\s+0\s+EOF\s*$"
        if not re.search(pattern,locks):
            raise ValueError("iSCSI authentication writer does not hold its own exclusive lock")
    except OSError as invalid:
        raise ValueError("iSCSI authentication writer is unavailable") from invalid


def iscsi_auth_name(value,target=False):
    if (not isinstance(value,str) or len(value)>223 or not re.fullmatch(r"iqn\.[0-9]{4}-[0-9]{2}\.[A-Za-z0-9.-]+:[A-Za-z0-9_.:-]+",value)
            or (target and ".local.storage:" not in value)):
        raise ValueError("iSCSI authentication has a foreign target or initiator")
    return value


def iscsi_auth_values(config,values):
    if not isinstance(config,dict) or not isinstance(values,dict):
        raise ValueError("iSCSI authentication inputs are not structured")
    result={}
    for flag,user,password,secret in (("chapEnabled","userid","password","chapSecret"),("mutualChapEnabled","userid_mutual","password_mutual","mutualChapSecret")):
        enabled=config.get(flag,False)
        if type(enabled) is not bool:raise ValueError("iSCSI authentication flags are invalid")
        username=config.get("chapUsername" if flag=="chapEnabled" else "mutualChapUsername")
        for field,value in ((user,username),(password,values.get(secret))):
            if enabled:
                if (not isinstance(value,str) or not value or not value.strip() or value.startswith("NULL")
                        or len(value.encode())>255 or any(char in value for char in ("\0","\r","\n"))):
                    raise ValueError("iSCSI authentication value is invalid for the fixed kernel attribute")
                result[field]=value.encode()
            else:result[field]=b"NULL"
    return result


class ConfigfsIscsiAuth:
    def __init__(self,root=None,writer=None,write=None):
        self.root=Path(root or "/sys/kernel/config/target/iscsi")
        self.writer=writer or iscsi_auth_writer
        self.write=write or os.write

    @staticmethod
    def identity(info):
        return info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid

    def auth_directory(self,target,initiator):
        iscsi_auth_name(target,True);iscsi_auth_name(initiator)
        path=self.root;descriptor=None
        try:
            for component in (None,target,"tpgt_1","acls",initiator,"auth"):
                if component is None:
                    named=path.lstat();opened=os.open(path,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
                else:
                    named=os.stat(component,dir_fd=descriptor,follow_symlinks=False)
                    opened=os.open(component,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=descriptor);path=path/component
                info=os.fstat(opened)
                if (not stat.S_ISDIR(named.st_mode) or named.st_uid!=os.geteuid() or named.st_mode&0o022
                        or self.identity(named)!=self.identity(info)):
                    os.close(opened);raise ValueError("iSCSI authentication directory is foreign or changed")
                if descriptor is not None:os.close(descriptor)
                descriptor=opened
            return descriptor,path
        except (OSError,ValueError):
            if descriptor is not None:os.close(descriptor)
            raise ValueError("iSCSI authentication directory is unavailable or replaced") from None

    def attribute(self,directory,field,write=False):
        if field not in ("userid","password","userid_mutual","password_mutual"):
            raise ValueError("iSCSI authentication attribute is outside its fixed allowlist")
        # configfs drops unreferenced attribute dentries and allocates a new
        # inode on lookup. Pin the opened dentry first, then compare its name.
        try:descriptor=os.open(field,(os.O_RDWR if write else os.O_RDONLY)|os.O_NOFOLLOW,dir_fd=directory)
        except OSError as invalid:raise ValueError("iSCSI authentication attribute is unavailable or not a direct file") from invalid
        try:
            opened=os.fstat(descriptor)
            if not stat.S_ISREG(opened.st_mode) or opened.st_uid!=os.geteuid() or opened.st_mode&0o022 or opened.st_nlink!=1:
                raise ValueError("iSCSI authentication attribute is foreign")
            named=os.stat(field,dir_fd=directory,follow_symlinks=False)
            if self.identity(named)!=self.identity(opened):
                raise ValueError("iSCSI authentication attribute changed after its dentry was pinned")
            return descriptor,opened
        except BaseException:
            os.close(descriptor);raise

    def apply(self,target,initiator,config,secrets):
        values=iscsi_auth_values(config,secrets);self.writer()
        directory,path=self.auth_directory(target,initiator);attributes={}
        try:
            for field in values:attributes[field]=self.attribute(directory,field,True)
            for field,value in values.items():
                if self.identity(path.lstat())!=self.identity(os.fstat(directory)):
                    raise ValueError("iSCSI authentication ACL was replaced before a write")
                descriptor,before=attributes[field]
                if self.identity(before)!=self.identity(os.stat(field,dir_fd=directory,follow_symlinks=False)):
                    raise ValueError("iSCSI authentication attribute was replaced before a write")
                os.lseek(descriptor,0,os.SEEK_SET)
                if self.write(descriptor,value)!=len(value):raise ValueError("iSCSI authentication attribute write was incomplete")
                os.lseek(descriptor,0,os.SEEK_SET);observed=os.read(descriptor,4096).rstrip(b"\n")
                if observed!=value:raise ValueError("iSCSI authentication attribute readback differed")
                if self.identity(before)!=self.identity(os.stat(field,dir_fd=directory,follow_symlinks=False)):
                    raise ValueError("iSCSI authentication attribute was replaced during readback")
            return {"success":True,"credentialReadbackVerified":True,"chapEnabled":config.get("chapEnabled",False),"mutualChapEnabled":config.get("mutualChapEnabled",False),"credentialSubprocessArguments":False}
        finally:
            for descriptor,info in attributes.values():os.close(descriptor)
            os.close(directory)


def iscsi_private_vault(path):
    path=Path(path)
    try:info=path.lstat()
    except FileNotFoundError:return {}
    parent=path.parent.lstat()
    if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=os.geteuid() or parent.st_mode&0o077
            or not stat.S_ISREG(info.st_mode) or info.st_uid!=os.geteuid() or stat.S_IMODE(info.st_mode)!=0o600 or info.st_size>8*1024*1024):
        raise ValueError("iSCSI private vault is not protected")
    descriptor=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        opened=os.fstat(descriptor)
        fields=("st_dev","st_ino","st_mode","st_uid","st_gid","st_size","st_mtime_ns","st_ctime_ns")
        if any(getattr(opened,key)!=getattr(info,key) for key in fields):raise ValueError("iSCSI private vault changed while opening")
        data=os.read(descriptor,8*1024*1024+1);after=os.fstat(descriptor)
        if len(data)>8*1024*1024 or any(getattr(after,key)!=getattr(opened,key) for key in fields):raise ValueError("iSCSI private vault changed while reading")
        value=json.loads(data)
    except (ValueError,TypeError) as invalid:
        raise ValueError("iSCSI private vault is invalid") from invalid
    finally:os.close(descriptor)
    if not isinstance(value,dict):raise ValueError("iSCSI private vault is invalid")
    for binding,secrets in value.items():
        parts=binding.split("|")
        if len(parts)!=2:raise ValueError("iSCSI private vault resource binding is invalid")
        iscsi_auth_name(parts[0],True);iscsi_auth_name(parts[1])
        if (not isinstance(secrets,dict) or not secrets or not set(secrets)<={"chapSecret","mutualChapSecret"}
                or any(not isinstance(item,str) or not item or len(item.encode())>255 or any(char in item for char in ("\0","\r","\n")) for item in secrets.values())):
            raise ValueError("iSCSI private vault credential binding is invalid")
    return value
# END EMBEDDED ISCSI AUTH

ISCSI_DIAGNOSTIC_STAGES = {"CLEANUP", "TARGET_CREATE", "PORTAL_CREATE", "BACKSTORE_CREATE", "LUN_CREATE", "ACL_CREATE", "AUTH_POLICY"}
ISCSI_DIAGNOSTIC_CATEGORIES = {"UNCLASSIFIED", "ATTRIBUTE_ERROR", "TYPE_ERROR", "IMPORT_ERROR", "PERMISSION_ERROR", "WWN_REJECTED", "CONFIGFS_ERROR", "TIMEOUT", "SPAWN_FAILURE"}
first_iscsi_failure = None
ISCSI_GUARD_STAGES = {"INPUT", "VAULT_STATE", "DEPENDENCY", "LISTENER", "DEVICE", "AUTH", "READINESS"}
ISCSI_GUARD_CATEGORIES = {"VALUE_ERROR", "TYPE_ERROR", "RUNTIME_ERROR", "OS_ERROR", "TIMEOUT", "SYSTEM_EXIT", "LOOKUP_ERROR", "ATTRIBUTE_ERROR", "ASSERTION_ERROR"}

def targetcli_error_category(result):
    # Inspect only fixed vendor tokens in RAM; never return arbitrary text.
    categories = set()
    classes = {"AttributeError": "ATTRIBUTE_ERROR", "TypeError": "TYPE_ERROR",
               "ImportError": "IMPORT_ERROR", "ModuleNotFoundError": "IMPORT_ERROR",
               "PermissionError": "PERMISSION_ERROR"}
    for line in ((result.stderr or "") + "\n" + (result.stdout or "")).splitlines():
        match = re.match(r"^(AttributeError|TypeError|ImportError|ModuleNotFoundError|PermissionError)(?::|$)", line.strip())
        if match: categories.add(classes[match.group(1)])
        if line.strip() == "WWN not valid as: iqn": categories.add("WWN_REJECTED")
        if line.strip() == "Could not create Target in configFS": categories.add("CONFIGFS_ERROR")
    return next(iter(categories)) if len(categories) == 1 else "UNCLASSIFIED"

def emit_iscsi_failure(kind, stage, return_code, category):
    global first_iscsi_failure
    if first_iscsi_failure is None:
        first_iscsi_failure = {"success": False, "kind": kind, "stage": stage,
                               "returnCode": return_code, "category": category}
        print(json.dumps(first_iscsi_failure, separators=(",", ":")), flush=True)


class IscsiTargetcliFailure(SystemExit):
    def __init__(self, stage, return_code, category):
        if stage not in ISCSI_DIAGNOSTIC_STAGES or category not in ISCSI_DIAGNOSTIC_CATEGORIES:
            raise ValueError("Invalid fixed iSCSI diagnostic")
        if return_code is not None and (type(return_code) is not int or return_code == 0 or not -64 <= return_code <= 255):
            raise ValueError("Invalid fixed iSCSI return code")
        if (return_code is None) != (category in ("TIMEOUT", "SPAWN_FAILURE")):
            raise ValueError("Unavailable iSCSI return code")
        emit_iscsi_failure("ISCSI_TARGETCLI_COMMAND_FAILED", stage, return_code, category)
        super().__init__("iSCSI targetcli command failed; private diagnostics omitted")

def run_targetcli(*args, stage="CLEANUP"):
    try:
        return run(["targetcli", *args])
    except subprocess.TimeoutExpired:
        raise IscsiTargetcliFailure(stage, None, "TIMEOUT") from None
    except OSError:
        raise IscsiTargetcliFailure(stage, None, "SPAWN_FAILURE") from None

def ok_or_exists(result):
    text = f"{result.stdout}\n{result.stderr}".lower()
    return result.returncode == 0 or "exists" in text or "already" in text

def require_targetcli(*args, stage):
    result = run_targetcli(*args, stage=stage)
    if not ok_or_exists(result):
        raise IscsiTargetcliFailure(stage, result.returncode, targetcli_error_category(result)) from None
    return result


def iscsi_guard(stage, action, *args, **kwargs):
    global first_iscsi_failure
    if stage not in ISCSI_GUARD_STAGES:
        raise ValueError("Unknown iSCSI guard phase")
    try:
        return action(*args, **kwargs)
    except IscsiTargetcliFailure:
        raise
    except BaseException as failure:
        if isinstance(failure, SystemExit) and failure.code in (None, 0):
            raise
        category = None
        if isinstance(failure, subprocess.TimeoutExpired):
            category = "TIMEOUT"
        elif isinstance(failure, OSError):
            category = "OS_ERROR"
        elif isinstance(failure, LookupError):
            category = "LOOKUP_ERROR"
        elif isinstance(failure, AttributeError):
            category = "ATTRIBUTE_ERROR"
        elif isinstance(failure, AssertionError):
            category = "ASSERTION_ERROR"
        elif isinstance(failure, ValueError):
            category = "VALUE_ERROR"
        elif isinstance(failure, TypeError):
            category = "TYPE_ERROR"
        elif isinstance(failure, RuntimeError):
            category = "RUNTIME_ERROR"
        elif isinstance(failure, SystemExit):
            category = "SYSTEM_EXIT"
        if category in ISCSI_GUARD_CATEGORIES:
            emit_iscsi_failure("ISCSI_APPLY_GUARD_FAILED", stage, None, category)
        elif first_iscsi_failure is None:
            # Reserve the first failure without inventing a public classification.
            first_iscsi_failure = False
        # Neither known nor unknown failures expose private messages/tracebacks.
        raise SystemExit("iSCSI apply failed; private diagnostics omitted") from None


def load_iscsi_payload(path):
    with open(path, "r", encoding="utf-8") as stream:
        return json.load(stream)


payload_path = sys.argv[1]
payload = iscsi_guard("INPUT", load_iscsi_payload, payload_path)

state_dir = "/etc/ablestack-storage"
iscsi_guard("VAULT_STATE", os.makedirs, state_dir, exist_ok=True)
state_file = os.path.join(state_dir, "iscsi-targets.json")
secret_dir = os.path.join(state_dir, "secrets")
secret_file = os.path.join(secret_dir, "iscsi-acl-secrets.json")

previous_payload = {}
try:
    with open(state_file, "r", encoding="utf-8") as previous_state_fp:
        previous_payload = json.load(previous_state_fp)
except Exception:
    previous_payload = {}

SENSITIVE_KEYS = {"secrets", "chapSecret", "mutualChapSecret", "secret", "password"}

def load_secret_store():
    return iscsi_private_vault(secret_file)

def write_secret_store(value):
    os.makedirs(secret_dir, mode=0o700, exist_ok=True)
    tmp_fd, tmp_path = tempfile.mkstemp(prefix=".iscsi-acl-secrets.", dir=secret_dir)
    try:
        with os.fdopen(tmp_fd, "w", encoding="utf-8") as tmp_fp:
            json.dump(value, tmp_fp, sort_keys=True, indent=2)
            tmp_fp.write("\n")
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, secret_file)
    finally:
        try:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
        except Exception:
            pass

def acl_secret_key(target, acl):
    return f"{target.get('targetName') or ''}|{acl.get('principal') or ''}"

def merge_and_persist_iscsi_secrets(value):
    store = load_secret_store()
    next_store = {}
    for target in value.get("targets", []) or []:
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        for acl in target.get("acls", []) or []:
            if acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
                continue
            config = acl.get("config") or {}
            needs_chap = bool(config.get("chapEnabled")) or bool(config.get("mutualChapEnabled"))
            if not needs_chap:
                continue
            key = acl_secret_key(target, acl)
            secrets = acl.setdefault("secrets", {})
            saved = store.get(key) or {}
            for name in ("chapSecret", "mutualChapSecret"):
                if secrets.get(name):
                    saved[name] = secrets.get(name)
                elif saved.get(name):
                    secrets[name] = saved.get(name)
            if saved:
                next_store[key] = saved
            # Reject every enabled username/key before target removal, private
            # vault publication, portal creation or configfs authentication.
            iscsi_auth_values(acl.get("config") or {},secrets)
    write_secret_store(next_store)

iscsi_guard("VAULT_STATE", merge_and_persist_iscsi_secrets, payload)

def sanitized(value):
    if isinstance(value, dict):
        return {k: sanitized(v) for k, v in value.items() if k not in SENSITIVE_KEYS}
    if isinstance(value, list):
        return [sanitized(v) for v in value]
    return value

def persist_iscsi_payload():
    if os.environ.get("ABLESTACK_STORAGE_ROOT_SOURCE_REPLAY")!="1":
        with open(state_file, "w", encoding="utf-8") as state_fp:
            json.dump(sanitized(payload), state_fp, sort_keys=True, indent=2)

iscsi_guard("VAULT_STATE", persist_iscsi_payload)

def run(args, timeout=20):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)


def command_exists(name):
    return shutil.which(name) is not None

def resolve_existing_path(path):
    if os.path.islink(path):
        target = os.readlink(path)
        if os.path.isabs(target):
            return target
        return os.path.normpath(os.path.join(os.path.dirname(path), target))
    return path

def has_elf_header(path):
    try:
        with open(resolve_existing_path(path), "rb") as fp:
            return fp.read(4) == b"\x7fELF"
    except Exception:
        return False

def has_text_prefix(path, prefix):
    try:
        with open(path, "rb") as fp:
            return fp.read(len(prefix)) == prefix.encode("utf-8")
    except Exception:
        return False

def ensure_iscsi_runtime_dependencies():
    failures = []
    python_path = shutil.which("python3") or "/usr/bin/python3"
    if not command_exists("targetcli"):
        failures.append("targetcli is missing")
    if not has_elf_header(python_path):
        failures.append(f"python3 has an invalid ELF header: {python_path}")
    if not has_elf_header("/usr/lib/python3/dist-packages/gi/_gi.cpython-311-x86_64-linux-gnu.so"):
        failures.append("python3-gi has an invalid ELF header")
    if not has_elf_header("/lib/x86_64-linux-gnu/libmagic.so.1"):
        failures.append("libmagic has an invalid ELF header")
    if not has_text_prefix("/var/lib/dpkg/status", "Package:"):
        failures.append("dpkg status database is unreadable")
    if not failures:
        result = run(["python3", "-c", "import gi"], timeout=10)
        if result.returncode != 0:
            failures.append((result.stderr or result.stdout or "python3-gi cannot be loaded").strip())
    if failures:
        raise SystemExit(
            "SystemVM iSCSI runtime dependency is broken: "
            + "; ".join(failures)
            + ". Rebuild and register a valid Storage Service SystemVM template."
        )

def best_effort_firewall(port):
    if command_exists("firewall-cmd"):
        run(["firewall-cmd", "--add-port", f"{port}/tcp"], timeout=15)
        run(["firewall-cmd", "--permanent", "--add-port", f"{port}/tcp"], timeout=15)
    if command_exists("iptables"):
        check = run(["iptables", "-C", "INPUT", "-p", "tcp", "--dport", str(port), "-j", "ACCEPT"], timeout=10)
        if check.returncode != 0:
            run(["iptables", "-I", "INPUT", "-p", "tcp", "--dport", str(port), "-j", "ACCEPT"], timeout=10)

def lsblk_devices():
    result = run(["lsblk", "-b", "-J", "-o", "NAME,PATH,TYPE,FSTYPE,UUID,SERIAL,SIZE,MOUNTPOINT"], timeout=20)
    if result.returncode != 0:
        return []
    try:
        return json.loads(result.stdout).get("blockdevices", [])
    except Exception:
        return []

def walk_devices(devices):
    for dev in devices:
        yield dev
        for child in dev.get("children") or []:
            yield from walk_devices([child])

def mounted(dev):
    if dev.get("mountpoint"):
        return True
    return any(mounted(child) for child in dev.get("children") or [])

def normalize_token(value):
    return str(value or "").replace("-", "").replace("_", "").lower()

def matchable_tokens(target):
    candidates = [
        target.get("volumeUuid"),
        target.get("volumeName"),
        target.get("volumePath"),
        target.get("expectedSerialPrefix"),
    ]
    config = target.get("config") or {}
    candidates.extend([
        config.get("volumeUuid"),
        config.get("volumeName"),
        config.get("volumeSerial"),
        config.get("volumePath"),
        config.get("expectedSerialPrefix"),
    ])
    tokens = []
    for candidate in candidates:
        token = normalize_token(candidate)
        if len(token) >= 8 and not token.isdigit():
            tokens.append(token)
    return tokens

def match_by_id(tokens):
    tokens = [normalize_token(token) for token in tokens if token]
    if not tokens:
        return None
    for path in glob.glob("/dev/disk/by-id/*"):
        text = normalize_token(os.path.basename(path))
        if any(token_matches_text(token, text) for token in tokens):
            return os.path.realpath(path)
    return None

def token_matches_text(token, text):
    if not token or not text:
        return False
    return token in text or text in token or (len(token) >= 16 and token[:16] in text)

def try_find_backing_path(target):
    config = target.get("config") or {}
    configured = config.get("backingPath")
    if configured and os.path.exists(configured):
        return configured
    tokens = matchable_tokens(target)
    matched = match_by_id(tokens)
    if matched:
        return matched
    devices = lsblk_devices()
    for dev in walk_devices(devices):
        fields = [normalize_token(dev.get(key)) for key in ("name", "path", "serial", "uuid")]
        if any(token_matches_text(token, field) for token in tokens for field in fields):
            return dev.get("path")
    return None

def find_backing_path(target):
    deadline = time.time() + int(target.get("deviceSettleSeconds") or payload.get("deviceSettleSeconds") or 90)
    last_tokens = matchable_tokens(target)
    while True:
        path = try_find_backing_path(target)
        if path:
            return path
        if time.time() >= deadline:
            break
        if command_exists("udevadm"):
            run(["udevadm", "settle"], timeout=10)
        time.sleep(2)
    raise SystemExit(f"unable to resolve backing block device for iSCSI target {target.get('targetName') or target.get('uuid')}; volumeUuid or volumeName did not match any guest disk")

def mountpoint_for_device(path):
    result = run(["findmnt", "-n", "-o", "TARGET", "--source", path], timeout=8)
    if result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip().splitlines()[0]
    return ""

def device_size_bytes(path):
    result = run(["lsblk", "-b", "-dn", "-o", "SIZE", path], timeout=8)
    if result.returncode == 0 and result.stdout.strip().isdigit():
        return int(result.stdout.strip())
    if os.path.exists(path):
        return os.path.getsize(path)
    raise SystemExit(f"unable to determine backing size for {path}")

def target_size_bytes(target, backing_path):
    config = target.get("config") or {}
    if normalize_backstore_type(target) == "BLOCK":
        return device_size_bytes(backing_path)
    value = config.get("lunSizeBytes") or target.get("lunSizeBytes") or target.get("effectiveSizeBytes") or target.get("volumeSizeBytes")
    if value:
        return int(value)
    return device_size_bytes(backing_path)

def normalize_backstore_type(target):
    config = target.get("config") or {}
    value = target.get("backstoreType") or target.get("backstoretype") or config.get("backstoreType") or config.get("backstoretype") or "BLOCK"
    value = str(value).strip().upper()
    if value != "BLOCK":
        raise SystemExit("iSCSI targets support block backstores only; file-backed LUNs are not supported")
    return value

def device_tree_for_path(path):
    real = os.path.realpath(path)
    for dev in walk_devices(lsblk_devices()):
        dev_path = dev.get("path")
        if dev_path and os.path.realpath(dev_path) == real:
            return dev
    return None

def device_has_mounted_or_swap_descendant(dev):
    if not dev:
        return False
    mountpoint = str(dev.get("mountpoint") or "")
    fstype = str(dev.get("fstype") or "").lower()
    if mountpoint or fstype == "swap":
        return True
    return any(device_has_mounted_or_swap_descendant(child) for child in dev.get("children") or [])

def validate_block_backstore_device(path):
    dev = device_tree_for_path(path)
    if not dev:
        raise SystemExit(f"unable to inspect backing block device {path}; refusing unsafe iSCSI BLOCK backstore")
    dev_type = str(dev.get("type") or "")
    if dev_type not in ("disk", "part", "lvm", "mpath"):
        raise SystemExit(f"backing device {path} has unsupported block type {dev_type}; refusing iSCSI BLOCK backstore")
    if device_has_mounted_or_swap_descendant(dev):
        raise SystemExit(f"backing device {path} or one of its partitions is mounted or swap; refusing iSCSI BLOCK backstore")

def resolve_backstore(target, backstore_name):
    path = find_backing_path(target)
    backstore_type = normalize_backstore_type(target)
    mountpoint = mountpoint_for_device(path)
    if mountpoint:
        raise SystemExit(f"backing device {path} is mounted at {mountpoint}; refusing iSCSI BLOCK backstore")
    validate_block_backstore_device(path)
    require_targetcli("/backstores/block", "create", backstore_name, path, stage="BACKSTORE_CREATE")
    return f"/backstores/block/{backstore_name}", path, "block"

def port_listening(port):
    if not command_exists("ss"):
        return False
    result = run(["ss", "-H", "-lnt"], timeout=8)
    suffix = ":" + str(port)
    return any(len(line.split()) >= 4 and line.split()[3].endswith(suffix) for line in result.stdout.splitlines())

def configured_listeners():
    listeners = []
    for item in payload.get("listeners") or []:
        if not isinstance(item, dict):
            continue
        listen_ip = str(item.get("listenIp") or item.get("listenip") or "0.0.0.0")
        port = int(item.get("port") or 3260)
        listeners.append({"listenIp": listen_ip, "port": port})
    if not listeners:
        listeners.append({"listenIp": str(payload.get("listenIp") or "0.0.0.0"), "port": int(payload.get("port") or 3260)})
    normalized = []
    seen = set()
    for item in listeners:
        key = (item["listenIp"], item["port"])
        if key in seen:
            continue
        seen.add(key)
        normalized.append(item)
    ports_with_any = {item["port"] for item in normalized if item["listenIp"] in ("0.0.0.0", "::")}
    if ports_with_any:
        normalized = [item for item in normalized if item["port"] not in ports_with_any or item["listenIp"] in ("0.0.0.0", "::")]
    return normalized

def target_listener_ports(target, listeners):
    config = target.get("config") or {}
    raw_ports = target.get("listenerPorts") or target.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports") or config.get("listenerPorts") or config.get("listenerports")
    ports = set()
    if isinstance(raw_ports, list):
        for value in raw_ports:
            try:
                ports.add(int(value))
            except Exception:
                pass
    elif isinstance(raw_ports, str):
        for value in raw_ports.split(','):
            value = value.strip()
            if value:
                ports.add(int(value))
    elif raw_ports:
        ports.add(int(raw_ports))
    if not ports:
        ports.add(int(payload.get("port") or 3260))
    return ports

def selected_listeners_for_target(target, listeners):
    config = target.get("config") or {}
    mode = str(target.get("endpointMode") or target.get("endpointmode") or config.get("endpointMode") or config.get("endpointmode") or "LISTENER_GROUP").upper()
    if mode == "ALL":
        return listeners
    ports = target_listener_ports(target, listeners)
    selected = [item for item in listeners if item["port"] in ports]
    if not selected:
        raise SystemExit(f"no iSCSI listener port group is enabled for target {target.get('targetName') or target.get('uuid')}: {sorted(ports)}")
    return selected

listeners = iscsi_guard("LISTENER", configured_listeners)
required_ports = set()

enabled = bool(payload.get("enabled", True))
applied = 0
skipped = 0
runtime_targets = []
targets = payload.get("targets", []) if enabled else []

def active_targets_by_iqn(targets):
    groups = {}
    for target in targets:
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        iqn = target.get("targetName")
        if not iqn:
            continue
        groups.setdefault(iqn, []).append(target)
    return groups

def merged_listeners_for_targets(group_targets, listeners):
    selected = []
    seen = set()
    for target in group_targets:
        for listener in selected_listeners_for_target(target, listeners):
            key = (listener["listenIp"], listener["port"])
            if key in seen:
                continue
            seen.add(key)
            selected.append(listener)
    return selected

def iscsi_portal_exists(iqn, listen_ip, port):
    path = Path("/sys/kernel/config/target/iscsi") / str(iqn) / "tpgt_1" / "np" / f"{listen_ip}:{port}"
    return path.exists()

def create_iscsi_portal(iqn, listen_ip, port):
    listen_ip = str(listen_ip or "0.0.0.0")
    port = int(port or 3260)
    if iscsi_portal_exists(iqn, listen_ip, port):
        return
    if listen_ip not in ("0.0.0.0", "::") and iscsi_portal_exists(iqn, "0.0.0.0", port):
        return
    result = run_targetcli(f"/iscsi/{iqn}/tpg1/portals", "create", listen_ip, str(port), stage="PORTAL_CREATE")
    if ok_or_exists(result):
        return
    if listen_ip not in ("0.0.0.0", "::") and iscsi_portal_exists(iqn, "0.0.0.0", port):
        return
    if iscsi_portal_exists(iqn, listen_ip, port):
        return
    raise IscsiTargetcliFailure("PORTAL_CREATE", result.returncode, targetcli_error_category(result)) from None

def iscsi_acl_chap_signature(acl):
    config = acl.get("config") or {}
    return "|".join([
        str(bool(config.get("chapEnabled"))),
        str(config.get("chapUsername") or ""),
        str(bool(config.get("mutualChapEnabled"))),
        str(config.get("mutualChapUsername") or ""),
    ])

def merged_acls_for_targets(group_targets):
    merged = []
    seen = {}
    for target in group_targets:
        for acl in target.get("acls", []):
            if acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
                continue
            initiator = acl.get("principal")
            if not initiator:
                continue
            signature = iscsi_acl_chap_signature(acl)
            if initiator in seen:
                if seen[initiator] != signature:
                    raise SystemExit(f"conflicting iSCSI CHAP settings for initiator {initiator}; CHAP is target-scoped")
                existing = next(item for item in merged if item.get("principal") == initiator)
                if not (existing.get("secrets") or {}) and (acl.get("secrets") or {}):
                    existing["secrets"] = acl.get("secrets")
                continue
            seen[initiator] = signature
            merged.append(acl)
    return merged

def chap_enabled_for_acl(acl):
    config = acl.get("config") or {}
    return bool(config.get("chapEnabled")) or bool(config.get("mutualChapEnabled"))

def target_acl_auth(iqn, initiator):
    result = run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "get", "auth", "userid", "password", "mutual_userid", "mutual_password")
    values = {}
    for line in (result.stdout or "").splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    return values

def previous_acl_auth_map(iqn):
    values = {}
    root = Path("/sys/kernel/config/target/iscsi") / str(iqn) / "tpgt_1" / "acls"
    if not root.exists():
        return values
    for item in root.iterdir():
        if item.is_dir():
            values[item.name] = target_acl_auth(iqn, item.name)
    return values

def require_chap_value(name, value, iqn, initiator):
    if value:
        return value
    raise SystemExit(f"iSCSI CHAP credential is required to apply target {iqn} for initiator {initiator}: missing {name}")

def managed_iqn(iqn):
    text = str(iqn or "")
    return text.startswith("iqn.") and ".local.storage:" in text

def existing_iscsi_targets():
    root = Path("/sys/kernel/config/target/iscsi")
    if not root.exists():
        return set()
    return {item.name for item in root.iterdir() if item.is_dir() and managed_iqn(item.name)}

def desired_iqns_from_payload(value):
    iqns = set()
    for target in value.get("targets", []) or []:
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        iqn = target.get("targetName")
        if iqn and managed_iqn(iqn):
            iqns.add(iqn)
    return iqns

def block_backstores_from_payload(value, iqns=None):
    names = set()
    for target in value.get("targets", []) or []:
        iqn = target.get("targetName")
        if iqns is not None and iqn not in iqns:
            continue
        uuid = target.get("uuid")
        if uuid:
            names.add(f"ablestack-{uuid}")
    return names

def existing_managed_block_backstores():
    root = Path("/sys/kernel/config/target/core")
    if not root.exists():
        return set()
    names = set()
    for path in root.glob("iblock_*/*"):
        if path.is_dir() and path.name.startswith("ablestack-"):
            names.add(path.name)
    return names

def cleanup_stale_managed_targets(desired_iqns):
    previous_iqns = desired_iqns_from_payload(previous_payload)
    stale_iqns = (existing_iscsi_targets() | previous_iqns) - desired_iqns
    for iqn in sorted(stale_iqns):
        if managed_iqn(iqn):
            run_targetcli("/iscsi", "delete", iqn)
    stale_backstores = block_backstores_from_payload(previous_payload, stale_iqns)
    if not desired_iqns:
        stale_backstores |= existing_managed_block_backstores()
    for name in sorted(stale_backstores):
        run_targetcli("/backstores/block", "delete", name)

def clear_managed_iscsi_runtime():
    for iqn in sorted(existing_iscsi_targets()):
        run_targetcli("/iscsi", "delete", iqn)
    for name in sorted(existing_managed_block_backstores()):
        run_targetcli("/backstores/block", "delete", name)

def rollback_created(created_iqns, created_backstores):
    for iqn in reversed(created_iqns):
        run_targetcli("/iscsi", "delete", iqn)
    for name in reversed(created_backstores):
        run_targetcli("/backstores/block", "delete", name)

if enabled and targets:
    iscsi_guard("DEPENDENCY", ensure_iscsi_runtime_dependencies)
if command_exists("targetcli"):
    desired_iqns = set(iscsi_guard("INPUT", active_targets_by_iqn, targets).keys())
    if os.environ.get("ABLESTACK_STORAGE_ISCSI_AUTHORITATIVE_REBUILD") == "1":
        clear_managed_iscsi_runtime()
    cleanup_stale_managed_targets(desired_iqns)
    created_iqns = []
    created_backstores = []
    for target in targets:
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error") or target.get("targetName"):
            continue
        skipped += 1
    try:
        for iqn, group_targets in iscsi_guard("INPUT", active_targets_by_iqn, targets).items():
            previous_auth = previous_acl_auth_map(iqn)
            run_targetcli("/iscsi", "delete", iqn)
            for target in group_targets:
                run_targetcli("/backstores/block", "delete", f"ablestack-{target.get('uuid')}")
            require_targetcli("/iscsi", "create", iqn, stage="TARGET_CREATE")
            created_iqns.append(iqn)
            run_targetcli(f"/iscsi/{iqn}/tpg1/portals", "delete", "0.0.0.0", "3260")
            group_listeners = iscsi_guard("LISTENER", merged_listeners_for_targets, group_targets, listeners)
            required_ports.update({item["port"] for item in group_listeners})
            for listener in group_listeners:
                iscsi_guard("LISTENER", create_iscsi_portal, iqn, listener["listenIp"], listener["port"])
            for target in group_targets:
                lun = str(target.get("lunOrNamespace") or "0")
                backstore = f"ablestack-{target.get('uuid')}"
                backstore_path, backing_path, backstore_type = iscsi_guard("DEVICE", resolve_backstore, target, backstore)
                created_backstores.append(backstore)
                require_targetcli(f"/iscsi/{iqn}/tpg1/luns", "create", backstore_path, lun, stage="LUN_CREATE")
                applied += 1
                runtime_targets.append({
                    "uuid": target.get("uuid"),
                    "targetName": iqn,
                    "lunOrNamespace": lun,
                    "volumeUuid": target.get("volumeUuid"),
                    "volumeName": target.get("volumeName"),
                    "volumeSizeBytes": target.get("volumeSizeBytes"),
                    "lunSizeBytes": target.get("lunSizeBytes") or (target.get("config") or {}).get("lunSizeBytes"),
                    "effectiveSizeBytes": iscsi_guard("DEVICE", target_size_bytes, target, backing_path),
                    "backingPath": backing_path,
                    "backstoreType": backstore_type,
                    "listenerPorts": sorted({item["port"] for item in group_listeners}),
                    "endpoints": [f"{item['listenIp']}:{item['port']}" for item in group_listeners],
                })
            chap_required = False
            for acl in merged_acls_for_targets(group_targets):
                initiator = acl.get("principal")
                require_targetcli(f"/iscsi/{iqn}/tpg1/acls", "create", initiator, stage="ACL_CREATE")
                acl_config = acl.get("config") or {}
                secrets = acl.get("secrets") or {}
                old_auth = previous_auth.get(initiator, {})
                if chap_enabled_for_acl(acl):
                    chap_required = True
                if acl_config.get("chapEnabled"):
                    username = require_chap_value("chapUsername", acl_config.get("chapUsername"), iqn, initiator)
                    password = secrets.get("chapSecret") or old_auth.get("password")
                    password = require_chap_value("chapSecret", password, iqn, initiator)
                    secrets["chapSecret"] = password
                if acl_config.get("mutualChapEnabled"):
                    mutual_username = require_chap_value("mutualChapUsername", acl_config.get("mutualChapUsername"), iqn, initiator)
                    mutual_password = secrets.get("mutualChapSecret") or old_auth.get("mutual_password")
                    mutual_password = require_chap_value("mutualChapSecret", mutual_password, iqn, initiator)
                    secrets["mutualChapSecret"] = mutual_password
                iscsi_guard("AUTH", ConfigfsIscsiAuth().apply, iqn, initiator, acl_config, secrets)
            require_targetcli(f"/iscsi/{iqn}/tpg1", "set", "attribute", f"authentication={1 if chap_required else 0}", stage="AUTH_POLICY")
    except BaseException:
        rollback_created(created_iqns, created_backstores)
        raise
    iscsi_guard("VAULT_STATE", merge_and_persist_iscsi_secrets, payload)
    # Canonical state plus the protected private vault own reboot recovery.
    # A generic targetcli saveconfig would dump plaintext CHAP outside that vault.
else:
    skipped = len(payload.get("targets", []))

def verify_iscsi_readiness():
    if enabled and applied:
        # Observe the live portals created above without a targetctl clear/restore.
        for port in required_ports:
            best_effort_firewall(port)
        for _ in range(10):
            if all(port_listening(port) for port in required_ports):
                break
            time.sleep(0.5)
        missing_ports = [port for port in sorted(required_ports) if not port_listening(port)]
        if missing_ports:
            raise SystemExit(f"iSCSI target service did not listen on TCP port(s): {', '.join(str(port) for port in missing_ports)}")

iscsi_guard("READINESS", verify_iscsi_readiness)

print(json.dumps({"success": True, "targets": len(payload.get("targets", [])), "applied": applied, "skipped": skipped, "ports": sorted(required_ports), "listening": all(port_listening(port) for port in required_ports), "runtimeTargets": runtime_targets}))
PY

}

apply_nvmeof_subsystems() {
  local payload_file="$1"

  python3 - "$payload_file" "$0" <<'PY'
import json
import os
import subprocess
import sys
import glob
import time
import errno

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
