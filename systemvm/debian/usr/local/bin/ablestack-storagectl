def verify_share_mount_boundary(path, root):
    if not root or not os.path.isdir(root):
        raise RuntimeError("Backing volume root is unavailable")
    canonical_root = os.path.realpath(root).rstrip("/")
    relative = os.path.relpath(path, canonical_root)
    if relative == "." or relative.startswith("../") or os.path.isabs(relative):
        raise RuntimeError("Share backing path must be below the selected volume root")
    mount = run(["findmnt", "-n", "-o", "TARGET", "-T", canonical_root], stdout=subprocess.PIPE, text=True)
    if mount.returncode != 0:
        raise RuntimeError("Cannot verify share backing mount")
    device = os.stat(canonical_root).st_dev
    current = canonical_root
    for part in relative.split(os.sep):
        current = os.path.join(current, part)
        if os.path.islink(current) or not os.path.isdir(current):
            raise RuntimeError("Share backing path contains a symlink or unavailable directory")
        observed = run(["findmnt", "-n", "-o", "TARGET", "-T", current], stdout=subprocess.PIPE, text=True)
        if os.stat(current).st_dev != device or observed.returncode != 0 or observed.stdout.strip() != mount.stdout.strip():
            raise RuntimeError("Share backing path crosses a filesystem or mount boundary")

if sys.argv[2] == "preflight":
    observations = []
    for share in payload.get("shares", []):
        config = share.get("config") or {}
        path = share.get("path") or config.get("backingPath")
        if not path or str(path).startswith("/export/"):
            raise ValueError("Creation preflight requires the canonical managed backing path")
        if config.get("relativeSharePath") and os.path.isdir(path):
            verify_share_mount_boundary(path, config.get("volumeMountPath"))
        smb_forced_identity(config, share.get("uuid"), share.get("acls", []), create=False)
        observations.append(smb_creation_acl_preflight(path, smb_creation_policy(config)))
    print(json.dumps({"success": True, "creationPolicyPreflight": observations}))
    raise SystemExit(0)

quota_state = {}
access_state = {}
enabled = bool(payload.get("enabled", True))
for share in payload.get("shares", []):
    name = safe_share_name(share.get("name") or share.get("uuid"))
    display_path = share.get("displayPath") or share.get("display_path") or share.get("path")
    config = share.get("config") or {}
    path = share.get("path") or config.get("backingPath")
    if path and str(path).startswith("/export/") and config.get("backingPath"):
        path = config.get("backingPath")
    state = share.get("state", "Ready")
    if not enabled or not path or state in ("Disabled", "Destroyed", "Error"):
        continue
    if str(path).startswith("/export/"):
        raise RuntimeError(f"Refusing to render SMB share {name} on root export path {path}; expected a backing volume path")
    create_directory = truth(config, "createDirectory", True)
    cross_protocol = truth(config, "crossProtocol", False)
    if not os.path.isdir(path):
        if not create_directory:
            raise FileNotFoundError(f"SMB share backing directory does not exist: {path}")
        os.makedirs(path, exist_ok=True)
    if config.get("relativeSharePath"):
        verify_share_mount_boundary(path, config.get("volumeMountPath"))
    forced_identity = smb_forced_identity(config, share.get("uuid"), share.get("acls", []), create=False)
    if forced_identity["posixOwnershipMode"] == "FORCED_UID_GID":
        if not verify_common_posix_policy(path, config) or (os.stat(path).st_uid, os.stat(path).st_gid) != (forced_identity["ownerUid"], forced_identity["ownerGid"]):
            raise ValueError("Forced SMB identity must match the applied common directory owner")
        forced_identity = smb_forced_identity(config, share.get("uuid"), share.get("acls", []), create=True)
    inheritance_policy = smb_inheritance_policy(config, share.get("acls", []))
    creation_policy = smb_creation_policy(config)
    if inheritance_policy["inheritGroup"]:
        if config.get("posixPolicyUuid") and (os.stat(path).st_mode & 0o2000) == 0:
            raise ValueError("Common directory policy must provide setgid for parent group inheritance")
        if not config.get("posixPolicyUuid"):
            config = dict(config, directoryMode=format(int(config.get("directoryMode") or "0770", 8) | 0o2000, "04o"))
    smb_creation_acl_preflight(path, creation_policy)
    previous = previous_access.get(str(share.get("uuid") or name), {})
    directory_mode = apply_directory_policy(path, config, cross_protocol, previous)
    if forced_identity["posixOwnershipMode"] == "FORCED_UID_GID":
        if config.get("posixPolicyUuid"):
            if (os.stat(path).st_uid, os.stat(path).st_gid) != (forced_identity["ownerUid"], forced_identity["ownerGid"]):
                raise ValueError("Forced identity differs from the common directory owner")
        else:
            raise ValueError("Forced SMB identity requires a common managed POSIX owner policy")
    if not config.get("posixPolicyUuid"):
        remove_stale_managed_smb_acls(path, share.get("acls", []), previous)
    valid_users = []
    write_list = []
    admin_users = []
    applied_acl_count = 0
    configured_acl_count = 0
    for acl in share.get("acls", []):
        if acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        principal = acl.get("principal")
        if not principal:
            continue
        configured_acl_count += 1
        principal_type = acl.get("principalType")
        if principal_type == "LOCAL_USER":
            ensure_local_smb_user(principal, acl.get("password"))
        elif principal_type == "LOCAL_GROUP":
            ensure_local_group(principal)
        smb_principal = samba_principal(principal_type, principal, workgroup, netbios_name)
        permission = acl.get("permission", "READ_ONLY")
        valid_users.append(smb_principal)
        if permission in ("READ_WRITE", "ADMIN") and not truth(config, "readOnly", False):
            write_list.append(smb_principal)
        if permission == "ADMIN":
            admin_users.append(smb_principal)
        if not config.get("posixPolicyUuid") and apply_posix_acl(path, principal_type, principal, permission):
            applied_acl_count += 1

    network_policy = smb_network_policy(share.get("networkAcls", []))
    guest_ok = truth(config, 'guestOk', False)
    if guest_ok and not config.get("posixPolicyUuid") and not cross_protocol and (previous.get("path") != path or not previous.get("guestOk")
            or bool(previous.get("readOnly", False)) != truth(config, "readOnly", False)):
        os.chmod(path, 0o777 if not truth(config, 'readOnly', False) else 0o755)
    access_state[str(share.get("uuid") or name)] = {
        **network_policy,
        **forced_identity,
        **inheritance_policy,
        "effectiveUid": os.stat(path).st_uid,
        "effectiveGid": os.stat(path).st_gid,
        "effectiveDirectoryMode": format(os.stat(path).st_mode & 0o7777, "04o"),
        "posixPolicyUuid": config.get("posixPolicyUuid"),
        "posixPolicyRevision": config.get("posixPolicyRevision"),
        "accountAclCount": configured_acl_count,
        "fileOperationIdentity": "forced" if forced_identity["posixOwnershipMode"] == "FORCED_UID_GID" else "authenticated",
        "sessionIdentityPreserved": True,
        "creationPolicy": creation_policy,
        "creationPolicyState": "CONSISTENT",
        "shareName": name,
        "path": path,
        "configuredAclCount": configured_acl_count,
        "appliedAclCount": applied_acl_count,
        "guestOk": guest_ok,
        "readOnly": truth(config, "readOnly", False),
        "accessState": "open" if guest_ok else ("protocol_acl" if config.get("posixPolicyUuid") and configured_acl_count > 0 else ("acl_applied" if applied_acl_count > 0 else "no_acl")),
        "directoryMode": oct(directory_mode),
        "aclSummary": [
            {
                "principalType": acl.get("principalType"),
                "principal": acl.get("principal"),
                "permission": acl.get("permission", "READ_ONLY"),
                "state": acl.get("state", "Ready"),
            }
            for acl in share.get("acls", [])
            if acl.get("state", "Ready") not in ("Disabled", "Destroyed", "Error") and acl.get("principal")
        ],
    }

    lines.extend([
        "",
        f"[{name}]",
        f"   path = {path}",
        f"   read only = {'yes' if smb_effective_read_only(config, configured_acl_count, guest_ok) else 'no'}",
        f"   browseable = {'yes' if truth(config, 'browseable', True) else 'no'}",
        f"   guest ok = {'yes' if guest_ok else 'no'}",

    ])
    lines.extend(smb_creation_lines(creation_policy))
    lines.extend(smb_inheritance_lines(inheritance_policy))
    lines.extend(smb_forced_identity_lines(forced_identity))
    lines.extend(smb_hosts_allow_lines(network_policy))
    if valid_users:
        lines.append("   valid users = " + " ".join(valid_users))
    if write_list:
        lines.append("   write list = " + " ".join(write_list))
    if admin_users:
        lines.append("   admin users = " + " ".join(admin_users))
    if share.get("quotaBytes") is not None:
        quota_state[str(share.get("uuid"))] = {
            "path": path,
            "displayPath": display_path,
            "quotaBytes": share.get("quotaBytes"),
            "filesystem": share.get("filesystem"),
        }

def smb_owned_listening_sockets(timeout=10):
    observed = run(["ss", "-ltnpH"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)
    result = set()
    for line in observed.stdout.splitlines():
        fields = line.split()
        if len(fields) < 5 or '"smbd"' not in line:
            continue
        address, _, port = fields[3].rpartition(":")
        address = address.strip("[]")
        try:
            result.add((str(ipaddress.ip_address(address)), int(port)))
        except ValueError:
            continue
    return result


def verify_smb_endpoint_listeners(rows, timeout=10):
    deadline = time.monotonic() + timeout
    def budget(maximum):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError("SMB endpoint listener verification deadline expired")
        return min(maximum, remaining)
    requested = []
    for row in rows:
        ip = str(ipaddress.ip_address(str(row.get("listenIp") or "0.0.0.0")))
        port = int(row.get("port") or 445)
        if not 1 <= port <= 65535:
            raise ValueError("SMB endpoint port is invalid")
        requested.append((ip, port))
    addresses = run(["ip", "-j", "address", "show"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=budget(10))
    assigned = {str(ipaddress.ip_address(item["local"])) for interface in json.loads(addresses.stdout)
                for item in interface.get("addr_info", []) if item.get("local")}
    if any(ip not in ("0.0.0.0", "::") and ip not in assigned for ip, port in requested):
        raise RuntimeError("An SMB endpoint IP is not assigned to this Storage Service VM")
    while True:
        owned = smb_owned_listening_sockets(timeout=budget(10))
        proofs = []
        for ip, port in requested:
            remaining = budget(1)
            ready = False
            if (ip, port) in owned:
                target = "127.0.0.1" if ip == "0.0.0.0" else "::1" if ip == "::" else ip
                try:
                    with socket.create_connection((target, port), timeout=remaining):
                        ready = True
                except OSError:
                    pass
            proofs.append({"listenIp": ip, "port": port, "listenerOwned": (ip, port) in owned,
                           "tcpReady": ready, "success": ready})
        if all(item["success"] for item in proofs):
            budget(1)
            return proofs
        if time.monotonic() >= deadline:
            missing = [str(item["listenIp"]) + ":" + str(item["port"]) for item in proofs if not item["success"]]
            raise RuntimeError("SMB endpoint listener verification failed: " + ", ".join(missing))
        time.sleep(budget(0.2))

def smb_listener_key(ip, port):
    return hashlib.sha256((str(ipaddress.ip_address(ip)) + ":" + str(int(port))).encode()).hexdigest()[:24]


def smb_legacy_listening_sockets():
    observed = run(["systemctl", "show", "smbd.service", "-p", "MainPID", "--value"],
                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
    pid = int(observed.stdout.strip() or "0")
    if pid <= 0:
        return set()
    sockets = run(["ss", "-ltnpH"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
    result = set()
    for line in sockets.stdout.splitlines():
        fields = line.split()
        if len(fields) < 5 or not re.search(r'"smbd",pid=' + str(pid) + r'[,)]', line):
            continue
        ip, _, port = fields[3].rpartition(":")
        try:
            result.add((str(ipaddress.ip_address(ip.strip("[]"))), int(port)))
        except ValueError:
            pass
    return result

def smb_managed_listening_sockets(records):
    known = set()
    observed = run(["ss", "-ltnpH"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
    for key, content in records.items():
        record = json.loads(content)
        unit = "ablestack-storage-smb@" + key + ".service"
        result = run(["systemctl", "show", unit, "-p", "MainPID", "-p", "ControlGroup"],
                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        properties = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
        if int(properties.get("MainPID") or "0") <= 0:
            continue
        pid_path = "/run/ablestack-storage/smb/" + key + "/smbd.pid"
        try:
            info = os.lstat(pid_path)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
                raise ValueError("Managed SMB acceptor PID receipt is not protected")
            with open(pid_path, encoding="ascii") as handle:
                pid = int(handle.read().strip())
            with open("/proc/" + str(pid) + "/cmdline", "rb") as handle:
                command = handle.read().split(b"\x00")
            with open("/proc/" + str(pid) + "/cgroup", encoding="ascii") as handle:
                cgroups = [line.strip().split(":", 2)[-1] for line in handle]
        except FileNotFoundError:
            continue
        expected_cgroup = properties.get("ControlGroup")
        if not expected_cgroup or expected_cgroup not in cgroups:
            raise ValueError("Managed SMB acceptor PID belongs to another service")
        required = [("--option=pid directory=/run/ablestack-storage/smb/" + key).encode(),
                    ("--option=smb ports=" + str(record["port"])).encode()]
        if any(argument not in command for argument in required):
            raise ValueError("Managed SMB acceptor PID does not match its pinned endpoint")
        for line in observed.stdout.splitlines():
            if re.search(r'"smbd",pid=' + str(pid) + r'[,)]', line):
                fields = line.split()
                ip, _, port = fields[3].rpartition(":")
                if (ip.strip("[]"), int(port)) == (record["listenIp"], record["port"]):
                    known.add((record["listenIp"], record["port"]))
    return known

def smb_endpoint_connections(ip, port):
    observed = run(["ss", "-tnpH", "state", "established"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
    count = 0
    for line in observed.stdout.splitlines():
        if '"smbd"' not in line:
            continue
        for field in line.split():
            address, separator, raw_port = field.rpartition(":")
            if separator and raw_port == str(port):
                try:
                    actual_ip = str(ipaddress.ip_address(address.strip("[]")))
                    if ip in ("0.0.0.0", "::") or actual_ip == ip:
                        count += 1
                        break
                except ValueError:
                    pass
    return count


def smb_unit_active(unit):
    return subprocess.run(["systemctl", "is-active", "--quiet", unit], check=False,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=smb_budget(10)).returncode == 0


def reconcile_smb_endpoint_units(rows):
    wanted = {}
    for item in rows:
        ip = str(ipaddress.ip_address(str(item.get("listenIp") or "0.0.0.0")))
        port = int(item.get("port") or 445)
        if not 1 <= port <= 65535:
            raise ValueError("SMB endpoint port is invalid")
        wanted[smb_listener_key(ip, port)] = {"listenIp": ip, "port": port}
    for endpoint in wanted.values():
        if endpoint["listenIp"] in ("0.0.0.0", "::") and any(other != endpoint and other["port"] == endpoint["port"] for other in wanted.values()):
            raise ValueError("Wildcard and specific SMB endpoints on one port overlap")
    current_sockets = smb_owned_listening_sockets()
    previous_sockets = set(current_sockets)
    legacy_sockets = smb_legacy_listening_sockets()
    requested_sockets = {(item["listenIp"], item["port"]) for item in wanted.values()}
    stale_legacy = {(ip, port) for ip, port in legacy_sockets - requested_sockets if ip not in ("127.0.0.1", "::1")}
    if stale_legacy and legacy_sockets & requested_sockets:
        raise RuntimeError("Shared legacy SMB acceptor endpoint removal requires explicit maintenance drain")
    if any(smb_endpoint_connections(ip, port) for ip, port in stale_legacy):
        raise RuntimeError("Legacy SMB endpoint removal requires its sessions to drain")
    empty_default_transition = False
    for endpoint in wanted.values():
        overlaps = {(wildcard, endpoint["port"]) for wildcard in ("0.0.0.0", "::") if (wildcard, endpoint["port"]) in current_sockets}
        if endpoint["listenIp"] not in ("0.0.0.0", "::") and overlaps:
            old_desired = os.path.join(state_dir, "desired-state", "smb-share-apply.json")
            if os.path.lexists(old_desired) or not overlaps.issubset(legacy_sockets) or any(smb_endpoint_connections(ip, port) for ip, port in overlaps):
                raise RuntimeError("Wildcard-to-specific SMB transition requires explicit session drain")
            empty_default_transition = True
    registry = os.path.join(state_dir, "smb-endpoint-listeners")
    os.makedirs(registry, mode=0o750, exist_ok=True)
    info = os.lstat(registry)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
        raise ValueError("SMB endpoint registry is not protected")
    unit_path = "/etc/systemd/system/ablestack-storage-smb@.service"
    unit_content = """[Unit]
Description=ABLESTACK Storage Service SMB endpoint %i
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecCondition=/usr/local/bin/ablestack-storagectl operation generation render-boot-gate %n
ExecStart=/usr/local/bin/ablestack-storagectl smb endpoint-run %i
RuntimeDirectory=ablestack-storage/smb/%i
RuntimeDirectoryMode=0750
KillMode=control-group
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
"""
    if os.path.lexists(unit_path):
        unit_info = os.lstat(unit_path)
        if not stat.S_ISREG(unit_info.st_mode) or unit_info.st_uid != os.geteuid() or unit_info.st_mode & 0o022:
            raise ValueError("SMB endpoint service definition is not protected")
        with open(unit_path, encoding="utf-8") as handle:
            installed_unit = handle.read()
        legacy_unit = unit_content.replace("ExecCondition=/usr/local/bin/ablestack-storagectl operation generation render-boot-gate %n\n", "")
        if installed_unit not in (unit_content, legacy_unit):
            raise ValueError("SMB endpoint service definition differs from the managed source")
        if installed_unit == legacy_unit and installed_unit != unit_content:
            descriptor, temporary = tempfile.mkstemp(prefix=".smb-endpoint-unit-", dir=os.path.dirname(unit_path))
            try:
                os.fchmod(descriptor, 0o644)
                with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                    handle.write(unit_content);handle.flush();os.fsync(handle.fileno())
                os.replace(temporary, unit_path)
                run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
            finally:
                if os.path.exists(temporary): os.unlink(temporary)
    else:
        descriptor, temporary = tempfile.mkstemp(prefix=".smb-endpoint-unit-", dir=os.path.dirname(unit_path))
        try:
            os.fchmod(descriptor, 0o644)
            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                handle.write(unit_content);handle.flush();os.fsync(handle.fileno())
            os.replace(temporary, unit_path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    previous = {}
    previous_active = set()
    for name in os.listdir(registry):
        if not re.fullmatch(r"[0-9a-f]{24}\.json", name):
            raise ValueError("SMB endpoint registry contains an unrecognized entry")
        path = os.path.join(registry, name)
        file_info = os.lstat(path)
        if not stat.S_ISREG(file_info.st_mode) or file_info.st_uid != os.geteuid() or file_info.st_mode & 0o022:
            raise ValueError("SMB endpoint listener record is not protected")
        with open(path, "rb") as handle:
            content = handle.read(4097)
        record = json.loads(content)
        if len(content) > 4096 or set(record) != {"listenIp", "port"} or isinstance(record["port"], bool) or not isinstance(record["port"], int) or not 1 <= record["port"] <= 65535:
            raise ValueError("SMB endpoint listener record is invalid")
        if smb_listener_key(record["listenIp"], record["port"]) != name[:-5]:
            raise ValueError("SMB endpoint listener record scope changed")
        previous[name[:-5]] = content
        if smb_unit_active("ablestack-storage-smb@" + name[:-5] + ".service"):
            previous_active.add(name[:-5])
    managed_sockets = smb_managed_listening_sockets(previous)
    foreign = (current_sockets & requested_sockets) - legacy_sockets - managed_sockets
    if foreign:
        raise RuntimeError("SMB endpoint listener is owned by an unrelated acceptor")
    default_enabled = subprocess.run(["systemctl", "is-enabled", "--quiet", "smbd.service"], check=False,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=smb_budget(10)).returncode == 0
    default_disabled = False
    journal_path = os.path.join(registry, "..", "smb-endpoint-journal.json")
    def atomic_endpoint(path, content):
        fd, tmp = tempfile.mkstemp(prefix=".smb-endpoint-", dir=os.path.dirname(path))
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "wb") as handle:
                handle.write(content);handle.flush();os.fsync(handle.fileno())
            os.replace(tmp, path)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    def journal(phase):
        atomic_endpoint(journal_path, json.dumps({"phase": phase, "previous": {key: json.loads(value) for key, value in previous.items()},
                                                 "previousActive": sorted(previous_active), "previousDefaultEnabled": default_enabled, "target": wanted}, sort_keys=True).encode())
    started = []
    stopped = []
    legacy_stopped = False
    journal("APPLYING")
    try:
        if empty_default_transition:
            legacy_stopped = True
            run(["systemctl", "stop", "smbd.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
            current_sockets = smb_owned_listening_sockets()
        for key, endpoint in wanted.items():
            atomic_endpoint(os.path.join(registry, key + ".json"), json.dumps(endpoint, sort_keys=True).encode())
            unit = "ablestack-storage-smb@" + key + ".service"
            if (endpoint["listenIp"], endpoint["port"]) not in current_sockets:
                started.append(key)
                run(["systemctl", "start", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
        for key in previous.keys() - wanted.keys():
            old = json.loads(previous[key])
            if smb_endpoint_connections(old["listenIp"], old["port"]):
                raise RuntimeError("SMB endpoint removal requires its sessions to drain")
            unit = "ablestack-storage-smb@" + key + ".service"
            if key in previous_active:
                run(["systemctl", "stop", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
                stopped.append(key)
            os.unlink(os.path.join(registry, key + ".json"))
        if stale_legacy and not legacy_stopped:
            legacy_stopped = True
            run(["systemctl", "stop", "smbd.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
        proof = verify_smb_endpoint_listeners(rows, timeout=smb_budget(10))
        # Boot reconcile creates only the desired per-endpoint acceptors after
        # aliases/mounts exist. Leave a legacy running master and its workers
        # intact during the in-place migration, but suppress its next boot.
        run(["systemctl", "disable", "smbd.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        default_disabled = True
        journal("VERIFIED")
        return proof
    except Exception as apply_failure:
        global smb_rollback_active
        smb_rollback_active = True
        try:
            for key in reversed(started):
                run(["systemctl", "stop", "ablestack-storage-smb@" + key + ".service"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
            for key in wanted.keys() - previous.keys():
                path = os.path.join(registry, key + ".json")
                if os.path.exists(path):
                    os.unlink(path)
            for key, content in previous.items():
                atomic_endpoint(os.path.join(registry, key + ".json"), content)
            # Restore the protected previous config bytes before reloading the
            # surviving A workers or restarting a previous endpoint acceptor.
            rollback_uncommitted_managed_identities()
            for path, content in smb_previous_files.items():
                if content is not None:
                    with open(path, "rb") as handle:
                        if hashlib.sha256(handle.read()).digest() != hashlib.sha256(content).digest():
                            raise RuntimeError("Previous SMB configuration hash was not restored")
                elif os.path.lexists(path):
                    raise RuntimeError("Previous absent SMB configuration was not restored")
            if legacy_stopped:
                run(["systemctl", "start", "smbd.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
            for key in set(stopped) | (set(started) & previous_active):
                run(["systemctl", "start", "ablestack-storage-smb@" + key + ".service"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
            if default_disabled and default_enabled:
                run(["systemctl", "enable", "smbd.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
            if shutil.which("smbcontrol"):
                run(["smbcontrol", "all", "reload-config"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
            previous_rows = [{"listenIp": ip, "port": port} for ip, port in sorted(previous_sockets)]
            verify_smb_endpoint_listeners(previous_rows, timeout=smb_budget(10))
            journal("ROLLED_BACK")
        except Exception as rollback_failure:
            journal("RECOVERY_REQUIRED")
            raise RuntimeError("SMB endpoint rollback requires manual recovery") from rollback_failure
        raise apply_failure


def rendered_runtime_context(domain):
    value = os.environ.get("ABLESTACK_STORAGE_RENDERED_REPLAY")
    if not value: return None
    root = Path(os.environ.get("ABLESTACK_STORAGE_RENDERED_GENERATIONS", "/var/lib/ablestack-storage/rendered-generations"))
    pointer = root / "current"
    if not pointer.is_symlink() or os.readlink(pointer) != "generations/" + Path(value).name or Path(value) != root / os.readlink(pointer):
        raise ValueError("Internal rendered replay differs from the managed current pointer")
    for parent in (root, root / "generations", Path(value)):
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
            raise ValueError("Internal rendered generation parent is not protected")
    def read(name):
        path = Path(value) / name
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > 8 * 1024 * 1024:
            raise ValueError("Internal rendered generation file is not protected")
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            opened = os.fstat(descriptor)
            if (opened.st_dev, opened.st_ino, opened.st_mode, opened.st_size) != (info.st_dev, info.st_ino, info.st_mode, info.st_size):
                raise ValueError("Internal rendered generation changed")
            data = os.read(descriptor, 8 * 1024 * 1024 + 1)
            after = os.fstat(descriptor)
            if (after.st_size, after.st_mtime_ns, after.st_ctime_ns) != (opened.st_size, opened.st_mtime_ns, opened.st_ctime_ns):
                raise ValueError("Internal rendered file changed while reading")
            return data
        finally: os.close(descriptor)
    manifest = json.loads(read("generation.json"))
    canonical = {key:item for key,item in manifest.items() if key != "manifestSha256"}
    if hashlib.sha256(json.dumps(canonical, sort_keys=True, separators=(",", ":")).encode()).hexdigest() != manifest.get("manifestSha256"):
        raise ValueError("Internal rendered generation manifest hash changed")
    journal = json.loads((root / "activation.json").read_text())
    if manifest["manifestSha256"] not in (journal.get("targetSha256"), journal.get("previousSha256")):
        raise ValueError("Internal rendered replay is outside its pinned activation")
    for name, digest in manifest["files"].items():
        if not re.fullmatch(r"(?:nfs/manifest.json|nfs/ganesha/[0-9a-f]{24}\.conf|nfs/exports/[0-9a-f-]{36}\.exports|smb/smb.conf|smb/manifest.json|smb/listeners/[0-9a-f]{24}\.json|block/(?:iscsi|nvmeof)-plan.json|desired-state.json|network-bindings.json|posix-plan.json|prerequisites.json|file-volumes.json)", name):
            raise ValueError("Internal rendered replay has an unexpected path")
        if hashlib.sha256(read(name)).hexdigest() != digest:
            raise ValueError("Internal rendered runtime file hash changed")
    return Path(value), manifest
def install_validated_smb_config(lines, config_path):
    context = rendered_runtime_context("SMB")
    if context:
        root, manifest = context
        path = Path(config_path)
        target = root.parent.parent / "current" / "smb/smb.conf"
        run(["testparm", "-s", str(target)], stdout=subprocess.DEVNULL)
        if path.is_symlink():
            if os.readlink(path) != str(target): raise ValueError("Samba config symlink belongs to another source")
        else:
            info = path.lstat()
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
                raise ValueError("Legacy Samba config is not protected")
            temporary = path.with_name(".rendered-smb.conf")
            temporary.unlink(missing_ok=True); temporary.symlink_to(target); os.replace(temporary, path)
        return
    fd, candidate = tempfile.mkstemp(prefix=".ablestack-smb-", dir=os.path.dirname(config_path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as smb_fp:
            smb_fp.write("\n".join(lines) + "\n")
            smb_fp.flush()
            os.fsync(smb_fp.fileno())
        run(["testparm", "-s", candidate], stdout=subprocess.DEVNULL)
        os.chmod(candidate, 0o644)
        os.replace(candidate, config_path)
    finally:
        if os.path.exists(candidate):
            os.unlink(candidate)

install_validated_smb_config(lines, "/etc/samba/smb.conf")

with open(os.path.join(state_dir, "smb-quotas.json"), "w", encoding="utf-8") as quota_fp:
