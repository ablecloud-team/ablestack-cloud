runtime_sessions() {
  local payload_file="${1:-}"
  emit_cached_runtime "sessions" "$payload_file" && return 0
  python3 - "$payload_file" <<'PY'
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, "/usr/local/lib/ablestack-storage")
from session_auth import (  # noqa: E402
    classify_iscsi_auth_session,
    compatibility_authenticated,
    parse_targetcli_auth_observation,
)

def load_payload(path):
    if not path:
        return {}
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return {}

def endpoint_host(value):
    if not value:
        return ""
    if value.startswith("[") and "]:" in value:
        value = value[1:value.index("]:")]
    else:
        value = value.rsplit(":", 1)[0]
    return normalize_ip(value)

def normalize_ip(value):
    value = str(value or "").strip()
    if value.startswith("[") and value.endswith("]"):
        value = value[1:-1]
    if value.lower().startswith("::ffff:"):
        return value.split(":", 3)[-1]
    return value

def endpoint_port(value):
    value = str(value or "").strip()
    if value.startswith("[") and "]:" in value:
        value = value.rsplit(":", 1)[-1]
    elif ":" in value:
        value = value.rsplit(":", 1)[-1]
    try:
        return int(value)
    except Exception:
        return None

def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return default

def store_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(value, handle, sort_keys=True)
        handle.write("\n")
    os.replace(tmp, path)

def read_text(path, default=""):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip()
    except Exception:
        return default

def nfs_protocol_mode_from_content(content):
    protocols = re.findall(r"Protocols\s*=\s*([^;\n]+)", content or "")
    joined = ",".join(protocols)
    return "V3V4_DUAL" if "3" in joined and "4" in joined else "V4_ONLY"

def nfs_export_name_from_pseudo(pseudo):
    name = str(pseudo or "").strip().strip("/")
    return name or ""

def configured_nfs_listener_exports():
    listeners = {}
    for path in sorted(glob.glob("/etc/ganesha/ablestack-storage/*.conf")):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                content = handle.read()
        except Exception:
            continue
        bind_match = re.search(r"Bind_addr\s*=\s*\"?([^\";\n]+)\"?", content)
        port_match = re.search(r"NFS_Port\s*=\s*(\d+)", content)
        listen_ip = normalize_ip(bind_match.group(1).strip() if bind_match else "0.0.0.0")
        port = int(port_match.group(1)) if port_match else 2049
        key = (listen_ip, port)
        entries = listeners.setdefault(key, [])
        for export_block in re.findall(r"EXPORT\s*\{(.*?)\n\}", content, re.S):
            pseudo_match = re.search(r"Pseudo\s*=\s*\"?([^\";\n]+)\"?", export_block)
            path_match = re.search(r"Path\s*=\s*\"?([^\";\n]+)\"?", export_block)
            pseudo = pseudo_match.group(1).strip() if pseudo_match else ""
            name = nfs_export_name_from_pseudo(pseudo)
            if not name:
                continue
            entries.append({
                "resourceName": name,
                "exportName": name,
                "clientPath": f"/{name}",
                "backingPath": path_match.group(1).strip() if path_match else "",
                "protocolMode": nfs_protocol_mode_from_content(export_block),
            })
    return listeners

def nfs_listener_ports():
    ports = {2049}
    for key, entries in configured_nfs_listener_exports().items():
        if entries:
            ports.add(key[1])
    return ports

def nfs_export_hint_for_session(local):
    listeners = configured_nfs_listener_exports()
    local_ip = endpoint_host(local)
    local_port = endpoint_port(local)
    if not local_port:
        return {}
    entries = list(listeners.get((local_ip, local_port), []))
    if not entries:
        entries = list(listeners.get(("0.0.0.0", local_port), []))
    if not entries:
        return {}
    if len(entries) == 1:
        return dict(entries[0])
    return {"possibleExports": entries, "resourceName": "", "exportName": ""}

def active_nvme_subsystems():
    state = load_json("/etc/ablestack-storage/nvmeof-subsystems.json", {})
    subsystems = []
    for subsystem in state.get("subsystems", []) if isinstance(state, dict) else []:
        name = subsystem.get("targetName") or subsystem.get("subsystemNqn")
        if name and subsystem.get("state", "Ready") not in ("Disabled", "Destroyed", "Error"):
            config = subsystem.get("config") if isinstance(subsystem.get("config"), dict) else {}
            namespace = str(subsystem.get("lunOrNamespace") or subsystem.get("lunornamespace") or subsystem.get("namespaceId") or subsystem.get("namespaceid") or config.get("namespaceId") or config.get("namespaceid") or "1")
            subsystems.append({
                "id": str(subsystem.get("id") or ""),
                "uuid": str(subsystem.get("uuid") or ""),
                "name": str(name),
                "subsystemNqn": str(name),
                "namespace": namespace,
                "namespaces": [namespace],
                "endpoint": f"{state.get('listenIp') or subsystem.get('listenIp') or ''}:{state.get('port') or subsystem.get('port') or 4420}".strip(":"),
            })
    return subsystems

def configfs_nvme_subsystem_details(name):
    root = os.path.join("/sys/kernel/config/nvmet/subsystems", str(name or ""))
    if not os.path.isdir(root):
        return {}
    namespaces = []
    namespaces_root = os.path.join(root, "namespaces")
    if os.path.isdir(namespaces_root):
        for entry in sorted(os.listdir(namespaces_root), key=lambda value: int(value) if str(value).isdigit() else str(value)):
            path = os.path.join(namespaces_root, entry)
            if not os.path.isdir(path):
                continue
            enabled = read_text(os.path.join(path, "enable"))
            device_path = read_text(os.path.join(path, "device_path"))
            namespaces.append({
                "id": str(entry),
                "enabled": enabled,
                "devicePath": device_path,
            })
    hosts = []
    hosts_root = os.path.join(root, "allowed_hosts")
    if os.path.isdir(hosts_root):
        for entry in sorted(os.listdir(hosts_root)):
            hosts.append(entry)
    allow_any_host = read_text(os.path.join(root, "attr_allow_any_host")) == "1"
    return {
        "subsystemNqn": str(name),
        "name": str(name),
        "namespaces": [namespace.get("id") for namespace in namespaces if namespace.get("id")],
        "namespaceDetails": namespaces,
        "namespaceCount": len([namespace for namespace in namespaces if namespace.get("enabled") == "1" or namespace.get("devicePath")]),
        "allowedHosts": hosts,
        "allowAnyHost": allow_any_host,
    }

def configfs_nvme_listeners():
    listeners = []
    root = "/sys/kernel/config/nvmet/ports"
    if not os.path.isdir(root):
        return listeners
    state_by_name = {item.get("name"): item for item in active_nvme_subsystems() if item.get("name")}
    for port_id in sorted(os.listdir(root), key=lambda value: int(value) if str(value).isdigit() else str(value)):
        port_root = os.path.join(root, port_id)
        if not os.path.isdir(port_root):
            continue
        listen_ip = normalize_ip(read_text(os.path.join(port_root, "addr_traddr"), ""))
        port = endpoint_port(read_text(os.path.join(port_root, "addr_trsvcid"), ""))
        transport = read_text(os.path.join(port_root, "addr_trtype"), "tcp") or "tcp"
        subsystem_root = os.path.join(port_root, "subsystems")
        subsystems = []
        if os.path.isdir(subsystem_root):
            for entry in sorted(os.listdir(subsystem_root)):
                detail = configfs_nvme_subsystem_details(entry)
                state_item = state_by_name.get(entry, {})
                if state_item:
                    for key, value in state_item.items():
                        if key in ("namespaces", "namespaceDetails", "namespaceCount", "allowedHosts", "allowAnyHost"):
                            continue
                        if value not in (None, "", []):
                            detail[key] = value
                    detail.setdefault("subsystemNqn", entry)
                    detail.setdefault("name", entry)
                if not detail:
                    detail = {"subsystemNqn": entry, "name": entry, "namespaces": [], "namespaceCount": 0}
                subsystems.append(detail)
        listeners.append({
            "portId": str(port_id),
            "listenIp": listen_ip,
            "port": port,
            "transport": transport,
            "subsystems": subsystems,
        })
    return listeners

def nvmeof_listener_ports():
    ports = {listener.get("port") for listener in configfs_nvme_listeners() if listener.get("port")}
    state = load_json("/etc/ablestack-storage/nvmeof-subsystems.json", {})
    if isinstance(state, dict):
        ports.update(normalize_port_values(state.get("port") or state.get("listenPort") or state.get("listenport")))
        for listener in state.get("listeners") or []:
            if isinstance(listener, dict):
                ports.update(normalize_port_values(listener.get("port") or listener.get("listenPort") or listener.get("listenport")))
        for subsystem in state.get("subsystems") or []:
            if isinstance(subsystem, dict):
                config = subsystem.get("config") if isinstance(subsystem.get("config"), dict) else {}
                ports.update(normalize_port_values(subsystem.get("listenerPorts") or subsystem.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports") or config.get("listenerPorts") or config.get("listenerports")))
    return ports or {4420}

def nvme_listener_matches_session(listener, local_ip, local_port):
    if listener.get("port") != local_port:
        return False
    listen_ip = normalize_ip(listener.get("listenIp"))
    return listen_ip in ("", "0.0.0.0", "::") or listen_ip == normalize_ip(local_ip)

def nvme_subsystem_candidates_for_session(local):
    local_ip = endpoint_host(local)
    local_port = endpoint_port(local)
    candidates = []
    if not local_port:
        return candidates
    for listener in configfs_nvme_listeners():
        if not nvme_listener_matches_session(listener, local_ip, local_port):
            continue
        for subsystem in listener.get("subsystems") or []:
            if subsystem.get("namespaceCount", 0) <= 0:
                continue
            item = dict(subsystem)
            item["listenerPort"] = listener.get("port")
            item["listenerIp"] = listener.get("listenIp")
            item["listenerPortId"] = listener.get("portId")
            candidates.append(item)
    return candidates

def nvme_subsystem_hint(filters):
    subsystems = active_nvme_subsystems()
    resource_id = str(filters.get("resourceId") or filters.get("resourceName") or "").strip()
    if resource_id:
        resource_id_lower = resource_id.lower()
        for subsystem in subsystems:
            candidates = (subsystem.get("id"), subsystem.get("uuid"), subsystem.get("name"))
            if any(resource_id_lower == str(candidate or "").lower() for candidate in candidates):
                return subsystem
    if len(subsystems) == 1:
        return subsystems[0]
    return {}

def active_iscsi_state():
    state = load_json("/etc/ablestack-storage/iscsi-targets.json", {})
    return state if isinstance(state, dict) else {}

def configfs_iscsi_listener_ports():
    ports = set()
    root = "/sys/kernel/config/target/iscsi"
    if not os.path.isdir(root):
        return ports
    for portals_root in glob.glob(os.path.join(root, "*", "tpgt_1", "np")):
        if not os.path.isdir(portals_root):
            continue
        for entry in os.listdir(portals_root):
            port = endpoint_port(entry)
            if port:
                ports.add(port)
    return ports

def normalize_port_values(value):
    ports = set()
    if isinstance(value, list):
        values = value
    elif isinstance(value, str):
        values = [part.strip() for part in value.split(",")]
    elif value is None:
        values = []
    else:
        values = [value]
    for item in values:
        try:
            port = int(item)
            if port > 0:
                ports.add(port)
        except Exception:
            pass
    return ports

def iscsi_listener_ports():
    state = active_iscsi_state()
    ports = set()
    ports.update(configfs_iscsi_listener_ports())
    for listener in state.get("listeners") or []:
        if isinstance(listener, dict):
            ports.update(normalize_port_values(listener.get("port") or listener.get("listenPort") or listener.get("listenport")))
    ports.update(normalize_port_values(state.get("port") or state.get("listenPort") or state.get("listenport")))
    for target in state.get("targets") or []:
        if not isinstance(target, dict):
            continue
        config = target.get("config") if isinstance(target.get("config"), dict) else {}
        ports.update(normalize_port_values(target.get("listenerPorts") or target.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports") or config.get("listenerPorts") or config.get("listenerports")))
    return ports or {3260}

def target_listener_ports_from_state(target):
    config = target.get("config") if isinstance(target.get("config"), dict) else {}
    ports = normalize_port_values(target.get("listenerPorts") or target.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports") or config.get("listenerPorts") or config.get("listenerports"))
    return ports or iscsi_listener_ports()

def active_iscsi_targets_for_port(local_port):
    state = active_iscsi_state()
    targets = []
    for target in state.get("targets") or []:
        if not isinstance(target, dict):
            continue
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        if local_port in target_listener_ports_from_state(target):
            targets.append(target)
    return targets

def target_name_value(target):
    return str(target.get("targetName") or target.get("targetname") or target.get("name") or "").strip()

def target_lun_value(target):
    return str(target.get("lunOrNamespace") or target.get("lunornamespace") or target.get("lun") or "0").strip()

def configfs_iscsi_acls_for_target(target_name):
    root = os.path.join("/sys/kernel/config/target/iscsi", str(target_name or ""), "tpgt_1", "acls")
    if not os.path.isdir(root):
        return []
    acls = []
    for name in sorted(os.listdir(root)):
        path = os.path.join(root, name)
        if os.path.isdir(path):
            acls.append({"principal": name, "state": "Ready", "source": "configfs"})
    return acls

def active_acls_for_target(target):
    acls = []
    raw_acls = target.get("acls", [])
    if not raw_acls:
        raw_acls = configfs_iscsi_acls_for_target(target_name_value(target))
    for acl in raw_acls:
        if not isinstance(acl, dict) or acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        principal = acl.get("principal") or acl.get("initiatorIqn") or acl.get("initiatoriqn")
        if not principal:
            continue
        acls.append(acl)
    return acls

def configfs_iscsi_lun_backstore_map():
    mapping = {}
    root = "/sys/kernel/config/target/iscsi"
    if not os.path.isdir(root):
        return mapping
    for target_name in sorted(os.listdir(root)):
        if target_name == "discovery_auth":
            continue
        lun_root = os.path.join(root, target_name, "tpgt_1", "lun")
        if not os.path.isdir(lun_root):
            continue
        for lun_dir_name in sorted(os.listdir(lun_root)):
            if not lun_dir_name.startswith("lun_"):
                continue
            lun_dir = os.path.join(lun_root, lun_dir_name)
            if not os.path.isdir(lun_dir):
                continue
            lun = lun_dir_name.split("_", 1)[1]
            for entry in os.listdir(lun_dir):
                path = os.path.join(lun_dir, entry)
                if not os.path.islink(path):
                    continue
                backstore = os.path.basename(os.path.realpath(path))
                if backstore:
                    mapping[backstore] = {"targetIqn": target_name, "lun": lun}
    return mapping

def targetcli_iscsi_session_details():
    if not shutil.which("targetcli"):
        return []
    result = subprocess.run(["targetcli", "sessions", "detail"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0:
        return []
    lun_map = configfs_iscsi_lun_backstore_map()
    sessions = []
    current = None
    for line in result.stdout.splitlines():
        text = line.strip()
        if not text:
            continue
        if text.startswith("alias:"):
            if current:
                sessions.append(current)
            current = {"mappedLuns": []}
            sid_match = re.search(r"\bsid:\s*([^\s]+)", text)
            if sid_match:
                current["targetcliSid"] = sid_match.group(1)
            state_match = re.search(r"session-state:\s*([A-Z_]+)", text)
            if state_match:
                current["state"] = state_match.group(1)
            continue
        if current is None:
            continue
        if text.startswith("name:"):
            name_match = re.search(r"name:\s*([^\s]+)", text)
            if name_match:
                current["initiatorIqn"] = name_match.group(1)
            current["targetcliAuthObservation"] = parse_targetcli_auth_observation(text)
            continue
        if text.startswith("mapped-lun:"):
            lun_match = re.search(r"mapped-lun:\s*([^\s]+)", text)
            backstore_match = re.search(r"backstore:\s*[^/]+/([^\s]+)", text)
            mode_match = re.search(r"\bmode:\s*([^\s]+)", text)
            mapped = {}
            if lun_match:
                mapped["mappedLun"] = lun_match.group(1)
            if backstore_match:
                backstore = backstore_match.group(1)
                mapped["backstore"] = backstore
                mapped.update(lun_map.get(backstore, {}))
            if mode_match:
                mapped["mode"] = mode_match.group(1)
            current["mappedLuns"].append(mapped)
            continue
        if text.startswith("address:"):
            address_match = re.search(r"address:\s*([^\s]+)", text)
            if address_match:
                current["peerHost"] = normalize_ip(address_match.group(1))
            connection_match = re.search(r"connection-state:\s*([A-Z_]+)", text)
            if connection_match:
                current["connectionState"] = connection_match.group(1)
            continue
    if current:
        sessions.append(current)
    return sessions

def configfs_iscsi_target_portals(target_name):
    portals = []
    if not target_name:
        return portals
    np_root = os.path.join("/sys/kernel/config/target/iscsi", target_name, "tpgt_1", "np")
    if not os.path.isdir(np_root):
        return portals
    for entry in sorted(os.listdir(np_root)):
        value = entry.strip()
        if value:
            portals.append(value)
    return portals

def active_iscsi_target_for_name(target_name):
    if not target_name:
        return {}
    for target in active_iscsi_state().get("targets", []) or []:
        if not isinstance(target, dict):
            continue
        if target_name_value(target) == target_name:
            return target
    return {}

def read_configfs_boolean(path):
    value = read_text(path, "").strip().lower()
    if value in ("1", "yes", "true", "on"):
        return True
    if value in ("0", "no", "false", "off"):
        return False
    return None

def configfs_iscsi_auth_required(target_name):
    if not target_name:
        return None
    return read_configfs_boolean(os.path.join(
        "/sys/kernel/config/target/iscsi", target_name, "tpgt_1", "attrib", "authentication"))

def nonempty_auth_value(value):
    return str(value or "").strip().lower() not in ("", "null", "none")

def configfs_iscsi_acl_chap_configured(target_name, initiator_iqn):
    if not target_name or not initiator_iqn:
        return None
    auth_root = os.path.join(
        "/sys/kernel/config/target/iscsi", target_name, "tpgt_1", "acls", initiator_iqn, "auth")
    if not os.path.isdir(auth_root):
        return None
    userid = read_text(os.path.join(auth_root, "userid"), "")
    password = read_text(os.path.join(auth_root, "password"), "")
    mutual_userid = read_text(os.path.join(auth_root, "mutual_userid"), "")
    mutual_password = read_text(os.path.join(auth_root, "mutual_password"), "")
    return ((nonempty_auth_value(userid) and nonempty_auth_value(password)) or
            (nonempty_auth_value(mutual_userid) and nonempty_auth_value(mutual_password)))

def desired_iscsi_acl_chap_configured(target, initiator_iqn):
    if not isinstance(target, dict) or not initiator_iqn:
        return None
    for acl in target.get("acls") or []:
        if not isinstance(acl, dict):
            continue
        principal = acl.get("principal") or acl.get("initiatorIqn") or acl.get("initiatoriqn")
        if str(principal or "") != str(initiator_iqn):
            continue
        config = acl.get("config") if isinstance(acl.get("config"), dict) else {}
        return bool(config.get("chapEnabled") or config.get("mutualChapEnabled"))
    return None

def iscsi_session_auth_contract(detail, target_name, target):
    initiator_iqn = detail.get("initiatorIqn")
    auth_required = configfs_iscsi_auth_required(target_name)
    desired_chap = desired_iscsi_acl_chap_configured(target, initiator_iqn)
    runtime_chap = configfs_iscsi_acl_chap_configured(target_name, initiator_iqn)
    chap_configured = True if True in (desired_chap, runtime_chap) else (
        False if desired_chap is False and runtime_chap is False else None)
    verification = classify_iscsi_auth_session(
        detail.get("connectionState") or detail.get("state"), auth_required, chap_configured)
    contract = {
        "sessionSchemaVersion": 2,
        "targetcliAuthObservation": detail.get("targetcliAuthObservation") or "UNSPECIFIED",
        "authVerification": verification,
    }
    if auth_required is not None:
        contract["authRequired"] = auth_required
    if chap_configured is not None:
        contract["chapConfigured"] = chap_configured
    authenticated = compatibility_authenticated(verification)
    if authenticated is not None:
        contract["authenticated"] = authenticated
    return contract

def targetcli_iscsi_session_rows():
    rows = []
    for detail in targetcli_iscsi_session_details():
        target_map = {}
        for mapped in detail.get("mappedLuns") or []:
            target_name = mapped.get("targetIqn")
            if not target_name:
                continue
            lun = str(mapped.get("lun") or mapped.get("mappedLun") or "").strip()
            item = target_map.setdefault(target_name, {"luns": set(), "mapped": []})
            if lun:
                item["luns"].add(lun)
            item["mapped"].append(mapped)
        if not target_map:
            continue
        for target_name, item in sorted(target_map.items()):
            target = active_iscsi_target_for_name(target_name)
            luns = ",".join(sort_lun_values(item.get("luns") or []))
            portals = configfs_iscsi_target_portals(target_name)
            ports = target_listener_ports_from_state(target) if target else sorted({endpoint_port(portal) for portal in portals if endpoint_port(portal)})
            exact_endpoint = len(portals) == 1
            local = portals[0] if exact_endpoint else ""
            peer_host = detail.get("peerHost") or ""
            session_id = hashlib.sha256(
                f"ISCSI|{detail.get('targetcliSid')}|{target_name}|{luns}|{detail.get('initiatorIqn')}|{peer_host}".encode("utf-8")
            ).hexdigest()[:20]
            state = "ESTAB" if str(detail.get("connectionState") or "").upper() == "LOGGED_IN" else (detail.get("connectionState") or detail.get("state") or "UNKNOWN")
            row = {
                "sessionId": session_id,
                "protocol": "ISCSI",
                "state": state,
                "connectionState": detail.get("connectionState") or detail.get("state"),
                "peer": peer_host,
                "client": peer_host,
                "initiatorIqn": detail.get("initiatorIqn"),
                "targetcliSid": detail.get("targetcliSid"),
                "resourceId": target.get("uuid") or target.get("id") if target else None,
                "resourceName": target_name,
                "targetName": target_name,
                "targetIqn": target_name,
                "targetiqn": target_name,
                "targetGroupKey": target_name,
                "targetLuns": luns,
                "lun": luns,
                "lunOrNamespace": luns,
                "mappingStatus": "exact",
                "endpointMappingStatus": "exact" if exact_endpoint else "candidate",
                "local": local,
                "possibleEndpoints": portals,
                "listenerPorts": ",".join(str(port) for port in ports) if ports else "",
            }
            row.update(iscsi_session_auth_contract(detail, target_name, target))
            if not exact_endpoint:
                row["mappingWarning"] = "Target/LUN attribution is exact from targetcli; endpoint is candidate because the target has multiple portals or shared listeners."
            rows.append({k: v for k, v in row.items() if v not in (None, "")})
    return rows

def sort_lun_values(values):
    return sorted(values, key=lambda value: int(value) if str(value).isdigit() else str(value))

def exact_iscsi_session_hint(local, peer=None):
    local_port = endpoint_port(local)
    peer_host = normalize_ip(endpoint_host(peer or ""))
    if not local_port or not peer_host:
        return {}
    targets_by_name = {target_name_value(target): target for target in active_iscsi_state().get("targets", []) if isinstance(target, dict)}
    candidates = []
    for session in targetcli_iscsi_session_details():
        if normalize_ip(session.get("peerHost")) != peer_host:
            continue
        target_map = {}
        for mapped in session.get("mappedLuns") or []:
            target_name = mapped.get("targetIqn")
            lun = str(mapped.get("lun") or mapped.get("mappedLun") or "").strip()
            if not target_name:
                continue
            target_map.setdefault(target_name, set())
            if lun:
                target_map[target_name].add(lun)
        for target_name, luns in target_map.items():
            target = targets_by_name.get(target_name)
            if target and local_port not in target_listener_ports_from_state(target):
                continue
            lun_list = ",".join(sort_lun_values(luns))
            candidates.append({
                "resourceId": target.get("uuid") or target.get("id") if target else None,
                "targetIqn": target_name,
                "targetiqn": target_name,
                "targetName": target_name,
                "resourceName": target_name,
                "targetGroupKey": target_name,
                "targetLuns": lun_list,
                "lun": lun_list,
                "lunOrNamespace": lun_list,
                "initiatorIqn": session.get("initiatorIqn"),
                "targetcliSid": session.get("targetcliSid"),
                "connectionState": session.get("connectionState"),
            })
    if not candidates:
        return {}
    if len(candidates) == 1:
        hint = dict(candidates[0])
        hint["mappingStatus"] = "exact"
        return {k: v for k, v in hint.items() if v not in (None, "")}
    return {
        "mappingStatus": "candidate",
        "possibleTargets": [{"targetIqn": item.get("targetIqn"), "lun": item.get("lun")} for item in candidates],
        "possibleInitiators": sorted({item.get("initiatorIqn") for item in candidates if item.get("initiatorIqn")}),
        "mappingWarning": "Multiple active iSCSI target sessions match this client and listener; target/LUN attribution is candidate-based.",
    }

def iscsi_session_hint(local, peer=None):
    exact_hint = exact_iscsi_session_hint(local, peer)
    if exact_hint:
        return exact_hint
    port = endpoint_port(local)
    if not port:
        return {}
    targets = active_iscsi_targets_for_port(port)
    if not targets:
        return {"mappingStatus": "unmapped", "mappingWarning": f"No active iSCSI target uses listener port {port}"}
    target_names = sorted({target_name_value(target) for target in targets if target_name_value(target)})
    if not target_names:
        return {"mappingStatus": "unmapped", "mappingWarning": f"No iSCSI target IQN was found for listener port {port}"}
    exact = len(target_names) == 1
    target_name = target_names[0] if exact else ", ".join(target_names)
    group_targets = [target for target in targets if exact and target_name_value(target) == target_name] if exact else targets
    luns = []
    acls = []
    seen_acl = set()
    for target in group_targets:
        lun = target_lun_value(target)
        if lun not in luns:
            luns.append(lun)
        for acl in active_acls_for_target(target):
            principal = acl.get("principal") or acl.get("initiatorIqn") or acl.get("initiatoriqn")
            if principal in seen_acl:
                continue
            seen_acl.add(principal)
            acls.append(acl)
    target = group_targets[0]
    hint = {
        "resourceId": target.get("uuid") or target.get("id"),
        "resourceName": target_name,
        "targetName": target_name,
        "targetIqn": target_name,
        "targetiqn": target_name,
        "targetGroupKey": target_name,
        "targetLuns": ",".join(luns),
        "lun": ",".join(luns),
        "lunOrNamespace": ",".join(luns),
        "mappingStatus": "exact" if exact else "candidate",
    }
    if len(acls) == 1:
        hint["initiatorIqn"] = acls[0].get("principal") or acls[0].get("initiatorIqn") or acls[0].get("initiatoriqn")
    elif len(acls) > 1:
        hint["possibleInitiators"] = sorted(seen_acl)
    if not exact:
        hint["possibleTargets"] = [
            {
                "targetIqn": target_name_value(target),
                "lun": target_lun_value(target),
                "resourceId": target.get("uuid") or target.get("id"),
            }
            for target in group_targets if target_name_value(target)
        ]
        hint["mappingWarning"] = "Multiple iSCSI targets share this listener port; target/LUN attribution is candidate-based."
    return {k: v for k, v in hint.items() if v not in (None, "")}

def smbstatus_sessions():
    if not shutil.which("smbstatus"):
        return []
    result = subprocess.run(["smbstatus", "--json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return []
    try:
        data = json.loads(result.stdout)
    except Exception:
        return []
    sessions = data.get("sessions") if isinstance(data, dict) else {}
    tcons = data.get("tcons") if isinstance(data, dict) else {}
    if not isinstance(sessions, dict) or not isinstance(tcons, dict):
        return []
    rows = []
    for tree_id, tree in tcons.items():
        if not isinstance(tree, dict):
            continue
        service = str(tree.get("service") or "")
        if not service or service == "IPC$":
            continue
        session_id = str(tree.get("session_id") or "")
        session = sessions.get(session_id, {}) if session_id else {}
        if not isinstance(session, dict):
            session = {}
        hostname = str(session.get("hostname") or "")
        remote_machine = str(session.get("remote_machine") or tree.get("machine") or "")
        peer = hostname.replace("ipv4:", "").replace("ipv6:", "") if hostname else remote_machine
        dialect = session.get("session_dialect")
        row = {
            "sessionId": f"smb-{session_id}-{tree_id}" if session_id else f"smb-{tree_id}",
            "sambaSessionId": session_id,
            "treeId": str(tree_id),
            "protocol": "SMB",
            "state": "ESTAB",
            "peer": peer,
            "client": remote_machine or endpoint_host(peer),
            "user": session.get("username"),
            "username": session.get("username"),
            "group": session.get("groupname"),
            "resourceName": service,
            "shareName": service,
            "dialect": dialect,
            "protocolVersion": dialect,
            "connectedAt": tree.get("connected_at"),
        }
        rows.append({k: v for k, v in row.items() if v not in (None, "")})
    return rows

def tcp_socket_rows():
    if not shutil.which("ss"):
        return []
    result = subprocess.run(["ss", "-H", "-tn"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    rows = []
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        local = parts[-2]
        peer = parts[-1]
        rows.append({
            "state": parts[0],
            "local": local,
            "peer": peer,
            "line": line,
            "localPort": endpoint_port(local),
        })
    return rows

def observed_iscsi_tcp_count():
    ports = iscsi_listener_ports()
    return len([row for row in tcp_socket_rows() if row.get("localPort") in ports])

def observed_nvmeof_tcp_count():
    ports = nvmeof_listener_ports()
    return len([row for row in tcp_socket_rows() if row.get("localPort") in ports])

def nvme_tcp_sessions(rows, filters):
    ports = nvmeof_listener_ports()
    grouped = {}
    for row in rows:
        if row.get("localPort") not in ports:
            continue
        local = row.get("local") or ""
        peer = row.get("peer") or ""
        client = endpoint_host(peer)
        key = (local, client)
        grouped.setdefault(key, []).append(row)
    sessions = []
    resource_id = str(filters.get("resourceId") or filters.get("resourceName") or "").strip().lower()
    for (local, client), group_rows in sorted(grouped.items(), key=lambda item: f"{item[0][0]}|{item[0][1]}"):
        peer_ports = sorted({endpoint_port(row.get("peer")) for row in group_rows if endpoint_port(row.get("peer"))})
        candidates = nvme_subsystem_candidates_for_session(local)
        if resource_id:
            candidates = [
                candidate for candidate in candidates
                if resource_id in {
                    str(candidate.get("id") or "").lower(),
                    str(candidate.get("uuid") or "").lower(),
                    str(candidate.get("name") or "").lower(),
                    str(candidate.get("subsystemNqn") or "").lower(),
                }
            ]
        state_values = {str(row.get("state") or "").upper() for row in group_rows}
        state = "ESTAB" if "ESTAB" in state_values else (next(iter(state_values), "UNKNOWN") or "UNKNOWN")
        transport_session_id = hashlib.sha256(f"NVME_OF|{local}|{client}".encode("utf-8")).hexdigest()[:20]
        possible_namespaces = []
        for candidate in candidates:
            subsystem_nqn = candidate.get("subsystemNqn") or candidate.get("name")
            for namespace_id in candidate.get("namespaces") or []:
                possible_namespaces.append({
                    "subsystemNqn": subsystem_nqn,
                    "namespaceId": str(namespace_id),
                })
        session = {
            "sessionId": transport_session_id,
            "transportSessionId": transport_session_id,
            "sessionKind": "TRANSPORT_AGGREGATE",
            "protocol": "NVME_OF",
            "state": state,
            "local": local,
            "peer": client,
            "client": client,
            "queueCount": len(group_rows),
            "peerPorts": peer_ports,
            "listenerPort": endpoint_port(local),
            "listenerPorts": str(endpoint_port(local) or ""),
            "possibleSubsystems": candidates,
            "possibleNamespaces": possible_namespaces,
            "canDisconnect": False,
            "disconnectDisabledReason": "The kernel exposes transport queues but no stable logical NVMe controller handle for this connection.",
        }
        if len(candidates) == 1:
            candidate = candidates[0]
            hosts = candidate.get("allowedHosts") or []
            session.update({
                "configuredHostNqns": hosts,
                "allowAnyHost": candidate.get("allowAnyHost"),
                "hostPolicy": "ALLOW_ANY" if candidate.get("allowAnyHost") else ("EXPLICIT_ACL" if hosts else "DENY_ALL"),
                "mappingStatus": "CANDIDATE",
                "endpointMappingStatus": "EXACT",
                "mappingWarning": "One configured subsystem is exposed on this transport endpoint, but the kernel does not expose a durable controller-to-subsystem identity for this TCP aggregate.",
            })
        elif candidates:
            session.update({
                "mappingStatus": "AMBIGUOUS",
                "endpointMappingStatus": "EXACT",
                "mappingWarning": "Multiple NVMe-oF subsystems with namespaces are exposed on this listener; subsystem attribution is candidate-based.",
            })
        else:
            session.update({
                "mappingStatus": "UNMAPPED",
                "endpointMappingStatus": "UNMAPPED",
                "mappingWarning": f"No active NVMe-oF subsystem namespace is linked to listener {local}.",
            })
        sessions.append({k: v for k, v in session.items() if v not in (None, "", [])})
    return sessions

def tcp_sessions(filters):
    rows = tcp_socket_rows()
    nfs_ports = nfs_listener_ports()
    nvme_ports = nvmeof_listener_ports()
    sessions = []
    for row in rows:
        local = row.get("local") or ""
        peer = row.get("peer") or ""
        local_port = row.get("localPort")
        protocol = None
        if local_port in nfs_ports:
            protocol = "NFS"
        elif local.endswith(":445") or local.endswith(":139"):
            protocol = "SMB"
        elif local_port in nvme_ports:
            continue
        if protocol:
            session_id = hashlib.sha256(f"{protocol}|{row.get('state')}|{local}|{peer}".encode("utf-8")).hexdigest()[:20]
            session = {"sessionId": session_id, "protocol": protocol, "state": row.get("state"), "local": local, "peer": peer, "client": endpoint_host(peer)}
            if protocol == "NFS":
                hint = nfs_export_hint_for_session(local)
                if hint:
                    session.update(hint)
            sessions.append(session)
    sessions.extend(nvme_tcp_sessions(rows, filters))
    return sessions

def ss_sessions(filters):
    tcp_rows = tcp_sessions(filters)
    smb_rows = smbstatus_sessions()
    iscsi_rows = targetcli_iscsi_session_rows()
    base_rows = [session for session in tcp_rows if session.get("protocol") != "ISCSI"]
    if not smb_rows:
        return base_rows + iscsi_rows
    result = [session for session in base_rows if session.get("protocol") != "SMB"]
    smb_tcp_rows = [session for session in base_rows if session.get("protocol") == "SMB"]
    for smb in smb_rows:
        client = smb.get("client") or endpoint_host(smb.get("peer"))
        match = next((tcp for tcp in smb_tcp_rows if client and client == tcp.get("client")), None)
        if match:
            smb.setdefault("local", match.get("local"))
            smb.setdefault("peer", match.get("peer"))
            smb.setdefault("state", match.get("state"))
        result.append(smb)
    return result + iscsi_rows

payload = load_payload(sys.argv[1] if len(sys.argv) > 1 else "")
protocol_filter = str(payload.get("protocol", "")).upper()
client_filter = str(payload.get("client", "")).strip()
state_filter = str(payload.get("state", "")).upper()
sessions = []
now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
session_state_path = "/run/ablestack-storage/monitor/session-state.json"
session_state = load_json(session_state_path, {})
next_state = {}
raw_sessions = ss_sessions(payload)
observed_iscsi = observed_iscsi_tcp_count()
observed_nvmeof = observed_nvmeof_tcp_count()
warnings = []
for session in raw_sessions:
    if protocol_filter and session.get("protocol") != protocol_filter:
        continue
    if client_filter and client_filter not in session.get("peer", "") and client_filter not in session.get("client", ""):
        continue
    if state_filter and session.get("state", "").upper() != state_filter:
        continue
    saved = session_state.get(session["sessionId"], {}) if isinstance(session_state, dict) else {}
    session["connectedAt"] = saved.get("connectedAt") or session.get("connectedAt") or now
    session["lastSeen"] = now
    next_state[session["sessionId"]] = {
        "connectedAt": session["connectedAt"],
        "lastSeen": now,
        "protocol": session.get("protocol"),
        "peer": session.get("peer"),
        "local": session.get("local"),
        "client": session.get("client"),
        "user": session.get("user"),
        "username": session.get("username"),
        "group": session.get("group"),
        "resourceId": session.get("resourceId"),
        "resourceName": session.get("resourceName"),
        "shareName": session.get("shareName"),
        "dialect": session.get("dialect"),
        "protocolVersion": session.get("protocolVersion"),
        "sambaSessionId": session.get("sambaSessionId"),
        "treeId": session.get("treeId"),
        "subsystemNqn": session.get("subsystemNqn"),
        "targetName": session.get("targetName"),
        "targetIqn": session.get("targetIqn"),
        "targetGroupKey": session.get("targetGroupKey"),
        "targetLuns": session.get("targetLuns"),
        "initiatorIqn": session.get("initiatorIqn"),
        "possibleInitiators": session.get("possibleInitiators"),
        "possibleTargets": session.get("possibleTargets"),
        "mappingStatus": session.get("mappingStatus"),
        "endpointMappingStatus": session.get("endpointMappingStatus"),
        "mappingWarning": session.get("mappingWarning"),
        "possibleEndpoints": session.get("possibleEndpoints"),
        "listenerPorts": session.get("listenerPorts"),
        "connectionState": session.get("connectionState"),
        "authenticated": session.get("authenticated"),
        "sessionSchemaVersion": session.get("sessionSchemaVersion"),
        "targetcliAuthObservation": session.get("targetcliAuthObservation"),
        "authVerification": session.get("authVerification"),
        "authRequired": session.get("authRequired"),
        "chapConfigured": session.get("chapConfigured"),
        "lun": session.get("lun"),
        "lunOrNamespace": session.get("lunOrNamespace"),
        "namespaceId": session.get("namespaceId"),
        "namespaceCount": session.get("namespaceCount"),
        "hostNqn": session.get("hostNqn"),
        "allowedHosts": session.get("allowedHosts"),
        "allowAnyHost": session.get("allowAnyHost"),
        "possibleSubsystems": session.get("possibleSubsystems"),
        "queueCount": session.get("queueCount"),
        "peerPorts": session.get("peerPorts"),
        "listenerPort": session.get("listenerPort"),
    }
    if session.get("mappingWarning"):
        warnings.append(session.get("mappingWarning"))
    sessions.append(session)
store_json(session_state_path, next_state)
status = "ok"
if observed_iscsi and not any(session.get("protocol") == "ISCSI" for session in sessions):
    status = "degraded"
    warnings.append("iSCSI TCP sessions were observed but no iSCSI session rows matched the current filters.")
elif any(session.get("protocol") == "ISCSI" and str(session.get("mappingStatus", "")).upper() == "UNMAPPED" for session in sessions):
    status = "degraded"
if observed_nvmeof and not any(session.get("protocol") == "NVME_OF" for session in sessions):
    status = "degraded"
    warnings.append("NVMe-oF TCP queues were observed but no NVMe-oF logical session rows matched the current filters.")
elif any(session.get("protocol") == "NVME_OF" and str(session.get("mappingStatus", "")).upper() == "UNMAPPED" for session in sessions):
    status = "degraded"
print(json.dumps({
    "success": True,
    "status": status,
    "sessionSchemaVersion": 2,
    "sessions": sessions,
    "count": len(sessions),
    "observedTcpCount": len(raw_sessions),
    "observedIscsiTcpCount": observed_iscsi,
    "observedNvmeofTcpCount": observed_nvmeof,
    "observedNvmeofSessionCount": len([session for session in sessions if session.get("protocol") == "NVME_OF"]),
    "warnings": sorted(set([warning for warning in warnings if warning])),
}, sort_keys=True))
PY
}

session_disconnect() {
  local payload_file="$1"
  python3 - "$payload_file" <<'PY'
import json
import re
import shutil
import subprocess
import sys

PORTS = {"NFS": "2049", "SMB": "445", "ISCSI": "3260", "NVME_OF": "4420"}

def load_payload(path):
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)

def endpoint_host(value):
    if not value:
        return ""
    if value.startswith("[") and "]:" in value:
        return value[1:value.index("]:")]
    return value.rsplit(":", 1)[0]

def endpoint_port(value):
    value = str(value or "").strip()
    if value.startswith("[") and "]:" in value:
        value = value.rsplit(":", 1)[-1]
    elif ":" in value:
        value = value.rsplit(":", 1)[-1]
    try:
        return int(value)
    except Exception:
        return None

payload = load_payload(sys.argv[1])
protocol = str(payload.get("protocol", "")).upper()
peer = payload.get("peer", "")
local = payload.get("local", "")
client = endpoint_host(peer)
port = str(endpoint_port(local) or PORTS.get(protocol) or "")
if not protocol or not port or not client:
    print(json.dumps({"success": False, "status": "INVALID_REQUEST", "details": "protocol and peer endpoint are required"}))
    sys.exit(1)
if not shutil.which("ss"):
    print(json.dumps({"success": False, "status": "UNSUPPORTED", "details": "ss command is not available"}))
    sys.exit(1)

commands = [
    ["ss", "-K", "dst", client, "dport", "=", f":{port}"],
    ["ss", "-K", "src", client, "sport", "=", f":{port}"],
]
results = []
success = False
for command in commands:
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    results.append({"command": " ".join(command), "exitCode": result.returncode, "stdout": result.stdout.strip(), "stderr": result.stderr.strip()})
    if result.returncode == 0:
        success = True
print(json.dumps({"success": success, "status": "ok" if success else "best_effort", "protocol": protocol, "peer": peer, "local": local, "commands": results}, sort_keys=True))
PY
}

volume_attach_inspect() {
  local payload_file="$1"
  local resume_mode="${2:-}"

  python3 - "$payload_file" "$resume_mode" <<'PY'
import json
import fcntl
import re
import time
import uuid
import hashlib
import stat
from pathlib import Path
import os
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

sys.path.insert(0, "/usr/local/lib/ablestack-storage")
from volume_identity import VolumeIdentityError, resolve_volume_device  # noqa: E402

"""Initialize a private new inode before an atomic no-replace directory publish."""
import ctypes
import errno
import os
import stat
import uuid


def publish_new_directory(parent_fd, stage_fd, name, owner_uid=None, owner_gid=None, mode=0o750):
    if not isinstance(name,str) or not name or name in ('.','..') or '/' in name or '\\' in name or any(ord(ch)<32 for ch in name):
        raise ValueError('New directory name is not a bounded single component')
    for value in (owner_uid,owner_gid):
        if value is not None and (isinstance(value,bool) or not isinstance(value,int) or not 0<=value<=2147483647):
            raise ValueError('New directory owner must be an explicit numeric UID/GID')
    if isinstance(mode,bool) or not isinstance(mode,int) or not 0<=mode<=0o7777:raise ValueError('New directory mode is invalid')
    stage=os.fstat(stage_fd);parent=os.fstat(parent_fd)
    if (not stat.S_ISDIR(stage.st_mode) or stage.st_uid!=os.geteuid() or stat.S_IMODE(stage.st_mode)!=0o700
            or stage.st_dev!=parent.st_dev):raise ValueError('New directory staging parent is not a protected directory on the same filesystem')
    try:
        existing=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent_fd)
    except FileNotFoundError:
        existing=None
    if existing is not None:
        os.close(existing);return None
    private='.new-directory-'+str(uuid.uuid4())
    os.mkdir(private,mode=0o700,dir_fd=stage_fd)
    descriptor=os.open(private,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=stage_fd)
    created=None
    try:
        created=os.fstat(descriptor)
        if created.st_uid!=os.geteuid() or created.st_dev!=parent.st_dev:raise ValueError('Private new directory identity changed')
        if owner_uid is not None or owner_gid is not None:
            os.fchown(descriptor,owner_uid if owner_uid is not None else -1,owner_gid if owner_gid is not None else -1)
        os.fchmod(descriptor,mode);os.fsync(descriptor)
        library=ctypes.CDLL(None,use_errno=True)
        rename=getattr(library,'renameat2',None)
        if rename is None:raise ValueError('Atomic no-replace directory publication is unavailable')
        rename.argtypes=[ctypes.c_int,ctypes.c_char_p,ctypes.c_int,ctypes.c_char_p,ctypes.c_uint]
        rename.restype=ctypes.c_int
        if rename(stage_fd,os.fsencode(private),parent_fd,os.fsencode(name),1):
            number=ctypes.get_errno()
            if number==errno.EEXIST:return None
            raise OSError(number,os.strerror(number))
        os.fsync(stage_fd);os.fsync(parent_fd)
        named=os.stat(name,dir_fd=parent_fd,follow_symlinks=False);opened=os.fstat(descriptor)
        if (named.st_dev,named.st_ino)!=(created.st_dev,created.st_ino):
            raise ValueError('Published directory was replaced; replacement metadata remains untouched')
        return {'created':True,'device':opened.st_dev,'inode':opened.st_ino,'effectiveUid':opened.st_uid,
                'effectiveGid':opened.st_gid,'effectiveMode':format(stat.S_IMODE(opened.st_mode),'04o')}
    finally:
        os.close(descriptor)
        try:
            leftover=os.stat(private,dir_fd=stage_fd,follow_symlinks=False)
            if created is not None and (leftover.st_dev,leftover.st_ino)==(created.st_dev,created.st_ino):os.rmdir(private,dir_fd=stage_fd)
        except FileNotFoundError:pass

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

def require_resume_request(request, required):
    resume = request.get("resumeOnly") is True
    if required and not resume:
        raise ValueError("Volume resume requires resumeOnly=true")
    if not resume:
        return False
    if request.get("importMode") != "MOUNT_EXISTING":
        raise ValueError("Volume resume cannot authorize a format import mode")
    for key in ("instanceUuid", "managerOperationUuid", "volumeUuid"):
        uuid.UUID(str(request[key]))
    revision = request["revision"]
    if isinstance(revision, bool) or not isinstance(revision, int) or revision < 1:
        raise ValueError("Volume resume manager revision is invalid")
    if request.get("operationId") != "volume-" + str(uuid.UUID(request["volumeUuid"])):
        raise ValueError("Volume resume native operation scope changed")
    if request.get("provisioningType") not in ("THIN", "SPARSE", "FAT"):
        raise ValueError("Volume resume provisioning type is unknown")
    return True

resume_only = require_resume_request(payload, len(sys.argv) > 2 and sys.argv[2] == "resume")

PROBE_TIMEOUT_SECONDS = 20
format_deadline = max(1, min(7200, int(payload.get("formatDeadlineSeconds") or 300)))
volume_key = str(payload.get("volumeUuid") or "")
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", volume_key):
    raise SystemExit("A stable volume UUID is required for backing-volume preparation")
operation_root = Path(os.environ.get("ABLESTACK_STORAGE_VOLUME_OPERATIONS", "/var/lib/ablestack-storage/volume-operations"))
operation_root.mkdir(parents=True, exist_ok=True, mode=0o700)
operation_path = operation_root / (volume_key + ".json")
operation_lock = open(operation_root / (volume_key + ".lock"), "a+")
try:
    fcntl.flock(operation_lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    print(json.dumps({"success": False, "errorCode": "OPERATION_BUSY", "operationId": "volume-" + volume_key}))
    raise SystemExit(1)
def read_volume_operation(path):
    try:
        info = path.lstat()
    except FileNotFoundError:
        return {}
    parent = path.parent.lstat()
    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.geteuid() or parent.st_mode & 0o022 or not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077 or info.st_size > 256 * 1024:
        raise ValueError("Volume operation journal is not protected")
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        opened_parent = os.fstat(directory)
        if (opened_parent.st_dev, opened_parent.st_ino, opened_parent.st_uid, opened_parent.st_mode) != (parent.st_dev, parent.st_ino, parent.st_uid, parent.st_mode):
            raise ValueError("Volume operation journal directory changed")
        descriptor = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory)
    finally:
        os.close(directory)
    try:
        opened = os.fstat(descriptor)
        fields = ("st_dev", "st_ino", "st_uid", "st_gid", "st_mode", "st_size", "st_mtime_ns", "st_ctime_ns")
        if tuple(getattr(opened, key) for key in fields) != tuple(getattr(info, key) for key in fields):
            raise ValueError("Volume operation journal changed while opening")
        with os.fdopen(descriptor, "rb", closefd=False) as handle:
            content = handle.read(256 * 1024 + 1)
        after = os.fstat(descriptor)
        if len(content) > 256 * 1024 or tuple(getattr(after, key) for key in fields) != tuple(getattr(opened, key) for key in fields):
            raise ValueError("Volume operation journal changed while reading")
        value = json.loads(content)
        if not isinstance(value, dict): raise ValueError("Volume operation journal is malformed")
        return value
    finally:
        os.close(descriptor)

try:
    operation = read_volume_operation(operation_path)
except (ValueError, OSError):
    raise SystemExit("RECOVERY_REQUIRED: volume operation journal is unreadable")

def phase(name, **diagnostic):
    operation.update(diagnostic)
    operation.update({"operationId": "volume-" + volume_key, "volumeUuid": volume_key,
                      "phase": name, "heartbeat": time.time(), "formatDeadlineSeconds": format_deadline})
    fd, tmp = tempfile.mkstemp(prefix=".operation.", dir=str(operation_root))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as output:
            json.dump(operation, output, sort_keys=True)
            output.flush()
            os.fsync(output.fileno())
        os.replace(tmp, operation_path)
        directory = os.open(str(operation_root), os.O_RDONLY)
        try: os.fsync(directory)
        finally: os.close(directory)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

def recovery(code, message):
    phase(code, errorCode=code, diagnostic=message)
    print(json.dumps({"success": False, "errorCode": code, "operation": operation}, sort_keys=True))
    raise SystemExit(1)

def run(args):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=PROBE_TIMEOUT_SECONDS)

def lsblk():
    result = run(["lsblk", "-b", "-J", "-o", "NAME,PATH,TYPE,FSTYPE,UUID,SERIAL,SIZE,MOUNTPOINT"])
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "lsblk failed")
    return json.loads(result.stdout).get("blockdevices", [])

def walk(devices, parent_disk_path=None, parent_path=None):
    for dev in devices:
        dev["_parentDiskPath"] = dev.get("path") if dev.get("type") == "disk" else parent_disk_path
        dev["_parentPath"] = parent_path
        yield dev
        for child in dev.get("children") or []:
            yield from walk([child], dev.get("_parentDiskPath"), dev.get("path"))

def compact(value):
    return "".join(ch for ch in str(value or "").lower() if ch.isalnum())

def token_matches(value, tokens):
    candidate = compact(value)
    if not candidate:
        return False
    for token in tokens:
        if len(token) >= 8 and (token in candidate or candidate in token):
            return True
    return False

def parse_size(value):
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0

def size_matches(dev, expected_size):
    if expected_size <= 0:
        return False
    actual_size = parse_size(dev.get("size"))
    if actual_size <= 0:
        return False
    tolerance = max(1024 * 1024, expected_size // 100)
    return abs(actual_size - expected_size) <= tolerance

devices = list(walk(lsblk()))
device_by_path = {dev.get("path"): dev for dev in devices if dev.get("path")}
import_mode = str(payload.get("importMode") or "MOUNT_EXISTING").upper()
format_modes = {"FORMAT_EMPTY", "FORMAT_IF_EMPTY"}
expected_size = parse_size(payload.get("volumeSizeBytes"))
identity_tokens = [compact(v) for v in (payload.get("volumeUuid"), payload.get("volumeName")) if compact(v)]
root_disk_paths = {
    dev.get("_parentDiskPath")
    for dev in devices
    if dev.get("_parentDiskPath") and (dev.get("mountpoint") in ("/", "/boot", "/boot/efi") or dev.get("fstype") == "swap")
}

def is_root_disk_tree(dev):
    return dev.get("_parentDiskPath") in root_disk_paths

def has_child_filesystem_or_mount(dev):
    path = dev.get("path")
    if not path:
        return False
    for child in devices:
        if child.get("_parentDiskPath") == path and child.get("path") != path and (child.get("fstype") or child.get("mountpoint")):
            return True
    return False

def device_matches_identity(dev):
    if not identity_tokens:
        return False
    return any(token_matches(dev.get(key), identity_tokens) for key in ("name", "path", "serial", "uuid"))

def safe_candidate(dev, allow_mounted_match=False):
    if not dev or not dev.get("path"):
        return False
    if dev.get("type") not in ("disk", "part"):
        return False
    if is_root_disk_tree(dev):
        return False
    if dev.get("mountpoint") and not (allow_mounted_match and device_matches_identity(dev)):
        return False
    if import_mode in format_modes:
        return dev.get("type") == "disk" and not dev.get("fstype") and not dev.get("mountpoint") and not has_child_filesystem_or_mount(dev)
    return True

def select_single(candidates, reason):
    unique = []
    seen = set()
    for dev in candidates:
        path = dev.get("path")
        if path and path not in seen:
            unique.append(dev)
            seen.add(path)
    if len(unique) == 1:
        return unique[0].get("path")
    if len(unique) > 1:
        paths = ", ".join(dev.get("path") for dev in unique)
        raise SystemExit(f"Ambiguous Storage Service volume device candidates for {reason}: {paths}")
    return None

config = payload.get("config") or {}
inspection = config.get("lastInspection") or config.get("lastinspection") or {}
configured_mount_path = config.get("volumeMountPath") or payload.get("mountPath")
mounted_source = None
if configured_mount_path:
    mounted = run(["findmnt", "-n", "-o", "SOURCE", "--target", configured_mount_path])
    if mounted.returncode == 0 and mounted.stdout.strip():
        mounted_source = mounted.stdout.strip().splitlines()[0]
try:
    resolved_device = resolve_volume_device(
