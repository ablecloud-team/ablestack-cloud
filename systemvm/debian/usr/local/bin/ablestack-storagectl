    elif [[ "$subcommand" == "quiesce" ]]; then
      python3 - "$action" "$0" <<'PYQUIESCE'
import json
import os
from pathlib import Path
import subprocess
import sys
import uuid

request = json.loads(Path(sys.argv[1]).read_text())
if "maintenanceUuid" in request:
    result=subprocess.run([sys.argv[2],"operation","maintenance","service-quiesce",sys.argv[1]],capture_output=True,text=True,timeout=180,pass_fds=(9,))
    print(result.stdout.strip());raise SystemExit(result.returncode)

domains=request.get("domains",["NFS","SMB"])
if not isinstance(domains,list) or not domains or len(set(domains))!=len(domains) or not set(domains)<={"NFS","SMB"}:raise ValueError("Quiesce domain scope is invalid")
instance = str(uuid.UUID(request["instanceUuid"]))
operation = str(uuid.UUID(request["operationUuid"]))
revision = request["revision"]
if isinstance(revision, bool) or not isinstance(revision, int) or revision < 1:
    raise ValueError("Quiesce revision is invalid")
root = Path(os.environ.get("ABLESTACK_STORAGE_GENERATION_DIR", "/var/lib/ablestack-storage/config-generations"))
for name in ("current.json", "pending.json"):
    path = root / name
    value = json.loads(path.read_text()) if path.exists() else {}
    if value and value.get("instanceUuid") != instance:
        raise ValueError("Quiesce generation instance changed")
    if name == "pending.json" and value and value.get("operationUuid") != operation:
        raise ValueError("Quiesce conflicts with a pending generation operation")
    if value and value.get("revision", 0) > revision:
        raise ValueError("Quiesce revision is stale")

maintenance = subprocess.run([sys.argv[2], "operation", "maintenance", "enter", sys.argv[1]],
                             capture_output=True, text=True, timeout=30, pass_fds=(9,))
if maintenance.returncode:
    print(maintenance.stdout.strip())
    raise SystemExit(1)
try:
    entered = json.loads(maintenance.stdout)
    expected_scope = {"instanceUuid": instance, "templateUpgradeUuid": str(uuid.UUID(request["templateUpgradeUuid"])),
                      "operationUuid": operation, "revision": revision}
    if entered.get("success") is not True or entered.get("bootHeld") is not True or entered.get("scope") != expected_scope:
        raise ValueError("Protected maintenance scope was not exactly entered")
except (ValueError, KeyError, TypeError):
    print(json.dumps({"success": False, "quiesced": False, "errorCode": "QUIESCE_MAINTENANCE_SCOPE_REJECTED"}))
    raise SystemExit(1)

rendered_pointer=Path(os.environ.get("ABLESTACK_STORAGE_RENDERED_GENERATIONS","/var/lib/ablestack-storage/rendered-generations"))/"current"
if set(domains)=={"NFS","SMB"} and rendered_pointer.is_symlink():
    stopped=subprocess.run([sys.argv[2],"operation","generation","render-root-quiesce-source","/dev/stdin"],input=json.dumps(expected_scope),capture_output=True,text=True,timeout=180,pass_fds=(9,))
    print(stopped.stdout.strip());raise SystemExit(stopped.returncode)

def run(arguments):
    return subprocess.run(arguments, capture_output=True, text=True, timeout=60)

listed = run(["systemctl", "list-units", "--state=active", "--type=service", "--no-legend", "--plain",
              "ablestack-storage-ganesha@*.service", "ablestack-storage-smb@*.service", "smbd.service", "nmbd.service", "winbind.service", "nfs-server.service", "nfs-kernel-server.service", "nfs-ganesha.service"])
if listed.returncode != 0:
    print(json.dumps({"success": False, "quiesced": False, "errorCode": "QUIESCE_SERVICE_OBSERVATION_FAILED"}))
    raise SystemExit(1)
units = []
for line in listed.stdout.splitlines():
    unit = line.split()[0] if line.split() else ""
    if unit in ("smbd.service", "nmbd.service", "winbind.service", "nfs-server.service", "nfs-kernel-server.service", "nfs-ganesha.service") or (
            (unit.startswith("ablestack-storage-ganesha@") or unit.startswith("ablestack-storage-smb@")) and unit.endswith(".service")):
        domain="SMB" if unit in ("smbd.service","nmbd.service","winbind.service") or unit.startswith("ablestack-storage-smb@") else "NFS"
        if domain in domains:units.append(unit)
stopped = []
try:
    for unit in units:
        if run(["systemctl", "disable", unit]).returncode != 0:
            raise RuntimeError("A file protocol acceptor could not be quarantined for boot")
        if run(["systemctl", "stop", unit]).returncode != 0:
            raise RuntimeError("A file protocol service could not be stopped")
        stopped.append(unit)
    os.sync()
    print(json.dumps({"success": True, "quiesced": True, "instanceUuid": instance,
                      "maintenanceSupported": True, "bootHeld": entered["bootHeld"], "scope": entered["scope"],
                      "operationUuid": operation, "revision": revision, "stoppedUnits": stopped,
                      "domainsQuiesced":domains,"blockTargetsPreserved": True, "blockSessionBoundary": "NORMAL_VM_SHUTDOWN"}))
except Exception:
    # Restore services on a partial quiesce failure. Desired files and all
    # configfs target/LUN/namespace mappings are deliberately untouched.
    for unit in reversed(stopped):
        run(["systemctl", "start", unit])
    print(json.dumps({"success": False, "quiesced": False, "errorCode": "QUIESCE_FAILED"}))
    raise SystemExit(1)
PYQUIESCE
    elif [[ "$subcommand" == "writer-idle" ]]; then
      python3 - <<'PYWRITERSTATUS'
import fcntl
import json
import os
from pathlib import Path
import stat
path = Path(os.environ.get("ABLESTACK_STORAGE_WRITER_LOCK_FILE", "/run/ablestack-storage/desired-writer.lock"))
idle = True
if path.exists() or path.is_symlink():
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise ValueError("Native writer lock observation is not protected")
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            idle = False
    finally:
        os.close(descriptor)
boot_child_active=False
journal=Path(os.environ.get("ABLESTACK_STORAGE_BOOT_CHILD_JOURNAL","/run/ablestack-storage/boot-execution/current.json"))
if journal.exists() or journal.is_symlink():
    info=journal.lstat();parent=journal.parent.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid!=os.geteuid() or stat.S_IMODE(info.st_mode)!=0o600 or not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=os.geteuid() or parent.st_mode&0o077:raise ValueError("Boot child journal is not protected")
    descriptor=os.open(journal,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        opened=os.fstat(descriptor)
        if (opened.st_dev,opened.st_ino,opened.st_size)!=(info.st_dev,info.st_ino,info.st_size):raise ValueError("Boot child journal changed")
        observed=json.loads(os.read(descriptor,128*1024))
    finally:os.close(descriptor)
    if observed.get("childActive") and observed.get("bootId")==Path("/proc/sys/kernel/random/boot_id").read_text().strip():
        process=Path("/proc")/str(int(observed["childPid"]))
        try:
            ticks=(process/"stat").read_text().rpartition(")")[2].split()[19]
            boot_child_active=observed.get("startTicks") is None or ticks==observed["startTicks"]
        except FileNotFoundError:pass
if boot_child_active:idle=False
print(json.dumps({"success": True, "status": "WRITER_IDLE" if idle else "WRITER_BUSY", "writerIdle": idle, "writerLockSupported": True,
                  "bootChildActive":boot_child_active,"bootRecoveryRequired":boot_child_active}))
PYWRITERSTATUS
    elif [[ "$subcommand" == "preflight" ]]; then
      python3 - <<'PYOP'
import json
import os
import shutil
memory = {}
with open("/proc/meminfo") as source:
    for line in source:
        key, value = line.split(":", 1)
        memory[key] = int(value.strip().split()[0]) * 1024
root = "/var/lib/ablestack-storage" if os.path.isdir("/var/lib/ablestack-storage") else "/var/lib"
free = shutil.disk_usage(root).free
available = memory.get("MemAvailable", memory.get("MemFree", 0))
ok = available >= 256 * 1024 * 1024 and free >= 100 * 1024 * 1024
print(json.dumps({"success": ok, "status": "READY" if ok else "RESOURCE_PRESSURE",
                  "memoryAvailableBytes": available, "stagingFreeBytes": free}))
raise SystemExit(0 if ok else 1)
PYOP
    elif [[ "$subcommand" == "resources" || "$subcommand" == "prepare-scale" || "$subcommand" == "activate-scale" ]]; then
      python3 - "$action" "$subcommand" <<'PYRESOURCES'
import json
import os
import sys
from pathlib import Path

def cpu_indices(path):
    values = []
    for part in Path(path).read_text().strip().split(","):
        bounds = [int(value) for value in part.split("-")]
        values.extend(range(bounds[0], bounds[-1] + 1))
    return values

def cpu_count(path):
    return len(cpu_indices(path))

request_path = sys.argv[1]
request = json.loads(Path(request_path).read_text().strip() or "{}") if request_path and Path(request_path).is_file() else {}
memory = {}
for line in Path("/proc/meminfo").read_text().splitlines():
    key, value = line.split(":", 1)
    memory[key] = int(value.strip().split()[0]) * 1024
online_path = Path("/sys/devices/system/memory/auto_online_blocks")
online_cpus = cpu_count("/sys/devices/system/cpu/online")
possible_cpus = cpu_count("/sys/devices/system/cpu/possible")
target_cpus = int(request.get("targetCpuCount")) if request.get("targetCpuCount") is not None else online_cpus
supported = 0 < target_cpus <= possible_cpus and online_path.is_file()
if sys.argv[2] in {"prepare-scale", "activate-scale"} and supported:
    online_path.write_text("online")
if sys.argv[2] == "activate-scale" and supported:
    present = cpu_indices("/sys/devices/system/cpu/present")
    supported = target_cpus <= len(present)
    if supported:
        for cpu in present[:target_cpus]:
            cpu_online = Path(f"/sys/devices/system/cpu/cpu{cpu}/online")
            if cpu_online.is_file() and cpu_online.read_text().strip() == "0":
                cpu_online.write_text("1")
        for memory_state in Path("/sys/devices/system/memory").glob("memory[0-9]*/state"):
            if memory_state.read_text().strip() == "offline":
                memory_state.write_text("online")
        online_cpus = cpu_count("/sys/devices/system/cpu/online")
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, value = line.split(":", 1)
            memory[key] = int(value.strip().split()[0]) * 1024
result = {
    "success": supported if sys.argv[2] in {"prepare-scale", "activate-scale"} else True,
    "status": "READY" if supported else "ONLINE_RESOURCES_UNSUPPORTED",
    "onlineCpuCount": online_cpus,
    "possibleCpuCount": possible_cpus,
    "scaleActivationSupported": True,
    "memoryTotalBytes": memory.get("MemTotal", 0),
    "memoryAvailableBytes": memory.get("MemAvailable", memory.get("MemFree", 0)),
    "memoryAutoOnline": online_path.read_text().strip() if online_path.is_file() else None,
}
print(json.dumps(result, sort_keys=True))
raise SystemExit(0 if result["success"] else 1)
PYRESOURCES
    elif [[ "$subcommand" == "verify" ]]; then
