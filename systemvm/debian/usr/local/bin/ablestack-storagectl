"""Fresh protected byte attestation for the compiled VFS POSIX ACL runtime."""
import hashlib
import json
import os
from pathlib import Path
import stat
import time
import re
import subprocess

GANESHA_ACL_SOURCE = "2a57b6d53295426247b200cd100ba0741b12aff9"
GANESHA_ACL_PREFIX = "/opt/ablestack-ganesha/5.5.3"


def ganesha_protected_read(path, limit=64*1024):
    path=Path(path);info=path.lstat();parent=path.parent.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid!=0 or info.st_mode&0o022 or info.st_size>limit
            or not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=0 or parent.st_mode&0o022):
        raise ValueError("Ganesha build attestation is not protected")
    descriptor=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        opened=os.fstat(descriptor);fields=("st_dev","st_ino","st_uid","st_gid","st_mode","st_size","st_mtime_ns","st_ctime_ns")
        if any(getattr(info,key)!=getattr(opened,key) for key in fields):raise ValueError("Ganesha attestation changed during open")
        with os.fdopen(descriptor,"rb",closefd=False) as handle:content=handle.read(limit+1)
        after=os.fstat(descriptor)
        if len(content)>limit or any(getattr(opened,key)!=getattr(after,key) for key in fields):raise ValueError("Ganesha attestation changed during read")
        return content,opened
    finally:os.close(descriptor)


MANAGED_GANESHA_UNIT = '[Unit]\nDescription=ABLESTACK Storage Service NFS Ganesha endpoint %i\nAfter=local-fs.target network-online.target rpcbind.service\nWants=network-online.target rpcbind.service\n\n[Service]\nExecCondition=/usr/local/bin/ablestack-storagectl operation generation render-boot-gate %n\nType=simple\nExecStartPre=/bin/mkdir -p /run/ablestack-storage/ganesha /etc/ganesha/ablestack-storage /run/ganesha\nExecStartPre=/usr/bin/find /run/ganesha -maxdepth 1 -name ganesha.pid -type f -delete\nExecStart=/usr/bin/ganesha.nfsd -F -p /run/ablestack-storage/ganesha/%i.pid -L /run/ablestack-storage/ganesha/%i.log -f /etc/ganesha/ablestack-storage/%i.conf\nRestart=on-failure\nRestartSec=2\nKillMode=process\nTimeoutStartSec=30\n\n[Install]\nWantedBy=multi-user.target\n'

GANESHA_SERVICE_BINDINGS = {
 "/etc/systemd/system/ablestack-storage-ganesha@.service.d/ablestack-storage-vfs-acl.conf":
 "[Service]\nExecStart=\nExecStart="+GANESHA_ACL_PREFIX+"/bin/ganesha.nfsd -F -p /run/ablestack-storage/ganesha/%i.pid -L /run/ablestack-storage/ganesha/%i.log -f /etc/ganesha/ablestack-storage/%i.conf\nExecReload=\nExecReload=/bin/kill -HUP $MAINPID\n",
 "/etc/systemd/system/nfs-ganesha.service.d/ablestack-storage-vfs-acl.conf":
 "[Service]\nExecStart=\nExecStart="+GANESHA_ACL_PREFIX+"/bin/ganesha.nfsd -C\nExecReload=\nExecReload=/bin/kill -HUP $MAINPID\n"}


def ganesha_service_binding(base,declared):
    expected={path:hashlib.sha256(content.encode()).hexdigest() for path,content in GANESHA_SERVICE_BINDINGS.items()}
    if declared!=expected:raise ValueError("Ganesha service executable binding attestation differs")
    for path,content in GANESHA_SERVICE_BINDINGS.items():
        actual,_=ganesha_protected_read(base/path.lstrip("/"))
        if actual.decode()!=content:raise ValueError("Ganesha selected service uses another executable")
    path=base/"etc/systemd/system/ablestack-storage-ganesha@.service"
    content,_=ganesha_protected_read(path)
    if content.decode()!=MANAGED_GANESHA_UNIT:raise ValueError("Ganesha managed base unit is foreign")
    # Reject unknown late overrides rather than treating our own drop-in as the
    # effective service selection. Gate-only source drop-ins may coexist.
    for prefix in ("etc/systemd/system","run/systemd/system","usr/lib/systemd/system","lib/systemd/system"):
        owner=base/prefix
        if not owner.exists():continue
        for unit in owner.glob("ablestack-storage-ganesha@*.service"):
            if unit.name!="ablestack-storage-ganesha@.service":
                raise ValueError("Ganesha endpoint has an unverified instance unit override")
        directories=list(owner.glob("ablestack-storage-ganesha@*.service.d"))
        directories.append(owner/"nfs-ganesha.service.d")
        for directory in directories:
            if not directory.exists():continue
            for item in directory.glob("*.conf"):
                relative="/"+str(item.relative_to(base))
                if relative in expected:continue
                content,_=ganesha_protected_read(item)
                if content.decode()!="[Service]\nExecCondition=/usr/local/bin/ablestack-storagectl operation generation render-boot-gate %n\n":
                    raise ValueError("Ganesha service has an unverified override")
    return expected


def ganesha_systemd_effective_binding(base):
    if base!=Path("/") or not Path("/run/systemd/system").is_dir():
        return {"systemdObserved":False,"bindingObservation":"PROTECTED_UNIT_FILES"}
    result={}
    for unit in ("ablestack-storage-ganesha@capability.service","nfs-ganesha.service"):
        observed=subprocess.run(["systemctl","show",unit,"-p","LoadState","-p","ExecStart"],capture_output=True,text=True,timeout=3)
        if observed.returncode:raise ValueError("Ganesha effective systemd binding is unavailable")
        values=dict(line.split("=",1) for line in observed.stdout.splitlines() if "=" in line)
        if values.get("LoadState")=="masked" and unit=="nfs-ganesha.service":
            result[unit]={"masked":True};continue
        selected=re.findall(r"\bpath=([^ ;}]+)",values.get("ExecStart",""))
        if selected!=[GANESHA_ACL_PREFIX+"/bin/ganesha.nfsd"]:
            raise ValueError("Effective systemd Ganesha executable is legacy or foreign")
        result[unit]={"masked":False,"execStartPath":selected[0]}
    return {"systemdObserved":True,"bindingObservation":"SYSTEMD_EFFECTIVE_EXECSTART","effectiveUnitBindings":result}


def ganesha_active_library_binding(base,process_root="/proc"):
    binary=base/GANESHA_ACL_PREFIX.lstrip("/")/"bin/ganesha.nfsd"
    library=base/GANESHA_ACL_PREFIX.lstrip("/")/"lib/x86_64-linux-gnu/ganesha/libfsalvfs.so"
    binary_info=binary.stat();library_info=library.stat();observed=[];deadline=time.monotonic()+3
    for process in Path(process_root).iterdir():
        if time.monotonic()>=deadline:raise ValueError("Ganesha active runtime observation deadline exhausted")
        if not process.name.isdigit():continue
        try:
            executable=os.readlink(process/"exe")
            canonical=executable[:-10] if executable.endswith(" (deleted)") else executable
            if not canonical.endswith("/ganesha.nfsd"):continue
            before=(process/"stat").read_text().rpartition(")")[2].split()[19]
            opened=(process/"exe").stat()
            if (opened.st_dev,opened.st_ino)!=(binary_info.st_dev,binary_info.st_ino) or executable.endswith(" (deleted)"):
                raise ValueError("Active Ganesha is bound to a legacy or replaced executable")
            matched=False
            for line in (process/"maps").read_text().splitlines():
                parts=line.split(None,5)
                if len(parts)!=6 or "libfsalvfs.so" not in parts[5]:continue
                if parts[5]!=str(library) and parts[5]!=GANESHA_ACL_PREFIX+"/lib/x86_64-linux-gnu/ganesha/libfsalvfs.so":
                    raise ValueError("Active Ganesha VFS library is legacy or foreign")
                major,minor=(int(value,16) for value in parts[3].split(":"))
                if (os.makedev(major,minor),int(parts[4]))!=(library_info.st_dev,library_info.st_ino):
                    raise ValueError("Active Ganesha VFS library inode differs from its manifest")
                matched=True
            if not matched:raise ValueError("Active Ganesha VFS mapping is unobservable")
            after=(process/"stat").read_text().rpartition(")")[2].split()[19]
            if before!=after:raise ValueError("Active Ganesha PID identity changed while inspecting")
            observed.append({"pid":int(process.name),"startTicks":before,"executable":GANESHA_ACL_PREFIX+"/bin/ganesha.nfsd",
                             "vfsDevice":library_info.st_dev,"vfsInode":library_info.st_ino})
        except FileNotFoundError:continue
    return observed

def ganesha_acl_capabilities(manifest=None,root=None,process_root="/proc"):
    path=Path(manifest or "/etc/ablestack-storage/ganesha-build-manifest.json");base=Path(root or "/")
    result={"success":True,"generatedEpoch":time.time(),"nfsVfsPosixAclSupported":False,
            "ganeshaVersion":None,"ganeshaBuildManifestSha256":None,"vfsLibrarySha256":None,
             "posixAclBuildEnabled":False,"posixAclSelfTestVerified":False,"configuredExecutableBindingVerified":False,
            "activeRuntimeVfsVerified":False,"activeGaneshaProcesses":[],"supportedFeatures":[]}
    try:
        data,_=ganesha_protected_read(path);value=json.loads(data)
        expected_flags={"ENABLE_VFS_POSIX_ACL":"ON","ENABLE_VFS_DEBUG_ACL":"OFF","USE_FSAL_VFS":"ON","USE_DBUS":"ON"}
        if (type(value.get("schemaVersion")) is not int or value.get("schemaVersion")!=1 or value.get("sourceCommit")!=GANESHA_ACL_SOURCE or value.get("version")!="5.5.3"
                or value.get("requiredCmakeFlags")!=expected_flags or value.get("prefix")!=GANESHA_ACL_PREFIX
                or value.get("selfTest",{}).get("namedAclReadWrite") is not True or value.get("selfTest",{}).get("defaultAclInheritance") is not True):
            raise ValueError("Ganesha build or real ACL self-test attestation is incomplete")
        files=value.get("files")
        required={"bin/ganesha.nfsd","lib/x86_64-linux-gnu/libganesha_nfsd.so.5.5.3","lib/x86_64-linux-gnu/libntirpc.so.5.0","lib/x86_64-linux-gnu/ganesha/libfsalvfs.so"}
        if not isinstance(files,dict) or set(files)!=required:raise ValueError("Ganesha fixed runtime file attestation differs")
        for name,expected in files.items():
            if not isinstance(expected,str) or len(expected)!=64:raise ValueError("Ganesha file digest is invalid")
            content,_=ganesha_protected_read(base/GANESHA_ACL_PREFIX.lstrip("/")/name,32*1024*1024)
            if hashlib.sha256(content).hexdigest()!=expected:raise ValueError("Ganesha installed runtime bytes changed")
        bindings=ganesha_service_binding(base,value.get("serviceBindings"))
        selected=ganesha_systemd_effective_binding(base)
        processes=ganesha_active_library_binding(base,process_root)
        result.update(**selected,configuredExecutableBindingVerified=True,activeRuntimeVfsVerified=bool(processes),
                      activeRuntimeNotApplicable=not bool(processes),activeGaneshaProcesses=processes,
                      serviceBindings=bindings,nfsVfsPosixAclSupported=True,ganeshaVersion=value["version"],
                      ganeshaBuildManifestSha256=hashlib.sha256(data).hexdigest(),
                      vfsLibrarySha256=files["lib/x86_64-linux-gnu/ganesha/libfsalvfs.so"],
                      posixAclBuildEnabled=True,posixAclSelfTestVerified=True,supportedFeatures=["NFS_VFS_POSIX_ACL"])
    except (OSError,ValueError,TypeError,KeyError,IndexError,subprocess.TimeoutExpired) as error:
        result["diagnostic"]=str(error)
    return result
# END EMBEDDED GANESHA FEATURES

def start_ganesha_endpoints(configs):
    if Path("/etc/ablestack-storage/ganesha-build-manifest.json").exists():
        binding=ganesha_acl_capabilities()
        if binding.get("nfsVfsPosixAclSupported") is not True:
            raise RuntimeError("GANESHA_RUNTIME_BINDING_UNVERIFIED: "+str(binding.get("diagnostic") or "selected service/library differs"))
        ganesha=GANESHA_ACL_PREFIX+"/bin/ganesha.nfsd"
    else:
        ganesha = shutil.which("ganesha.nfsd")
    dynamic=rendered_ganesha_dynamic_candidates(configs)
    if not globals().get("rendered_context"):stop_default_ganesha_service()
    if not configs:
        stop_ganesha_endpoints()
        return []
    ensure_ganesha_runtime_dirs()
    if not ganesha:
        raise RuntimeError("nfs-ganesha is required for Storage Service NFS endpoint isolation")
    if not ensure_rpcbind_started():
        raise RuntimeError("rpcbind is required for Storage Service NFS Ganesha runtime")
    active_keys = {key for key, _conf_path, _ip, _port, _mode in configs}
    if shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
        subprocess.run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=ganesha_remaining(30))
    if not globals().get("rendered_context"):stop_ganesha_endpoints(active_keys=active_keys)
    ensure_ganesha_runtime_dirs()
    started = []
    dynamic_results={}
    for key, conf_path, ip, port, mode in configs:
        ganesha_remaining()
        log_path = os.path.join(ganesha_run_dir, f"{key}.log")
        pid_path = os.path.join(ganesha_run_dir, f"{key}.pid")
        if key in dynamic:
            adapter,pid,before,after,bus_name=dynamic[key]
            dynamic_results[key]=adapter.transition(bus_name,pid,conf_path,before,after)
            started.append((key,conf_path,ip,int(port),mode,pid,log_path))
            continue
        try:
            if os.path.exists(pid_path):
                os.unlink(pid_path)
        except Exception:
            pass
        try:
            open(log_path, "ab").close()
        except Exception:
            pass
        if shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
            unit = f"ablestack-storage-ganesha@{key}.service"
            result = subprocess.run(["systemctl", "restart", unit], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=ganesha_remaining(30))
            if result.returncode != 0:
                item_tail = tail_file(log_path, 80)
                raise RuntimeError(f"failed to start {unit}: {(result.stderr or result.stdout).strip()}{': ' + item_tail if item_tail else ''}")
            pid = 0
            deadline_pid = min(time.monotonic()+10,nfs_operation_deadline)
            while time.monotonic() < deadline_pid:
                show = subprocess.run(["systemctl", "show", "-p", "MainPID", "--value", unit], text=True,
                                      stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False, timeout=ganesha_remaining(10))
                try:
                    pid = int(show.stdout.strip() or "0")
                except Exception:
                    pid = 0
                if pid > 0:
                    try:
                        with open(pid_path, "w", encoding="utf-8") as pid_fp:
                            pid_fp.write(str(pid))
                    except Exception:
                        pass
                    break
                time.sleep(0.2)
            started.append((key, conf_path, ip, int(port), mode, pid, log_path))
        else:
            log_fp = open(log_path, "wb")
            proc = subprocess.Popen([ganesha, "-F", "-p", pid_path, "-L", log_path, "-f", conf_path],
                                    stdin=subprocess.DEVNULL, stdout=log_fp, stderr=log_fp,
                                    start_new_session=True, close_fds=True)
            with open(pid_path, "w", encoding="utf-8") as pid_fp:
                pid_fp.write(str(proc.pid))
            started.append((key, conf_path, ip, int(port), mode, proc.pid, log_path))
    runtime = []
    for key, conf_path, ip, port, mode, pid, log_path in started:
        ganesha_remaining()
        deadline = min(time.monotonic()+15,nfs_operation_deadline)
        item = {
            "key": key,
            "listenIp": ip,
            "port": port,
            "protocolMode": mode,
            "pid": pid,
            "logPath": log_path,
            "processRunning": managed_ganesha_process(pid) if pid else False,
            "listening": False,
            "activationStrategy": dynamic_results.get(key,{}).get("activationStrategy","ROOT_MAINTENANCE_RECREATE" if globals().get("rendered_context") and root_maintenance_nfs_boundary() else "OWNED_UNIT_START"),
            "restartPerformed": key not in dynamic_results,
        }
        candidate_ip = str(ip or "127.0.0.1").strip()
        if candidate_ip in ("0.0.0.0", "::"):
            candidate_ip = "127.0.0.1"
        last_error = ""
        while time.monotonic() < deadline:
            item["processRunning"] = managed_ganesha_process(pid) if pid else False
            if pid and not process_exists(pid):
                item["error"] = "managed ganesha process exited"
                failed_conf_path = conf_path + ".failed"
                try:
                    shutil.copyfile(conf_path, failed_conf_path)
                    item["failedConfPath"] = failed_conf_path
                    conf_tail = tail_file(failed_conf_path, 80)
                    if conf_tail:
                        item["confTail"] = conf_tail
                except Exception:
                    pass
                log_tail = tail_file(log_path, 80)
                if log_tail:
                    item["logTail"] = log_tail
                break
            try:
                with socket.create_connection((candidate_ip, port), timeout=ganesha_remaining(1)):
                    item["listening"] = True
                    break
            except Exception as exc:
                last_error = str(exc)
                if time.monotonic()>=nfs_operation_deadline:break
                time.sleep(min(.5,ganesha_remaining(.5)))
        if item.get("listening"):
            managed_deadline = min(time.monotonic()+3,nfs_operation_deadline)
            while pid and not managed_ganesha_process(pid) and process_exists(pid) and time.monotonic() < managed_deadline:
                time.sleep(0.2)
            item["processRunning"] = managed_ganesha_process(pid) if pid else False
            try:
                with open(conf_path, "r", encoding="utf-8", errors="replace") as conf_fp:
                    conf_body = conf_fp.read()
            except Exception:
                conf_body = ""
            if "EXPORT {" in conf_body:
                log_tail = tail_file(log_path, 80)
                rejection_markers = (
                    "No export entries found",
                    "out of range",
                    "invalid param value",
                    "errors found block EXPORT",
                    "Expected an IP address",
                    "Could not parse",
                    "Error while parsing",
                )
                if any(marker in log_tail for marker in rejection_markers):
                    item["listening"] = False
                    item["error"] = "managed ganesha config was rejected"
                    item["logTail"] = log_tail
                    failed_conf_path = conf_path + ".failed"
                    try:
                        shutil.copyfile(conf_path, failed_conf_path)
                        item["failedConfPath"] = failed_conf_path
                    except Exception:
                        pass
        if item.get("listening") and not item.get("processRunning"):
            item["listening"] = False
            item["processRunning"] = False
            item["error"] = "endpoint port is open but the managed ganesha process is not confirmed"
        if not item["listening"]:
            item["error"] = item.get("error") or last_error or "endpoint did not begin listening"
            log_tail = tail_file(log_path, 80)
            if log_tail:
                item["logTail"] = log_tail
        runtime.append(item)
    failures = [item for item in runtime if not item.get("listening")]
    if failures:
        if not globals().get("rendered_context"):stop_ganesha_endpoints()
        details = ", ".join(f"{item.get('listenIp')}:{item.get('port')} ({item.get('error') or 'not listening'}{': ' + item.get('logTail') if item.get('logTail') else ''})" for item in failures)
        raise RuntimeError(f"nfs-ganesha endpoints failed to start: {details}")
    return runtime

def probe_nfs_export_visibility(runtime, endpoint_exports):
    # The complete probe, including cleanup and termination, shares one budget.
    probe_deadline = time.monotonic() + max(1, min(120, int(payload.get("probeDeadlineSeconds") or 30)))
    def bounded_probe_command(arguments, maximum):
        remaining=probe_deadline-time.monotonic()
        if remaining<=0:raise subprocess.TimeoutExpired(arguments,0)
        inherited=(9,) if os.environ.get("ABLESTACK_STORAGE_WRITER_LOCK_FD")=="9" else ()
        process=subprocess.Popen(arguments,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,pass_fds=inherited)
        descriptor=None
        if callable(getattr(os,"pidfd_open",None)):
            try:descriptor=os.pidfd_open(process.pid,0)
            except ProcessLookupError:pass
        def checkpoint(phase):
            if not inherited:return
            import json,stat
            from pathlib import Path
            path=Path(os.environ.get("ABLESTACK_STORAGE_NFS_PROBE_JOURNAL","/var/lib/ablestack-storage/nfs-probe-child.json"))
            path.parent.mkdir(parents=True,mode=0o700,exist_ok=True)
            info=path.parent.lstat()
            if not stat.S_ISDIR(info.st_mode) or info.st_uid!=os.geteuid() or info.st_mode&0o022:raise ValueError("NFS probe journal directory is not protected")
            fd,temporary=tempfile.mkstemp(prefix=".nfs-probe-child-",dir=path.parent)
            try:
                os.fchmod(fd,0o600)
                with os.fdopen(fd,"w") as handle:
                    json.dump({"phase":phase,"childPid":process.pid,"command":arguments[0],"childActive":process.poll() is None,"deadlineExceededEpoch":time.time()},handle);handle.flush();os.fsync(handle.fileno())
                os.replace(temporary,path)
                directory=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
                try:os.fsync(directory)
                finally:os.close(directory)
            finally:
                if os.path.exists(temporary):os.unlink(temporary)
        try:
            output,error=process.communicate(timeout=min(maximum,max(.01,remaining-2)))
            return subprocess.CompletedProcess(arguments,process.returncode,output,error)
        except subprocess.TimeoutExpired:
            # The child keeps the writer descriptor while kernel I/O remains
            # blocked. No second mount/probe is launched on the same operation.
            checkpoint("TIMED_OUT_PENDING_RECONCILE")
            if descriptor is not None:
                signal.pidfd_send_signal(descriptor,signal.SIGTERM,None,0)
                wait=min(1,max(0,probe_deadline-time.monotonic()))
                if wait:
                    try:process.communicate(timeout=wait)
                    except subprocess.TimeoutExpired:
                        signal.pidfd_send_signal(descriptor,signal.SIGKILL,None,0)
                        wait=min(1,max(0,probe_deadline-time.monotonic()))
                        if wait:
                            try:process.communicate(timeout=wait)
                            except subprocess.TimeoutExpired:pass
            checkpoint("RECOVERY_REQUIRED" if process.poll() is None else "TIMED_OUT_PENDING_RECONCILE")
            failure=subprocess.TimeoutExpired(arguments,maximum)
            failure.childActive=process.poll() is None
            failure.childPid=process.pid
            raise failure
        finally:
            if descriptor is not None:os.close(descriptor)
    def local_global_ipv4_addresses():
        proc = bounded_probe_command(["ip", "-4", "-o", "addr", "show", "scope", "global"],10)
        addresses = []
        if proc.returncode != 0:
            return addresses
        for line in proc.stdout.splitlines():
            parts = line.split()
            if "inet" not in parts:
                continue
            try:
                inet_value = parts[parts.index("inet") + 1]
                address = str(ipaddress.ip_interface(inet_value).ip)
            except Exception:
                continue
            if address not in addresses:
                addresses.append(address)
        return addresses

    def client_tokens(export):
        tokens = []
        for client in export.get("clients") or []:
            for token in str(client.get("clients") or "").split(","):
                token = token.strip()
                if token:
                    tokens.append(token)
        return tokens

    def address_matches_client(address, client):
        client = str(client or "").strip()
        if client in ("*", "0.0.0.0/0", "::/0"):
            return True
        try:
            probe_address = ipaddress.ip_address(address)
        except Exception:
            return False
        try:
            if "/" in client:
                return probe_address in ipaddress.ip_network(client, strict=False)
            return probe_address == ipaddress.ip_address(client)
        except Exception:
            return False

    def address_allowed_by_export(address, export):
        tokens = client_tokens(export)
        if not tokens:
            return False
        return any(address_matches_client(address, token) for token in tokens)

    def select_mount_host(listen_ip, export, local_addresses):
        host = str(listen_ip or "").strip()
        if host not in ("", "0.0.0.0", "::") and address_allowed_by_export(host, export):
            return host, None
        for address in local_addresses:
            if host not in ("", "0.0.0.0", "::") and address != host:
                continue
            if address_allowed_by_export(address, export):
                return address, None
        if any(token in ("*", "0.0.0.0/0", "::/0") for token in client_tokens(export)):
            return "127.0.0.1", None
        clients = ", ".join(client_tokens(export)) or "none"
        return None, f"no local IPv4 address is allowed by export clients: {clients}"

    failures = []
    local_addresses = local_global_ipv4_addresses()
    for endpoint in runtime:
        listen_ip = str(endpoint.get("listenIp") or "").strip()
        port = int(endpoint.get("port") or 0)
        exports = endpoint_exports.get((listen_ip, port), []) or []
        endpoint["probeSuccess"] = True
        endpoint["exportsVisible"] = True
        endpoint["probeResults"] = []
        if not exports:
            continue

        endpoint_success = True
        for export in exports:
            export_mode = str(export.get("protocolMode") or "V4_ONLY").strip().upper()
            export_name = str(export.get("name") or export.get("path") or "export").strip() or "export"
            host, host_error = select_mount_host(listen_ip, export, local_addresses)
            probe_specs = []
            if export_mode == "V3V4_DUAL":
                probe_specs.append({
                    "mode": "NFSv4",
                    "mountType": "nfs4",
                    "target": f"{host}:{export.get('pseudo')}",
                    "options": f"vers=4.1,proto=tcp,port={port},ro,soft,timeo=1,retrans=1",
                })
                probe_specs.append({
                    "mode": "NFSv3",
                    "mountType": "nfs",
                    "target": f"{host}:{export.get('pseudo')}",
                    "options": f"vers=3,proto=tcp,port={port},nolock,ro,soft,timeo=1,retrans=1",
                })
            else:
                probe_specs.append({
                    "mode": "NFSv4",
                    "mountType": "nfs4",
                    "target": f"{host}:{export.get('pseudo')}",
                    "options": f"vers=4.1,proto=tcp,port={port},ro,soft,timeo=1,retrans=1",
                })

            export_result = {
                "exportUuid": export.get("uuid"),
                "exportName": export_name,
                "protocolMode": export_mode,
                "targetPath": export.get("path"),
                "pseudoPath": export.get("pseudo"),
                "success": True,
                "probes": [],
            }
            if host_error:
                export_result["success"] = None
                export_result["status"] = "SKIPPED_ACL"
                export_result["error"] = host_error
                endpoint["probeResults"].append(export_result)
                endpoint["exportsVisible"] = None
                continue
            for spec in probe_specs:
                remaining = probe_deadline - time.monotonic()
                if remaining <= 0:
                    export_result["success"] = None
                    export_result["status"] = "PROBE_PENDING"
                    endpoint["exportsVisible"] = None
                    break
                probe_dir = tempfile.mkdtemp(prefix=f"nfs-probe-{endpoint_key(listen_ip, port)}-", dir=nfs_probe_root)
                try:
                    cmd = [
                        "mount",
                        "-t",
                        spec["mountType"],
                        "-o",
                        spec["options"],
                        spec["target"],
                        probe_dir,
                    ]
                    proc = bounded_probe_command(cmd,15)
                    success = proc.returncode == 0
                    error = None
                    if success:
                        umount = bounded_probe_command(["umount",probe_dir],10)
                        if umount.returncode != 0:
                            success = False
                            error = umount.stderr.strip() or umount.stdout.strip() or "failed to unmount probe mountpoint"
                    else:
                        error = proc.stderr.strip() or proc.stdout.strip() or "mount probe failed"
                    probe_info = {
                        "mode": spec["mode"],
                        "mountType": spec["mountType"],
                        "target": spec["target"],
                        "options": spec["options"],
                        "success": success,
                    }
                    if error:
                        probe_info["error"] = error
                    export_result["probes"].append(probe_info)
                    if not success:
                        export_result["success"] = False
                        export_result["error"] = error or "mount probe failed"
                        endpoint_success = False
                        break
                except subprocess.TimeoutExpired as timeout:
                    export_result["probeChildActive"] = bool(getattr(timeout,"childActive",False))
                    export_result["probeChildPid"] = getattr(timeout,"childPid",None)
                    endpoint_success = False
                    export_result["success"] = None
                    export_result["status"] = "PROBE_PENDING"
                    export_result["error"] = "mount probe deadline exceeded"
                    endpoint["exportsVisible"] = None
                    break
                finally:
                    # Never recurse into a potentially still-mounted client filesystem.
                    try:
                        if export_result.get("probeChildActive") or probe_deadline<=time.monotonic():
                            export_result["cleanupPending"] = True
                        else:bounded_probe_command(["umount",probe_dir],10)
                    except subprocess.TimeoutExpired:
                        export_result["cleanupPending"] = True
                    if not export_result.get("cleanupPending"):
                        try:os.rmdir(probe_dir)
                        except OSError:pass

            endpoint["probeResults"].append(export_result)
            if export_result["success"] is False:
                endpoint_success = False

        endpoint["probeSuccess"] = endpoint_success
        if endpoint.get("exportsVisible") is not None:
            endpoint["exportsVisible"] = endpoint_success
        if not endpoint_success:
            failures.append(endpoint)
    return failures

def run(command):
    return subprocess.run(command, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

def fstab_escape(value):
    return str(value).replace("\\", "\\\\").replace(" ", "\\040").replace("\t", "\\011")

def update_fstab(marker, entry=None):
    fstab_path = "/etc/fstab"
    lines = []
    if os.path.exists(fstab_path):
        with open(fstab_path, "r", encoding="utf-8") as fstab_fp:
            for line in fstab_fp:
                if marker not in line:
                    lines.append(line)
    if entry:
        lines.append(entry.rstrip("\n") + "\n")
    fd, tmp_path = tempfile.mkstemp(prefix=".fstab.", dir=os.path.dirname(fstab_path), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as tmp_fp:
            tmp_fp.writelines(lines)
        os.replace(tmp_path, fstab_path)
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)

def daemon_reload():
    if os.path.exists("/run/systemd/system"):
        subprocess.run(["systemctl", "daemon-reload"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=ganesha_remaining(20))

def ipv4_to_int(value):
    parts = [int(part) for part in str(value).split(".")]
    if len(parts) != 4 or any(part < 0 or part > 255 for part in parts):
        raise ValueError(f"invalid IPv4 address: {value}")
    result = 0
    for part in parts:
        result = (result << 8) + part
    return result

def same_ipv4_cidr(left, right, prefix):
    mask = 0 if int(prefix) == 0 else (0xffffffff << (32 - int(prefix))) & 0xffffffff
    return (ipv4_to_int(left) & mask) == (ipv4_to_int(right) & mask)

def ensure_listen_ip():
    listen_ip = str(payload.get("listenIp") or "").strip()
    if not listen_ip or listen_ip in ("0.0.0.0", "::"):
        return
    ip_state = run(["ip", "-o", "-4", "addr", "show"])
    if ip_state.returncode != 0:
        raise RuntimeError(f"failed to inspect IPv4 addresses: {ip_state.stderr.strip()}")
    candidates = []
    for line in ip_state.stdout.splitlines():
        parts = line.split()
        if len(parts) < 4 or parts[2] != "inet":
            continue
        iface = parts[1]
        address, prefix = parts[3].split("/", 1)
        if address == listen_ip:
            return
        try:
            if same_ipv4_cidr(listen_ip, address, int(prefix)):
                candidates.append((iface, prefix))
        except Exception:
            continue
    if not candidates:
        raise ValueError(f"listen IP {listen_ip} is not in the same CIDR as any Storage Service NIC")
    iface, prefix = candidates[0]
    add_ip = run(["ip", "addr", "add", f"{listen_ip}/{prefix}", "dev", iface])
    if add_ip.returncode != 0 and "File exists" not in add_ip.stderr:
        raise RuntimeError(f"failed to add listen IP {listen_ip}/{prefix} to {iface}: {add_ip.stderr.strip()}")

def remove_listen_ip():
    listen_ip = str(payload.get("removeListenIp") or "").strip()
    if not listen_ip or listen_ip in ("0.0.0.0", "::"):
        return
    ip_state = run(["ip", "-o", "-4", "addr", "show"])
    if ip_state.returncode != 0:
        raise RuntimeError(f"failed to inspect IPv4 addresses before endpoint removal: {ip_state.stderr.strip()}")
    for line in ip_state.stdout.splitlines():
        parts = line.split()
        if len(parts) < 4 or parts[2] != "inet":
            continue
        iface = parts[1]
        address, prefix = parts[3].split("/", 1)
        if address != listen_ip:
            continue
        delete_ip = run(["ip", "addr", "del", f"{listen_ip}/{prefix}", "dev", iface])
        if delete_ip.returncode != 0 and "Cannot assign requested address" not in delete_ip.stderr:
            raise RuntimeError(f"failed to remove listen IP {listen_ip}/{prefix} from {iface}: {delete_ip.stderr.strip()}")
        return

def is_mountpoint(path):
    return run(["findmnt", "-n", "--mountpoint", path]).returncode == 0

def is_path_on_mount(path, mount_path):
    if not path or not mount_path:
        return False
    path_real = os.path.realpath(path)
    mount_real = os.path.realpath(mount_path)
    return path_real == mount_real or path_real.startswith(mount_real.rstrip("/") + "/")

def verify_share_mount_boundary(path, root):
    if not root or not os.path.isdir(root) or os.path.islink(root):
        raise RuntimeError("Backing volume root is unavailable")
    canonical_root = os.path.abspath(root).rstrip("/")
    if os.path.realpath(canonical_root) != canonical_root:
        raise RuntimeError("Backing volume root contains a symlink")
    relative = os.path.relpath(path, canonical_root)
    if relative == ".." or relative.startswith("../") or os.path.isabs(relative):
        raise RuntimeError("Share backing path escapes the selected volume root")
    mount = run(["findmnt", "-n", "-o", "TARGET", "-T", canonical_root])
    if mount.returncode != 0 or mount.stdout.strip() != canonical_root:
        raise RuntimeError("Cannot verify share backing mount")
    descriptor = os.open(canonical_root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    device = os.fstat(descriptor).st_dev
    current = canonical_root
    try:
        for part in ([] if relative == "." else relative.split(os.sep)):
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
            current = os.path.join(current, part)
            observed = run(["findmnt", "-n", "-o", "TARGET", "-T", current])
            if os.fstat(descriptor).st_dev != device or observed.returncode != 0 or observed.stdout.strip() != canonical_root:
                raise RuntimeError("Share backing path crosses a filesystem or mount boundary")
        pinned = os.fstat(descriptor)
        named = os.lstat(current)
        if (pinned.st_dev, pinned.st_ino) != (named.st_dev, named.st_ino) or os.path.islink(current):
            raise RuntimeError("Share backing path changed during mount verification")
    finally:
        os.close(descriptor)

def ensure_directory_below_volume(root, path, create):
    relative = os.path.relpath(path, root)
    if relative == ".." or relative.startswith("../") or os.path.isabs(relative):
        raise ValueError("Export directory escapes the selected volume root")
    if os.path.realpath(root) != os.path.abspath(root) or os.path.islink(root):
        raise ValueError("Selected backing volume root contains a symlink")
    descriptor = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    device = os.fstat(descriptor).st_dev
    mounted = run(["findmnt", "-n", "-o", "TARGET", "-T", root])
    if mounted.returncode != 0 or mounted.stdout.strip() != root:
        os.close(descriptor)
        raise RuntimeError("Selected backing volume mount changed")
    current = root
    created_final = False
    try:
        # A mounted filesystem root already exists. It never receives implicit
        # protocol ownership/mode initialization, even after a new format.
        components = [] if relative == "." else relative.split(os.sep)
        for index, part in enumerate(components):
            created = False
            try:
                child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            except FileNotFoundError:
                if not create:
                    raise RuntimeError("Backing directory does not exist")
                os.mkdir(part, mode=0o750, dir_fd=descriptor)
                child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
                created = True
            os.close(descriptor)
            descriptor = child
            current = os.path.join(current, part)
            observed = run(["findmnt", "-n", "-o", "TARGET", "-T", current])
            if os.fstat(descriptor).st_dev != device or observed.returncode != 0 or observed.stdout.strip() != root:
                raise RuntimeError("Backing directory crosses a mount boundary")
            if index == len(components) - 1:
                created_final = created
        return {"device": os.fstat(descriptor).st_dev, "inode": os.fstat(descriptor).st_ino} if created_final else None
    finally:
        os.close(descriptor)

def ensure_export_alias(export):
    export_config = effective_nfs_export_config(export.get("config") or {})
    backing_path = str(export_config.get("backingPath") or "").strip().rstrip("/")
    volume_mount_path = str(export_config.get("volumeMountPath") or "").strip().rstrip("/")
    uuid = safe_uuid(export.get("uuid"))
    exposed_path = str(export.get("path") or "").strip().rstrip("/")
    root_name = safe_export_root_name(export.get("exportPath") or export.get("name"), exposed_path)
    expected_path = f"/export/{root_name}"
    if exposed_path != expected_path:
        raise ValueError(f"NFS export path must be {expected_path}")
    if not backing_path:
        raise ValueError(f"NFS export {uuid} is missing config.backingPath; refusing to export a root filesystem directory")
    if not volume_mount_path:
        raise ValueError(f"NFS export {uuid} is missing config.volumeMountPath; refusing to export a root filesystem directory")
    if backing_path in ("/", "/export") or backing_path.startswith("/export/"):
        raise ValueError(f"NFS export {uuid} backingPath must be a managed data-volume path, not {backing_path}")
    if not volume_mount_path.startswith("/srv/ablestack-storage/volumes/"):
        raise ValueError(f"NFS export {uuid} volumeMountPath is outside the managed Storage Service volume area: {volume_mount_path}")
    if not is_mountpoint(volume_mount_path):
        raise RuntimeError(f"NFS export {uuid} backing volume is not mounted at {volume_mount_path}")
    if not is_path_on_mount(backing_path, volume_mount_path):
        raise ValueError(f"NFS export {uuid} backingPath {backing_path} is not under mounted volume {volume_mount_path}")
    create_directory = truth(export_config, "createDirectory", True)
    export["_createdBackingDirectory"] = ensure_directory_below_volume(volume_mount_path, backing_path, create_directory)
    if not os.path.isdir(backing_path):
        raise ValueError(f"NFS export {uuid} backingPath is not a directory: {backing_path}")
    verify_share_mount_boundary(backing_path, volume_mount_path)
    if os.path.exists(exposed_path) and not os.path.isdir(exposed_path):
        raise ValueError(f"NFS export alias path exists and is not a directory: {exposed_path}")
    os.makedirs(exposed_path, exist_ok=True)
    if not is_mountpoint(exposed_path) and os.listdir(exposed_path):
        raise RuntimeError(f"refusing to hide non-empty root filesystem NFS export alias: {exposed_path}")
    if is_mountpoint(exposed_path):
        try:
            same_target = os.path.samefile(exposed_path, backing_path)
        except Exception:
            same_target = False
        if not same_target:
            unmount = run(["umount", exposed_path])
            if unmount.returncode != 0:
                raise RuntimeError(f"failed to unmount stale NFS export alias {exposed_path}: {unmount.stderr.strip()}")
    if not is_mountpoint(exposed_path):
        mount = run(["mount", "--bind", backing_path, exposed_path])
        if mount.returncode != 0:
            raise RuntimeError(f"failed to bind NFS export alias {exposed_path} to {backing_path}: {mount.stderr.strip()}")
    if not is_mountpoint(exposed_path):
        raise RuntimeError(f"NFS export alias {exposed_path} is not a bind mount after mount operation")
    marker = f"ablestack-storage:{uuid}:alias"
    options = f"bind,nofail,x-systemd.requires-mounts-for={fstab_escape(backing_path)}"
    entry = f"{fstab_escape(backing_path)} {fstab_escape(exposed_path)} none {options} 0 0 # {marker}"
    update_fstab(marker, entry)
    daemon_reload()
    return exposed_path

def verify_common_posix_policy(path, config):
    policy_uuid = config.get("posixPolicyUuid")
    if not policy_uuid:
        return False
    with open("/etc/ablestack-storage/posix-directory-policies.json", "r", encoding="utf-8") as fp:
        policies = json.load(fp)
    stored = policies.get(str(policy_uuid))
    if not isinstance(stored, dict):
        raise RuntimeError("Referenced common POSIX policy is not applied")
    request = stored.get("request") or {}
    canonical = os.path.normpath(os.path.join(str(request.get("volumeMountPath") or "").rstrip("/"), str(request.get("relativePath") or "")))
    if os.path.realpath(path) != canonical or int(request.get("revision", -1)) != int(config.get("posixPolicyRevision", -2)):
        raise RuntimeError("Protocol directory or revision differs from the common POSIX policy")
    if os.path.islink(path):
        raise RuntimeError("Common POSIX directory is a symlink")
    return True

def apply_posix_permissions(backing_path, export_config, created_directory=False):
    # Protocol reconciliation observes common policy ownership. It never changes
    # ownership/mode on pre-existing data, including legacy exports.
    if verify_common_posix_policy(backing_path, export_config):
        return
    if not created_directory:
        return
    if truth(export_config, "recursivePermission", False):
        raise ValueError("Recursive permissions require a separate explicit POSIX directory operation")
    owner_uid = int_config(export_config, "ownerUid")
    owner_gid = int_config(export_config, "ownerGid")
    mode = mode_config(export_config)
    descriptor = os.open(backing_path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        opened = os.fstat(descriptor)
        expected = (created_directory["device"], created_directory["inode"])
        if (opened.st_dev, opened.st_ino) != expected or (os.lstat(backing_path).st_dev, os.lstat(backing_path).st_ino) != expected:
            raise RuntimeError("New export directory changed before initialization")
        if owner_uid is not None or owner_gid is not None:
            os.fchown(descriptor, owner_uid if owner_uid is not None else -1, owner_gid if owner_gid is not None else -1)
        if mode is not None:
            os.fchmod(descriptor, mode)
    finally:
        os.close(descriptor)

def load_alias_state():
    try:
        with open(alias_state_path, "r", encoding="utf-8") as state_fp:
            return json.load(state_fp)
    except Exception:
        return {}

quota_state = {}
alias_state = load_alias_state()
next_alias_state = {}
managed_files = set()
endpoint_exports = {}
enabled = bool(payload.get("enabled", True))
remove_legacy_root_export()
if not rendered_context:
    remove_listen_ip()
    ensure_listen_ip()
default_listen_ip = str(payload.get("listenIp") or "0.0.0.0").strip() or "0.0.0.0"
default_port = int(payload.get("port") or 2049)
service_protocol_mode = str(payload.get("protocolMode") or payload.get("protocolmode") or "V4_ONLY").strip().upper()
if service_protocol_mode not in ("V4_ONLY", "V3V4_DUAL"):
    service_protocol_mode = "V4_ONLY"

for export in payload.get("exports", []):
    uuid = safe_uuid(export.get("uuid"))
    export_file = os.path.join(exports_dir, f"ablestack-{uuid}.exports")
    managed_files.add(export_file)
    path = export.get("path")
    state = export.get("state", "Ready")
    if enabled and path and state not in ("Disabled", "Destroyed", "Error"):
        export_config = effective_nfs_export_config(export.get("config") or {})
        backing_path = str(export_config.get("backingPath") or "").strip().rstrip("/")
        exposed_path = ensure_export_alias(export)
        root_name = safe_export_root_name(export.get("exportPath") or export.get("name"), exposed_path)
        next_alias_state[uuid] = {
            "aliasPath": exposed_path,
            "backingPath": backing_path,
            "name": export.get("name"),
        }
        apply_posix_permissions(backing_path, export_config, export.get("_createdBackingDirectory", False))
        rendered_acl_keys = set()
        clients = []
        for acl in export.get("acls", []):
            acl_state = acl.get("state", "Ready")
            if acl_state in ("Disabled", "Destroyed", "Error"):
                continue
            principal = acl.get("principal")
            if not principal:
                continue
            rendered_principal = nfs_export_principal(principal)
            permission = acl.get("permission", "READ_ONLY")
            acl_config = acl.get("config") or {}
            read_write = "rw" if permission == "READ_WRITE" and not truth(export_config, "readOnly", False) else "ro"
            all_squash = truth(acl_config, "allSquash", truth(export_config, "allSquash", False))
            root_squash = "all_squash" if all_squash else ("root_squash" if truth(acl_config, "rootSquash", truth(export_config, "rootSquash", True)) else "no_root_squash")
            sync = "sync" if truth(acl_config, "sync", truth(export_config, "sync", True)) else "async"
            secure = "secure" if truth(acl_config, "secure", truth(export_config, "secure", True)) else "insecure"
            options = [read_write, sync, root_squash, secure, "no_subtree_check"]
            anon_uid = int_config(acl_config, "anonUid")
            anon_gid = int_config(acl_config, "anonGid")
            if anon_uid is None:
                anon_uid = int_config(export_config, "anonUid")
            if anon_gid is None:
                anon_gid = int_config(export_config, "anonGid")
            if anon_uid is not None:
                options.append(f"anonuid={anon_uid}")
            if anon_gid is not None:
                options.append(f"anongid={anon_gid}")
            options = ",".join(options)
            rendered_key = f"{exposed_path} {rendered_principal}"
            if rendered_key in rendered_acl_keys:
                continue
            rendered_acl_keys.add(rendered_key)
            clients.append({
                "clients": ganesha_clients(principal),
                "access": ganesha_access(permission, truth(export_config, "readOnly", False)),
                "squash": ganesha_squash(all_squash, truth(acl_config, "rootSquash", truth(export_config, "rootSquash", True))),
                "anonUid": anon_uid,
                "anonGid": anon_gid,
            })
        if not clients:
            anon_uid = int_config(export_config, "anonUid")
            anon_gid = int_config(export_config, "anonGid")
            clients.append({
                "clients": "*",
                "access": ganesha_access("READ_WRITE", truth(export_config, "readOnly", False)),
                "squash": ganesha_squash(truth(export_config, "allSquash", False), truth(export_config, "rootSquash", True)),
                "anonUid": anon_uid,
                "anonGid": anon_gid,
                "implicit": True,
            })
        rendered_export = {
            "uuid": uuid,
            "name": export.get("name"),
            "path": exposed_path,
            "pseudo": f"/{root_name}",
            "filesystemId": nested_export_filesystem_id(uuid) if export_config.get("relativeSharePath") else None,
            "protocolMode": service_protocol_mode,
            "anonUid": int_config(export_config, "anonUid"),
            "anonGid": int_config(export_config, "anonGid"),
            "clients": clients,
        }
        for listener_ip in nfs_export_endpoint_ips(export_config,default_listen_ip):
            listener_ip=str(ipaddress.IPv4Address(listener_ip))
            for listener_port in nfs_export_listener_ports(export_config, default_port, service_protocol_mode):
                endpoint_exports.setdefault((listener_ip, int(listener_port)), []).append(dict(rendered_export))
        if export.get("quotaBytes") is not None:
            quota_state[uuid] = {
                "path": path,
                "exportPath": exposed_path,
                "quotaBytes": export.get("quotaBytes"),
                "filesystem": export.get("filesystem"),
            }
    with open(export_file, "w", encoding="utf-8"):
        pass

if service_protocol_mode == "V3V4_DUAL":
    collapsed_exports = []
    seen_exports = set()
    for exports in endpoint_exports.values():
        for export in exports:
            export_key = export.get("uuid") or export.get("name") or export.get("pseudo")
            if export_key in seen_exports:
                continue
            seen_exports.add(export_key)
            export["protocolMode"] = "V3V4_DUAL"
            collapsed_exports.append(export)
    endpoint_exports = {("0.0.0.0", 2049): collapsed_exports} if collapsed_exports else {}

cleanup_legacy_kernel_exports(managed_files)

with open(os.path.join(quota_dir, "nfs-quotas.json"), "w", encoding="utf-8") as quota_fp:
    json.dump(quota_state, quota_fp, sort_keys=True, indent=2)

for uuid, old_alias in alias_state.items():
    if uuid in next_alias_state:
        continue
    alias_path = old_alias.get("aliasPath") if isinstance(old_alias, dict) else None
    if alias_path and alias_path not in ("/", "/export") and alias_path.startswith("/") and is_mountpoint(alias_path):
        run(["umount", alias_path])
    update_fstab(f"ablestack-storage:{uuid}:alias")

with open(alias_state_path, "w", encoding="utf-8") as alias_fp:
    json.dump(next_alias_state, alias_fp, sort_keys=True, indent=2)

for (listen_ip,listen_port) in endpoint_exports:
    if listen_ip=="0.0.0.0" and any(ip!="0.0.0.0" and port==listen_port for ip,port in endpoint_exports):
        raise ValueError("NFS wildcard and selected endpoints overlap; explicit drain/rebind is required")
configs = write_ganesha_configs(endpoint_exports, default_port)
needs_rpcbind = any(mode == "V3V4_DUAL" for _, _, _, _, mode in configs)
runtime_endpoints = start_ganesha_endpoints(configs if enabled else [])
runtime_probe_failures = probe_nfs_export_visibility(runtime_endpoints, endpoint_exports if enabled else {})
if runtime_probe_failures:
    details = []
    for endpoint in runtime_probe_failures:
        listen_ip = endpoint.get("listenIp") or "unknown"
        port = endpoint.get("port") or "unknown"
        for export in endpoint.get("probeResults", []):
            for probe in export.get("probes", []):
                if not probe.get("success"):
                    target = probe.get("target") or "unknown"
                    details.append(f"{listen_ip}:{port} {export.get('exportName') or 'export'} {probe.get('mode') or 'probe'} -> {target}: {probe.get('error') or 'probe failed'}")
    raise RuntimeError("nfs-ganesha export visibility probe failed: " + "; ".join(details))
runtime_ready = (not enabled) or not configs or all(item.get("listening") and item.get("probeSuccess", True) for item in runtime_endpoints)

print(json.dumps({
    "success": True,
    "exports": len(payload.get("exports", [])),
    "endpoints": len(configs),
    "quotas": len(quota_state),
    "runtimeReady": runtime_ready,
    "runtimeEndpoints": runtime_endpoints,
    "runtimeProbeSuccess": all(
        export.get("success") is True
        for endpoint in runtime_endpoints for export in endpoint.get("probeResults", [])
    ),
    "runtimeProbeFailures": runtime_probe_failures,
    "runtimeProbePending": [
        export for endpoint in runtime_endpoints for export in endpoint.get("probeResults", [])
        if export.get("success") is None
    ],
    "rpcbindRequired": needs_rpcbind,
    "rpcbindActive": rpcbind_active(),
    "listenPorts": {str(item.get("listenIp")): int(item.get("port") or default_port) for item in runtime_endpoints},
}, sort_keys=True))
PY

  persist_nfs_desired_state "$payload_file"

  local nfs_port
  nfs_port="$(python3 - "$payload_file" <<'PY'
import json
import sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as payload_fp:
        print(int(json.load(payload_fp).get("port") or 2049))
except Exception:
    print(2049)
PY
)"
  local rpcbind_required
  rpcbind_required="$(python3 - "$payload_file" <<'PY'
import json
import sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as payload_fp:
        payload = json.load(payload_fp)
    value = str(payload.get("protocolMode") or payload.get("protocolmode") or "V4_ONLY").strip().upper()
    print("1" if value == "V3V4_DUAL" else "0")
except Exception:
    print("0")
PY
)"
  open_tcp_firewall_port "$nfs_port"
  if [[ "$rpcbind_required" == "1" ]]; then
    open_tcp_firewall_port "111"
    open_udp_firewall_port "111"
  fi
}

ganesha_feature_capabilities() {
  python3 - <<'PYGANESHAFEATURES'
# Licensed to the Apache Software Foundation (ASF) under one
# or more contributor license agreements. See the NOTICE file
