import json
import re
import shutil
import subprocess
import sys
from pathlib import Path
request = json.loads(Path(sys.argv[1]).read_text())
mode = str(request.get("idMappingMode") or "NAME_DOMAIN").upper()
binary = shutil.which("ganesha.nfsd")
version = ""
supported = mode in ("NAME_DOMAIN", "NUMERIC") and bool(binary)
if binary:
    result = subprocess.run([binary, "-v"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
    version = (result.stdout or "") + (result.stderr or "")
    number = re.search(r"\b[Vv]?(\d+)\.(\d+)", version)
