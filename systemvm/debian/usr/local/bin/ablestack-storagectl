    ;;
  smb)
    if [[ "$subcommand" == "identity" && ( "$action" == "current-review" || "$action" == "current-quiesce" || "$action" == "current-export" || "$action" == "current-retain" || "$action" == "current-verify" ) ]]; then
      identity_capsule_command "$action" "$payload"
