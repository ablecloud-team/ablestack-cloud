runtime_endpoints = reconcile_smb_endpoint_units(listener_rows)
fd, managed_temporary = tempfile.mkstemp(prefix=".smb-identities-", dir=state_dir)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as managed_fp:
