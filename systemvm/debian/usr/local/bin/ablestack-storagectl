# Embedded Python programs use stdin for their script. A sealed memfd makes the separate
# payload readable by all native stages without plaintext files or secret-bearing arguments.
if [[ "$command" != "identity" && !( "$command" == "smb" && "$subcommand" == "identity" && ( "$action" == "local-source-status" || "$action" == "current-review" || "$action" == "current-quiesce" || "$action" == "current-export" || "$action" == "current-retain" || "$action" == "current-verify" ) ) && "${@: -1}" == "/dev/stdin" ]]; then
  materialize_stdin_payload_in_memory "$@"
  exit $?
fi

