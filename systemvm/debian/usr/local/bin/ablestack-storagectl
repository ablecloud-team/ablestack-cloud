set -euo pipefail

LOG_FILE="/var/log/ablestack-storagectl.log"
MONITOR_CACHE_DIR="${ABLESTACK_STORAGE_MONITOR_CACHE_DIR:-/run/ablestack-storage/monitor}"
DESIRED_STATE_DIR="${ABLESTACK_STORAGE_DESIRED_STATE_DIR:-/etc/ablestack-storage/desired-state}"
NFS_DESIRED_STATE_FILE="${ABLESTACK_STORAGE_NFS_DESIRED_STATE_FILE:-${DESIRED_STATE_DIR}/nfs-export-apply.json}"
SMB_DESIRED_STATE_FILE="${ABLESTACK_STORAGE_SMB_DESIRED_STATE_FILE:-${DESIRED_STATE_DIR}/smb-share-apply.json}"

materialize_stdin_payload_in_memory() {
  python3 - "$0" "$@" 3<&0 <<'PYMEMFD'
import os
import sys
import fcntl
import subprocess
with os.fdopen(3, "rb") as source:
    payload = source.read(8 * 1024 * 1024 + 1)
if not payload or len(payload) > 8 * 1024 * 1024:
    raise SystemExit("Storage Service stdin payload is empty or exceeds its limit")
fd = os.memfd_create("ablestack-storage-payload", os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
try:
    os.fchmod(fd, 0o600)
    os.write(fd, payload)
    os.lseek(fd, 0, os.SEEK_SET)
    fcntl.fcntl(fd, fcntl.F_ADD_SEALS, fcntl.F_SEAL_WRITE | fcntl.F_SEAL_GROW | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_SEAL)
    arguments = [value if value != "/dev/stdin" else f"/proc/self/fd/{fd}" for value in sys.argv[2:]]
    inherited = (9,) if os.environ.get("ABLESTACK_STORAGE_WRITER_LOCK_FD") == "9" else ()
    result = subprocess.run([sys.argv[1], *arguments], pass_fds=(fd, *inherited))
    raise SystemExit(result.returncode)
finally:
    os.close(fd)
PYMEMFD
}

acquire_storage_writer_lock() {
  local lock_file="${ABLESTACK_STORAGE_WRITER_LOCK_FILE:-/run/ablestack-storage/desired-writer.lock}"
  local lock_dir
  lock_dir="$(dirname -- "$lock_file")"
  if [[ -L "$lock_dir" || -L "$lock_file" ]]; then
    printf '%s\n' '{"success":false,"errorCode":"STORAGE_WRITER_LOCK_INVALID"}'
    return 2
  fi
  mkdir -p -- "$lock_dir"
  if [[ "$(stat -c %u -- "$lock_dir")" != "$(id -u)" ]] || (( (8#$(stat -c %a -- "$lock_dir") & 8#022) != 0 )); then
    printf '%s\n' '{"success":false,"errorCode":"STORAGE_WRITER_LOCK_INVALID"}'
    return 2
  fi
  if [[ ! -e "$lock_file" ]]; then
    (umask 077; set -C; : > "$lock_file") 2>/dev/null || true
  fi
  if [[ ! -f "$lock_file" || -L "$lock_file" || "$(stat -c %u -- "$lock_file")" != "$(id -u)" || "$(stat -c %a -- "$lock_file")" != "600" ]]; then
    printf '%s\n' '{"success":false,"errorCode":"STORAGE_WRITER_LOCK_INVALID"}'
    return 2
  fi
  if [[ "${ABLESTACK_STORAGE_WRITER_LOCK_FD:-}" == "9" ]]; then
    if [[ "$(readlink -f /proc/$$/fd/9 2>/dev/null || true)" != "$(readlink -f -- "$lock_file")" ]]; then
      printf '%s\n' '{"success":false,"errorCode":"STORAGE_WRITER_LOCK_INVALID"}'
      return 2
    fi
  else
    exec 9>>"$lock_file"
  fi
  if ! flock -n 9; then
    printf '%s\n' '{"success":false,"errorCode":"STORAGE_WRITER_BUSY"}'
    return 75
  fi
  export ABLESTACK_STORAGE_WRITER_LOCK_FILE="$lock_file" ABLESTACK_STORAGE_WRITER_LOCK_FD=9
}

json_escape() {
  local value="${1:-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

emit_success() {
  local message="$1"
  printf '{"success":true,"message":"%s"}\n' "$(json_escape "$message")"
}

emit_error() {
  local message="$1"
  printf '{"success":false,"message":"%s"}\n' "$(json_escape "$message")" >&2
}

log_command() {
  mkdir -p "$(dirname "$LOG_FILE")"
  printf '%s command=%s payload=%s\n' "$(date -Is)" "${1:-}" "${2:-}" >> "$LOG_FILE"
}

persist_nfs_desired_state() {
  if [[ "${ABLESTACK_STORAGE_ROOT_SOURCE_REPLAY:-}" == "1" ]]; then return 0; fi
  local payload_file="$1"
  local tmp
  if [[ -z "$payload_file" || ! -r "$payload_file" ]]; then
    return
  fi
  mkdir -p "$DESIRED_STATE_DIR"
  tmp="$(mktemp "${DESIRED_STATE_DIR}/.nfs-export-apply.XXXXXX")"
  cp "$payload_file" "$tmp"
  chmod 0600 "$tmp"
  mv "$tmp" "$NFS_DESIRED_STATE_FILE"
}

persist_smb_desired_state() {
  if [[ "${ABLESTACK_STORAGE_ROOT_SOURCE_REPLAY:-}" == "1" ]]; then return 0; fi
  local payload_file="$1"
  local tmp
  if [[ -z "$payload_file" || ! -r "$payload_file" ]]; then
    return
  fi
  mkdir -p "$DESIRED_STATE_DIR"
  tmp="$(mktemp "${DESIRED_STATE_DIR}/.smb-share-apply.XXXXXX")"
  python3 - "$payload_file" "$tmp" <<'PY'
import json
import sys

source, target = sys.argv[1], sys.argv[2]
with open(source, "r", encoding="utf-8") as source_fp:
    payload = json.load(source_fp)
for share in payload.get("shares", []):
    for acl in share.get("acls", []):
        acl.pop("password", None)
if "password" in payload:
    payload.pop("password", None)
with open(target, "w", encoding="utf-8") as target_fp:
    json.dump(payload, target_fp, sort_keys=True, indent=2)
    target_fp.write("\n")
PY
  chmod 0600 "$tmp"
  mv "$tmp" "$SMB_DESIRED_STATE_FILE"
}

open_tcp_firewall_port() {
  local port="$1"
  if [[ -z "$port" ]]; then
    return
  fi
  if command -v firewall-cmd >/dev/null 2>&1; then
    firewall-cmd --add-port="${port}/tcp" >/dev/null 2>&1 || true
    firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null 2>&1 || true
  fi
  if command -v iptables >/dev/null 2>&1; then
    iptables -C INPUT -p tcp --dport "$port" -j ACCEPT >/dev/null 2>&1 || \
    iptables -I INPUT -p tcp --dport "$port" -j ACCEPT >/dev/null 2>&1 || true
  fi
}

open_udp_firewall_port() {
  local port="$1"
  if [[ -z "$port" ]]; then
    return
  fi
  if command -v firewall-cmd >/dev/null 2>&1; then
    firewall-cmd --add-port="${port}/udp" >/dev/null 2>&1 || true
    firewall-cmd --permanent --add-port="${port}/udp" >/dev/null 2>&1 || true
  fi
  if command -v iptables >/dev/null 2>&1; then
    iptables -C INPUT -p udp --dport "$port" -j ACCEPT >/dev/null 2>&1 || \
      iptables -I INPUT -p udp --dport "$port" -j ACCEPT >/dev/null 2>&1 || true
  fi
}

emit_cached_runtime() {
  local scope="$1"
  local payload_file="${2:-}"
  if [[ "${ABLESTACK_STORAGECTL_CACHE:-1}" == "0" ]]; then
    return 1
  fi
  python3 - "$MONITOR_CACHE_DIR" "$scope" "$payload_file" <<'PY'
import json
import os
import sys
import time

cache_dir, scope = sys.argv[1], sys.argv[2]
payload_file = sys.argv[3] if len(sys.argv) > 3 else ""
path = os.path.join(cache_dir, scope + ".json")

def load_payload(path):
    if not path:
        return {}
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return {}

def matches(session, payload):
    protocol = str(payload.get("protocol") or "").upper()
    client = str(payload.get("client") or "").strip()
    state = str(payload.get("state") or "").upper()
    resource_id = str(payload.get("resourceId") or "").strip()
    if protocol and str(session.get("protocol") or "").upper() != protocol:
        return False
    if client and client not in str(session.get("peer") or "") and client not in str(session.get("client") or ""):
        return False
    if state and str(session.get("state") or "").upper() != state:
        return False
    if resource_id and resource_id not in (str(session.get("resourceId") or ""), str(session.get("resourceName") or "")):
        return False
    return True

try:
    with open(path, "r", encoding="utf-8") as handle:
        cached = json.load(handle)
except Exception:
    sys.exit(1)

generated = float(cached.get("generatedEpoch") or 0)
stale_after = int(cached.get("staleAfterSeconds") or 15)
if generated <= 0 or time.time() - generated > stale_after:
    sys.exit(1)

cached["cached"] = True
if scope in ("health", "inventory"):
    # Reuse the monitor's independent filesystem collector; never run df here.
    capacity = load_payload(os.path.join(cache_dir, "capacity.json"))
    if isinstance(capacity, dict) and capacity.get("success") is True:
        cached["capacitySnapshot"] = capacity
if scope == "sessions":
    payload = load_payload(payload_file)
    sessions = [session for session in cached.get("sessions", []) if matches(session, payload)]
    cached["sessions"] = sessions
    cached["count"] = len(sessions)
print(json.dumps(cached, sort_keys=True))
PY
}


network_endpoint_apply() {
  local payload_file="${1:-}"
  if [[ -z "$payload_file" || ( ! -r "$payload_file" && "${3:-}" != "reconcile" ) ]]; then
    emit_error "A readable payload file is required for network endpoint apply."
    exit 2
  fi
  python3 - "$payload_file" "${2:-}" "${3:-}" <<'PY'
import ipaddress
import hashlib
import stat
import tempfile
import json
import os
import re
import subprocess
import sys

STATE_PATH = "/etc/ablestack-storage/network-endpoints.json"
BINDING_RECEIPT_PATH = "/var/lib/ablestack-storage/network-endpoint-bindings.json"
STATIC_NETWORK_STATE_PATH = "/etc/ablestack-storage/sharedfs-network.json"
payload_path = sys.argv[1]
binding_path = sys.argv[2] if len(sys.argv) > 2 else ""
reconcile_mode = len(sys.argv) > 3 and sys.argv[3] == "reconcile"
inspect_mode = len(sys.argv) > 3 and sys.argv[3] == "inspect"
strict_bindings = None

def run(args):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return default

def write_state(entries):
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump({"endpoints": entries}, handle, sort_keys=True)
        handle.write("\n")
    os.replace(tmp, STATE_PATH)

def normalize_payload(payload):
    if isinstance(payload, dict):
        entries = []
        if isinstance(payload.get("endpoints"), list):
            entries.extend(payload.get("endpoints") or [])
        if isinstance(payload.get("listeners"), list):
            entries.extend(payload.get("listeners") or [])
        if isinstance(payload.get("endpointAliases"), list):
            entries.extend(payload.get("endpointAliases") or [])
        if entries:
            return entries
        if payload.get("listenIp") or payload.get("listenip"):
            return [payload]
        return []
    if isinstance(payload, list):
        return payload
    return []

def netmask_to_prefix(netmask):
    if not netmask:
        return None
    try:
        return ipaddress.IPv4Network("0.0.0.0/" + str(netmask), strict=False).prefixlen
    except Exception:
        return None

def cidr_to_prefix(cidr):
    if not cidr:
        return None
    try:
        return ipaddress.IPv4Network(str(cidr), strict=False).prefixlen
    except Exception:
        return None

def requested_prefix(entry):
    for key in ("prefixlen", "prefixLen"):
        value = entry.get(key)
        if value not in (None, ""):
            try:
                prefix = int(value)
                if 0 <= prefix <= 32:
                    return prefix
            except Exception:
                pass
    prefix = cidr_to_prefix(entry.get("networkCidr") or entry.get("cidr"))
    if prefix is not None:
        return prefix
    prefix = netmask_to_prefix(entry.get("netmask"))
    return prefix if prefix is not None else 24

def interface_addresses():
    result = run(["ip", "-j", "-4", "addr", "show", "scope", "global"])
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "failed to inspect IPv4 addresses")
    return json.loads(result.stdout or "[]")

def interface_links():
    result = run(["ip", "-j", "link", "show"])
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "failed to inspect network links")
    return json.loads(result.stdout or "[]")

def find_existing_iface(listen_ip, links):
    for link in links:
        for addr in link.get("addr_info") or []:
            if addr.get("local") == listen_ip:
                return link.get("ifname"), int(addr.get("prefixlen") or 24)
    return None, None

def find_target_iface(entry, links):
    primary_ip = str(entry.get("primaryIp") or "").strip()
    requested_prefix_value = requested_prefix(entry)
    if primary_ip:
        for link in links:
            for addr in link.get("addr_info") or []:
                if addr.get("local") == primary_ip:
                    return link.get("ifname"), int(addr.get("prefixlen") or requested_prefix_value)
    listen_ip = ipaddress.IPv4Address(str(entry.get("listenIp")))
    for link in links:
        for addr in link.get("addr_info") or []:
            local = addr.get("local")
            prefix = int(addr.get("prefixlen") or requested_prefix_value)
            if not local:
                continue
            try:
                network = ipaddress.IPv4Interface(f"{local}/{prefix}").network
            except Exception:
                continue
            if listen_ip in network:
                return link.get("ifname"), prefix
    candidates = []
    for link in interface_links():
        ifname = str(link.get("ifname") or "")
        if not ifname or ifname == "lo":
            continue
        if link.get("link_type") not in (None, "ether"):
            continue
        candidates.append(ifname)
    if len(candidates) == 1:
        return candidates[0], requested_prefix_value
    return None, requested_prefix_value

def root_binding_targets(expected, requested):
    if not isinstance(expected, list):
        raise ValueError("ROOT expectedBindings must be an array")
    targets = {}
    links = interface_links()
    addresses = interface_addresses()
    for item in expected:
        if not isinstance(item, dict):
            raise ValueError("ROOT endpoint binding is invalid")
        ip = str(ipaddress.IPv4Address(item["listenIp"]))
        primary = str(ipaddress.IPv4Address(item["primaryIp"]))
        mac = str(item["macAddress"]).lower()
        prefix = item["prefixlen"]
        if not re.fullmatch(r"(?:[0-9a-f]{2}:){5}[0-9a-f]{2}", mac) or isinstance(prefix, bool) or not isinstance(prefix, int) or not 0 <= prefix <= 32:
            raise ValueError("ROOT endpoint MAC or prefix is invalid")
        matching = [link for link in links if str(link.get("address") or "").lower() == mac]
        if len(matching) != 1 or not matching[0].get("ifname"):
            raise ValueError("ROOT endpoint MAC is missing or ambiguous")
        iface = matching[0]["ifname"]
        primary_owners = [link["ifname"] for link in addresses for address in link.get("addr_info", []) if address.get("local") == primary]
        if primary_owners != [iface]:
            raise ValueError("ROOT endpoint primary IP does not belong to its pinned MAC")
        validate_endpoint_primary(primary,iface,addresses)
        owners = [(link["ifname"], int(address.get("prefixlen", -1))) for link in addresses
                  for address in link.get("addr_info", []) if address.get("local") == ip]
        if owners and owners != [(iface, prefix)]:
            raise ValueError("ROOT endpoint IP is bound to a foreign MAC or prefix")
        target = {"listenIp": ip, "primaryIp": primary, "macAddress": mac, "interface": iface, "prefixlen": prefix}
        if ip in targets and targets[ip] != target:
            raise ValueError("ROOT endpoint binding is ambiguous")
        targets[ip] = target
    required = {str(entry.get("listenIp") or entry.get("listenip") or "").strip() for entry in requested}
    required -= {"", "0.0.0.0", "::"}
    if not required.issubset(targets):
        raise ValueError("Cached ROOT endpoint has no pinned NIC binding")
    return targets


def verify_root_binding(ip, target):
    links = interface_links()
    actual = [link for link in links if link.get("ifname") == target["interface"]]
    if len(actual) != 1 or str(actual[0].get("address") or "").lower() != target["macAddress"]:
        raise ValueError("ROOT endpoint interface MAC changed during replay")
    owners = [(link["ifname"], int(address.get("prefixlen", -1))) for link in interface_addresses()
              for address in link.get("addr_info", []) if address.get("local") == ip]
    if owners != [(target["interface"], target["prefixlen"])]:
        raise ValueError("ROOT endpoint actual IP binding differs from its pinned topology")
    return {"listenIp": ip, "interface": target["interface"], "prefixlen": target["prefixlen"],
            "macAddress": target["macAddress"], "active": True}

def protected_network_bytes(path):
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return None
    directory = os.path.dirname(path)
    parent = os.lstat(directory)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022 or info.st_size > 1024 * 1024 or not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.geteuid() or parent.st_mode & 0o022:
        raise ValueError("ROOT endpoint binding file or directory is not protected")
    parent_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        opened_parent = os.fstat(parent_fd)
        if (opened_parent.st_dev, opened_parent.st_ino, opened_parent.st_uid, opened_parent.st_mode) != (parent.st_dev, parent.st_ino, parent.st_uid, parent.st_mode):
            raise ValueError("ROOT endpoint binding directory changed")
        descriptor = os.open(os.path.basename(path), os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent_fd)
    finally:
        os.close(parent_fd)
    try:
        opened = os.fstat(descriptor)
        attributes = ("st_dev", "st_ino", "st_uid", "st_gid", "st_mode", "st_size", "st_mtime_ns", "st_ctime_ns")
        if tuple(getattr(opened, key) for key in attributes) != tuple(getattr(info, key) for key in attributes):
            raise ValueError("ROOT endpoint binding file changed while opening")
        with os.fdopen(descriptor, "rb", closefd=False) as handle:
            content = handle.read(1024 * 1024 + 1)
        after = os.fstat(descriptor)
        if len(content) > 1024 * 1024 or tuple(getattr(after, key) for key in attributes) != tuple(getattr(opened, key) for key in attributes):
            raise ValueError("ROOT endpoint binding file changed while reading")
        return content
    finally:
        os.close(descriptor)


def validate_endpoint_primary(primary,iface,addresses):
    if not primary:return
    observed=[(link.get("ifname"),address) for link in addresses for address in link.get("addr_info",[]) if address.get("local")==primary]
    if len(observed)!=1 or observed[0][0]!=iface:raise ValueError("Endpoint primary IP does not belong to its selected interface")
    if observed[0][1].get("secondary") is True:raise ValueError("Endpoint primary IP is a secondary alias")
    content=protected_network_bytes(STATIC_NETWORK_STATE_PATH)
    if content is not None:
        declared=json.loads(content)
        mac=str(declared.get("macAddress") or "").lower()
        matches=[link for link in interface_links() if link.get("ifname")==iface]
        if len(matches)!=1:raise ValueError("Endpoint primary interface identity is ambiguous")
        if mac and str(matches[0].get("address") or "").lower()==mac and primary!=str(declared.get("ipAddress") or ""):
            raise ValueError("Endpoint primary IP differs from its protected STATIC declaration")


def read_binding_receipt():
    content = protected_network_bytes(BINDING_RECEIPT_PATH)
    return json.loads(content) if content is not None else None


def network_desired_proof():
    content = protected_network_bytes(STATE_PATH)
    if content is None:
        return False, None
    value = json.loads(content)
    if not isinstance(value, dict) or not isinstance(value.get("endpoints"), list):
        raise ValueError("ROOT endpoint desired cache is malformed")
    return True, hashlib.sha256(content).hexdigest()


def verify_binding_receipt(expected, proofs):
    receipt = read_binding_receipt()
    present, checksum = network_desired_proof()
    if (not receipt or receipt.get("schemaVersion") != 1 or receipt.get("desiredPresent") != present
            or receipt.get("desiredStateSha256") != checksum or receipt.get("expectedBindings") != expected
            or receipt.get("observedBindings") != proofs):
        raise ValueError("ROOT endpoint binding receipt readback differs from the exact desired/observed scope")
    return {"bindingReceiptVerified": True, "bindingReceiptDesiredStateSha256": receipt["desiredStateSha256"],
            "desiredStateSha256": checksum, "bindingReceiptDesiredStatePresent": present, "desiredStatePresent": present}


def write_binding_receipt(expected, proofs):
    directory = os.path.dirname(BINDING_RECEIPT_PATH)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    info = os.lstat(directory)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
        raise ValueError("ROOT endpoint binding receipt directory is not protected")
    present, checksum = network_desired_proof()
    if not present and (expected or proofs):
        raise ValueError("Nonempty ROOT endpoint bindings require a desired cache")
    record = {"schemaVersion": 1, "desiredPresent": present, "desiredStateSha256": checksum, "expectedBindings": expected, "observedBindings": proofs}
    fd, temporary = tempfile.mkstemp(prefix=".network-bindings-", dir=directory)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(record, handle, sort_keys=True);handle.flush();os.fsync(handle.fileno())
        os.replace(temporary, BINDING_RECEIPT_PATH)
        parent_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return verify_binding_receipt(expected, proofs)


def observed_binding_expectations(entries):
    links = interface_links()
    addresses = interface_addresses()
    result = []
    for entry in entries:
        ip = str(entry.get("listenIp") or entry.get("listenip") or "").strip()
        if not ip or ip in ("0.0.0.0", "::"):
            continue
        owners = [(link, addr) for link in addresses for addr in link.get("addr_info", []) if addr.get("local") == ip]
        if len(owners) != 1:
            raise ValueError("Managed endpoint address ownership is ambiguous")
        owner, address = owners[0]
        matches = [link for link in links if link.get("ifname") == owner["ifname"]]
        if len(matches) != 1:
            raise ValueError("Managed endpoint link ownership is ambiguous")
        primary = str(entry.get("primaryIp") or "").strip()
        if not primary:
            candidates = [addr["local"] for addr in owner.get("addr_info", []) if not addr.get("secondary")]
            if len(candidates) != 1:
                raise ValueError("Managed endpoint primary IP is unavailable")
            primary = candidates[0]
        result.append({"listenIp": ip, "macAddress": matches[0].get("address"), "primaryIp": primary,
                       "prefixlen": int(address["prefixlen"])})
    root_binding_targets(result, entries)
    return result

def apply_one(entry):
    listen_ip = str(entry.get("listenIp") or entry.get("listenip") or "").strip()
    if not listen_ip or listen_ip in ("0.0.0.0", "::"):
        return None
    ipaddress.IPv4Address(listen_ip)
    links = interface_addresses()
    if strict_bindings is not None:
        target = strict_bindings[listen_ip]
        existing, _ = find_existing_iface(listen_ip, links)
        if not existing:
            result = run(["ip", "link", "set", target["interface"], "up"])
            if result.returncode:
                raise RuntimeError("ROOT endpoint interface activation failed")
            result = run(["ip", "addr", "add", listen_ip + "/" + str(target["prefixlen"]), "dev", target["interface"]])
            if result.returncode and "File exists" not in (result.stderr or ""):
                raise RuntimeError("ROOT endpoint address replay failed")
        verified = verify_root_binding(listen_ip, target)
        verified["changed"] = not bool(existing)
        return verified
    iface, prefix = find_existing_iface(listen_ip, links)
    primary=str(entry.get("primaryIp") or "").strip()
    if iface:
        validate_endpoint_primary(primary,iface,links)
        return {"listenIp": listen_ip, "interface": iface, "prefixlen": prefix, "active": True, "changed": False}
    iface, prefix = find_target_iface({**entry, "listenIp": listen_ip}, links)
    if not iface:
        raise RuntimeError(f"No System VM interface can host Storage Service listen IP {listen_ip}")
    validate_endpoint_primary(primary,iface,links)
    link_result = run(["ip", "link", "set", iface, "up"])
    if link_result.returncode != 0:
        raise RuntimeError(link_result.stderr.strip() or f"failed to bring up {iface}")
    result = run(["ip", "addr", "add", f"{listen_ip}/{prefix}", "dev", iface])
    if result.returncode != 0 and "File exists" not in (result.stderr or ""):
        raise RuntimeError(result.stderr.strip() or f"failed to add {listen_ip}/{prefix} to {iface}")
    links = interface_addresses()
    verify_iface, verify_prefix = find_existing_iface(listen_ip, links)
    if not verify_iface:
        raise RuntimeError(f"Storage Service listen IP {listen_ip} was not active after ip addr add")
    return {"listenIp": listen_ip, "interface": verify_iface, "prefixlen": verify_prefix, "active": True, "changed": result.returncode == 0}

payload = load_json(payload_path, {})
requested = [entry for entry in normalize_payload(payload) if isinstance(entry, dict)]
expected = None
if binding_path:
    with open(binding_path, encoding="utf-8") as handle:
        binding_request = json.load(handle)
    if "expectedBindings" in binding_request:
        expected = binding_request["expectedBindings"]
receipt = read_binding_receipt()
if expected is None and payload_path == STATE_PATH and receipt is not None:
    present = os.path.isfile(STATE_PATH)
    checksum = None
    if present:
        with open(STATE_PATH, "rb") as handle:
            checksum = hashlib.sha256(handle.read()).hexdigest()
    if receipt.get("schemaVersion") != 1 or receipt.get("desiredPresent", True) != present or receipt.get("desiredStateSha256") != checksum:
        raise ValueError("ROOT endpoint binding receipt does not match its desired cache")
    expected = receipt["expectedBindings"]
if expected and not os.path.isfile(STATE_PATH) and not inspect_mode:
    raise ValueError("Nonempty ROOT endpoint bindings require a desired cache")
if reconcile_mode and not os.path.isfile(STATE_PATH) and expected is None and receipt is None:
    expected = []
if expected is not None:
    strict_bindings = root_binding_targets(expected, requested)
    expected = [{key: target[key] for key in ("listenIp", "macAddress", "primaryIp", "prefixlen")}
                for ip, target in sorted(strict_bindings.items())]
if inspect_mode:
    if expected is None: raise ValueError("Pure endpoint inspection requires exact expected MAC bindings")
    addresses = interface_addresses()
    rows = []
    for ip, target in sorted(strict_bindings.items()):
        actual_iface, actual_prefix = find_existing_iface(ip, addresses)
        rows.append({**{key: target[key] for key in ("listenIp", "macAddress", "primaryIp", "prefixlen", "interface")},
                     "active": actual_iface == target["interface"] and actual_prefix == target["prefixlen"]})
    print(json.dumps({"success": True, "sideEffects": False, "bindingsValidated": True, "endpoints": rows}, sort_keys=True))
    raise SystemExit(0)

state = load_json(STATE_PATH, {"endpoints": []})
merged = {str(entry.get("listenIp") or entry.get("listenip") or "").strip(): entry for entry in state.get("endpoints", []) if isinstance(entry, dict)}
results = []
receipt_proof = {}
for entry in requested:
    result = apply_one(entry)
    if not result:
        continue
    merged[result["listenIp"]] = {**entry, "listenIp": result["listenIp"], "prefixlen": result["prefixlen"]}
    results.append(result)
if strict_bindings is None:
    # Validate the complete candidate binding set before replacing the cached
    # desired state. A bad historical primary must not create another bad
    # receipt or partially replace the canonical cache.
    if receipt is not None:expected = observed_binding_expectations(list(merged.values()))
    write_state(list(merged.values()))
    if receipt is not None:
        receipt_proof = write_binding_receipt(expected, results)
else:
    receipt_proof = write_binding_receipt(expected, results)
print(json.dumps({"success": True, "status": "ok", "endpoints": results, "count": len(results), **receipt_proof}, sort_keys=True))
PY
}

network_endpoints_reconcile() {
  local state="/etc/ablestack-storage/network-endpoints.json"
  network_endpoint_apply "$state" "${1:-}" "reconcile"
}

runtime_health() {
  emit_cached_runtime "health" && return 0
  python3 - <<'PY'
import glob
import json
import os
import re
import shutil
import socket
import subprocess
import time

def run(args):
    try:
        return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=5)
    except Exception as exc:
        return type("Result", (), {"returncode": 1, "stdout": "", "stderr": str(exc)})()

def service_state(name):
    if not shutil.which("systemctl"):
        return "unknown"
    result = run(["systemctl", "is-active", name])
    return result.stdout.strip() or "unknown"

def first_service_state(*names):
    for name in names:
        state = service_state(name)
        if state not in ("unknown", "inactive", "failed"):
            return state
    return service_state(names[0]) if names else "unknown"

def command_present(name):
    return shutil.which(name) is not None

def port_listening(port):
    if not shutil.which("ss"):
        return False
    result = run(["ss", "-H", "-lnt"])
    suffix = ":" + str(port)
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[3].endswith(suffix):
            return True
    return False

def endpoint_listening(ip, port, timeout=1.0):
    deadline = time.time() + max(timeout, 0.5)
    last_error = ""
    candidate_ip = str(ip or "127.0.0.1").strip()
    if candidate_ip in ("0.0.0.0", "::"):
        candidate_ip = "127.0.0.1"
    while time.time() < deadline:
        try:
            with socket.create_connection((candidate_ip, int(port)), timeout=1.0):
                return True, ""
        except Exception as exc:
            last_error = str(exc)
            time.sleep(0.25)
    return False, last_error

def nfs_protocol_mode_from_content(content):
    if not content:
        return "V4_ONLY"
    for match in re.finditer(r"Protocols\s*=\s*([^;]+);", content, re.I):
        value = re.sub(r"\s+", "", match.group(1))
        if "3" in value and "4" in value:
            return "V3V4_DUAL"
        if value == "4":
            return "V4_ONLY"
    return "V4_ONLY"

def rpcbind_active():
    if not shutil.which("systemctl"):
        return False
    for unit in ("rpcbind.socket", "rpcbind.service"):
        try:
            result = subprocess.run(["systemctl", "is-active", "--quiet", unit],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if result.returncode == 0:
                return True
        except Exception:
            continue
    return False

def collect_ganesha_runtime():
    runtime_dir = "/run/ablestack-storage/ganesha"
    endpoints = []
    for conf_path in sorted(glob.glob("/etc/ganesha/ablestack-storage/*.conf")):
        item = {"file": os.path.basename(conf_path), "listening": False, "processRunning": False}
        try:
            with open(conf_path, "r", encoding="utf-8") as fp:
                content = fp.read()
            listen_ip = ""
            listen_port = 2049
            for line in content.splitlines():
                stripped = line.strip()
                if stripped.startswith("Bind_addr"):
                    listen_ip = stripped.split("=", 1)[1].strip().rstrip(";").strip('"')
                elif stripped.startswith("NFS_Port"):
                    try:
                        listen_port = int(stripped.split("=", 1)[1].strip().rstrip(";"))
                    except Exception:
                        listen_port = 2049
            protocol_mode = nfs_protocol_mode_from_content(content)
            numeric = bool(re.search(r"Only_Numeric_Owners\s*=\s*true\s*;", content, re.IGNORECASE))
            item["idMappingMode"] = "NUMERIC" if numeric else "NAME_DOMAIN"
            key = os.path.splitext(os.path.basename(conf_path))[0]
            pid_path = os.path.join(runtime_dir, f"{key}.pid")
            log_path = os.path.join(runtime_dir, f"{key}.log")
            item.update({"listenIp": listen_ip, "port": listen_port, "protocolMode": protocol_mode, "pidPath": pid_path, "logPath": log_path})
            if os.path.exists(pid_path):
                try:
                    with open(pid_path, "r", encoding="utf-8") as pid_fp:
                        pid = int(pid_fp.read().strip())
                    item["pid"] = pid
                    item["processRunning"] = os.path.exists(f"/proc/{pid}")
                except Exception as exc:
                    item["error"] = str(exc)
            item["listening"], listen_error = endpoint_listening(listen_ip or "127.0.0.1", listen_port)
            if not item["listening"] and listen_error:
                item["error"] = listen_error
            item["status"] = "active" if item["listening"] else "inactive"
        except Exception as exc:
            item["error"] = str(exc)
            item["status"] = "error"
        endpoints.append(item)
    active = [item for item in endpoints if item.get("listening")]
    needs_rpcbind = any(item.get("protocolMode") == "V3V4_DUAL" for item in endpoints)
    return {
        "configured": len(endpoints),
        "active": len(active),
        "listening": bool(active),
        "status": "ok" if (not endpoints or len(active) == len(endpoints)) and (not needs_rpcbind or rpcbind_active()) else "degraded",
        "protocolMode": "V3V4_DUAL" if any(item.get("protocolMode") == "V3V4_DUAL" for item in endpoints) else "V4_ONLY",
        "rpcbindRequired": needs_rpcbind,
        "rpcbindActive": rpcbind_active(),
        "endpoints": endpoints,
        "idMappingMode": next(iter({item.get("idMappingMode", "UNKNOWN") for item in endpoints})) if endpoints and len({item.get("idMappingMode", "UNKNOWN") for item in endpoints}) == 1 else ("DRIFT" if endpoints else "UNKNOWN"),
    }

def collect_network_addresses():
    if not shutil.which("ip"):
        return []
    addresses = []
    seen = set()
    result = run(["ip", "-j", "-4", "addr", "show", "scope", "global"])
    if result.returncode == 0:
        try:
            for link in json.loads(result.stdout or "[]"):
                ifname = link.get("ifname")
                for item in link.get("addr_info", []) or []:
                    ipaddress = item.get("local")
                    prefix = item.get("prefixlen")
                    if not ipaddress or ipaddress in seen:
                        continue
                    seen.add(ipaddress)
                    flags = item.get("flags") or []
                    secondary = bool(item.get("secondary")) or "secondary" in flags
                    dynamic = bool(item.get("dynamic")) or "dynamic" in flags
                    entry = {
                        "interface": ifname,
                        "ipaddress": ipaddress,
                        "secondary": secondary,
                        "primary": not secondary,
                        "role": "secondary" if secondary else "primary",
                    }
                    if dynamic:
                        entry["dynamic"] = True
                    if prefix is not None:
                        entry["prefixlen"] = prefix
                        entry["cidr"] = f"{ipaddress}/{prefix}"
                    addresses.append(entry)
            return addresses
        except Exception:
            pass
    result = run(["ip", "-o", "-4", "addr", "show", "scope", "global"])
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        ifname = parts[1]
        cidr = parts[3]
        ipaddress = cidr.split("/", 1)[0]
        if not ipaddress or ipaddress in seen:
            continue
        seen.add(ipaddress)
        secondary = " secondary " in f" {line} "
        entry = {
            "interface": ifname,
            "ipaddress": ipaddress,
            "cidr": cidr,
            "secondary": secondary,
            "primary": not secondary,
            "role": "secondary" if secondary else "primary",
        }
        if " dynamic " in f" {line} ":
            entry["dynamic"] = True
        if "/" in cidr:
            try:
                entry["prefixlen"] = int(cidr.split("/", 1)[1])
            except Exception:
                pass
        addresses.append(entry)
    return addresses

def nvmeof_capabilities():
    base = "/sys/kernel/config/nvmet"
    host_root = os.path.join(base, "hosts")
    sample_host = "nqn.2014-08.org.nvmexpress:uuid:00000000-0000-0000-0000-000000000000"
    host_dir = os.path.join(host_root, sample_host)
    existed = os.path.exists(host_dir)
    result = {
        "kernel": run(["uname", "-r"]).stdout.strip(),
        "kernelTargetSupported": os.path.isdir(base),
        "configfsHostSupported": os.path.isdir(host_root),
        "dhChapSupported": False,
        "dhChapCtrlSupported": False,
    }
    if not result["kernelTargetSupported"]:
        result["reason"] = "missing nvmet configfs root"
        return result
    if not result["configfsHostSupported"]:
        result["reason"] = "missing nvmet hosts configfs root"
        return result
    try:
        os.makedirs(host_dir, exist_ok=True)
        result["dhChapSupported"] = os.path.exists(os.path.join(host_dir, "dhchap_key"))
        result["dhChapCtrlSupported"] = os.path.exists(os.path.join(host_dir, "dhchap_ctrl_key"))
        if not result["dhChapSupported"] or not result["dhChapCtrlSupported"]:
            result["reason"] = "missing nvmet host dhchap_key/dhchap_ctrl_key"
    except Exception as exc:
        result["reason"] = str(exc)
    finally:
        if not existed:
            try:
                os.rmdir(host_dir)
            except Exception:
                pass
    return result

def load_state(name):
    path = os.path.join("/etc/ablestack-storage", name)
    if not os.path.exists(path):
        return False
    return os.path.getsize(path) >= 0

def load_json_state(name):
    path = os.path.join("/etc/ablestack-storage", name)
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as fp:
            return json.load(fp)
    except Exception as exc:
        return {"state": "ERROR", "message": str(exc)}

ganesha_runtime = collect_ganesha_runtime()

services = {
    "qemuGuestAgent": service_state("qemu-guest-agent"),
    "nfs": ganesha_runtime["status"] if ganesha_runtime["configured"] else (
        service_state("nfs-server") if service_state("nfs-server") != "unknown" else service_state("nfs-kernel-server")
    ),
    "nfsGanesha": ganesha_runtime["status"],
    "smbd": service_state("smbd"),
    "nmbd": service_state("nmbd"),
    "winbind": service_state("winbind"),
    "iscsiTarget": first_service_state("target", "rtslib-fb-targetctl"),
}
commands = {
    "exportfs": command_present("exportfs"),
    "smbd": command_present("smbd"),
    "net": command_present("net"),
    "targetcli": command_present("targetcli"),
    "nvme": command_present("nvme"),
}
desired_state = {
    "nfsQuotas": load_state("nfs-quotas.json"),
    "smbQuotas": load_state("smb-quotas.json"),
    "smbDomain": load_state("smb-domain.json"),
    "smbDomainError": load_state("smb-domain-error.json"),
    "iscsiTargets": load_state("iscsi-targets.json"),
    "nvmeofSubsystems": load_state("nvmeof-subsystems.json"),
}
def desired_iscsi_ports(state):
    ports = set()
    if isinstance(state, dict):
        for listener in state.get("listeners") or []:
            if isinstance(listener, dict):
                try:
                    ports.add(int(listener.get("port") or 3260))
                except Exception:
                    pass
        if not ports and state.get("port"):
            try:
                ports.add(int(state.get("port")))
            except Exception:
                pass
        for target in state.get("targets") or []:
            config = target.get("config") or {}
            raw = target.get("listenerPorts") or config.get("listenerGroupPorts") or config.get("listenerPorts")
            if isinstance(raw, list):
                for value in raw:
                    try:
                        ports.add(int(value))
                    except Exception:
                        pass
            elif isinstance(raw, str):
                for value in re.split(r"[,\s]+", raw):
                    if not value:
                        continue
                    try:
                        ports.add(int(value))
                    except Exception:
                        pass
    if not ports:
        ports.add(3260)
    return sorted(ports)

def desired_nvmeof_ports(state):
    ports = set()
    if isinstance(state, dict):
        for listener in state.get("listeners") or []:
            if not isinstance(listener, dict):
                continue
            try:
                ports.add(int(listener.get("port") or listener.get("listenPort") or listener.get("listenport") or state.get("port") or 4420))
            except Exception:
                pass
        has_namespace = False
        has_subsystem = bool(state.get("subsystems"))
        if not ports:
            for subsystem in state.get("subsystems") or []:
                for namespace in subsystem.get("namespaces") or []:
                    has_namespace = True
                    config = namespace.get("config") or {}
                    raw = namespace.get("listenerPorts") or namespace.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports")
                    if isinstance(raw, list):
                        for value in raw:
                            try:
                                ports.add(int(value))
                            except Exception:
                                pass
                    elif isinstance(raw, str):
                        for value in re.split(r"[,\s]+", raw):
                            if not value:
                                continue
                            try:
                                ports.add(int(value))
                            except Exception:
                                pass
        if not ports and (has_namespace or has_subsystem):
            try:
                ports.add(int(state.get("port") or 4420))
            except Exception:
                ports.add(4420)
    return sorted(ports)

def nvmeof_namespace_ports(namespace):
    ports = set()
    if not isinstance(namespace, dict):
        return ports
    config = namespace.get("config") or {}
    raw = namespace.get("listenerPorts") or namespace.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports")
    if isinstance(raw, list):
        values = raw
    elif isinstance(raw, str):
        values = re.split(r"[,\s]+", raw)
    else:
        values = []
    for value in values:
        if value in (None, ""):
            continue
        try:
            ports.add(int(value))
        except Exception:
            pass
    return ports

def nvmeof_linked_ports(state):
    ports = set()
    if not isinstance(state, dict):
        return ports
    default_port = int(state.get("port") or 4420)
    for subsystem in state.get("subsystems") or []:
        if not isinstance(subsystem, dict) or str(subsystem.get("state", "Ready")) in ("Disabled", "Destroyed", "Error"):
            continue
        for namespace in subsystem.get("namespaces") or []:
            if not isinstance(namespace, dict) or str(namespace.get("state", "Ready")) in ("Disabled", "Destroyed", "Error"):
                continue
            ports.update(nvmeof_namespace_ports(namespace) or {default_port})
    return ports

def nvmeof_port_runtime(state):
    configured_ports = set(desired_nvmeof_ports(state))
    linked_ports = nvmeof_linked_ports(state)
    configured_ports.update(linked_ports)
    if not configured_ports and isinstance(state, dict) and state.get("subsystems"):
        configured_ports.add(int(state.get("port") or 4420))
    runtime = {}
    for port in sorted(configured_ports):
        listening = port_listening(port)
        linked = port in linked_ports
        if linked and listening:
            port_state = "LISTENING"
        elif linked:
            port_state = "ERROR"
        else:
            port_state = "UNUSED"
        runtime[str(port)] = {
            "configured": True,
            "linked": linked,
            "listening": listening,
            "state": port_state,
        }
    return runtime

def nvmeof_runtime_ok(runtime):
    return all(str(item.get("state", "")).upper() != "ERROR" for item in runtime.values())

def collect_smb_listener_runtime():
    desired = load_json_state("desired-state/smb-share-apply.json")
    if not desired or desired.get("enabled") is False:
        return {"configured": 0, "available": True, "listening": True, "runtimeEndpoints": []}
    rows = desired.get("listeners") or [{"listenIp": desired.get("listenIp") or "0.0.0.0", "port": desired.get("port") or 445}]
    deadline = time.monotonic() + 5
    observed = run(["ss", "-ltnpH"])
    owned = set()
    if observed.returncode == 0:
        for line in observed.stdout.splitlines():
            fields = line.split()
            if len(fields) < 5 or '"smbd"' not in line:
                continue
            ip, _, port = fields[3].rpartition(":")
            owned.add((ip.strip("[]"), port))
    endpoints = []
    for row in rows:
        ip = str(row.get("listenIp") or "0.0.0.0")
        port = int(row.get("port") or 445)
        listener_owned = (ip, str(port)) in owned
        ready = False
        remaining = deadline - time.monotonic()
        if listener_owned and remaining > 0:
            target = "127.0.0.1" if ip == "0.0.0.0" else "::1" if ip == "::" else ip
            try:
                with socket.create_connection((target, port), timeout=min(1, remaining)):
                    ready = True
            except OSError:
                pass
        endpoints.append({"listenIp": ip, "port": port, "listenerOwned": listener_owned,
                          "tcpReady": ready, "listening": listener_owned and ready,
                          "available": observed.returncode == 0})
    result = {"configured": len(endpoints), "available": observed.returncode == 0,
              "listening": all(row["listening"] for row in endpoints), "runtimeEndpoints": endpoints}
    if observed.returncode != 0:
        result["errorCode"] = "SMB_SOCKET_OBSERVATION_UNAVAILABLE"
    return result

smb_runtime = collect_smb_listener_runtime()
if smb_runtime["configured"]:
    services["smbd"] = "active" if smb_runtime["listening"] else "failed"

iscsi_targets_state = load_json_state("iscsi-targets.json")
iscsi_ports = desired_iscsi_ports(iscsi_targets_state)
nvmeof_state = load_json_state("nvmeof-subsystems.json")
nvmeof_ports = desired_nvmeof_ports(nvmeof_state)
nvmeof_runtime = nvmeof_port_runtime(nvmeof_state)
listen_ports = {
    "nfs": ganesha_runtime["listening"] if ganesha_runtime["configured"] else port_listening(2049),
    "smb": smb_runtime["listening"] if smb_runtime["configured"] else port_listening(445) or port_listening(139),
    "iscsi": all(port_listening(port) for port in iscsi_ports),
    "iscsiPorts": {str(port): port_listening(port) for port in iscsi_ports},
    "nvmeof": nvmeof_runtime_ok(nvmeof_runtime),
    "nvmeofPorts": nvmeof_runtime,
}
status = "ok"
if services["qemuGuestAgent"] not in ("active", "unknown"):
    status = "degraded"
if ganesha_runtime["active"] < ganesha_runtime["configured"]:
    status = "degraded"
if iscsi_targets_state.get("targets") and not listen_ports["iscsi"]:
    status = "degraded"
if desired_state["nvmeofSubsystems"] and not nvmeof_runtime_ok(nvmeof_runtime):
    status = "degraded"
if desired_state.get("smbDomainError") or (smb_runtime["configured"] and not smb_runtime["listening"]):
    status = "degraded"

print(json.dumps({
    "success": True,
    "status": status,
    "hostname": socket.gethostname(),
    "generatedEpoch": time.time(),
    "observedEpoch": time.time(),
    "uptimeSeconds": int(time.time() - os.stat("/proc/1").st_ctime) if os.path.exists("/proc/1") else None,
    "network": {"addresses": collect_network_addresses()},
    "services": services,
    "commands": commands,
    "desiredState": desired_state,
    "identity": {"smbDomain": load_json_state("smb-domain.json"), "smbDomainError": load_json_state("smb-domain-error.json")},
    "listenPorts": listen_ports,
    "nfsGanesha": ganesha_runtime,
    "smbRuntime": smb_runtime,
    "capabilities": {
        "nvmeof": nvmeof_capabilities(),
        "smbNetworkAccessSupported": bool(commands.get("smbd")),
        "smbNetworkIpv6Supported": any(":" in str(address.get("ipaddress") or "") and not str(address.get("ipaddress") or "").lower().startswith("fe80:") for address in collect_network_addresses()),
    },
}, sort_keys=True))
PY
}

