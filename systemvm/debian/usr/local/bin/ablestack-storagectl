        if final!=target:raise ValueError("ROOT TARGET public stopped bytes changed during RAW collection")
        capsule=encrypt(payload,request["publicKey"],controls["instanceUuid"]+":"+controls["operationUuid"])
        checkpoint=RootTargetCipher().retain(request,capsule,target,key_proof)
        print(json.dumps({"success":True,"capsule":capsule,"rootIdentityCheckpoint":checkpoint},sort_keys=True))
elif action=="ad-authorize-imported":
    print(json.dumps(RootAdImportedAuthorization().authorize(request,identity_command(("operation","maintenance","status"))),sort_keys=True))
elif action=="ad-retain":
    required={"instanceUuid","templateUpgradeUuid","operationUuid","revision","capsule","credentialPrivateKey","retainedRootAuthorization"}
    if not required<=set(request) or not set(request)<=required|{"originalSourceScope","sourceConfigurationSha256"}:raise ValueError("ROOT AD retain request is not closed")
    capsule_scope=RootIdentityReference().authorize(request,request["capsule"],identity_command(("operation","maintenance","status")))
    payload=decrypt(request["capsule"],request["credentialPrivateKey"],capsule_scope);validate_payload(payload)
    identity=payload.get("adIdentity")
    if not isinstance(identity,dict) or not {"machineAccountSid","dnsAliases","machineConfigurationSha256","idmapPolicy"}<=set(identity):raise ValueError("SAMEVM AD capsule lacks its full source identity")
    if not isinstance(request.get("retainedRootAuthorization"),dict):raise ValueError("ROOT AD retain requires authenticated retained authorization")
    original_scope=request.get("originalSourceScope") or {key:request[key] for key in ("instanceUuid","templateUpgradeUuid","operationUuid","revision")}
    source_sha=request.get("sourceConfigurationSha256") or payload.get("sourceConfigurationSha256")
    if payload.get("sourceConfigurationSha256")!=source_sha:raise ValueError("ROOT AD original source seven digest differs")
    original_sha=hashlib.sha256(base64.b64decode(request["capsule"]["ciphertext"],validate=True)).hexdigest()
    result=identity_command(("identity","domain","retain","/dev/stdin"),{**{key:request[key] for key in ("instanceUuid","operationUuid","revision")},
        "expectedIdentity":identity,"retainedRootAuthorization":request["retainedRootAuthorization"],"originalCipherSha256":original_sha,"sourceConfigurationSha256":source_sha,"originalSourceScope":original_scope})
    print(json.dumps(result,sort_keys=True))
elif action == "import":
    if "templateUpgradeUuid" in request:
        scope=RootIdentityReference().authorize(request,request["capsule"],identity_command(("operation","maintenance","status")))
    payload = decrypt(request["capsule"], request["credentialPrivateKey"], scope)
    validate_payload(payload)
    if "templateUpgradeUuid" in request and payload.get("rootSourceConfiguration") is not None:
        original=request.get("originalSourceScope") or {key:request[key] for key in ("instanceUuid","templateUpgradeUuid","operationUuid","revision")}
        root_configuration_authorize(payload,original,request["sourceConfigurationSha256"])
    if "templateUpgradeUuid" in request and payload.get("sourceConfigurationSha256") not in (None,request.get("sourceConfigurationSha256")):
        raise ValueError("ROOT capsule source configuration differs from its pinned import request")
    if "templateUpgradeUuid" in request and request["capsule"].get("scope")==request["instanceUuid"]+":"+request["operationUuid"]:
        source_sha=payload.get("sourceConfigurationSha256") or request.get("sourceConfigurationSha256")
        RootIdentityReference().retain(request,request["capsule"],source_sha)
    if "restoreDomains" in request:payload=select_restore_domains(payload,request["restoreDomains"])
    receipts_deferred=bool(payload.get("posixPolicies"))
    payload=dict(payload);payload.pop("posixPolicies",None);payload.pop("sourceConfigurationSha256",None);payload.pop("rootSourceConfiguration",None)
    if request.get("deferNvmeReplay") is True:
        validate_payload(payload)
        files_only = dict(payload); files_only.pop("nvmeHosts", None)
        print(json.dumps({**restore(files_only), "nvmeReplayDeferred": True,"posixReceiptRestoreDeferred":receipts_deferred}, sort_keys=True))
    else:
        print(json.dumps({**restore_protected(payload, request.get("nvmeDesired")),"posixReceiptRestoreDeferred":receipts_deferred}, sort_keys=True))
else:
    raise ValueError("Unsupported identity capsule action")
