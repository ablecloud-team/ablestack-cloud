def identity_command(arguments,payload=None):
    import signal
    if not callable(getattr(os,"pidfd_open",None)) or not callable(getattr(signal,"pidfd_send_signal",None)):
        raise ValueError("Identity observation requires exact child control")
    child=subprocess.Popen([sys.argv[3],*arguments],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,
                           text=True,pass_fds=writer_lock_fds())
    descriptor=None
    try:
        try:descriptor=os.pidfd_open(child.pid,0)
        except ProcessLookupError:
            if child.poll() is None:raise ValueError("Identity child scope is unavailable")
        try:output,_=child.communicate(input=json.dumps(payload) if payload is not None else None,timeout=15)
        except subprocess.TimeoutExpired:
            if descriptor is not None:
                try:signal.pidfd_send_signal(descriptor,signal.SIGTERM,None,0)
                except ProcessLookupError:pass
            try:child.wait(timeout=.2)
            except subprocess.TimeoutExpired:
                if descriptor is not None:
                    try:signal.pidfd_send_signal(descriptor,signal.SIGKILL,None,0)
                    except ProcessLookupError:pass
                try:child.wait(timeout=.2)
                except subprocess.TimeoutExpired:pass
            raise ValueError("Identity observation timed out; attestation remains unverified")
        if child.returncode or len(output)>8*1024*1024:raise ValueError("Identity observation failed")
        value=json.loads(output)
        if value.get("success") is not True:raise ValueError("Identity observation did not verify")
        return value
    finally:
        if descriptor is not None:os.close(descriptor)
        for stream in (child.stdin,child.stdout):
            if stream is not None:stream.close()

