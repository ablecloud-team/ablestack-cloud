command="${1:-}"
subcommand="${2:-}"
action="${3:-}"
payload="${4:-}"

# Embedded Python programs use stdin for their script. A sealed memfd makes the separate
# payload readable by all native stages without plaintext files or secret-bearing arguments.
if [[ "$command" != "identity" && "${@: -1}" == "/dev/stdin" ]]; then
  materialize_stdin_payload_in_memory "$@"
  exit $?
fi

# Keep the descriptor open through native child work, even if the management writer disappears.
case "$command:$subcommand:$action" in
  operation:reservation:acquire|operation:reservation:renew|operation:reservation:release|operation:reservation:status|volume:operation:capabilities|smb:identity:inspect|smb:endpoint-run:*|health:*|inventory:*|sessions:*|operation:verify:*|operation:observe:*|operation:resources:*|network:endpoints:inspect|operation:generation:render-boot-gate|operation:generation:render-status|operation:generation:render-maintenance-verify|operation:generation:render-root-identity-export-source|operation:generation:status|operation:generation:frozen|posix:directory:inspect|posix:directory:plan|posix:directory:attest-plan|operation:maintenance:status|operation:maintenance:service-status|operation:maintenance:service-capabilities|operation:root-data:inspect|operation:writer-idle:*|volume:operation:status|nfs:idmapping:preflight|nfs:capabilities:*|identity:capsule:capabilities|identity:domain:inspect|identity:principal:resolve)
    ;;
  *)
    acquire_storage_writer_lock || exit $?
    ;;
esac

if [[ -n "${ABLESTACK_STORAGE_ROOT_SOURCE_REPLAY:-}" ]]; then
  case "$command:$subcommand:$action" in
    nfs:export:apply|smb:share:apply|iscsi:target:apply|nvmeof:subsystem:apply)
      if [[ "$ABLESTACK_STORAGE_ROOT_SOURCE_REPLAY" != "1" ]]; then
        printf '%s\n' '{"success":false,"errorCode":"ROOT_SOURCE_REPLAY_REJECTED"}'
        exit 2
      fi
      rendered_generation_command render-root-replay-guard "" >/dev/null
      ;;
  esac
fi

case "$command:$subcommand:$action" in
  nfs:export:apply|smb:share:apply|iscsi:target:apply|nvmeof:subsystem:apply)
    rendered_current="${ABLESTACK_STORAGE_RENDERED_GENERATIONS:-/var/lib/ablestack-storage/rendered-generations}/current"
    if [[ -L "$rendered_current" && -z "${ABLESTACK_STORAGE_RENDERED_REPLAY:-}" ]]; then
      printf '%s\n' '{"success":false,"errorCode":"RENDERED_GENERATION_SCOPE_REQUIRED"}'
      exit 2
    fi
    ;;
