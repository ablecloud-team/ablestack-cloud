                         or config.get("filesystemUuid") or config.get("fsUuid")),
        mount_source=mounted_source,
        expected_size=expected_size,
        allow_blank_size_fallback=False,
    )
except VolumeIdentityError as error:
    raise SystemExit(str(error))
def assert_mutating_volume_identity(resolved, requested, observed_devices, size):
    try:
        identity = uuid.UUID(str(requested.get("volumeUuid"))).hex
    except (ValueError, TypeError, AttributeError) as failure:
        raise ValueError("Volume mutation requires a canonical volume UUID") from failure
    serial = compact(resolved.get("serial"))
    if resolved.get("matchedBy") != "VOLUME_SERIAL" or serial not in (identity, identity[:20]):
        raise ValueError("Volume mutation requires the exact requested volume serial; filesystem/mount/size fallbacks are forbidden")
    device_info = next((item for item in observed_devices if item.get("path") == resolved.get("devicePath")), None)
    if size <= 0 or not device_info or parse_size(device_info.get("size")) != size:
        raise ValueError("Volume mutation requires the exact declared device size")
    config = requested.get("config") or {}
    inspected = config.get("lastInspection") or config.get("lastinspection") or {}
    expected_filesystem = inspected.get("filesystemUuid") or inspected.get("fsUuid") or config.get("filesystemUuid") or config.get("fsUuid")
    if expected_filesystem and device_info.get("uuid") != expected_filesystem:
        raise ValueError("Volume mutation filesystem UUID differs from its pinned inspection")

if import_mode != "INSPECT_ONLY":
    assert_mutating_volume_identity(resolved_device, payload, devices, expected_size)

device = resolved_device["devicePath"]
