smb_domain_join() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import re
import subprocess
import sys
import time

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)
state_path = os.path.join(state_dir, "smb-domain.json")
error_path = os.path.join(state_dir, "smb-domain-error.json")

def write_join_error(phase, message):
    with open(error_path, "w", encoding="utf-8") as error_fp:
        json.dump({
            "state": "JOIN_FAILED",
            "phase": phase,
            "message": str(message),
            "domainName": payload.get("domainName"),
            "workgroup": payload.get("workgroup") or (payload.get("config") or {}).get("workgroup"),
            "updatedAt": int(time.time()),
        }, error_fp, sort_keys=True, indent=2)

def command_label(args):
    cleaned = []
    for item in args:
        value = str(item)
        if "%" in value and "-U" not in value:
            value = value.split("%", 1)[0] + "%<redacted>"
        cleaned.append(value)
    return " ".join(cleaned)

def run_checked(phase, args, input_text=None):
    result = subprocess.run(args, input=input_text, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "command failed").strip()
        if input_text:
            detail = detail.replace(input_text.strip(), "<redacted>")
        if not detail:
            detail = command_label(args) + " failed"
        write_join_error(phase, detail)
        raise SystemExit(detail)
    return result

def derive_ad_workgroup(domain_name, workgroup):
    value = str(workgroup or "").strip()
    if value and value.upper() != "WORKGROUP":
        return re.sub(r"[^A-Za-z0-9]", "", value)[:15].upper() or "WORKGROUP"
    domain_value = str(domain_name or "").strip()
    if domain_value:
        derived = re.sub(r"[^A-Za-z0-9]", "", domain_value.split(".", 1)[0])[:15].upper()
        if derived:
            return derived
    return "WORKGROUP"

def normalize_realm(domain_name):
    return str(domain_name or "").strip().upper()

def kerberos_principal(username, realm):
    value = str(username or "").strip()
    if "@" in value:
        return value
    if "\\" in value:
        value = value.split("\\", 1)[1]
    return f"{value}@{realm}"

def write_smb_conf(workgroup_name):
    lines = [
        "[global]",
        "   server string = ABLESTACK Storage Service",
        f"   netbios name = {netbios_name}",
        f"   workgroup = {workgroup_name}",
        f"   realm = {realm}",
        "   security = ADS",
        "   kerberos method = secrets and keytab",
        "   winbind use default domain = yes",
        "   winbind enum users = yes",
        "   winbind enum groups = yes",
        "   idmap config * : backend = tdb",
        "   idmap config * : range = 10000-999999",
        "   load printers = no",
        "   printing = bsd",
        "   disable spoolss = yes",
        "   map to guest = Bad User",
    ]
    with open("/etc/samba/smb.conf", "w", encoding="utf-8") as smb_fp:
        smb_fp.write("\n".join(lines) + "\n")

domain = payload.get("domainName")
username = payload.get("username")
password = payload.get("password")
ou = payload.get("organizationalUnit")
dns_servers = payload.get("dnsServers")
config = payload.get("config") or {}
realm = normalize_realm(domain)
workgroup = derive_ad_workgroup(domain, config.get("workgroup"))
netbios_name = re.sub(r"[^A-Za-z0-9]", "", str(payload.get("netbiosName") or config.get("netbiosName") or ""))[:15].upper()
if not netbios_name:
    netbios_name = "STORAGEVM"

if not domain or not username or not password:
    write_join_error("validate", "domainName, username, and password are required for SMB domain join")
    raise SystemExit("domainName, username, and password are required for SMB domain join")

if os.path.exists(error_path):
    os.remove(error_path)

if dns_servers:
    with open(os.path.join(state_dir, "smb-dns-servers"), "w", encoding="utf-8") as dns_fp:
        dns_fp.write(str(dns_servers) + "\n")
    backup_path = os.path.join(state_dir, "resolv.conf.storage-backup")
    if os.path.exists("/etc/resolv.conf") and not os.path.exists(backup_path):
        with open("/etc/resolv.conf", "r", encoding="utf-8", errors="ignore") as source_fp, open(backup_path, "w", encoding="utf-8") as backup_fp:
            backup_fp.write(source_fp.read())
    with open("/etc/resolv.conf", "w", encoding="utf-8") as resolv_fp:
        resolv_fp.write(f"search {domain}\n")
        for server in re.split(r"[,\\s]+", str(dns_servers)):
            if server:
                resolv_fp.write(f"nameserver {server}\n")

with open("/etc/krb5.conf", "w", encoding="utf-8") as krb_fp:
    krb_fp.write("[libdefaults]\n")
    krb_fp.write(f" default_realm = {realm}\n")
    krb_fp.write(" dns_lookup_realm = false\n dns_lookup_kdc = true\n rdns = false\n")

write_smb_conf(workgroup)
run_checked("testparm", ["testparm", "-s"])
lookup = subprocess.run(["net", "ads", "lookup", "-S", domain], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
if lookup.returncode == 0:
    for line in lookup.stdout.splitlines():
        if "Pre-Win2k Domain:" in line:
            discovered = line.split(":", 1)[1].strip()
            if discovered:
                workgroup = derive_ad_workgroup(domain, discovered)
                write_smb_conf(workgroup)
            break

kinit_principal = kerberos_principal(username, realm)
run_checked("kinit", ["kinit", kinit_principal], input_text=f"{password}\n")

cmd = ["net", "ads", "join", "-k"]
if ou:
    cmd.append(f"createcomputer={ou}")
try:
    run_checked("join", cmd)
finally:
    subprocess.run(["kdestroy"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

with open(state_path, "w", encoding="utf-8") as state_fp:
    json.dump({
        "domainName": domain,
        "organizationalUnit": ou,
        "dnsServers": dns_servers,
        "workgroup": workgroup,
        "realm": realm,
        "netbiosName": netbios_name,
        "state": "JOINED",
        "trustVerified": False,
    }, state_fp, sort_keys=True, indent=2)

print(json.dumps({"success": True, "domainName": domain}))
PY

  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now smbd >/dev/null 2>&1 || true
    systemctl enable --now nmbd >/dev/null 2>&1 || true
    systemctl enable --now winbind >/dev/null 2>&1 || true
    systemctl restart smbd >/dev/null 2>&1 || true
    systemctl restart nmbd >/dev/null 2>&1 || true
    systemctl restart winbind >/dev/null 2>&1 || true
  fi
  net cache flush >/dev/null 2>&1 || true

  local verify_error=""
  if ! verify_error="$(net ads testjoin 2>&1)"; then
