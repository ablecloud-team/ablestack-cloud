relative_share_path = str(config.get("relativeSharePath") or str(payload.get("path") or "").strip("/")).strip()
create_directory = bool(config.get("createDirectory", True))
share_uuid = str(payload.get("shareUuid") or payload.get("shareId") or payload.get("volumeUuid") or "unknown")
managed_marker = f"ablestack-storage:{share_uuid}:backing"

def fstab_escape(value):
    return str(value).replace("\\", "\\\\").replace(" ", "\\040").replace("\t", "\\011")

def update_fstab(marker, entry=None):
    fstab_path = "/etc/fstab"
    lines = []
    if os.path.exists(fstab_path):
        with open(fstab_path, "r", encoding="utf-8") as fstab_fp:
            for line in fstab_fp:
                if marker not in line:
                    lines.append(line)
    if entry:
        lines.append(entry.rstrip("\n") + "\n")
    directory = os.path.dirname(fstab_path)
    fd, tmp_path = tempfile.mkstemp(prefix=".fstab.", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as tmp_fp:
            tmp_fp.writelines(lines)
        os.replace(tmp_path, fstab_path)
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)

def daemon_reload():
    if shutil.which("systemctl"):
        subprocess.run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=20)

def blkid_value(path, field):
    result = run(["blkid", "-s", field, "-o", "value", path])
    if result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip().splitlines()[0]
    return ""

def persist_backing_mount(device, target_path, fs):
    fs_uuid = blkid_value(device, "UUID")
    if not fs_uuid:
        raise SystemExit(f"Unable to resolve filesystem UUID for Storage Service backing volume {device}")
    fstype = fs or blkid_value(device, "TYPE") or "auto"
    options = "defaults,nofail,x-systemd.device-timeout=30"
    entry = f"UUID={fstab_escape(fs_uuid)} {fstab_escape(target_path)} {fstab_escape(fstype)} {options} 0 2 # {managed_marker}"
    update_fstab(managed_marker, entry)
    daemon_reload()
    return fs_uuid

format_invoked = False

def format_empty_device():
    global format_invoked
    if payload.get("provisioningType") not in ("SPARSE", "FAT"):
        raise SystemExit("New filesystem formatting requires explicit SPARSE or FAT provisioning; existing THIN data can only be inspected or mounted")
    fs = str(requested_filesystem or "xfs").lower()
    if fs not in {"xfs", "ext4"}:
        raise SystemExit(f"Unsupported filesystem for empty backing volume format: {fs}")
    if operation.get("formatStarted"):
        recovery("RECOVERY_REQUIRED", "An earlier format was started; a blank probe cannot authorize automatic reformat")
    tool = f"mkfs.{fs}"
    if not shutil.which(tool):
        raise SystemExit(f"Missing filesystem formatter: {tool}")
    signatures = run(["wipefs", "--no-act", "--json", device])
    if signatures.returncode != 0:
        recovery("RECOVERY_REQUIRED", "Unable to prove the device has no existing signatures")
    if json.loads(signatures.stdout).get("signatures"):
        recovery("RECOVERY_REQUIRED", "Existing device signatures prohibit automatic formatting")
    discard_policy = str(payload.get("formatDiscardPolicy") or "DEFAULT").upper()
    if discard_policy not in ("DEFAULT", "SKIP_DISCARD"):
        raise SystemExit("Unsupported per-volume filesystem discard policy")
    command = [tool, "-f"] if fs == "xfs" else [tool, "-F"]
    if discard_policy == "SKIP_DISCARD":
        # Scope this option to the exact newly proved blank volume. In SPARSE
        # qcow2, discarding the complete logical 10TiB address space can exhaust
        # the deadline while punching metadata holes in the shared backend.
        command += ["-K"] if fs == "xfs" else ["-E", "nodiscard,lazy_itable_init=1,lazy_journal_init=1"]
    command.append(device)
    phase("FORMATTING", formatStarted=True, formatReceiptUuid=str(uuid.uuid4()), filesystem=fs, devicePath=device,
          started=time.time(), volumeSizeBytes=expected_size, formatter=tool, formatterOptions=command[1:-1], formatDiscardPolicy=discard_policy)
    inherited = (9,) if os.path.exists("/proc/self/fd/9") else ()
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, pass_fds=inherited)
    format_invoked = True
    phase("FORMATTING", formatterPid=process.pid)
    deadline = time.monotonic() + format_deadline
    while True:
        try:
            stdout, stderr = process.communicate(timeout=max(0.1, min(5, deadline - time.monotonic())))
            break
        except subprocess.TimeoutExpired:
            phase("FORMATTING", elapsedSeconds=time.time() - operation["started"])
            if time.monotonic() >= deadline:
                # Persist the deadline before attempting signals: an
                # uninterruptible I/O wait can outlive both TERM and KILL.
                phase("TIMED_OUT_PENDING_RECONCILE", errorCode="TIMED_OUT_PENDING_RECONCILE",
                      diagnostic="Format deadline exceeded; bounded formatter termination requested",
                      formatterPid=process.pid, formatterActive=True, terminationRequested=True,
                      terminationPending=True, elapsedSeconds=time.time() - operation["started"])
                process.terminate()
                try:
                    process.communicate(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    try:
                        process.communicate(timeout=5)
                    except subprocess.TimeoutExpired:
                        # The formatter retains FD9 even after this writer
                        # returns. No retry/second mkfs is authorized here.
                        phase("RECOVERY_REQUIRED", formatterActive=True, terminationPending=True,
                              elapsedSeconds=time.time() - operation["started"])
                        recovery("RECOVERY_REQUIRED", "Formatter did not exit after bounded TERM/KILL; preserve the volume and observe its active writer, never reformat")
                phase("TIMED_OUT_PENDING_RECONCILE", formatterActive=False, terminationPending=False,
                      elapsedSeconds=time.time() - operation["started"])
                recovery("TIMED_OUT_PENDING_RECONCILE", "Format deadline exceeded; re-observe filesystem identity before resuming")
    if process.returncode != 0:
        recovery("RECOVERY_REQUIRED", (stderr.strip() or "Filesystem formatter failed")[:1024])
    phase("VERIFYING_FILESYSTEM", filesystemUuid=blkid_value(device, "UUID"))
    if blkid_value(device, "TYPE") != fs or not operation.get("filesystemUuid"):
        recovery("RECOVERY_REQUIRED", "Formatted filesystem identity cannot be verified")
    phase("FILESYSTEM_VERIFIED", formatterExitCode=0, formatterActive=False, terminationPending=False,
          formatterSuccessReceipt={"schemaVersion": 1, "volumeUuid": volume_key, "filesystemUuid": operation["filesystemUuid"],
                                   "filesystem": fs, "formatterPid": process.pid, "formatterExitCode": 0,
                                   "serial": resolved_device["serial"], "sizeBytes": expected_size, "formatDiscardPolicy": discard_policy,
                                   "formatterOptions": command[1:-1], "verifiedEpoch": time.time()})
    return fs

def active_formatter(record):
    pid = record.get("formatterPid")
    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
        return False
    try:
        command = Path("/proc/" + str(pid) + "/cmdline").read_bytes().split(b"\x00")
    except FileNotFoundError:
        return False
    expected = str(record.get("formatter") or "mkfs." + str(record.get("filesystem") or ""))
    return bool(command and os.path.basename(os.fsdecode(command[0])) == expected)


def legacy_complete_mount_is_verified(request, record, existing_type, observed_uuid):
    # Compatibility for a normally completed historical preparation. It is
    # ordinary existing-FS mounting, never an interrupted/partial resume.
    return (request.get("resumeOnly") is not True and request.get("importMode") == "MOUNT_EXISTING"
            and record.get("phase") == "COMPLETE" and not record.get("terminationPending")
            and record.get("volumeUuid") == request.get("volumeUuid")
            and bool(record.get("filesystemUuid")) and record["filesystemUuid"] == observed_uuid
            and record.get("filesystem") == existing_type and existing_type in ("xfs", "ext4"))

def require_completed_format_receipt(record, existing_type, observed_uuid):
    receipt = record.get("formatterSuccessReceipt")
    if (record.get("terminationPending") or not isinstance(receipt, dict) or receipt.get("schemaVersion") != 1
            or receipt.get("formatterExitCode") != 0 or record.get("formatterExitCode") != 0
            or receipt.get("volumeUuid") != record.get("volumeUuid") or receipt.get("filesystemUuid") != observed_uuid
            or receipt.get("filesystem") != existing_type or record.get("filesystemUuid") != observed_uuid):
        raise ValueError("Filesystem signatures alone do not prove mkfs completion; preserve partial state for explicit recovery")

def require_resume_filesystem(request, record, existing_type, observed_uuid):
    if not request.get("resumeOnly"):
        return
    if record.get("volumeUuid") != request["volumeUuid"] or record.get("operationId") != request["operationId"] or record.get("formatStarted") is not True:
        raise ValueError("Volume resume lacks its original scoped format journal")
    if active_formatter(record):
        raise ValueError("Volume resume is blocked by its active formatter")
    require_completed_format_receipt(record, existing_type, observed_uuid)
    known = record.get("filesystemUuid")
    if not known or not observed_uuid or known != observed_uuid or record.get("filesystem") != existing_type or existing_type not in ("xfs", "ext4"):
        raise ValueError("Volume resume has no verified matching filesystem; blank/partial state cannot authorize mkfs")
    if request.get("expectedFilesystemUuid") is not None and request["expectedFilesystemUuid"] != known:
        raise ValueError("Volume resume filesystem UUID changed after its preflight")

if resume_only:
    require_resume_filesystem(payload, operation, existing_filesystem, blkid_value(device, "UUID"))
    # The historical mount choice is immutable authority for a preparation
    # resume. A request cannot redirect it to another path or create DATA dirs.
    prior_mount = operation.get("mountPath")
    expected_mount = "/srv/ablestack-storage/volumes/" + volume_key
    if prior_mount is not None and prior_mount != expected_mount:
        raise ValueError("Volume resume journal has an unsupported managed mount root")
    mount_path = expected_mount
    relative_share_path = ""
    create_directory = False

resume_format = bool(operation.get("formatStarted"))
if resume_format:
    observed_uuid = blkid_value(device, "UUID")
    if active_formatter(operation):
        recovery("RECOVERY_REQUIRED", "An active formatter prohibits mount, probe or a second format")
    if not legacy_complete_mount_is_verified(payload, operation, existing_filesystem, observed_uuid):
        try:
            require_completed_format_receipt(operation, existing_filesystem, observed_uuid)
        except ValueError as failure:
            recovery("RECOVERY_REQUIRED", str(failure))
    if operation.get("volumeUuid") != volume_key or operation.get("filesystem") != existing_filesystem or not observed_uuid:
        recovery("RECOVERY_REQUIRED", "Interrupted format has no verified matching filesystem; automatic reformat is prohibited")
    if operation.get("filesystemUuid") and operation["filesystemUuid"] != observed_uuid:
        recovery("RECOVERY_REQUIRED", "Filesystem UUID changed since volume preparation")
    phase("VERIFYING_FILESYSTEM", filesystemUuid=observed_uuid)

if import_mode != "INSPECT_ONLY":
    if existing_filesystem and import_mode == "FORMAT_EMPTY" and not resume_format:
        raise SystemExit(f"Refusing to format {device}: filesystem {existing_filesystem} already exists")
    if existing_filesystem and existing_filesystem not in supported_filesystems:
        raise SystemExit(f"Unsupported filesystem for existing Storage Service backing volume: {existing_filesystem}. Supported filesystems: xfs, ext4")
    if not existing_filesystem and import_mode in format_modes:
        filesystem = format_empty_device()
    elif not filesystem:
        raise SystemExit(f"No filesystem was detected on {device}; format workflows are not part of existing-volume import")
    if filesystem and filesystem not in supported_filesystems:
        raise SystemExit(f"Unsupported filesystem for Storage Service backing volume: {filesystem}. Supported filesystems: xfs, ext4")
    phase("MOUNTING", devicePath=device, filesystem=filesystem)
    os.makedirs(mount_path, exist_ok=True)
    target = run(["findmnt", "-n", "-o", "SOURCE", "--mountpoint", mount_path])
    if target.returncode == 0 and target.stdout.strip():
        mounted_source = target.stdout.strip().splitlines()[0]
        if os.path.realpath(mounted_source) != os.path.realpath(device):
            raise SystemExit(f"Mount path {mount_path} is already used by another device: {mounted_source}")
    desired_mount_path = mount_path
    current = run(["findmnt", "-n", "-o", "TARGET", "--source", device])
    current_targets = [line.strip() for line in current.stdout.splitlines() if line.strip()] if current.returncode == 0 else []
    if desired_mount_path in current_targets:
        mount_path = desired_mount_path
    else:
        mount_result = run(["mount", device, mount_path])
        if mount_result.returncode != 0:
            raise SystemExit(mount_result.stderr.strip() or f"failed to mount {device}")
        mount_path = desired_mount_path
    if operation.get("formatStarted"):
        probe_fd, probe_path = tempfile.mkstemp(prefix=".ablestack-volume-verify.", dir=mount_path)
        try:
            os.write(probe_fd, b"ABLESTACK volume preparation verification\n")
            os.fsync(probe_fd)
        finally:
            os.close(probe_fd)
            os.unlink(probe_path)
    phase("PERSISTING_MOUNT", filesystemUuid=blkid_value(device, "UUID"))
    fs_uuid = persist_backing_mount(device, mount_path, filesystem)
else:
    if existing_filesystem and existing_filesystem not in supported_filesystems:
        raise SystemExit(f"Unsupported filesystem for existing Storage Service backing volume: {existing_filesystem}. Supported filesystems: xfs, ext4")
    fs_uuid = blkid_value(device, "UUID")

created_directory_receipts = []

def resolve_backing_path(volume_mount_path, relative_path, create_missing):
    if not relative_path:
        return volume_mount_path
    cleaned = relative_path.strip()
    if cleaned.startswith("/") or "\\" in cleaned or any(ord(character) < 32 for character in cleaned) or any(part in ("", ".", "..") for part in cleaned.split("/")):
        raise SystemExit(f"Invalid backing volume relative share path: {relative_path}")
    if cleaned == "export":
        raise SystemExit("The legacy /export root cannot be used as a share backing directory")
    root = os.path.abspath(volume_mount_path)
    if os.path.realpath(root) != root:
        raise SystemExit("Backing volume root contains a symlink")
    root_mount = run(["findmnt", "-n", "-o", "TARGET", "-T", root])
    if root_mount.returncode or root_mount.stdout.strip() != root:
        raise SystemExit("Cannot verify backing volume mount boundary")
    descriptor = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    stage_descriptor = None
    device = os.fstat(descriptor).st_dev
    target = root
    try:
        components = cleaned.split("/")
        for index, segment in enumerate(components):
            initialized = None
            try:
                child = os.open(segment, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            except FileNotFoundError:
                if not create_missing:
                    raise SystemExit("Backing volume relative share path does not exist")
                if stage_descriptor is None:
                    stage_name = ".ablestack-directory-initializers"
                    try: os.mkdir(stage_name, mode=0o700, dir_fd=descriptor)
                    except FileExistsError: pass
                    stage_descriptor = os.open(stage_name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
                permissions = (config.get("newDirectoryPermissions") or {}) if index == len(components) - 1 else {}
                mode = str(permissions.get("mode") or "0755")
                if not re.fullmatch(r"0?[0-7]{3,4}", mode): raise ValueError("New backing directory mode is invalid")
                initialized = publish_new_directory(descriptor, stage_descriptor, segment, permissions.get("ownerUid"), permissions.get("ownerGid"), int(mode, 8))
                child = os.open(segment, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
                if initialized:
                    opened = os.fstat(child)
                    if (opened.st_dev, opened.st_ino) != (initialized["device"], initialized["inode"]):
                        raise ValueError("New backing directory changed after atomic publication")
                    created_directory_receipts.append({**initialized, "relativePath": "/".join(components[:index + 1]),
                                                       "filesystemUuid": fs_uuid, "volumeUuid": volume_key})
            os.close(descriptor); descriptor = child
            target = os.path.join(target, segment)
            observed = run(["findmnt", "-n", "-o", "TARGET", "-T", target])
            if os.fstat(descriptor).st_dev != device or observed.returncode or observed.stdout.strip() != root:
                raise SystemExit("Backing share path crosses a filesystem or mount boundary")
        return target
    finally:
        os.close(descriptor)
        if stage_descriptor is not None: os.close(stage_descriptor)

backing_path = resolve_backing_path(mount_path, relative_share_path, create_directory)

if import_mode != "INSPECT_ONLY":
    if operation.get("formatReceiptUuid") and not operation.get("formatReceipt"):
        root_descriptor = os.open(mount_path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            root_info = os.fstat(root_descriptor)
            acl = subprocess.run(["getfacl", "-cpn", "/proc/self/fd/" + str(root_descriptor)],
                                 pass_fds=(root_descriptor,), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                 check=True, timeout=PROBE_TIMEOUT_SECONDS).stdout
            acl_entries = [line.split("#", 1)[0].strip() for line in acl.splitlines() if line.split("#", 1)[0].strip()]
            named = os.lstat(mount_path)
            if (named.st_dev, named.st_ino) != (root_info.st_dev, root_info.st_ino):
                recovery("RECOVERY_REQUIRED", "Formatted filesystem root changed before receipt verification")
            identity = {"filesystemUuid": fs_uuid, "device": root_info.st_dev, "inode": root_info.st_ino,
                        "effectiveUid": root_info.st_uid, "effectiveGid": root_info.st_gid,
                        "effectiveMode": format(stat.S_IMODE(root_info.st_mode), "04o"),
                        "aclSha256": hashlib.sha256(json.dumps(acl_entries, separators=(",", ":")).encode()).hexdigest()}
            operation["formatReceipt"] = {"schemaVersion": 1, "receiptUuid": operation["formatReceiptUuid"],
                                          "volumeUuid": volume_key, "filesystemUuid": fs_uuid,
                                          "matchedBy": resolved_device["matchedBy"], "serial": resolved_device["serial"],
                                          "sizeBytes": expected_size, "directoryIdentity": identity, "createdEpoch": time.time()}
        finally:
            os.close(root_descriptor)
    phase("COMPLETE", filesystemUuid=fs_uuid, mountPath=mount_path, createdDirectoryReceipts=(operation.get("createdDirectoryReceipts") or []) + created_directory_receipts, elapsedSeconds=time.time() - operation.get("started", time.time()))

print(json.dumps({
    "success": True,
    "status": "ok",
    "operation": operation,
    "schemaVersion": 2,
    "operationId": operation.get("operationId"),
    "instanceUuid": payload.get("instanceUuid"),
    "managerOperationUuid": payload.get("managerOperationUuid"),
    "revision": payload.get("revision"),
    "resumed": resume_only,
    "resumeOnly": resume_only,
    "formatInvoked": format_invoked,
    "formatDiscardPolicy": operation.get("formatDiscardPolicy"),
    "formatterOptions": operation.get("formatterOptions"),
    "formatterActive": active_formatter(operation),
    "volumeUuid": payload.get("volumeUuid"),
    "devicePath": device,
    "observedDevicePath": device,
    "matchedBy": resolved_device.get("matchedBy"),
    "serial": resolved_device.get("serial"),
    "filesystem": filesystem,
    "filesystemSupported": filesystem in supported_filesystems,
    "fsUuid": fs_uuid,
    "filesystemUuid": fs_uuid,
    "observedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    "bootId": open("/proc/sys/kernel/random/boot_id", "r", encoding="utf-8").read().strip() if os.path.exists("/proc/sys/kernel/random/boot_id") else "",
    "mountPath": mount_path,
    "volumeMountPath": mount_path,
    "createdDirectoryReceipts": created_directory_receipts,
    "relativeSharePath": relative_share_path,
    "backingPath": backing_path,
    "persistentMount": import_mode != "INSPECT_ONLY",
    "importMode": import_mode,
}, sort_keys=True))
PY
}

volume_operation_status() {
  local payload_file="$1"
  python3 - "$payload_file" <<'PYVOLUME'
import json
import os
from pathlib import Path
import re
import subprocess
import stat
import time
import sys

def read_volume_operation(path):
    try:
        info = path.lstat()
    except FileNotFoundError:
        return {}
    parent = path.parent.lstat()
    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.geteuid() or parent.st_mode & 0o022 or not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077 or info.st_size > 256 * 1024:
        raise ValueError("Volume operation journal is not protected")
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        opened_parent = os.fstat(directory)
        if (opened_parent.st_dev, opened_parent.st_ino, opened_parent.st_uid, opened_parent.st_mode) != (parent.st_dev, parent.st_ino, parent.st_uid, parent.st_mode):
            raise ValueError("Volume operation journal directory changed")
        descriptor = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory)
    finally:
        os.close(directory)
    try:
        opened = os.fstat(descriptor)
        fields = ("st_dev", "st_ino", "st_uid", "st_gid", "st_mode", "st_size", "st_mtime_ns", "st_ctime_ns")
        if tuple(getattr(opened, key) for key in fields) != tuple(getattr(info, key) for key in fields):
            raise ValueError("Volume operation journal changed while opening")
        with os.fdopen(descriptor, "rb", closefd=False) as handle:
            content = handle.read(256 * 1024 + 1)
        after = os.fstat(descriptor)
        if len(content) > 256 * 1024 or tuple(getattr(after, key) for key in fields) != tuple(getattr(opened, key) for key in fields):
            raise ValueError("Volume operation journal changed while reading")
        value = json.loads(content)
        if not isinstance(value, dict): raise ValueError("Volume operation journal is malformed")
        return value
    finally:
        os.close(descriptor)


with open(sys.argv[1], encoding="utf-8") as source:
    payload = json.load(source)
volume = str(payload.get("volumeUuid") or "")
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", volume):
    raise SystemExit("A stable volume UUID is required")
root = Path(os.environ.get("ABLESTACK_STORAGE_VOLUME_OPERATIONS", "/var/lib/ablestack-storage/volume-operations"))
path = root / (volume + ".json")
if not path.exists():
    print(json.dumps({"success": True, "status": "NOT_STARTED", "operationId": "volume-" + volume}))
    raise SystemExit(0)
operation = read_volume_operation(path)
if operation.get("volumeUuid") != volume:
    raise SystemExit("Volume operation identity mismatch")
def formatter_observation(operation):
    pid = operation.get("formatterPid")
    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
        return {"active": False, "state": None}
    try:
        args = Path("/proc/" + str(pid) + "/cmdline").read_bytes().split(bytes([0]))
        active = bool(args and Path(os.fsdecode(args[0])).name in ("mkfs.xfs", "mkfs.ext4")
                      and str(operation.get("devicePath") or "").encode() in args)
        raw = Path("/proc/" + str(pid) + "/stat").read_text()
        state = raw[raw.rfind(")") + 2:].split()[0]
        return {"active": active, "state": state if active else None}
    except (OSError, ValueError, IndexError):
        return {"active": False, "state": None}


def project_volume_operation(operation, formatter, now):
    original = operation.get("phase") or "RECOVERY_REQUIRED"
    started = operation.get("started")
    elapsed = max(0, now - float(started)) if isinstance(started, (int, float)) else None
    deadline = float(operation.get("formatDeadlineSeconds") or 300)
    active = formatter["active"]
    expired = elapsed is not None and elapsed >= deadline
    observed = original
    stale = original == "FORMATTING" and expired
    pending = bool(operation.get("terminationPending"))
    diagnostic = operation.get("diagnostic")
    error = operation.get("errorCode")
    if original in ("FORMATTING", "TIMED_OUT_PENDING_RECONCILE", "RECOVERY_REQUIRED"):
        if active and expired:
            observed = "RECOVERY_REQUIRED" if formatter.get("state") == "D" or pending else "TIMED_OUT_PENDING_RECONCILE"
            pending = True
            error = "FORMATTER_ACTIVE_AFTER_DEADLINE"
            diagnostic = "Formatter remains active after its deadline; preserve the volume, do not retry mkfs or detach it"
        elif not active and original in ("FORMATTING", "TIMED_OUT_PENDING_RECONCILE"):
            observed = "RECONCILE_REQUIRED"
            diagnostic = "Formatter no longer runs; verify the exact existing filesystem before an explicit resume"
    projection = {**operation, "phase": observed, "formatterActive": active, "formatterState": formatter.get("state"),
                  "terminationPending": pending, "elapsedSeconds": elapsed, "stale": stale,
                  "diagnostic": diagnostic, "errorCode": error}
    return {"success": True, "status": observed, "formatterActive": active, "formatterState": formatter.get("state"),
            "terminationPending": pending, "stale": stale, "observedEpoch": now, "elapsedSeconds": elapsed,
            "diagnostic": diagnostic, "errorCode": error, "operationId": operation.get("operationId"),
            "operation": operation, "observedOperation": projection}

print(json.dumps(project_volume_operation(operation, formatter_observation(operation), time.time()), sort_keys=True))

PYVOLUME
}

volume_detach_prepare() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys
import tempfile

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

volume_uuid = str(payload.get("volumeUuid") or "").strip()
mount_path = str(payload.get("mountPath") or "").strip()

def run(args):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=120)

def is_mountpoint(path):
    return bool(path) and run(["findmnt", "-n", "--mountpoint", path]).returncode == 0

def update_fstab(markers):
    fstab_path = "/etc/fstab"
    lines = []
    if os.path.exists(fstab_path):
        with open(fstab_path, "r", encoding="utf-8") as fstab_fp:
            for line in fstab_fp:
                if any(marker and marker in line for marker in markers):
                    continue
                lines.append(line)
    directory = os.path.dirname(fstab_path)
    fd, tmp_path = tempfile.mkstemp(prefix=".fstab.", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as tmp_fp:
            tmp_fp.writelines(lines)
        os.replace(tmp_path, fstab_path)
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)

def daemon_reload():
    if os.path.exists("/bin/systemctl") or os.path.exists("/usr/bin/systemctl"):
        subprocess.run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=20)

if mount_path:
    current = run(["findmnt", "-R", "-n", "-o", "TARGET", "--target", mount_path])
    targets = sorted([line.strip() for line in current.stdout.splitlines() if line.strip()], key=len, reverse=True) if current.returncode == 0 else []
    for target in targets:
        unmount = run(["umount", target])
        if unmount.returncode != 0:
            raise SystemExit(unmount.stderr.strip() or f"failed to unmount {target}")

markers = []
if volume_uuid:
    markers.append(volume_uuid)
if mount_path:
    markers.append(mount_path)
update_fstab(markers)
daemon_reload()
print(json.dumps({
    "success": True,
    "status": "ok",
    "volumeUuid": volume_uuid,
    "mountPath": mount_path,
    "detachedInGuest": True,
    "dataDeleted": False
}, sort_keys=True))
PY
}

volume_rescan() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

sys.path.insert(0, "/usr/local/lib/ablestack-storage")
from volume_identity import VolumeIdentityError, resolve_volume_device  # noqa: E402

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

def run(args, timeout=60):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)

def settle():
    if os.path.exists("/usr/bin/udevadm") or os.path.exists("/bin/udevadm"):
        subprocess.run(["udevadm", "settle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=60)

def lsblk():
    result = run(["lsblk", "-b", "-J", "-o", "NAME,PATH,TYPE,FSTYPE,UUID,SERIAL,SIZE,MOUNTPOINT"], timeout=30)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "lsblk failed")
    return json.loads(result.stdout).get("blockdevices", [])

def walk(devices, parent_disk=None):
    for dev in devices:
        disk = dev if dev.get("type") == "disk" else parent_disk
        dev["_parentDisk"] = disk
        yield dev
        for child in dev.get("children") or []:
            yield from walk([child], disk)

def compact(value):
    return "".join(ch for ch in str(value or "").lower() if ch.isalnum())

def token_matches(value, tokens):
    candidate = compact(value)
    if not candidate:
        return False
    for token in tokens:
        if len(token) >= 8 and (token in candidate or candidate in token):
            return True
    return False

def resolve_disk(device_path):
    devices = list(walk(lsblk()))
    identities = [
        ("volumeUuid", compact(payload.get("volumeUuid"))),
        ("volumeName", compact(payload.get("volumeName")))
    ]
    identities = [(kind, token) for kind, token in identities if token]
    root_disks = {
        dev.get("_parentDisk", {}).get("name")
        for dev in devices
        if dev.get("_parentDisk") and (dev.get("mountpoint") in ("/", "/boot", "/boot/efi") or dev.get("fstype") == "swap")
    }
    if device_path:
        real_path = os.path.realpath(device_path)
        for dev in devices:
            if os.path.realpath(dev.get("path") or "") == real_path and dev.get("_parentDisk"):
                disk = dev["_parentDisk"]
                if disk.get("name") not in root_disks:
                    return {
                        "name": disk.get("name"),
                        "path": disk.get("path") or f"/dev/{disk.get('name')}",
                        "matchedBy": "devicePath"
                    }
    candidates = {}
    for dev in devices:
        disk = dev.get("_parentDisk") or dev
        name = disk.get("name")
        if not name or name in root_disks or disk.get("type") != "disk":
            continue
        for identity_kind, token in identities:
            if any(token_matches(dev.get(key), [token]) for key in ("name", "path", "serial", "uuid")):
                candidates[name] = {
                    "name": name,
                    "path": disk.get("path") or f"/dev/{name}",
                    "matchedBy": identity_kind
                }
                break
    if not candidates:
        raise SystemExit(
            "Unable to identify the exact attached Storage Service volume device for "
            f"{payload.get('volumeUuid') or payload.get('volumeName') or 'unknown volume'}"
        )
    if len(candidates) != 1:
        raise SystemExit("Ambiguous attached Storage Service volume mapping: " + ", ".join(sorted(candidates)))
    return next(iter(candidates.values()))

def rescan_disk(target):
    name = target.get("name")
    rescan_path = f"/sys/block/{name}/device/rescan"
    if not name or not os.path.exists(rescan_path):
        raise SystemExit(f"Rescan path is unavailable for the resolved Storage Service volume device: {name}")
    with open(rescan_path, "w", encoding="utf-8") as rescan_fp:
        rescan_fp.write("1\n")
    return {"disk": name, "devicePath": target.get("path"), "matchedBy": target.get("matchedBy"), "rescanned": True}

settle()
config = payload.get("config") or {}
inspection = config.get("lastInspection") or config.get("lastinspection") or {}
mount_path = payload.get("mountPath") or config.get("volumeMountPath") or inspection.get("volumeMountPath")
mount_source = None
if mount_path:
    mounted = run(["findmnt", "-n", "-o", "SOURCE", "--target", mount_path], timeout=10)
    if mounted.returncode == 0 and mounted.stdout.strip():
        mount_source = mounted.stdout.strip().splitlines()[0]
try:
    resolved = resolve_volume_device(
        lsblk(),
        volume_uuid=payload.get("volumeUuid"),
        volume_name=payload.get("volumeName"),
        filesystem_uuid=(inspection.get("filesystemUuid") or inspection.get("fsUuid")
                         or config.get("filesystemUuid") or config.get("fsUuid")),
        mount_source=mount_source,
    )
except VolumeIdentityError as error:
    raise SystemExit(str(error))
target = {
    "name": resolved.get("diskName"),
    "path": resolved.get("diskPath"),
    "matchedBy": resolved.get("matchedBy"),
}
result = rescan_disk(target)
settle()
expected_size = int(payload.get("volumeSizeBytes") or 0)
actual_size = 0
deadline = time.time() + 30
while time.time() < deadline:
    observed = run(["blockdev", "--getsize64", target.get("path")], timeout=10)
    if observed.returncode == 0 and observed.stdout.strip().isdigit():
        actual_size = int(observed.stdout.strip())
        if expected_size <= 0 or actual_size >= expected_size:
            break
    time.sleep(1)
    settle()
if expected_size > 0 and actual_size < expected_size:
    raise SystemExit(
        f"Storage Service volume rescan did not expose the requested size on {target.get('path')}: "
        f"expected at least {expected_size} bytes, observed {actual_size} bytes"
    )

print(json.dumps({
    "success": True,
    "status": "ok",
    "volumeUuid": payload.get("volumeUuid"),
    "volumeName": payload.get("volumeName"),
    "volumeSizeBytes": expected_size,
    "actualSizeBytes": actual_size,
    "devicePath": target.get("path"),
    "observedDevicePath": target.get("path"),
    "matchedBy": target.get("matchedBy"),
    "observedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    "bootId": open("/proc/sys/kernel/random/boot_id", "r", encoding="utf-8").read().strip() if os.path.exists("/proc/sys/kernel/random/boot_id") else "",
    "rescans": [result]
}, sort_keys=True))
PY
}

filesystem_resize() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import datetime
import json
import os
import subprocess
import sys

sys.path.insert(0, "/usr/local/lib/ablestack-storage")
from volume_identity import VolumeIdentityError, resolve_volume_device  # noqa: E402

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

def run(args):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=120)

def lsblk():
    result = run(["lsblk", "-J", "-b", "-o", "NAME,KNAME,PATH,TYPE,SIZE,FSTYPE,UUID,SERIAL,MOUNTPOINT"])
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "Unable to inspect attached Storage Service volumes")
    return json.loads(result.stdout).get("blockdevices") or []

mount_path = payload.get("path")
config = payload.get("config") or {}
inspection = config.get("lastInspection") or {}
filesystem = payload.get("filesystem") or inspection.get("filesystem")
mount_source = None

if mount_path:
    source_result = run(["findmnt", "-n", "-o", "SOURCE,FSTYPE", "--target", mount_path])
    if source_result.returncode == 0 and source_result.stdout.strip():
        parts = source_result.stdout.strip().split()
        if parts:
            mount_source = parts[0]
        if len(parts) > 1:
            filesystem = filesystem or parts[1]

try:
    resolved = resolve_volume_device(
        lsblk(),
        volume_uuid=payload.get("volumeUuid"),
        volume_name=payload.get("volumeName"),
        filesystem_uuid=(inspection.get("filesystemUuid") or inspection.get("fsUuid")
                         or config.get("filesystemUuid") or config.get("fsUuid")),
        mount_source=mount_source,
        expected_size=payload.get("volumeSizeBytes"),
        allow_blank_size_fallback=False,
    )
except VolumeIdentityError as exc:
    raise SystemExit(str(exc))

device = resolved.get("devicePath")
filesystem = filesystem or resolved.get("filesystem")
if not device:
    raise SystemExit("Unable to resolve the exact mounted device for filesystem resize")

if filesystem == "xfs":
    if not mount_path:
        raise SystemExit("XFS resize requires a mounted path")
    result = run(["xfs_growfs", mount_path])
elif filesystem in ("ext2", "ext3", "ext4"):
    result = run(["resize2fs", device])
else:
    raise SystemExit(f"Unsupported filesystem for resize: {filesystem}")

if result.returncode != 0:
    raise SystemExit(result.stderr.strip() or result.stdout.strip() or "filesystem resize failed")

print(json.dumps({
    "success": True,
    "status": "ok",
    "observedDevicePath": device,
    "matchedBy": resolved.get("matchedBy"),
    "observedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "bootId": open("/proc/sys/kernel/random/boot_id", "r", encoding="utf-8").read().strip()
        if os.path.exists("/proc/sys/kernel/random/boot_id") else "",
    "filesystem": filesystem,
    "filesystemUuid": resolved.get("filesystemUuid"),
    "mountPath": mount_path,
    "quotaBytes": payload.get("quotaBytes"),
    "volumeSizeGb": payload.get("volumeSizeGb"),
}, sort_keys=True))
PY
}

nvmeof_prepare() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import shutil
import subprocess
import sys

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

engine = str(payload.get("engine") or "KERNEL_NVMET").upper()
transport = str(payload.get("transport") or "tcp").lower()
if engine == "SPDK":
    print(json.dumps({
        "success": False,
        "status": "PREPARATION_REQUIRED",
        "engine": engine,
        "transport": transport,
        "vmRuntimeCapabilityRequired": True,
    }, sort_keys=True))
    raise SystemExit(1)
if engine != "KERNEL_NVMET":
    raise SystemExit(f"Unsupported NVMe-oF engine: {engine}")
if transport != "tcp":
    raise SystemExit(f"Unsupported NVMe-oF transport: {transport}")

for module in ("configfs", "nvmet", "nvmet-tcp"):
    subprocess.run(["modprobe", module], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

commands = {
    "nvme": shutil.which("nvme") is not None,
    "nvmetcli": shutil.which("nvmetcli") is not None,
}
modules = {
    "configfs": os.path.isdir("/sys/kernel/config"),
    "nvmet": os.path.isdir("/sys/kernel/config/nvmet"),
}
status = "ok" if modules["configfs"] and modules["nvmet"] else "missing_prerequisites"
print(json.dumps({
    "success": status == "ok",
    "status": status,
    "engine": engine,
    "transport": transport,
    "commands": commands,
    "modules": modules,
    "validateOnly": bool(payload.get("validateOnly")),
}, sort_keys=True))
if status != "ok":
    raise SystemExit(1)
PY
}

apply_nfs_exports() {
  local payload_file="$1"

  if [[ -z "${ABLESTACK_STORAGE_RENDERED_REPLAY:-}" ]] && command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now nfs-server >/dev/null 2>&1 || systemctl disable --now nfs-kernel-server >/dev/null 2>&1 || true
    systemctl disable --now nfs-ganesha.service >/dev/null 2>&1 || true
    systemctl reset-failed nfs-ganesha.service >/dev/null 2>&1 || true
  fi
  if [[ -z "${ABLESTACK_STORAGE_RENDERED_REPLAY:-}" ]]; then exportfs -ua >/dev/null 2>&1 || true; fi

  python3 - "$payload_file" <<'PY'
import json
from pathlib import Path
import stat
import ipaddress
import os
import re
import shutil
import subprocess
import signal
import sys
import tempfile
import time
import socket
import zlib
import hashlib

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

id_mapping_mode = str(payload.get("idMappingMode") or "NAME_DOMAIN").strip().upper()
if id_mapping_mode not in ("NAME_DOMAIN", "NUMERIC"):
    raise ValueError("Unsupported service-wide NFS owner mapping mode")
if id_mapping_mode == "NUMERIC" and str(payload.get("securityType") or "sys").lower() != "sys":
    raise ValueError("NUMERIC NFS owner mapping requires AUTH_SYS")

exports_dir = "/etc/exports.d"
quota_dir = "/etc/ablestack-storage"
alias_state_path = os.path.join(quota_dir, "nfs-export-aliases.json")
ganesha_conf_dir = "/etc/ganesha/ablestack-storage"

nfs_operation_deadline=time.monotonic()+max(1,min(180,float(os.environ.get("ABLESTACK_STORAGE_RENDERED_BUDGET","180"))))
def ganesha_remaining(maximum=10):
    value=min(maximum,nfs_operation_deadline-time.monotonic())
    if value<=0:raise TimeoutError("NFS total activation deadline exhausted")
    return value


def rendered_runtime_context(domain, source=False):
    value = os.environ.get("ABLESTACK_STORAGE_RENDERED_FROM" if source else "ABLESTACK_STORAGE_RENDERED_REPLAY")
    if not value: return None
    root = Path(os.environ.get("ABLESTACK_STORAGE_RENDERED_GENERATIONS", "/var/lib/ablestack-storage/rendered-generations"))
    pointer = root / "current"
    if not re.fullmatch(r"[0-9a-f-]{36}",Path(value).name) or Path(value)!=root/"generations"/Path(value).name:
        raise ValueError("Internal rendered replay path is outside its generation root")
    if not source and (not pointer.is_symlink() or os.readlink(pointer) != "generations/" + Path(value).name or Path(value) != root / os.readlink(pointer)):
        raise ValueError("Internal rendered replay differs from the managed current pointer")
    for parent in (root, root / "generations", Path(value)):
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
            raise ValueError("Internal rendered generation parent is not protected")
    def read(name):
        path = Path(value) / name
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > 8 * 1024 * 1024:
            raise ValueError("Internal rendered generation file is not protected")
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            opened = os.fstat(descriptor)
            if (opened.st_dev, opened.st_ino, opened.st_mode, opened.st_size) != (info.st_dev, info.st_ino, info.st_mode, info.st_size):
                raise ValueError("Internal rendered generation changed")
            data = os.read(descriptor, 8 * 1024 * 1024 + 1)
            after = os.fstat(descriptor)
            if (after.st_size, after.st_mtime_ns, after.st_ctime_ns) != (opened.st_size, opened.st_mtime_ns, opened.st_ctime_ns):
                raise ValueError("Internal rendered file changed while reading")
            return data
        finally: os.close(descriptor)
    manifest = json.loads(read("generation.json"))
    canonical = {key:item for key,item in manifest.items() if key != "manifestSha256"}
    if hashlib.sha256(json.dumps(canonical, sort_keys=True, separators=(",", ":")).encode()).hexdigest() != manifest.get("manifestSha256"):
        raise ValueError("Internal rendered generation manifest hash changed")
    journal_path=root/"activation.json"
    info=journal_path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid!=os.geteuid() or stat.S_IMODE(info.st_mode)!=0o600:
        raise ValueError("Internal rendered journal is not protected")
    fd=os.open(journal_path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        opened=os.fstat(fd)
        if (opened.st_dev,opened.st_ino,opened.st_mode,opened.st_size)!=(info.st_dev,info.st_ino,info.st_mode,info.st_size):raise ValueError("Rendered journal changed while opening")
        journal=json.loads(os.read(fd,8*1024*1024+1))
    finally:os.close(fd)
    if manifest["manifestSha256"] not in (journal.get("targetSha256"), journal.get("previousSha256")):
        raise ValueError("Internal rendered replay is outside its pinned activation")
    for name, digest in manifest["files"].items():
        if not re.fullmatch(r"(?:nfs/manifest.json|nfs/ganesha/[0-9a-f]{24}\.conf|nfs/exports/[0-9a-f-]{36}\.exports|smb/smb.conf|smb/manifest.json|smb/listeners/[0-9a-f]{24}\.json|block/(?:iscsi|nvmeof)-plan.json|desired-state.json|network-bindings.json|posix-plan.json|prerequisites.json|file-volumes.json)", name):
            raise ValueError("Internal rendered replay has an unexpected path")
        if hashlib.sha256(read(name)).hexdigest() != digest:
            raise ValueError("Internal rendered runtime file hash changed")
    return Path(value), manifest

rendered_context = rendered_runtime_context("NFS")
rendered_from_context = rendered_runtime_context("NFS", source=True) if rendered_context else None
ganesha_run_dir = "/run/ablestack-storage/ganesha"
ganesha_default_run_dir = "/run/ganesha"
ganesha_default_pid_path = os.path.join(ganesha_default_run_dir, "ganesha.pid")
nfs_probe_root = "/run/ablestack-storage/nfs-probe"
os.makedirs(exports_dir, exist_ok=True)
os.makedirs(quota_dir, exist_ok=True)
os.makedirs(ganesha_conf_dir, exist_ok=True)
os.makedirs(ganesha_run_dir, exist_ok=True)
os.makedirs(ganesha_default_run_dir, exist_ok=True)
os.makedirs(nfs_probe_root, exist_ok=True)

def remove_legacy_root_export():
    exports_path = "/etc/exports"
    if not os.path.exists(exports_path):
        return
    kept = []
    changed = False
    with open(exports_path, "r", encoding="utf-8") as exports_fp:
        for line in exports_fp:
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and stripped.split()[0].rstrip("/") == "/export":
                changed = True
                continue
            kept.append(line)
    if changed:
        with open(exports_path, "w", encoding="utf-8") as exports_fp:
            exports_fp.writelines(kept)

def truth(config, key, default):
    value = config.get(key, default) if isinstance(config, dict) else default
    return bool(value)

def int_config(config, key):
    if not isinstance(config, dict) or config.get(key) in (None, ""):
        return None
    try:
        value = int(config.get(key))
    except Exception as exc:
        raise ValueError(f"invalid integer NFS option {key}: {config.get(key)}") from exc
    if value < 0 or value > 65535:
        raise ValueError(f"NFS option {key} must be between 0 and 65535")
    return value

def mode_config(config):
    if not isinstance(config, dict) or not config.get("mode"):
        return None
    value = str(config.get("mode")).strip()
    if not re.match(r"^0?[0-7]{3,4}$", value):
        raise ValueError(f"invalid NFS directory mode: {value}")
    return int(value, 8)

def effective_nfs_export_config(config):
    result = dict(config or {})
    read_only = truth(result, "readOnly", False)
    root_squash = truth(result, "rootSquash", True)
    if read_only or not root_squash:
        return result
    if result.get("anonUid") in (None, ""):
        result["anonUid"] = 65534
    if result.get("anonGid") in (None, ""):
        result["anonGid"] = 65534
    if result.get("ownerUid") in (None, ""):
        result["ownerUid"] = result.get("anonUid")
    if result.get("ownerGid") in (None, ""):
        result["ownerGid"] = result.get("anonGid")
    if result.get("mode") in (None, ""):
        result["mode"] = "0775"
    if result.get("recursivePermission") in (None, ""):
        result["recursivePermission"] = False
    if result.get("posixPolicy") in (None, ""):
        result["posixPolicy"] = "ANONYMOUS_WRITE"
    return result

def safe_uuid(value):
    value = str(value or "")
    if not re.match(r"^[A-Za-z0-9_.-]+$", value):
        raise ValueError(f"invalid export uuid: {value}")
    return value

def safe_export_root_name(value, path):
    value = str(value or "").strip().strip("/")
    if not value and path:
        value = os.path.basename(str(path).rstrip("/"))
    if not value or value in (".", ".."):
        raise ValueError("NFS export name is required")
    value = re.sub(r"[^A-Za-z0-9_.-]+", "-", value)
    value = value.strip(".-")
    if not value:
        raise ValueError("NFS export name is invalid")
    return value

def nfs_export_principal(value):
    value = str(value or "").strip()
    if value in ("0.0.0.0/0", "::/0"):
        return "*"
    if any(ch.isspace() for ch in value):
        raise ValueError(f"invalid NFS export principal: {value}")
    return value

def ganesha_clients(value):
    rendered = nfs_export_principal(value)
    return "*" if rendered == "*" else rendered

def ganesha_squash(all_squash, root_squash):
    if all_squash:
        return "All_Squash"
    return "Root_Squash" if root_squash else "No_Root_Squash"

def ganesha_access(permission, read_only):
    return "RW" if permission == "READ_WRITE" and not read_only else "RO"

def quote_ganesha(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'

def ganesha_raw_literal(value, label):
    token = str(value or "").strip()
    if not token:
        raise ValueError(f"{label} is required")
    if re.search(r"\s", token) or any(ch in token for ch in ['"', "'", ";", "{", "}"]):
        raise ValueError(f"invalid {label}: {token}")
    return token


def ganesha_bind_addr(value):
    return ganesha_raw_literal(value or "0.0.0.0", "Ganesha bind address")


def ganesha_client_list(value):
    rendered = ganesha_clients(value)
    tokens = [item.strip() for item in str(rendered).split(",") if item.strip()]
    if not tokens:
        raise ValueError("Ganesha client list is required")
    return ", ".join(ganesha_raw_literal(item, "Ganesha client") for item in tokens)

def nfs_protocols_for_mode(protocol_mode):
    mode = str(protocol_mode or "V4_ONLY").strip().upper()
    return "3,4" if mode == "V3V4_DUAL" else "4"

def nfs_protocol_mode_from_content(content):
    if not content:
        return "V4_ONLY"
    for match in re.finditer(r"Protocols\s*=\s*([^;]+);", content, re.I):
        value = re.sub(r"\s+", "", match.group(1))
        if "3" in value and "4" in value:
            return "V3V4_DUAL"
        if value == "4":
            return "V4_ONLY"
    return "V4_ONLY"

GANESHA_EXPORT_ID_MIN = 1000
GANESHA_EXPORT_ID_MAX = 65535

def export_id(value):
    span = GANESHA_EXPORT_ID_MAX - GANESHA_EXPORT_ID_MIN + 1
    return GANESHA_EXPORT_ID_MIN + (zlib.crc32(str(value).encode("utf-8")) % span)

def assign_ganesha_export_ids(exports):
    span = GANESHA_EXPORT_ID_MAX - GANESHA_EXPORT_ID_MIN + 1
    used = set()
    assigned = []
    for index, export in enumerate(exports or []):
        rendered = dict(export)
        source = rendered.get("uuid") or rendered.get("name") or rendered.get("path") or index
        candidate = export_id(source)
        for _ in range(span):
            if candidate not in used:
                used.add(candidate)
                rendered["id"] = candidate
                assigned.append(rendered)
                break
            candidate += 1
            if candidate > GANESHA_EXPORT_ID_MAX:
                candidate = GANESHA_EXPORT_ID_MIN
        else:
            raise RuntimeError("No available Ganesha Export_Id values for Storage Service NFS endpoint")
    return assigned

def endpoint_key(ip, port):
    safe_ip = re.sub(r"[^A-Za-z0-9_.-]+", "_", str(ip or "0.0.0.0"))
    return f"{safe_ip}_{int(port)}"

def rpcbind_active():
    if not shutil.which("systemctl"):
        return False
    for unit in ("rpcbind.socket", "rpcbind.service"):
        try:
            result = subprocess.run(["systemctl", "is-active", "--quiet", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if result.returncode == 0:
                return True
        except Exception:
            continue
    return False

def ensure_rpcbind_started():
    if not shutil.which("systemctl"):
        return False
    started = False
    for unit in ("rpcbind.socket", "rpcbind.service"):
        try:
            result = subprocess.run(["systemctl", "start", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            started = started or result.returncode == 0
        except Exception:
            continue
    return rpcbind_active() or started

def nfs_export_endpoint_ips(export_config, default_ip):
    mode = str(export_config.get("endpointMode") or export_config.get("endpointmode") or "").strip().upper()
    raw_ips = export_config.get("listenIps") if "listenIps" in export_config else export_config.get("listenips")
    if isinstance(raw_ips, list):
        ips = [str(item).strip() for item in raw_ips if str(item).strip()]
    elif raw_ips:
        ips = [str(item).strip() for item in str(raw_ips).split(",") if str(item).strip()]
    else:
        ips = []
    if mode == "SELECTED":
        if not ips:
            return [default_ip or "0.0.0.0"]
        return ips
    if not mode and ips:
        return ips
    return [default_ip or "0.0.0.0"]

def nfs_export_listener_ports(export_config, default_port, protocol_mode):
    if str(protocol_mode or "V4_ONLY").strip().upper() == "V3V4_DUAL":
        return [2049]
    raw_ports = None
    for key in ("listenerGroupPorts", "listenergroupports", "listenerPorts", "listenerports"):
        if key in export_config:
            raw_ports = export_config.get(key)
            break
    if isinstance(raw_ports, list):
        values = raw_ports
    elif raw_ports is None or str(raw_ports).strip() == "":
        values = []
    else:
        values = str(raw_ports).split(",")
    ports = []
    seen = set()
    for value in values:
        try:
            port = int(str(value).strip())
        except Exception:
            continue
        if 1 <= port <= 65535 and port not in seen:
            seen.add(port)
            ports.append(port)
    if not ports:
        try:
            fallback = int(default_port or 2049)
        except Exception:
            fallback = 2049
        ports.append(fallback)
    return ports

def cleanup_legacy_kernel_exports(managed_files):
    for name in os.listdir(exports_dir):
        if name.startswith("ablestack-") and name.endswith(".exports"):
            full_path = os.path.join(exports_dir, name)
            if full_path not in managed_files:
                managed_files.add(full_path)
            with open(full_path, "w", encoding="utf-8"):
                pass

def process_cmdline(pid):
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as cmd_fp:
            return cmd_fp.read().replace(b"\x00", b" ").decode("utf-8", "replace").strip()
    except Exception:
        return ""


def process_exists(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except Exception:
        return False


def managed_ganesha_process(pid):
    cmdline = process_cmdline(pid)
    return "ganesha.nfsd" in cmdline and ganesha_conf_dir in cmdline


def tail_file(path, limit=20):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fp:
            lines = fp.readlines()
        return "".join(lines[-limit:]).strip()
    except Exception:
        return ""



def cleanup_default_ganesha_pid(stale_only=True):
    try:
        with open(ganesha_default_pid_path, "r", encoding="utf-8") as pid_fp:
            pid = int(pid_fp.read().strip())
    except FileNotFoundError:
        return
    except Exception:
        try:
            os.unlink(ganesha_default_pid_path)
        except Exception:
            pass
        return
    if process_exists(pid):
        if stale_only:
            return
        cmdline = process_cmdline(pid)
        if "ganesha.nfsd" in cmdline and ganesha_conf_dir not in cmdline:
            try:
                os.kill(pid, 15)
            except Exception:
                return
        else:
            return
    deadline = time.time() + 5
    while process_exists(pid) and time.time() < deadline:
        time.sleep(0.2)
    if not process_exists(pid):
        try:
            os.unlink(ganesha_default_pid_path)
        except FileNotFoundError:
            pass
        except Exception:
            pass


def ensure_ganesha_runtime_dirs():
    os.makedirs(ganesha_conf_dir, exist_ok=True)
    os.makedirs(ganesha_run_dir, exist_ok=True)
    os.makedirs(ganesha_default_run_dir, exist_ok=True)
    cleanup_default_ganesha_pid(stale_only=True)


def terminate_pid(pid):
    try:
        pid = int(pid)
    except Exception:
        return
    if not managed_ganesha_process(pid):
        return
    try:
        os.kill(pid, 15)
    except ProcessLookupError:
        return
    except Exception:
        return
    deadline = time.time() + 5
    while time.time() < deadline:
        if not os.path.exists(f"/proc/{pid}"):
            return
        time.sleep(0.2)
    try:
        os.kill(pid, 9)
    except Exception:
        pass


def stop_default_ganesha_service():
    if shutil.which("systemctl"):
        for unit in ("nfs-ganesha.service",):
            subprocess.run(["systemctl", "disable", "--now", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=ganesha_remaining(20))
            subprocess.run(["systemctl", "reset-failed", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=ganesha_remaining(20))
    try:
        with open(ganesha_default_pid_path, "r", encoding="utf-8") as pid_fp:
            pid = int(pid_fp.read().strip())
        cmdline = process_cmdline(pid)
        if "ganesha.nfsd" in cmdline and ganesha_conf_dir not in cmdline:
            cleanup_default_ganesha_pid(stale_only=False)
    except Exception:
        cleanup_default_ganesha_pid(stale_only=True)



def stop_ganesha_endpoints(active_keys=None):
    active_keys = set(active_keys or [])
    unit_prefix = "ablestack-storage-ganesha@"
    if shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
        try:
            proc = subprocess.run(["systemctl", "list-units", "--all", "--plain", "--no-legend", f"{unit_prefix}*.service"],
                                  text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False, timeout=ganesha_remaining(20))
            for line in proc.stdout.splitlines():
                unit = line.split()[0] if line.split() else ""
                if not unit.startswith(unit_prefix) or not unit.endswith(".service"):
                    continue
                key = unit[len(unit_prefix):-len(".service")]
                if key in active_keys:
                    continue
                subprocess.run(["systemctl", "stop", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=ganesha_remaining(30))
                subprocess.run(["systemctl", "reset-failed", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=ganesha_remaining(20))
        except Exception:
            pass
    for name in os.listdir(ganesha_run_dir):
        if not name.endswith(".pid"):
            continue
        pid_path = os.path.join(ganesha_run_dir, name)
        key = name[:-4]
        if key in active_keys:
            continue
        try:
            with open(pid_path, "r", encoding="utf-8") as pid_fp:
                pid = int(pid_fp.read().strip())
            terminate_pid(pid)
        except Exception:
            pass
        try:
            os.unlink(pid_path)
        except Exception:
            pass

def nested_export_filesystem_id(export_uuid):
    # Distinct NFSv4 inode/open-owner identities for overlapping exports.
    # Do not depend on the assigned 16-bit Export_Id or listener ordering.
    digest = hashlib.sha256(str(export_uuid).encode("utf-8")).digest()
    return f"{int.from_bytes(digest[:8], 'big')}.{int.from_bytes(digest[8:16], 'big')}"

def render_ganesha_export(rendered):
    protocol_mode = str(rendered.get('protocolMode') or 'V4_ONLY').strip().upper()
    anonymous_uid = rendered.get("anonUid")
    anonymous_gid = rendered.get("anonGid")
    lines = [
        "EXPORT {",
        f"    Export_Id = {rendered['id']};",
        f"    Path = {quote_ganesha(rendered['path'])};",
        f"    Pseudo = {quote_ganesha(rendered['pseudo'])};",
        f"    Protocols = {nfs_protocols_for_mode(protocol_mode)};",
        "    Transports = TCP;",
        "    Access_Type = None;",
        "    Squash = Root_Squash;",
        "    SecType = sys;",
        "    FSAL {",
        "        Name = VFS;",
        "    }",
    ]
    if rendered.get("filesystemId"):
        lines.append(f"    Filesystem_Id = {rendered['filesystemId']};")
    if anonymous_uid is not None:
        lines.append(f"    Anonymous_uid = {int(anonymous_uid)};")
    if anonymous_gid is not None:
        lines.append(f"    Anonymous_gid = {int(anonymous_gid)};")
    for client in rendered["clients"]:
        lines.extend([
            "    CLIENT {",
            f"        Clients = {ganesha_client_list(client['clients'])};",
            f"        Access_Type = {client['access']};",
            f"        Squash = {client['squash']};",
        ])
        if client.get("anonUid") is not None:
            lines.append(f"        Anonymous_uid = {int(client['anonUid'])};")
        if client.get("anonGid") is not None:
            lines.append(f"        Anonymous_gid = {int(client['anonGid'])};")
        lines.append("    }")
    lines.append("}")
    return "\n".join(lines)

def write_ganesha_configs(endpoint_exports, port):
    if globals().get("rendered_context"):
        root, manifest = rendered_context
        endpoints = json.loads((root / "nfs/manifest.json").read_text())["endpoints"]
        configs = []
        for endpoint in endpoints:
            key = endpoint["legacyUnitKey"]
            if not re.fullmatch(r"[A-Za-z0-9_.-]+", key): raise ValueError("Rendered Ganesha unit key is invalid")
            path = Path(ganesha_conf_dir) / (key + ".conf")
            desired = root.parent.parent / "current" / endpoint["configurationPath"]
            if path.is_symlink() and os.readlink(path) == str(desired): pass
            elif path.exists() and not path.is_symlink():
                info = path.lstat()
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
                    raise ValueError("Legacy Ganesha config is not protected")
                temporary = path.with_name(".rendered-" + key)
                temporary.unlink(missing_ok=True); temporary.symlink_to(desired); os.replace(temporary, path)
            elif not path.exists() and not path.is_symlink(): path.symlink_to(desired)
            else: raise ValueError("Ganesha configuration symlink belongs to another source")
            configs.append((key, str(path), endpoint["listenIp"], endpoint["port"], endpoint["mode"]))
        return configs
    for name in os.listdir(ganesha_conf_dir):
        if name.endswith(".conf"):
            os.unlink(os.path.join(ganesha_conf_dir, name))
    configs = []
    for (ip, endpoint_port), exports in sorted(endpoint_exports.items()):
        if not exports:
            continue
        endpoint_mode = "V3V4_DUAL" if any(str(export.get("protocolMode") or "V4_ONLY").strip().upper() == "V3V4_DUAL" for export in exports) else "V4_ONLY"
        key = endpoint_key(ip, endpoint_port)
        conf_path = os.path.join(ganesha_conf_dir, f"{key}.conf")
        content = [
            "NFS_Core_Param {",
            f"    NFS_Port = {int(endpoint_port)};",
            f"    Bind_addr = {ganesha_bind_addr(ip)};",
            '    Dbus_Name_Prefix = "org.ablestack.storage.ganesha.e' + hashlib.sha256((ip + ":" + str(endpoint_port)).encode()).hexdigest()[:24] + '";',
            f"    Protocols = {nfs_protocols_for_mode(endpoint_mode)};",
        ]
        if endpoint_mode == "V3V4_DUAL":
            content.append("    mount_path_pseudo = true;")
        else:
            content.extend([
                "    Enable_NLM = false;",
                "    Enable_RQUOTA = false;",
            ])
        content.extend([
            "}",
            "NFSV4 {",
            "    Grace_Period = 5;",
            "    Allow_Numeric_Owners = true;",
            "    Only_Numeric_Owners = " + ("true" if id_mapping_mode == "NUMERIC" else "false") + ";",
            "}",
            "EXPORT_DEFAULTS {",
            "    Access_Type = None;",
            f"    Protocols = {nfs_protocols_for_mode(endpoint_mode)};",
            "    Transports = TCP;",
            "    SecType = sys;",
            "}",
        ])
        rendered_exports = assign_ganesha_export_ids(exports)
        content.extend(render_ganesha_export(export) for export in rendered_exports)
        with open(conf_path, "w", encoding="utf-8") as conf_fp:
            conf_fp.write("\n\n".join(content) + "\n")
        configs.append((key, conf_path, ip, endpoint_port, endpoint_mode))
    return configs


# BEGIN EMBEDDED GANESHA DBUS
EXPORT_PATH="/org/ganesha/nfsd/ExportMgr"
EXPORT_INTERFACE="org.ganesha.nfsd.exportmgr"


class GaneshaDbus:
    def __init__(self,bus=None,deadline=None):
        if bus is None:
            import dbus
            bus=dbus.SystemBus()
        self.bus=bus;self.deadline=deadline or time.monotonic()+30

    def budget(self):
        remaining=self.deadline-time.monotonic()
        if remaining<=0:raise TimeoutError("Ganesha DBus total deadline exceeded")
        return min(5,remaining)

    def name(self,listen_ip,port):
        key=hashlib.sha256((listen_ip+":"+str(port)).encode()).hexdigest()[:24]
        return "org.ablestack.storage.ganesha.e"+key+".org.ganesha.nfsd"

    def owned_manager(self,name,pid):
        if not re.fullmatch(r"(?:org\.ganesha\.nfsd|org\.ablestack\.storage\.ganesha\.e[0-9a-f]{24}\.org\.ganesha\.nfsd)",name):
            raise ValueError("Ganesha bus name is outside its managed namespace")
        owner=self.bus.get_object('org.freedesktop.DBus','/org/freedesktop/DBus').get_dbus_method('GetConnectionUnixProcessID','org.freedesktop.DBus')
        if int(owner(name,timeout=self.budget()))!=pid:raise ValueError("Ganesha DBus owner differs from the owned endpoint process")
        return self.bus.get_object(name,EXPORT_PATH)

    def owned_endpoint_manager(self,listen_ip,port,pid):
        name=self.name(listen_ip,port)
        try:return name,self.owned_manager(name,pid)
        except Exception as current_error:
            try:return "org.ganesha.nfsd",self.owned_manager("org.ganesha.nfsd",pid)
            except Exception:raise ValueError("No managed or legacy Ganesha bus belongs to the owned endpoint PID") from current_error

    def call(self,manager,method,*arguments):
        if method not in ('ShowExports','DisplayExport','UpdateExport','RemoveExport'):
            raise ValueError("Unknown fixed Ganesha export method")
        return manager.get_dbus_method(method,EXPORT_INTERFACE)(*arguments,timeout=self.budget())

    def inventory(self,manager):
        response=self.call(manager,'ShowExports')
        if not isinstance(response,(list,tuple)) or len(response)!=2:raise ValueError("Ganesha export inventory has an unknown schema")
        result={}
        for row in response[1]:
            if len(row)<2:raise ValueError("Ganesha export row is malformed")
            identifier=int(row[0]);path=str(row[1])
            if identifier in result:raise ValueError("Ganesha export inventory duplicates an ID")
            if identifier!=0:result[identifier]=path
        return result

    @staticmethod
    def client_identifier(value):
        value=str(value).strip()
        return "*" if value=="*" else str(ipaddress.ip_network(value,strict=False))

    def verify_clients(self,displayed,wanted):
        observed={}
        for client in displayed:
            if len(client)!=10:raise ValueError("Ganesha client permission readback has an unknown schema")
            name=self.client_identifier(client[0])
            if name in observed:raise ValueError("Ganesha client permission binding duplicates")
            observed[name]=client
        if set(observed)!={row["client"] for row in wanted}:raise ValueError("Ganesha client access set differs")
        for row in wanted:
            actual=observed[row["client"]];options=int(actual[8]);configured=int(actual[9])
            if configured&0x1e7!=0x1e7 or options&0x1e7!=row["options"]:
                raise ValueError("Ganesha client access/squash policy differs")
            for key,position,mask in (("anonUid",5,8),("anonGid",6,16)):
                if row[key] is not None and (configured&mask!=mask or int(actual[position])!=row[key]):
                    raise ValueError("Ganesha client anonymous identity differs")

    def verify(self,manager,expected):
        wanted={int(row['exportId']):row['pseudo'] if row.get('mountPathPseudo') else row['path'] for row in expected}
        if len(wanted)!=len(expected) or self.inventory(manager)!=wanted:
            raise ValueError("Ganesha export inventory differs from the exact declared generation")
        for row in expected:
            displayed=self.call(manager,'DisplayExport',int(row['exportId']))
            # Ganesha 4.3 DisplayExport returns ID/fullpath/displaypath/tag/clients.
            # displaypath follows mount_path_pseudo; NFSv4 pseudo visibility
            # must also be confirmed by the native mount/RPC probe.
            if len(displayed)!=5 or int(displayed[0])!=int(row['exportId']) or str(displayed[1])!=row['path'] or str(displayed[2])!=(row['pseudo'] if row.get('mountPathPseudo') else row['path']):
                raise ValueError("Ganesha export path/pseudo binding differs")
            if "clients" in row:self.verify_clients(displayed[4],row["clients"])
        return True

    @staticmethod
    def configuration(content):
        # Parse only the fixed serializer's complete EXPORT blocks. Braces inside
        # quoted paths do not terminate a block, and duplicate bindings reject.
        chunks=[];exports=[];cursor=0
        for match in re.finditer(r"(?m)^EXPORT\s*\{",content):
            if match.start()<cursor:continue
            start=match.start();position=match.end();depth=1;quoted=False;escaped=False
            while position<len(content) and depth:
                char=content[position]
                if escaped:escaped=False
                elif quoted and char==chr(92):escaped=True
                elif char=='"':quoted=not quoted
                elif not quoted and char=='{':depth+=1
                elif not quoted and char=='}':depth-=1
                position+=1
            if depth or quoted:raise ValueError("Fixed Ganesha EXPORT block is truncated")
            block=content[start:position];chunks.append(content[cursor:start]);cursor=position
            def field(name,pattern):
                rows=re.findall(r"(?m)^\s*"+name+r"\s*=\s*("+pattern+r")\s*;",block)
                if len(rows)!=1:raise ValueError("Fixed Ganesha export binding is ambiguous")
                return rows[0]
            identifier=int(field('Export_Id',r'[0-9]+'))
            path=json.loads(field('Path',r'"(?:[^"\\]|\\.)*"'))
            pseudo=json.loads(field('Pseudo',r'"(?:[^"\\]|\\.)*"'))
            fsal=field('Name',r'[A-Za-z0-9_]+')
            if fsal!='VFS':raise ValueError("Fixed Ganesha export FSAL is unsupported")
            clients=[]
            for client_block in re.findall(r"CLIENT\s*\{([^{}]*)\}",block,re.S):
                def client_field(name,default=None):
                    values=re.findall(r"(?m)^\s*"+name+r"\s*=\s*([^;]+);",client_block)
                    if len(values)>1:raise ValueError("Ganesha client policy is ambiguous")
                    return values[0].strip() if values else default
                access=client_field("Access_Type");squash=client_field("Squash")
                access_bits={"RW":0x1e0,"RO":0xa0,"None":0};squash_bits={"Root_Squash":2,"All_Squash":4,"No_Root_Squash":0}
                if access not in access_bits or squash not in squash_bits:raise ValueError("Ganesha client policy is outside its fixed serializer")
                uid=client_field("Anonymous_uid");gid=client_field("Anonymous_gid")
                for item in client_field("Clients","").split(","):
                    clients.append({"client":GaneshaDbus.client_identifier(item),"options":access_bits[access]|squash_bits[squash],"anonUid":int(uid) if uid is not None else None,"anonGid":int(gid) if gid is not None else None})
            exports.append({'exportId':identifier,'path':path,'pseudo':pseudo,'fsal':fsal,'clients':clients,
                            'mountPathPseudo':bool(re.search(r'(?i)mount_path_pseudo\s*=\s*true\s*;',content))})
        chunks.append(content[cursor:])
        # The managed DBus name is claimed at daemon startup. Updating only this
        # prefix does not alter NFS binding/global behavior of a running daemon;
        # the old owned bus is used until its next boot, then the new name.
        global_content=''.join(chunks)
        prefixes=re.findall(r'(?m)^[ \t]*Dbus_Name_Prefix[ \t]*=[ \t]*"([^"\n]+)"[ \t]*;[ \t]*$',global_content)
        if len(prefixes)>1 or any(not re.fullmatch(r'org\.ablestack\.storage\.ganesha\.e[0-9a-f]{24}',prefix) for prefix in prefixes):
            raise ValueError("Ganesha DBus prefix is outside the fixed endpoint namespace")
        global_content=re.sub(r'(?m)^[ \t]*Dbus_Name_Prefix[ \t]*=[ \t]*"[^"\n]+"[ \t]*;[ \t]*\n?', '', global_content)
        if len({row['exportId'] for row in exports})!=len(exports):raise ValueError("Fixed Ganesha export IDs duplicate")
        return {'exports':exports,'globalSha256':hashlib.sha256(global_content.strip().encode()).hexdigest()}

    def transition(self,name,pid,configuration,previous_content,target_content):
        before=self.configuration(previous_content);after=self.configuration(target_content)
        if before['globalSha256']!=after['globalSha256']:
            raise ValueError("NFS global/listener change requires explicit drain/recreate")
        return self.update(name,pid,configuration,before['exports'],after['exports'])

    def update(self,name,pid,configuration,previous,target):
        old={int(row['exportId']):row for row in previous};wanted={int(row['exportId']):row for row in target}
        if len(old)!=len(previous) or len(wanted)!=len(target):raise ValueError("Ganesha generation duplicates an export ID")
        for identifier in old.keys() & wanted.keys():
            if any(old[identifier].get(field)!=wanted[identifier].get(field) for field in ('path','pseudo','fsal')):
                raise ValueError("NFS immutable export binding change requires explicit drain/recreate")
        # Removal is a separate maintenance/drain operation until exact open
        # state is independently proved. Never silently tear down an export.
        if old.keys()-wanted.keys():raise ValueError("NFS export removal requires the explicit native drain adapter")
        manager=self.owned_manager(name,pid);self.verify(manager,previous)
        for identifier in sorted(wanted):
            self.call(manager,'UpdateExport',str(configuration),'EXPORT(Export_Id='+str(identifier)+')')
        self.verify(manager,target)
        # Owner PID must remain identical after all operations and readback.
        self.owned_manager(name,pid)
        return {'success':True,'activationStrategy':'DBUS_DYNAMIC_UPDATE_VERIFIED','processPid':pid,'exportsVerified':len(wanted),'restartPerformed':False}

# END EMBEDDED GANESHA DBUS

def root_maintenance_nfs_boundary():
    if not globals().get("rendered_context"):return False
    root,manifest=rendered_context
    activation=json.loads((root.parent.parent/"activation.json").read_text())
    proof_path=Path("/run/ablestack-storage/rendered-authorization/writer.json")
    try:
        info=proof_path.lstat();parent=proof_path.parent.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid!=os.geteuid() or stat.S_IMODE(info.st_mode)!=0o600 or not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=os.geteuid() or parent.st_mode&0o077:return False
        descriptor=os.open(proof_path,os.O_RDONLY|os.O_NOFOLLOW)
        try:
            opened=os.fstat(descriptor)
            if (opened.st_dev,opened.st_ino,opened.st_size)!=(info.st_dev,info.st_ino,info.st_size):return False
            proof=json.loads(os.read(descriptor,128*1024))
        finally:os.close(descriptor)
        response=subprocess.run(["/usr/local/bin/ablestack-storagectl","operation","maintenance","status"],capture_output=True,text=True,check=True,timeout=min(5,float(os.environ.get("ABLESTACK_STORAGE_RENDERED_BUDGET","5"))))
        maintenance=json.loads(response.stdout)
        scope=maintenance.get("scope")
        if (maintenance.get("bootHeld") is not True or not isinstance(scope,dict) or (set(scope)!={"instanceUuid","templateUpgradeUuid","operationUuid","revision"} and not (maintenance.get("maintenanceKind")=="SERVICE" and set(scope)=={"instanceUuid","maintenanceUuid","operationUuid","revision"} and scope["maintenanceUuid"]==scope["operationUuid"]))
                or scope!=proof.get("maintenanceScope") or proof.get("scope")!=activation["scope"]
                or any(scope.get(key)!=value for key,value in activation["scope"].items())):return False
        # This is an approved Root downtime boundary, not NFSv4 state drain.
        return True
    except (OSError,KeyError,ValueError,subprocess.SubprocessError):return False

def stop_owned_rendered_ganesha(key,path,inspect_only=False,remove_configuration=False):
    if not re.fullmatch(r"[A-Za-z0-9_.-]+",key):raise ValueError("Ganesha endpoint unit key is invalid")
    unit="ablestack-storage-ganesha@"+key+".service"
    response=subprocess.run(["systemctl","show","-p","MainPID","--value",unit],capture_output=True,text=True,check=True,timeout=ganesha_remaining(5))
    pid=int(response.stdout.strip() or "0")
    configuration=Path(path)
    if remove_configuration:
        source_root,_=rendered_from_context
        rows=json.loads((source_root/"nfs/manifest.json").read_text())["endpoints"]
        matching=[row for row in rows if row["legacyUnitKey"]==key]
        if len(matching)!=1 or not configuration.is_symlink() or os.readlink(configuration)!=str(source_root.parent.parent/"current"/matching[0]["configurationPath"]):
            raise ValueError("Root NFS removal config is outside its exact rendered source")
    if pid:
        arguments=Path("/proc/"+str(pid)+"/cmdline").read_bytes().split(bytes([0]))
        if not arguments or not arguments[0].endswith(b"ganesha.nfsd") or arguments.count(b"-f")!=1 or arguments[arguments.index(b"-f")+1].decode()!=path:
            raise ValueError("Root maintenance Ganesha unit process is foreign")
        if not inspect_only:subprocess.run(["systemctl","stop",unit],check=True,timeout=min(20,float(os.environ.get("ABLESTACK_STORAGE_RENDERED_BUDGET","20"))))
    if remove_configuration and not inspect_only:configuration.unlink()

def rendered_ganesha_dynamic_candidates(configs):
    if not globals().get("rendered_context"):return {}
    if not globals().get("rendered_from_context"):raise ValueError("Rendered NFS source generation is missing")
    source_root,_=rendered_from_context
    source=json.loads((source_root/"nfs/manifest.json").read_text())
    previous={row["legacyUnitKey"]:row for row in source["endpoints"]}
    wanted={row[0] for row in configs}
    # Removing/rebinding an existing NFS export needs open-state drain, beyond
    # TCP session observation. It is never turned into an automatic restart.
    maintenance=root_maintenance_nfs_boundary()
    removed=set(previous)-wanted
    if removed and not maintenance:raise ValueError("NFS endpoint removal requires verified export-state drain or exact Root maintenance")
    # Only fixed units from the immutable prior generation can be stopped. The
    # scope gate is rechecked immediately before the first lifecycle effect.
    recreate=[]
    for key in sorted(removed):stop_owned_rendered_ganesha(key,str(Path(ganesha_conf_dir)/(key+".conf")),inspect_only=True,remove_configuration=True)
    result={};adapter=GaneshaDbus(deadline=time.monotonic()+min(30,float(os.environ.get("ABLESTACK_STORAGE_RENDERED_BUDGET","30"))))
    for key,path,ip,port,mode in configs:
        if key not in previous:continue
        unit="ablestack-storage-ganesha@"+key+".service"
        show=subprocess.run(["systemctl","show","-p","MainPID","--value",unit],text=True,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,timeout=adapter.budget(),check=False)
        if show.returncode:raise ValueError("Owned Ganesha unit process observation failed")
        pid=int(show.stdout.strip() or "0")
        if not pid:continue # Cold boot: the fixed owned unit may be started.
        arguments=Path("/proc/"+str(pid)+"/cmdline").read_bytes().split(bytes([0]))
        if not arguments or not arguments[0].endswith(b"ganesha.nfsd") or arguments.count(b"-f")!=1:
            raise ValueError("Ganesha unit PID is not the fixed config process")
        index=arguments.index(b"-f")
        if index+1>=len(arguments) or arguments[index+1].decode()!=path:raise ValueError("Ganesha unit process config binding is foreign")
        before=(source_root/previous[key]["configurationPath"]).read_text();after=Path(path).read_text()
        old=adapter.configuration(before);new=adapter.configuration(after)
        if old['globalSha256']!=new['globalSha256'] or {row['exportId'] for row in old['exports']}!={row['exportId'] for row in new['exports']}:
            if not maintenance:raise ValueError("NFS listener/export-set change requires its reversible native drain adapter")
            if not root_maintenance_nfs_boundary():raise ValueError("Root NFS maintenance scope changed")
            stop_owned_rendered_ganesha(key,path,inspect_only=True)
            recreate.append((key,path))
            continue
        bus_name,manager=adapter.owned_endpoint_manager(ip,port,pid)
        adapter.verify(manager,old['exports'])
        result[key]=(adapter,pid,before,after,bus_name)
    # All target/source ownership checks precede every stop. Recheck exact
    # protected Root approval and unit PID/config binding immediately at effect.
    for key,path in [*( (key,str(Path(ganesha_conf_dir)/(key+".conf"))) for key in sorted(removed)),*recreate]:
        if not root_maintenance_nfs_boundary():raise ValueError("Root NFS maintenance scope changed")
        stop_owned_rendered_ganesha(key,path,remove_configuration=key in removed)
    return result

