"""Fresh protected byte attestation for the compiled VFS POSIX ACL runtime."""
import hashlib
import json
import os
from pathlib import Path
import stat
import time
import re
import subprocess

GANESHA_ACL_SOURCE = "2a57b6d53295426247b200cd100ba0741b12aff9"
GANESHA_ACL_PREFIX = "/opt/ablestack-ganesha/5.5.3"


def ganesha_protected_read(path, limit=64*1024):
    path=Path(path);info=path.lstat();parent=path.parent.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid!=0 or info.st_mode&0o022 or info.st_size>limit
            or not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=0 or parent.st_mode&0o022):
        raise ValueError("Ganesha build attestation is not protected")
    descriptor=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        opened=os.fstat(descriptor);fields=("st_dev","st_ino","st_uid","st_gid","st_mode","st_size","st_mtime_ns","st_ctime_ns")
        if any(getattr(info,key)!=getattr(opened,key) for key in fields):raise ValueError("Ganesha attestation changed during open")
        with os.fdopen(descriptor,"rb",closefd=False) as handle:content=handle.read(limit+1)
        after=os.fstat(descriptor)
        if len(content)>limit or any(getattr(opened,key)!=getattr(after,key) for key in fields):raise ValueError("Ganesha attestation changed during read")
        return content,opened
    finally:os.close(descriptor)


MANAGED_GANESHA_UNIT = '[Unit]\nDescription=ABLESTACK Storage Service NFS Ganesha endpoint %i\nAfter=local-fs.target network-online.target rpcbind.service\nWants=network-online.target rpcbind.service\n\n[Service]\nExecCondition=/usr/local/bin/ablestack-storagectl operation generation render-boot-gate %n\nType=simple\nExecStartPre=/bin/mkdir -p /run/ablestack-storage/ganesha /etc/ganesha/ablestack-storage /run/ganesha\nExecStartPre=/usr/bin/find /run/ganesha -maxdepth 1 -name ganesha.pid -type f -delete\nExecStart=/usr/bin/ganesha.nfsd -F -p /run/ablestack-storage/ganesha/%i.pid -L /run/ablestack-storage/ganesha/%i.log -f /etc/ganesha/ablestack-storage/%i.conf\nRestart=on-failure\nRestartSec=2\nKillMode=process\nTimeoutStartSec=30\n\n[Install]\nWantedBy=multi-user.target\n'

GANESHA_SERVICE_BINDINGS = {
 "/etc/systemd/system/ablestack-storage-ganesha@.service.d/ablestack-storage-vfs-acl.conf":
 "[Service]\nExecStart=\nExecStart="+GANESHA_ACL_PREFIX+"/bin/ganesha.nfsd -F -p /run/ablestack-storage/ganesha/%i.pid -L /run/ablestack-storage/ganesha/%i.log -f /etc/ganesha/ablestack-storage/%i.conf\nExecReload=\nExecReload=/bin/kill -HUP $MAINPID\n",
 "/etc/systemd/system/nfs-ganesha.service.d/ablestack-storage-vfs-acl.conf":
 "[Service]\nExecStart=\nExecStart="+GANESHA_ACL_PREFIX+"/bin/ganesha.nfsd -C\nExecReload=\nExecReload=/bin/kill -HUP $MAINPID\n"}


def ganesha_service_binding(base,declared):
    expected={path:hashlib.sha256(content.encode()).hexdigest() for path,content in GANESHA_SERVICE_BINDINGS.items()}
    if declared!=expected:raise ValueError("Ganesha service executable binding attestation differs")
    for path,content in GANESHA_SERVICE_BINDINGS.items():
        actual,_=ganesha_protected_read(base/path.lstrip("/"))
        if actual.decode()!=content:raise ValueError("Ganesha selected service uses another executable")
    path=base/"etc/systemd/system/ablestack-storage-ganesha@.service"
    content,_=ganesha_protected_read(path)
    if content.decode()!=MANAGED_GANESHA_UNIT:raise ValueError("Ganesha managed base unit is foreign")
    # Reject unknown late overrides rather than treating our own drop-in as the
    # effective service selection. Gate-only source drop-ins may coexist.
    for prefix in ("etc/systemd/system","run/systemd/system","usr/lib/systemd/system","lib/systemd/system"):
        owner=base/prefix
        if not owner.exists():continue
        for unit in owner.glob("ablestack-storage-ganesha@*.service"):
            if unit.name!="ablestack-storage-ganesha@.service":
                raise ValueError("Ganesha endpoint has an unverified instance unit override")
        directories=list(owner.glob("ablestack-storage-ganesha@*.service.d"))
        directories.append(owner/"nfs-ganesha.service.d")
        for directory in directories:
            if not directory.exists():continue
            for item in directory.glob("*.conf"):
                relative="/"+str(item.relative_to(base))
                if relative in expected:continue
                content,_=ganesha_protected_read(item)
                if content.decode()!="[Service]\nExecCondition=/usr/local/bin/ablestack-storagectl operation generation render-boot-gate %n\n":
                    raise ValueError("Ganesha service has an unverified override")
    return expected


def ganesha_systemd_effective_binding(base):
    if base!=Path("/") or not Path("/run/systemd/system").is_dir():
        return {"systemdObserved":False,"bindingObservation":"PROTECTED_UNIT_FILES"}
    result={}
    for unit in ("ablestack-storage-ganesha@capability.service","nfs-ganesha.service"):
        observed=subprocess.run(["systemctl","show",unit,"-p","LoadState","-p","ExecStart"],capture_output=True,text=True,timeout=3)
        if observed.returncode:raise ValueError("Ganesha effective systemd binding is unavailable")
        values=dict(line.split("=",1) for line in observed.stdout.splitlines() if "=" in line)
        if values.get("LoadState")=="masked" and unit=="nfs-ganesha.service":
            result[unit]={"masked":True};continue
        selected=re.findall(r"\bpath=([^ ;}]+)",values.get("ExecStart",""))
        if selected!=[GANESHA_ACL_PREFIX+"/bin/ganesha.nfsd"]:
            raise ValueError("Effective systemd Ganesha executable is legacy or foreign")
        result[unit]={"masked":False,"execStartPath":selected[0]}
    return {"systemdObserved":True,"bindingObservation":"SYSTEMD_EFFECTIVE_EXECSTART","effectiveUnitBindings":result}


def ganesha_active_library_binding(base,process_root="/proc"):
    binary=base/GANESHA_ACL_PREFIX.lstrip("/")/"bin/ganesha.nfsd"
    library=base/GANESHA_ACL_PREFIX.lstrip("/")/"lib/x86_64-linux-gnu/ganesha/libfsalvfs.so"
    binary_info=binary.stat();library_info=library.stat();observed=[];deadline=time.monotonic()+3
    for process in Path(process_root).iterdir():
        if time.monotonic()>=deadline:raise ValueError("Ganesha active runtime observation deadline exhausted")
        if not process.name.isdigit():continue
        try:
            executable=os.readlink(process/"exe")
            canonical=executable[:-10] if executable.endswith(" (deleted)") else executable
            if not canonical.endswith("/ganesha.nfsd"):continue
            before=(process/"stat").read_text().rpartition(")")[2].split()[19]
            opened=(process/"exe").stat()
            if (opened.st_dev,opened.st_ino)!=(binary_info.st_dev,binary_info.st_ino) or executable.endswith(" (deleted)"):
                raise ValueError("Active Ganesha is bound to a legacy or replaced executable")
            matched=False
            for line in (process/"maps").read_text().splitlines():
                parts=line.split(None,5)
                if len(parts)!=6 or "libfsalvfs.so" not in parts[5]:continue
                if parts[5]!=str(library) and parts[5]!=GANESHA_ACL_PREFIX+"/lib/x86_64-linux-gnu/ganesha/libfsalvfs.so":
                    raise ValueError("Active Ganesha VFS library is legacy or foreign")
                major,minor=(int(value,16) for value in parts[3].split(":"))
                if (os.makedev(major,minor),int(parts[4]))!=(library_info.st_dev,library_info.st_ino):
                    raise ValueError("Active Ganesha VFS library inode differs from its manifest")
                matched=True
            if not matched:raise ValueError("Active Ganesha VFS mapping is unobservable")
            after=(process/"stat").read_text().rpartition(")")[2].split()[19]
            if before!=after:raise ValueError("Active Ganesha PID identity changed while inspecting")
            observed.append({"pid":int(process.name),"startTicks":before,"executable":GANESHA_ACL_PREFIX+"/bin/ganesha.nfsd",
                             "vfsDevice":library_info.st_dev,"vfsInode":library_info.st_ino})
        except FileNotFoundError:continue
    return observed

def ganesha_acl_capabilities(manifest=None,root=None,process_root="/proc"):
    path=Path(manifest or "/etc/ablestack-storage/ganesha-build-manifest.json");base=Path(root or "/")
    result={"success":True,"generatedEpoch":time.time(),"nfsVfsPosixAclSupported":False,
            "ganeshaVersion":None,"ganeshaBuildManifestSha256":None,"vfsLibrarySha256":None,
             "posixAclBuildEnabled":False,"posixAclSelfTestVerified":False,"configuredExecutableBindingVerified":False,
            "activeRuntimeVfsVerified":False,"activeGaneshaProcesses":[],"supportedFeatures":[]}
    try:
        data,_=ganesha_protected_read(path);value=json.loads(data)
        expected_flags={"ENABLE_VFS_POSIX_ACL":"ON","ENABLE_VFS_DEBUG_ACL":"OFF","USE_FSAL_VFS":"ON","USE_DBUS":"ON"}
        if (type(value.get("schemaVersion")) is not int or value.get("schemaVersion")!=1 or value.get("sourceCommit")!=GANESHA_ACL_SOURCE or value.get("version")!="5.5.3"
                or value.get("requiredCmakeFlags")!=expected_flags or value.get("prefix")!=GANESHA_ACL_PREFIX
                or value.get("selfTest",{}).get("namedAclReadWrite") is not True or value.get("selfTest",{}).get("defaultAclInheritance") is not True):
            raise ValueError("Ganesha build or real ACL self-test attestation is incomplete")
        files=value.get("files")
        required={"bin/ganesha.nfsd","lib/x86_64-linux-gnu/libganesha_nfsd.so.5.5.3","lib/x86_64-linux-gnu/libntirpc.so.5.0","lib/x86_64-linux-gnu/ganesha/libfsalvfs.so"}
        if not isinstance(files,dict) or set(files)!=required:raise ValueError("Ganesha fixed runtime file attestation differs")
        for name,expected in files.items():
            if not isinstance(expected,str) or len(expected)!=64:raise ValueError("Ganesha file digest is invalid")
            content,_=ganesha_protected_read(base/GANESHA_ACL_PREFIX.lstrip("/")/name,32*1024*1024)
            if hashlib.sha256(content).hexdigest()!=expected:raise ValueError("Ganesha installed runtime bytes changed")
        bindings=ganesha_service_binding(base,value.get("serviceBindings"))
        selected=ganesha_systemd_effective_binding(base)
        processes=ganesha_active_library_binding(base,process_root)
        result.update(**selected,configuredExecutableBindingVerified=True,activeRuntimeVfsVerified=bool(processes),
                      activeRuntimeNotApplicable=not bool(processes),activeGaneshaProcesses=processes,
                      serviceBindings=bindings,nfsVfsPosixAclSupported=True,ganeshaVersion=value["version"],
                      ganeshaBuildManifestSha256=hashlib.sha256(data).hexdigest(),
                      vfsLibrarySha256=files["lib/x86_64-linux-gnu/ganesha/libfsalvfs.so"],
                      posixAclBuildEnabled=True,posixAclSelfTestVerified=True,supportedFeatures=["NFS_VFS_POSIX_ACL"])
    except (OSError,ValueError,TypeError,KeyError,IndexError,subprocess.TimeoutExpired) as error:
        result["diagnostic"]=str(error)
    return result

print(json.dumps(ganesha_acl_capabilities(), sort_keys=True))
PYGANESHAFEATURES
}

posix_directory_policy() {
  local action="$1" payload_file="$2"
  python3 - "$action" "$payload_file" "$0" <<'PYPOSIX'
import grp
import hashlib
import json
import os
import pwd
import re
import stat
import subprocess
import sys
import tempfile
import uuid

"""Explicit one-inode initialization bound to an immutable NEW format receipt."""
import hashlib
import json
import os
from pathlib import Path
import stat
import tempfile
import time
import uuid


def root_receipt_read(path):
    try:
        info = path.lstat()
    except FileNotFoundError:
        return None
    parent = path.parent.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077
            or info.st_size > 256 * 1024 or not stat.S_ISDIR(parent.st_mode)
            or parent.st_uid != os.geteuid() or parent.st_mode & 0o022):
        raise ValueError("NEW filesystem receipt is not protected")
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        pinned = os.fstat(directory)
        if (pinned.st_dev, pinned.st_ino, pinned.st_uid, pinned.st_mode) != (parent.st_dev, parent.st_ino, parent.st_uid, parent.st_mode):
            raise ValueError("NEW filesystem receipt directory changed")
        descriptor = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory)
    finally:
        os.close(directory)
    try:
        opened = os.fstat(descriptor)
        fields = ("st_dev", "st_ino", "st_uid", "st_gid", "st_mode", "st_size")
        if tuple(getattr(opened, key) for key in fields) != tuple(getattr(info, key) for key in fields):
            raise ValueError("NEW filesystem receipt changed while reading")
        with os.fdopen(descriptor, "rb", closefd=False) as handle:
            content = handle.read(256 * 1024 + 1)
        if len(content) > 256 * 1024:
            raise ValueError("NEW filesystem receipt is too large")
        return json.loads(content)
    finally:
        os.close(descriptor)


def root_receipt_write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    parent = path.parent.lstat()
    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.geteuid() or parent.st_mode & 0o077:
        raise ValueError("NEW initializer receipt directory is not protected")
    descriptor, temporary = tempfile.mkstemp(prefix=".root-initializer-", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w") as handle:
            json.dump(value, handle, sort_keys=True, allow_nan=False)
            handle.flush(); os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


class RootInitialization:
    def __init__(self, operations=None, receipts=None):
        self.operations = Path(operations or os.environ.get("ABLESTACK_STORAGE_VOLUME_OPERATIONS", "/var/lib/ablestack-storage/volume-operations"))
        self.receipts = Path(receipts or os.environ.get("ABLESTACK_STORAGE_ROOT_INITIALIZATIONS", "/var/lib/ablestack-storage/root-posix-initializations"))

    def path(self, request):
        return self.receipts / (str(uuid.UUID(request["volumeUuid"])) + ".json")

    def scope(self, request):
        initialization = request.get("rootInitialization")
        if not isinstance(initialization, dict) or set(initialization) != {"formatReceiptUuid", "operationUuid"}:
            raise ValueError("NEW root initializer needs its exact format and operation scope")
        if request.get("allowFilesystemRoot") is not True or request.get("relativePath") not in ("", "."):
            raise ValueError("NEW initializer applies only to the selected filesystem root")
        revision = request["revision"]
        if isinstance(revision, bool) or not isinstance(revision, int) or revision < 1:
            raise ValueError("NEW initializer policy revision is invalid")
        return {"instanceUuid": str(uuid.UUID(request["instanceUuid"])), "policyUuid": str(uuid.UUID(request["uuid"])),
                "volumeUuid": str(uuid.UUID(request["volumeUuid"])), "revision": revision,
                "formatReceiptUuid": str(uuid.UUID(initialization["formatReceiptUuid"])),
                "operationUuid": str(uuid.UUID(initialization["operationUuid"]))}

    def empty_root(self, descriptor):
        for name in os.listdir(descriptor):
            info = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            if name != "lost+found" or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
                raise ValueError("NEW filesystem root already contains user data")
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            try:
                if os.listdir(child):
                    raise ValueError("NEW filesystem root recovery directory contains data")
            finally:
                os.close(child)

    def preview(self, request, before, descriptor):
        receipt = root_receipt_read(self.path(request))
        if receipt:
            return {"available": False, "phase": receipt["phase"], "formatReceiptUuid": receipt["scope"]["formatReceiptUuid"]}
        journal = root_receipt_read(self.operations / (str(uuid.UUID(request["volumeUuid"])) + ".json"))
        proof = (journal or {}).get("formatReceipt") or {}
        available = (journal is not None and journal.get("phase") == "COMPLETE" and journal.get("formatStarted") is True
                     and proof.get("schemaVersion") == 1 and proof.get("volumeUuid") == request["volumeUuid"]
                     and proof.get("matchedBy") == "VOLUME_SERIAL" and bool(proof.get("serial"))
                     and journal.get("mountPath") == request["volumeMountPath"]
                     and proof.get("directoryIdentity") == before["directoryIdentity"]
                     and proof.get("filesystemUuid") == before["filesystemUuid"])
        if available:
            try:
                self.empty_root(descriptor)
            except ValueError:
                available = False
        return {"available": bool(available), "phase": "UNUSED" if available else "UNAVAILABLE",
                "formatReceiptUuid": proof.get("receiptUuid") if available else None}

    def prepare(self, request, before, descriptor):
        scope = self.scope(request)
        opened = os.fstat(descriptor)
        actual = {"device": opened.st_dev, "inode": opened.st_ino, "effectiveUid": opened.st_uid,
                  "effectiveGid": opened.st_gid, "effectiveMode": format(stat.S_IMODE(opened.st_mode), "04o")}
        if any(before["directoryIdentity"].get(key) != value for key, value in actual.items()):
            raise ValueError("NEW filesystem root changed after preview")
        checksum = hashlib.sha256(json.dumps(request.get("config") or {}, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()).hexdigest()
        existing = root_receipt_read(self.path(request))
        if existing:
            if existing.get("scope") != scope or existing.get("policySha256") != checksum or request.get("expectedDirectoryIdentity") != existing["before"]["directoryIdentity"]:
                raise ValueError("NEW initializer receipt belongs to another request")
            if existing.get("phase") in ("VERIFIED", "COMPLETE"):
                if existing["after"]["directoryIdentity"] != before["directoryIdentity"]:
                    raise ValueError("Initialized filesystem root has changed")
                return existing, True
            if existing.get("phase") != "APPLYING" or existing["before"]["directoryIdentity"] != before["directoryIdentity"]:
                raise ValueError("NEW initializer requires verified recovery")
            return existing, False
        journal = root_receipt_read(self.operations / (scope["volumeUuid"] + ".json"))
        proof = (journal or {}).get("formatReceipt")
        if (not journal or journal.get("formatStarted") is not True or journal.get("phase") != "COMPLETE"
                or not isinstance(proof, dict) or proof.get("schemaVersion") != 1
                or proof.get("receiptUuid") != scope["formatReceiptUuid"]
                or proof.get("volumeUuid") != scope["volumeUuid"] or proof.get("matchedBy") != "VOLUME_SERIAL"
                or not proof.get("serial") or journal.get("mountPath") != request["volumeMountPath"]
                or proof.get("filesystemUuid") != before["filesystemUuid"]
                or proof.get("directoryIdentity") != before["directoryIdentity"]
                or request.get("expectedDirectoryIdentity") != before["directoryIdentity"]):
            raise ValueError("NEW root initialization lacks an exact unused format receipt")
        self.empty_root(descriptor)
        receipt = {"scope": scope, "policySha256": checksum, "phase": "APPLYING", "before": before, "createdEpoch": time.time()}
        root_receipt_write(self.path(request), receipt)
        return receipt, False

    def verified(self, request, receipt, after):
        if receipt.get("scope") != self.scope(request) or any(after["directoryIdentity"].get(key) != receipt["before"]["directoryIdentity"].get(key) for key in ("filesystemUuid", "device", "inode")):
            raise ValueError("NEW root initializer verification scope changed")
        receipt.update(phase="VERIFIED", after=after, verifiedEpoch=time.time())
        root_receipt_write(self.path(request), receipt)

    def complete(self, request, receipt):
        if receipt.get("scope") != self.scope(request) or receipt.get("phase") not in ("VERIFIED", "COMPLETE"):
            raise ValueError("NEW root initializer has not been verified")
        receipt.update(phase="COMPLETE", completedEpoch=time.time())
        root_receipt_write(self.path(request), receipt)

    def failed(self, request, receipt, observed):
        restored = observed["directoryIdentity"] == receipt["before"]["directoryIdentity"]
        receipt.update(phase="ROLLED_BACK" if restored else "RECOVERY_REQUIRED", observed=observed)
        root_receipt_write(self.path(request), receipt)
"""Post-apply POSIX attestation; replay verifies one inode without changing metadata."""
import hashlib
import json
import os
import re
from pathlib import Path
import time
import uuid

IDENTITY_FIELDS = ("filesystemUuid", "device", "inode", "effectiveUid", "effectiveGid", "effectiveMode", "aclSha256")


class PosixPolicyReceipt:
    def __init__(self, receipts=None):
        self.receipts = Path(receipts or os.environ.get("ABLESTACK_STORAGE_POSIX_RECEIPTS", "/var/lib/ablestack-storage/posix-policy-receipts"))

    def scope(self, request):
        revision = request.get("revision")
        if type(revision) is not int or revision < 1:
            raise ValueError("POSIX attestation needs its exact positive policy revision")
        return {"instanceUuid": str(uuid.UUID(request["instanceUuid"])), "policyUuid": str(uuid.UUID(request["uuid"])),
                "volumeUuid": str(uuid.UUID(request["volumeUuid"])), "revision": revision,
                "volumeMountPath": request["volumeMountPath"], "relativePath": request["relativePath"]}

    def path(self, request):
        return self.receipts / (str(uuid.UUID(request["uuid"])) + ".json")

    def checksum(self, request):
        return hashlib.sha256(json.dumps(request, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()).hexdigest()

    def read(self, request):
        return root_receipt_read(self.path(request))

    def attest(self, request, observed):
        identity = observed.get("directoryIdentity")
        if not isinstance(identity, dict) or set(identity) != set(IDENTITY_FIELDS):
            raise ValueError("POSIX post-apply identity is incomplete")
        return {"schemaVersion": 1, "phase": "COMPLETE", "scope": self.scope(request),
                "requestSha256": self.checksum(request), "directoryIdentity": identity, "verifiedEpoch": time.time()}

    def verify(self, request, observed, receipt):
        if (not isinstance(receipt, dict) or receipt.get("schemaVersion") != 1 or receipt.get("phase") != "COMPLETE"
                or receipt.get("scope") != self.scope(request) or receipt.get("requestSha256") != self.checksum(request)
                or receipt.get("directoryIdentity") != observed.get("directoryIdentity")):
            raise ValueError("POSIX post-apply receipt differs from its request or current directory")
        return True

    def replay(self, request, stored, observed):
        if not isinstance(stored, dict) or stored.get("request") != request:
            return False
        receipt = self.read(request)
        if receipt is None:
            return False
        self.verify(request, observed, receipt)
        canonical=receipt.get("canonicalDirectoryIdentity",receipt["directoryIdentity"])
        if (stored.get("effective") or {}).get("directoryIdentity") != canonical:
            raise ValueError("POSIX committed effective directory differs from its post-apply receipt")
        if canonical!=observed.get("directoryIdentity"):
            if (receipt.get("canonicalRowSha256")!=hashlib.sha256(json.dumps(stored,sort_keys=True,separators=(",",":"),allow_nan=False).encode()).hexdigest()
                    or not isinstance(receipt.get("rootScope"),dict) or receipt["rootScope"].get("instanceUuid")!=request["instanceUuid"]
                    or any(canonical.get(key)!=observed["directoryIdentity"].get(key) for key in IDENTITY_FIELDS if key!="device")):
                raise ValueError("POSIX ROOT device remap lacks its protected source canonical attestation")
        return True

    def transferred_plan(self,row,observed,root_scope,source_sha,maintenance):
        request=row.get("request") if isinstance(row,dict) else None
        names={"instanceUuid","templateUpgradeUuid","operationUuid","revision"}
        if (not isinstance(root_scope,dict) or set(root_scope)!=names or type(root_scope["revision"]) is not int or root_scope["revision"]<1
                or maintenance.get("maintenanceKind") not in (None,"ROOT") or maintenance.get("bootHeld") is not True or maintenance.get("scope")!=root_scope
                or not isinstance(request,dict) or request.get("instanceUuid")!=root_scope["instanceUuid"]
                or not re.fullmatch("[0-9a-f]{64}",str(source_sha)) or set(row)!={"request","config","effective"} or row.get("config")!=request.get("config",{})):
            raise ValueError("ROOT POSIX transferred plan lacks its exact protected marker")
        for key in names-{"revision"}:uuid.UUID(root_scope[key])
        receipt=self.read(request);self.verify(request,observed,receipt)
        checksum=hashlib.sha256(json.dumps(row,sort_keys=True,separators=(",",":"),allow_nan=False).encode()).hexdigest()
        canonical=receipt.get("canonicalDirectoryIdentity");binding=receipt.get("volumeBinding")
        if (receipt.get("rootScope")!=root_scope or receipt.get("sourceConfigurationSha256")!=source_sha or receipt.get("canonicalRowSha256")!=checksum
                or not isinstance(canonical,dict) or canonical!=(row.get("effective") or {}).get("directoryIdentity")
                or not isinstance(binding,dict) or binding.get("volumeUuid")!=request.get("volumeUuid")
                or binding.get("filesystemUuid")!=observed["directoryIdentity"].get("filesystemUuid")
                or any(canonical.get(key)!=observed["directoryIdentity"].get(key) for key in IDENTITY_FIELDS if key!="device")):
            raise ValueError("ROOT POSIX transferred plan differs from its attested source row/inode")
        return {"success":True,"sideEffects":False,"transferOnly":True,"beforeDirectoryIdentity":observed["directoryIdentity"],
                "predictedDirectoryIdentity":observed["directoryIdentity"],"configurationDesiredRow":row,"postApplyReceiptRequired":True,
                "postApplyReceiptVerified":True,"rootScope":root_scope,"sourceConfigurationSha256":source_sha,"dataPermissionsChanged":False,"canonicalDesiredStateChanged":False}

    def write(self, request, observed):
        receipt = self.attest(request, observed)
        root_receipt_write(self.path(request), receipt)
        self.verify(request, observed, self.read(request))
        return receipt

    def restore(self, request, previous_policy, previous_receipt, observed):
        if previous_receipt is None:
            # Invalidate newer attestation after an exact rollback to a legacy policy.
            path = self.path(request)
            if path.exists() or path.is_symlink():
                self.read(request)
                path.unlink()
                descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                try: os.fsync(descriptor)
                finally: os.close(descriptor)
            return
        previous_request = (previous_policy or {}).get("request")
        if not isinstance(previous_request, dict) or previous_request.get("uuid") != request.get("uuid"):
            raise ValueError("POSIX receipt rollback lacks the exact previous committed request")
        self.verify(previous_request, observed, previous_receipt)
        canonical=previous_receipt.get("canonicalDirectoryIdentity",previous_receipt["directoryIdentity"])
        if (previous_policy.get("effective") or {}).get("directoryIdentity") != canonical:
            raise ValueError("POSIX restored metadata differs from the previous committed policy")
        if canonical!=observed.get("directoryIdentity") and previous_receipt.get("canonicalRowSha256")!=hashlib.sha256(json.dumps(previous_policy,sort_keys=True,separators=(",",":"),allow_nan=False).encode()).hexdigest():
            raise ValueError("POSIX previous ROOT receipt lacks its exact canonical policy digest")
        root_receipt_write(self.path(previous_request), previous_receipt)

operation = sys.argv[1]
with open(sys.argv[2], encoding="utf-8") as fp:
    request = json.load(fp)
transfer_request=None
if operation=="attest-plan":
    transfer_request=request
    if not isinstance(transfer_request,dict) or set(transfer_request)!={"canonicalPolicyRow","rootScope","sourceConfigurationSha256"}:
        raise ValueError("ROOT POSIX attest-plan request fields are invalid")
    request=transfer_request["canonicalPolicyRow"]["request"]

def run(args, **kwargs):
    if "directory_fd" in globals():
        kwargs["pass_fds"] = (directory_fd,)
    return subprocess.run(args, check=True, timeout=15, **kwargs)

def verify_legacy_mount_binding(payload, root, filesystem_uuid):
    expected_uuid = payload.get("expectedFilesystemUuid")
    expected_serial = payload.get("expectedVolumeSerial")
    if not expected_uuid or expected_uuid != filesystem_uuid or not isinstance(expected_serial, str) or not expected_serial:
        raise ValueError("Legacy filesystem root needs its fresh filesystem UUID and volume serial")
    identity = uuid.UUID(payload["volumeUuid"]).hex
    compact_serial = "".join(character for character in expected_serial.lower() if character.isalnum())
    if compact_serial not in (identity, identity[:20]):
        raise ValueError("Legacy filesystem root serial differs from its attached volume")
    source = run(["findmnt", "-n", "-o", "SOURCE", "--mountpoint", root], stdout=subprocess.PIPE, text=True).stdout.strip()
    inventory = json.loads(run(["lsblk", "-b", "-J", "-o", "PATH,NAME,TYPE,SIZE,SERIAL,UUID,FSTYPE,MOUNTPOINT"], stdout=subprocess.PIPE, text=True).stdout)
    devices = []
    def flatten(items, parent=None):
        for item in items:
            disk = item if item.get("type") == "disk" else parent
            devices.append((item, disk))
            flatten(item.get("children") or [], disk)
    flatten(inventory.get("blockdevices") or [])
    roots = {disk.get("path") for item, disk in devices if disk and (item.get("mountpoint") in ("/", "/boot", "/boot/efi") or item.get("fstype") == "swap")}
    matches = [(item, disk) for item, disk in devices if item.get("path") and os.path.realpath(item["path"]) == os.path.realpath(source)]
    if len(matches) != 1:
        raise ValueError("Legacy filesystem root mounted device is ambiguous")
    item, disk = matches[0]
    if (not disk or disk.get("path") in roots or (item.get("serial") or disk.get("serial")) != expected_serial
            or item.get("uuid") != expected_uuid or item.get("type") not in ("disk", "part")):
        raise ValueError("Legacy mount is not the exact attached DATA filesystem")
    if payload.get("expectedSizeBytes") is not None and int(disk.get("size") or 0) != int(payload["expectedSizeBytes"]):
        raise ValueError("Legacy filesystem root volume size differs from its frozen DATA binding")
    return {"volumeSerial": expected_serial, "observedDevicePath": item["path"]}

def path_identity(payload):
    volume = str(uuid.UUID(payload["volumeUuid"]))
    root = str(payload["volumeMountPath"]).rstrip("/")
    relative = str(payload["relativePath"])
    filesystem_root = relative in ("", ".")
    managed = root == "/srv/ablestack-storage/volumes/" + volume
    legacy = (payload.get("allowLegacyMountRoot") is True and filesystem_root and payload.get("allowFilesystemRoot") is True
              and re.fullmatch(r"/export(?:/[A-Za-z0-9][A-Za-z0-9_.-]{0,127})?", root) is not None)
    if not (managed or legacy) or os.path.islink(root) or not os.path.isdir(root) or os.path.realpath(root) != root:
        raise ValueError("POSIX policy requires an exact managed or explicitly bound legacy DATA mount root")
    if filesystem_root and payload.get("allowFilesystemRoot") is not True:
        raise ValueError("Filesystem root policy requires an explicit root preview/apply scope")
    if relative.startswith("/") or "\\" in relative or any(ord(ch) < 32 for ch in relative):
        raise ValueError("Invalid volume-relative directory path")
    components = [] if filesystem_root else relative.split("/")
    if any(part in ("", ".", "..") for part in components):
        raise ValueError("Directory path traversal is forbidden")
    mounted = run(["findmnt", "-n", "-o", "TARGET,UUID", "-T", root], stdout=subprocess.PIPE, text=True).stdout.strip().split()
    if len(mounted) != 2 or mounted[0] != root:
        raise ValueError("Selected volume mount identity is unavailable")
    if legacy:
        verify_legacy_mount_binding(payload, root, mounted[1])
    descriptor = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    device = os.fstat(descriptor).st_dev
    path = root
    try:
        for part in components:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
            path = os.path.join(path, part)
            if os.fstat(descriptor).st_dev != device:
                raise ValueError("POSIX directory crosses a device boundary")
            target = run(["findmnt", "-n", "-o", "TARGET", "-T", path], stdout=subprocess.PIPE, text=True).stdout.strip()
            if target != root:
                raise ValueError("POSIX directory crosses a mount boundary")
        return path, mounted[1], descriptor
    except Exception:
        os.close(descriptor)
        raise

def acl_lines(path):
    output = run(["getfacl", "-cpn", "/proc/self/fd/" + str(directory_fd)], stdout=subprocess.PIPE, text=True).stdout
    result = []
    for raw in output.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if not re.fullmatch(r"(?:default:)?(?:user|group|mask|other):[0-9]*:[r-][w-][x-]", line):
            raise ValueError("Unsupported native ACL snapshot entry")
        result.append(line)
    return result

def observe(payload):
    if (payload["volumeUuid"], payload["volumeMountPath"], payload["relativePath"]) != (request["volumeUuid"], request["volumeMountPath"], request["relativePath"]):
        raise ValueError("Directory snapshot path identity differs from its pinned scope")
    path, filesystem = canonical_path, filesystem_uuid
    value = os.fstat(directory_fd)
    named = os.lstat(path)
    if os.path.islink(path) or (named.st_dev, named.st_ino) != (value.st_dev, value.st_ino):
        raise ValueError("Directory path was replaced after canonical preflight")
    result = {"success": True, "uuid": str(uuid.UUID(payload["uuid"])), "instanceUuid": str(uuid.UUID(payload["instanceUuid"])),
            "volumeUuid": str(uuid.UUID(payload["volumeUuid"])), "volumeMountPath": payload["volumeMountPath"],
            "relativePath": payload["relativePath"], "canonicalPath": path, "filesystemUuid": filesystem,
            "effectiveUid": value.st_uid, "effectiveGid": value.st_gid, "effectiveMode": format(stat.S_IMODE(value.st_mode), "04o"),
            "device": value.st_dev, "inode": value.st_ino, "acl": acl_lines(path), "revision": int(payload.get("revision", 0)), "driftStatus": "UNOBSERVED",
            "filesystemRoot": payload["relativePath"] in ("", ".")}
    result["directoryIdentity"] = {key: result[key] for key in ("filesystemUuid", "device", "inode", "effectiveUid", "effectiveGid", "effectiveMode")}
    result["directoryIdentity"]["aclSha256"] = hashlib.sha256(json.dumps(result["acl"], separators=(",", ":")).encode()).hexdigest()
    result["allowFilesystemRoot"] = result["filesystemRoot"]
    if payload.get("allowLegacyMountRoot") is True:
        result["allowLegacyMountRoot"] = True
        result["expectedFilesystemUuid"] = payload.get("expectedFilesystemUuid")
        result["expectedVolumeSerial"] = payload.get("expectedVolumeSerial")
        result["expectedSizeBytes"] = payload.get("expectedSizeBytes")
    if payload.get("rootInitialization") is not None:
        result["rootInitialization"] = payload["rootInitialization"]
    return result

def verify_expected_directory_identity(payload, before):
    expected = payload.get("expectedDirectoryIdentity")
    if before["filesystemRoot"] and not isinstance(expected, dict):
        raise ValueError("Filesystem root permission changes require the exact preview identity")
    if expected is not None and (expected != before["directoryIdentity"] or any(type(expected.get(key)) is not type(value) for key, value in before["directoryIdentity"].items())):
        raise ValueError("Directory filesystem/inode/permissions changed after preview")

def restore(snapshot):
    path, filesystem = canonical_path, filesystem_uuid
    value = os.fstat(directory_fd)
    if (filesystem != snapshot["filesystemUuid"] or (value.st_dev, value.st_ino) != (int(snapshot["device"]), int(snapshot["inode"]))
            or os.path.islink(path) or (os.lstat(path).st_dev, os.lstat(path).st_ino) != (value.st_dev, value.st_ino)):
        raise ValueError("Refusing POSIX restore on a replaced filesystem or directory")
    for line in snapshot["acl"]:
        if not re.fullmatch(r"(?:default:)?(?:user|group|mask|other):[0-9]*:[r-][w-][x-]", line):
            raise ValueError("Invalid structured native ACL snapshot")
    os.chown(directory_fd, int(snapshot["effectiveUid"]), int(snapshot["effectiveGid"]))
    pinned = "/proc/self/fd/" + str(directory_fd)
    run(["setfacl", "-b", pinned]);run(["setfacl", "-k", pinned])
    run(["setfacl", "--set-file=-", pinned], input="\n".join(snapshot["acl"]) + "\n", text=True)
    os.chmod(directory_fd, int(snapshot["effectiveMode"], 8))
    if "previousPolicy" in snapshot:
        if snapshot["previousPolicy"] is None:
            desired.pop(snapshot["uuid"], None)
        else:
            desired[snapshot["uuid"]] = snapshot["previousPolicy"]
    return observe(snapshot)

def resolved_entry(entry):
    kind = entry.get("principalType")
    principal = str(entry.get("principal") or "")
    if kind in ("NUMERIC_UID", "NUMERIC_GID"):
        if not re.fullmatch(r"[0-9]{1,10}", principal) or int(principal) > 2147483647:
            raise ValueError("Invalid numeric POSIX principal")
        key, numeric = ("u" if kind == "NUMERIC_UID" else "g"), int(principal)
    elif kind in ("LOCAL_USER", "LOCAL_GROUP"):
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]{0,63}", principal):
            raise ValueError("Invalid local POSIX principal")
        key = "u" if kind == "LOCAL_USER" else "g"
        numeric = pwd.getpwnam(principal).pw_uid if key == "u" else grp.getgrnam(principal).gr_gid
    else:
        raise ValueError("Only numeric/local POSIX principals are supported; AD is deferred")
    permission = entry.get("permission")
    if permission not in ("READ_ONLY", "READ_WRITE", "FULL_CONTROL"):
        raise ValueError("Invalid POSIX permission")
    return key, numeric, "r-x" if permission == "READ_ONLY" else "rwx"

def bits(value):
    return ("r" if value & 4 else "-") + ("w" if value & 2 else "-") + ("x" if value & 1 else "-")

def validate_policy(config):
    if config.get("recursive"):
        raise ValueError("Recursive directory modification is unsupported")
    mode = str(config.get("directoryMode") or "0770")
    if not re.fullmatch(r"0?[0-7]{3,4}", mode) or int(mode, 8) > 0o7777:
        raise ValueError("Invalid directory mode")
    for field in ("accessEntries", "defaultEntries"):
        entries = config.get(field) or []
        if not isinstance(entries, list) or len(entries) > 128:
            raise ValueError("Invalid structured POSIX ACL list")
        values = [resolved_entry(entry) for entry in entries]
        if len({(kind, numeric) for kind, numeric, permission in values}) != len(values):
            raise ValueError("Duplicate resolved POSIX ACL principal")
    if config.get("applyOwner"):
        uid, gid = config.get("ownerUid"), config.get("ownerGid")
        if isinstance(uid, bool) or isinstance(gid, bool) or not isinstance(uid, int) or not isinstance(gid, int) or not 0 <= uid <= 2147483647 or not 0 <= gid <= 2147483647:
            raise ValueError("Owner change needs explicit valid numeric UID and GID")

def apply_policy(payload, before, old_policy):
    verify_expected_directory_identity(payload, observe(payload))
    config = payload.get("config") or {}
    if config.get("recursive"):
        raise ValueError("Recursive directory modification is unsupported")
    mode = str(config.get("directoryMode") or "0770")
    if not re.fullmatch(r"0?[0-7]{3,4}", mode) or int(mode, 8) > 0o7777:
        raise ValueError("Invalid directory mode")
    resolved = {}
    for field in ("accessEntries", "defaultEntries"):
        entries = config.get(field) or []
        if not isinstance(entries, list) or len(entries) > 128:
            raise ValueError("Invalid structured POSIX ACL list")
        resolved[field] = [resolved_entry(entry) for entry in entries]
        if len({(kind, numeric) for kind, numeric, permission in resolved[field]}) != len(resolved[field]):
            raise ValueError("Duplicate POSIX ACL principal")
    path = "/proc/self/fd/" + str(directory_fd)
    if config.get("applyOwner"):
        uid, gid = config.get("ownerUid"), config.get("ownerGid")
        if isinstance(uid, bool) or isinstance(gid, bool) or not isinstance(uid, int) or not isinstance(gid, int) or not 0 <= uid <= 2147483647 or not 0 <= gid <= 2147483647:
            raise ValueError("Owner change needs explicit valid numeric UID and GID")
        if (uid, gid) != (before["effectiveUid"], before["effectiveGid"]):
            os.chown(directory_fd, uid, gid)
    os.chmod(directory_fd, int(mode, 8))
    for field, default in (("accessEntries", False), ("defaultEntries", True)):
        desired = {(kind, numeric) for kind, numeric, permission in resolved[field]}
        for old in (old_policy.get("config") or {}).get(field, []):
            kind, numeric, permission = resolved_entry(old)
            if (kind, numeric) not in desired:
                run(["setfacl", *( ["-d"] if default else [] ), "-x", f"{kind}:{numeric}", path])
        for kind, numeric, permission in resolved[field]:
            run(["setfacl", *( ["-d"] if default else [] ), "-m", f"{kind}:{numeric}:{permission}", path])
    after = observe(payload)
    if after["effectiveMode"] != format(int(mode, 8), "04o"):
        raise RuntimeError("POSIX ACL mask conflicts with requested directory mode")
    if config.get("applyOwner") and (after["effectiveUid"], after["effectiveGid"]) != (config["ownerUid"], config["ownerGid"]):
        raise RuntimeError("POSIX owner did not match the explicit directory policy")
    after["resolvedAccessEntries"] = [{"kind": kind, "numericId": numeric, "permission": permission} for kind, numeric, permission in resolved["accessEntries"]]
    after["resolvedDefaultEntries"] = [{"kind": kind, "numericId": numeric, "permission": permission} for kind, numeric, permission in resolved["defaultEntries"]]
    after["driftStatus"] = "CONSISTENT"
    return after

def apply_policy_atomic(payload, before, old_policy):
    verify_expected_directory_identity(payload, before)
    try:
        return apply_policy(payload, before, old_policy)
    except Exception:
        restore(before)
        raise

def plan_policy(payload, before, old_policy):
    """Simulate one inode only in private scratch; DATA stays untouched."""
    verify_expected_directory_identity(payload, before)
    validate_policy(payload.get("config") or {})
    if payload.get("rootInitialization") is not None:
        raise ValueError("NEW root initializer has a separate format receipt transaction")
    global canonical_path, directory_fd
    original_path, original_descriptor = canonical_path, directory_fd
    with tempfile.TemporaryDirectory(prefix="ablestack-posix-plan-", dir="/run") as scratch:
        descriptor = os.open(scratch, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            canonical_path, directory_fd = scratch, descriptor
            os.chown(descriptor, before["effectiveUid"], before["effectiveGid"])
            pinned = "/proc/self/fd/" + str(descriptor)
            run(["setfacl", "-b", pinned]);run(["setfacl", "-k", pinned])
            run(["setfacl", "--set-file=-", pinned], input="\n".join(before["acl"])+"\n", text=True)
            os.chmod(descriptor, int(before["effectiveMode"],8))
            simulated_before = observe(payload)
            simulated_request = {**payload, "expectedDirectoryIdentity": simulated_before["directoryIdentity"]}
            simulated = apply_policy_atomic(simulated_request, simulated_before, old_policy)
        finally:
            canonical_path, directory_fd = original_path, original_descriptor
            os.close(descriptor)
    if observe(payload)["directoryIdentity"] != before["directoryIdentity"]:
        raise ValueError("POSIX DATA changed during pure policy planning")
    effective = {**simulated, "canonicalPath": original_path, "device": before["device"], "inode": before["inode"]}
    effective["directoryIdentity"] = {**effective["directoryIdentity"], "device":before["device"],"inode":before["inode"]}
    return {"success":True,"sideEffects":False,"scratchOnly":True,"beforeDirectoryIdentity":before["directoryIdentity"],
            "predictedDirectoryIdentity":effective["directoryIdentity"],"predictedEffective":effective,
            "configurationDesiredRow":{"request":payload,"config":payload.get("config") or {},"effective":effective},
            "postApplyReceiptRequired":True}

canonical_path, filesystem_uuid, directory_fd = path_identity(request)
state_path = "/etc/ablestack-storage/posix-directory-policies.json"
try:
    with open(state_path, encoding="utf-8") as fp:
        desired = json.load(fp)
except FileNotFoundError:
    desired = {}

initializer = RootInitialization() if request.get("rootInitialization") is not None else None
initialization_receipt = None
post_apply_receipts = PosixPolicyReceipt()
already_effective = False
if operation == "restore":
    if initializer:
        initialization_receipt = root_receipt_read(initializer.path(request))
        if not initialization_receipt or initialization_receipt.get("scope") != initializer.scope(request):
            raise ValueError("NEW root initializer restore scope changed")
    # Validate previous attestation before any metadata inverse operation.
    previous_receipt = request.get("previousPostApplyReceipt")
    if previous_receipt is not None:
        previous_request = (request.get("previousPolicy") or {}).get("request")
        if not isinstance(previous_request, dict):
            raise ValueError("POSIX restore lacks its previous committed request")
        post_apply_receipts.verify(previous_request, request, previous_receipt)
    result = restore(request)
    result["driftStatus"] = "RESTORED"
    if initializer:
        initializer.failed(request, initialization_receipt, result)
elif operation == "inspect":
    validate_policy(request.get("config") or {})
    result = observe(request)
    result["previousPolicy"] = desired.get(result["uuid"])
    result["postApplyReceiptVerified"] = False
    try:
        result["previousPostApplyReceipt"] = post_apply_receipts.read(request)
        previous = result["previousPolicy"]
        if isinstance(previous,dict) and isinstance(previous.get("request"),dict):
            stored=previous["request"]
            if all(stored.get(key)==request.get(key) for key in ("uuid","instanceUuid","volumeUuid","volumeMountPath","relativePath")):
                result["postApplyReceiptVerified"] = post_apply_receipts.replay(stored,previous,result)
    except (OSError,ValueError,KeyError,TypeError) as unavailable:
        result["previousPostApplyReceipt"] = None
        result["postApplyReceiptDiagnostic"] = str(unavailable)
    if result["filesystemRoot"]:
        result["newRootInitialization"] = RootInitialization().preview(request, result, directory_fd)
elif operation == "attest-plan":
    response=run([sys.argv[3],"operation","maintenance","status"],capture_output=True,text=True)
    maintenance=json.loads(response.stdout)
    result=post_apply_receipts.transferred_plan(transfer_request["canonicalPolicyRow"],observe(request),transfer_request["rootScope"],transfer_request["sourceConfigurationSha256"],maintenance)
elif operation == "plan":
    before = observe(request)
    result = plan_policy(request, before, desired.get(before["uuid"]) or {})
elif operation == "forget":
    result = observe(request)
    desired.pop(str(uuid.UUID(request["uuid"])), None)
elif operation == "apply":
    before = observe(request)
    before["previousPolicy"] = desired.get(before["uuid"])
    before["previousPostApplyReceipt"] = post_apply_receipts.read(request)
    old = before["previousPolicy"] or {}
    already_effective = post_apply_receipts.replay(request, old, before)
    replayed = False
    if initializer and not already_effective:
        initialization_receipt, replayed = initializer.prepare(request, before, directory_fd)
    try:
        if already_effective:
            result = {**old["effective"], **before, "driftStatus": "CONSISTENT", "alreadyEffective": True, "postApplyReceiptVerified": True}
            result.pop("previousPolicy", None);result.pop("previousPostApplyReceipt", None)
        elif replayed:
            result = {**initialization_receipt["after"], **before, "driftStatus": "CONSISTENT"}
            result.pop("previousPolicy", None);result.pop("previousPostApplyReceipt", None)
        else:
            result = apply_policy_atomic(request, before, old)
            if initializer:
                initializer.verified(request, initialization_receipt, result)
    except Exception:
        if initializer:
            initializer.failed(request, initialization_receipt, observe(request))
        raise
    if not already_effective:
        desired[before["uuid"]] = {"request": request, "config": request.get("config") or {}, "effective": result}
else:
    raise ValueError("Unsupported POSIX directory operation")

if operation in ("apply", "forget", "restore") and not already_effective:
    fd, temporary = tempfile.mkstemp(prefix=".posix-policy-", dir=os.path.dirname(state_path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fp:
            json.dump(desired, fp, sort_keys=True, indent=2);fp.flush();os.fsync(fp.fileno())
        os.replace(temporary, state_path)
    except Exception:
        if operation == "apply":
            restored = restore(before)
            if initializer:
                initializer.failed(request, initialization_receipt, restored)
        raise
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
if operation == "apply" and not already_effective:
    post_apply_receipts.write(request, result)
    result["alreadyEffective"] = False
    result["postApplyReceiptVerified"] = True
elif operation == "restore":
    post_apply_receipts.restore(request, request.get("previousPolicy"), request.get("previousPostApplyReceipt"), result)
elif operation == "forget":
    post_apply_receipts.restore(request, None, None, result)
if operation == "apply" and initializer and not already_effective:
    initializer.complete(request, initialization_receipt)
    result["newRootInitialization"] = {"available": False, "phase": "COMPLETE", "formatReceiptUuid": initialization_receipt["scope"]["formatReceiptUuid"]}
result["postApplyReceiptSupported"] = True
os.close(directory_fd)
print(json.dumps(result, sort_keys=True))
PYPOSIX
}

apply_smb_shares() {
  local payload_file="$1"
  local mode="${2:-apply}"

  python3 - "$payload_file" "$mode" <<'PY'
import json
from pathlib import Path
import ipaddress
import atexit
import grp
import hashlib
import stat
import os
import pwd
import re
import shutil
import socket
import time
import subprocess
import tempfile
import sys

smb_operation_started = time.monotonic()
smb_operation_deadline = smb_operation_started + 300
smb_apply_deadline = smb_operation_started + 240
smb_rollback_active = False

def smb_budget(maximum=30):
    deadline = smb_operation_deadline if smb_rollback_active else smb_apply_deadline
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise RuntimeError("SMB endpoint operation deadline expired")
    return min(maximum, remaining)

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)
try:
    previous_name_result = subprocess.run(["testparm", "-s", "--parameter-name=netbios name"],
                                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=10)
    previous_netbios_name = previous_name_result.stdout.strip().upper() if previous_name_result.returncode == 0 else ""
except (OSError, subprocess.TimeoutExpired):
    previous_netbios_name = ""

try:
    with open(os.path.join(state_dir, "smb-access.json"), "r", encoding="utf-8") as previous_fp:
        previous_access = json.load(previous_fp)
except FileNotFoundError:
    previous_access = {}


def run(command, **kwargs):
    kwargs["timeout"] = smb_budget(kwargs.get("timeout", 30))
    return subprocess.run(command, check=True, **kwargs)

def run_optional(command, **kwargs):
    kwargs["timeout"] = smb_budget(kwargs.get("timeout", 30))
    try:
        return subprocess.run(command, check=True, **kwargs)
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None

def truth(config, key, default):
    value = config.get(key, default) if isinstance(config, dict) else default
    return bool(value)

def smb_network_policy(acls):
    sources = []
    configured = 0
    for acl in acls:
        if acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        configured += 1
        if acl.get("permission") != "CONNECT":
            raise ValueError("SMB source rule requires CONNECT permission")
        value = str(acl.get("principal") or "").strip()
        kind = acl.get("principalType")
        if kind == "CIDR":
            if "/" not in value:
                raise ValueError("CIDR source requires a prefix")
            normalized = str(ipaddress.ip_network(value, strict=False))
        elif kind == "IP_ADDRESS":
            if "%" in value:
                raise ValueError("Scoped IPv6 source tokens are unsupported")
            normalized = str(ipaddress.ip_address(value))
        else:
            raise ValueError("Only literal IP/CIDR source rules are supported")
        if normalized not in sources:
            sources.append(normalized)
    return {"networkAccessMode": "ALLOW_LIST" if sources else "ANY_SOURCE", "allowedSources": sources,
            "configuredNetworkAclCount": configured, "effectiveNetworkAclCount": len(sources),
            "networkAccessState": "restricted" if sources else "open"}

def smb_hosts_allow_lines(policy):
    if policy["networkAccessMode"] == "ANY_SOURCE":
        return []
    return ["   hosts allow = " + " ".join([*policy["allowedSources"], "127.0.0.1", "::1"])]

def smb_creation_policy(config):
    result = {}
    for key, default in (("createMask", "0660"), ("forceCreateMode", "0000"),
                         ("directoryMask", "0770"), ("forceDirectoryMode", "0000")):
        value = str(config.get(key, default))
        if not re.fullmatch(r"0?[0-7]{3}", value):
            raise ValueError(key + " must be octal 0000 through 0777")
        result[key] = format(int(value, 8), "04o")
    result["inheritPermissions"] = truth(config, "inheritPermissions", False)
    for mask, forced in (("createMask", "forceCreateMode"), ("directoryMask", "forceDirectoryMode")):
        if int(result[forced], 8) & ~int(result[mask], 8):
            raise ValueError("Forced mode is outside its mask")
    if result["inheritPermissions"] and (int(result["forceCreateMode"], 8) or int(result["forceDirectoryMode"], 8)):
        raise ValueError("Parent permission inheritance conflicts with forced modes")
    return result

def smb_creation_lines(policy):
    return ["   create mask = " + policy["createMask"],
            "   force create mode = " + policy["forceCreateMode"],
            "   directory mask = " + policy["directoryMask"],
            "   force directory mode = " + policy["forceDirectoryMode"],
            "   inherit permissions = " + ("yes" if policy["inheritPermissions"] else "no")]

smb_previous_files = {}
smb_previous_modes = {}
for previous_path in ("/etc/samba/smb.conf", os.path.join(state_dir, "smb-access.json"), os.path.join(state_dir, "smb-quotas.json"), os.path.join(state_dir, "smb-managed-identities.json")):
    try:
        with open(previous_path, "rb") as previous_fp:
            smb_previous_files[previous_path] = previous_fp.read()
            smb_previous_modes[previous_path] = os.stat(previous_path).st_mode & 0o777
    except FileNotFoundError:
        smb_previous_files[previous_path] = None

managed_identity_path = os.path.join(state_dir, "smb-managed-identities.json")
try:
    with open(managed_identity_path, "r", encoding="utf-8") as managed_fp:
        managed_identities = json.load(managed_fp)
except FileNotFoundError:
    managed_identities = {}
active_managed_identities = {}

created_identity_users = []
created_identity_groups = []
identity_apply_verified = False

def rollback_uncommitted_managed_identities():
    global smb_rollback_active
    smb_rollback_active = True
    if identity_apply_verified:
        return
    for path, content in smb_previous_files.items():
        if content is None:
            try:
                os.unlink(path)
            except FileNotFoundError:
                pass
            continue
        fd, temporary = tempfile.mkstemp(prefix=".smb-rollback-", dir=os.path.dirname(path))
        try:
            with os.fdopen(fd, "wb") as rollback_fp:
                rollback_fp.write(content);rollback_fp.flush();os.fsync(rollback_fp.fileno())
            os.chmod(temporary, smb_previous_modes.get(path, 0o600))
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    if shutil.which("smbcontrol"):
        run_optional(["smbcontrol", "all", "reload-config"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for name in reversed(created_identity_users):
        run_optional(["userdel", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for name in reversed(created_identity_groups):
        run_optional(["groupdel", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

atexit.register(rollback_uncommitted_managed_identities)

def smb_forced_identity(config, share_uuid, acls, create=False):
    mode = str(config.get("posixOwnershipMode") or "AUTHENTICATED_USER").upper()
    if mode == "AUTHENTICATED_USER":
        return {"posixOwnershipMode": mode}
    if mode != "FORCED_UID_GID":
        raise ValueError("Unknown forced POSIX ownership mode")
    uid, gid = config.get("ownerUid"), config.get("ownerGid")
    if not isinstance(uid, int) or not isinstance(gid, int) or uid < 10000 or gid < 10000 or uid == 65534 or gid == 65534 or uid > 2147483647 or gid > 2147483647:
        raise ValueError("Forced identity requires non-protected UID/GID")
    if truth(config, "guestOk", False) or config.get("ownershipInheritance") == "INHERIT_PARENT_OWNER":
        raise ValueError("Forced identity cannot be combined with guest or parent-owner inheritance")
    if any(acl.get("permission") == "ADMIN" and acl.get("state", "Ready") not in ("Disabled", "Destroyed", "Error") for acl in acls):
        raise ValueError("ADMIN account ACL cannot override forced identity")
    token = re.sub(r"[^a-fA-F0-9]", "", str(share_uuid))[:20].lower()
    if len(token) != 20:
        raise ValueError("Managed identity needs a stable share UUID")
    user, group = "sf_u_" + token, "sf_g_" + token
    try:
        observed_group = grp.getgrnam(group)
        if observed_group.gr_gid != gid:
            raise ValueError("Managed group maps to another GID")
    except KeyError:
        try:
            grp.getgrgid(gid)
            raise ValueError("Requested GID belongs to an existing group")
        except KeyError:
            if create:
                run(["groupadd", "--gid", str(gid), group])
                created_identity_groups.append(group)
    try:
        observed_user = pwd.getpwnam(user)
        if observed_user.pw_uid != uid or observed_user.pw_gid != gid or observed_user.pw_shell not in ("/usr/sbin/nologin", "/sbin/nologin", "/bin/false"):
            raise ValueError("Managed user identity differs from its requested UID/GID or login policy")
    except KeyError:
        try:
            pwd.getpwuid(uid)
            raise ValueError("Requested UID belongs to an existing user")
        except KeyError:
            if create:
                run(["useradd", "--uid", str(uid), "--gid", str(gid), "--no-create-home", "--home-dir", "/nonexistent", "--shell", "/usr/sbin/nologin", user])
                created_identity_users.append(user)
    if create:
        checked = pwd.getpwnam(user)
        if checked.pw_uid != uid or checked.pw_gid != gid or checked.pw_dir != "/nonexistent" or checked.pw_shell != "/usr/sbin/nologin":
            raise ValueError("Managed identity failed UID/GID/non-login verification")
        if grp.getgrnam(group).gr_gid != gid:
            raise ValueError("Managed group failed GID verification")
    result = {"posixOwnershipMode": mode, "ownerUid": uid, "ownerGid": gid, "managedUser": user, "managedGroup": group}
    if create:
        recorded = managed_identities.get(str(share_uuid), {})
        result["createdByControllerUser"] = bool(recorded.get("createdByControllerUser")) or user in created_identity_users
        result["createdByControllerGroup"] = bool(recorded.get("createdByControllerGroup")) or group in created_identity_groups
        active_managed_identities[str(share_uuid)] = result
    return result

def smb_forced_identity_lines(policy):
    if policy["posixOwnershipMode"] != "FORCED_UID_GID":
        return []
    return ["   force user = " + policy["managedUser"], "   force group = " + policy["managedGroup"]]

def smb_effective_read_only(config, account_acl_count, guest_ok):
    # Account ACL permissions are enforced before the forced UNIX identity is used.
    return truth(config, "readOnly", False) or (account_acl_count > 0 and not guest_ok)

def smb_inheritance_policy(config, acls):
    mode = str(config.get("ownershipInheritance") or "AUTHENTICATED_USER").upper()
    if mode not in ("AUTHENTICATED_USER", "INHERIT_PARENT_OWNER"):
        raise ValueError("Unknown SMB parent ownership inheritance mode")
    group = truth(config, "inheritGroup", False)
    if group and mode != "INHERIT_PARENT_OWNER":
        raise ValueError("Parent group inheritance requires parent owner inheritance")
    if mode == "INHERIT_PARENT_OWNER":
        if str(config.get("posixOwnershipMode") or "AUTHENTICATED_USER").upper() == "FORCED_UID_GID" or truth(config, "guestOk", False):
            raise ValueError("Parent owner inheritance conflicts with forced identity or guest access")
        if any(acl.get("permission") == "ADMIN" and acl.get("state", "Ready") not in ("Disabled", "Destroyed", "Error") for acl in acls):
            raise ValueError("ADMIN account ACL cannot override parent-owner inheritance")
    return {"ownershipInheritance": mode, "inheritGroup": group}

def smb_inheritance_lines(policy):
    return ["   inherit owner = yes"] if policy["ownershipInheritance"] == "INHERIT_PARENT_OWNER" else []

def smb_creation_acl_preflight(path, policy):
    if not int(policy["forceCreateMode"], 8) and not int(policy["forceDirectoryMode"], 8):
        return {"state": "COMPATIBLE", "defaultAclMode": None}
    if not os.path.isdir(path):
        return {"state": "NEW_DIRECTORY", "defaultAclMode": None}
    observed = run(["getfacl", "-cpn", path], stdout=subprocess.PIPE, text=True)
    entries = {}
    for line in observed.stdout.splitlines():
        fields = line.split(":")
        if len(fields) == 4 and fields[0] == "default" and not fields[2]:
            entries[fields[1]] = fields[3].split()[0]
    if not entries:
        return {"state": "COMPATIBLE", "defaultAclMode": None}
    def bits(value):
        return (4 if "r" in value else 0) | (2 if "w" in value else 0) | (1 if "x" in value else 0)
    allowed = (bits(entries.get("user", "---")) << 6) | (bits(entries.get("mask", entries.get("group", "---"))) << 3) | bits(entries.get("other", "---"))
    for key in ("forceCreateMode", "forceDirectoryMode"):
        if int(policy[key], 8) & ~allowed:
            raise RuntimeError("SMB forced creation mode conflicts with existing default POSIX ACL at " + path
                               + "; default ACL permits " + format(allowed, "04o") + ". Review the common directory policy before changing permissions.")
    return {"state": "COMPATIBLE", "defaultAclMode": format(allowed, "04o")}

def safe_share_name(value):
    value = str(value or "")
    if not re.match(r"^[A-Za-z0-9_.-]+$", value):
        raise ValueError(f"invalid SMB share name: {value}")
    return value

def derive_ad_workgroup(domain_name, workgroup):
    value = str(workgroup or "").strip()
    if value and value.upper() != "WORKGROUP":
        return re.sub(r"[^A-Za-z0-9]", "", value)[:15].upper() or "WORKGROUP"
    domain = str(domain_name or "").strip()
    if domain:
        derived = re.sub(r"[^A-Za-z0-9]", "", domain.split(".", 1)[0])[:15].upper()
        if derived:
            return derived
    return "WORKGROUP"

def smb_identity(value):
    value = str(value or "")
    if not value:
        return ""
    if value.startswith("@"):
        return value
    return value.replace("/", "\\")

def smb_conf_quote(value):
    return chr(34) + str(value or '').replace(chr(34), "\\" + chr(34)) + chr(34)


def smb_group(value):
    value = smb_identity(value)
    if value.startswith('@'):
        value = value[1:]
    return '@' + smb_conf_quote(value)


def smb_user(value):
    return smb_conf_quote(smb_identity(value))

def record_created_local_identity(user=None, group=None):
    provenance_path = os.path.join(state_dir, "smb-local-account-provenance.json")
    try:
        with open(provenance_path, "r", encoding="utf-8") as handle:
            provenance = json.load(handle)
    except FileNotFoundError:
        provenance = {"schemaVersion": 1, "accounts": {"/etc/passwd": [], "/etc/group": []}}
    for path, name in (("/etc/passwd", user), ("/etc/group", group)):
        if not name:
            continue
        with open(path, "r", encoding="utf-8") as handle:
            record = next(line.rstrip("\n") for line in handle if line.split(":", 1)[0] == name)
        records = provenance["accounts"].setdefault(path, [])
        records[:] = [line for line in records if line.split(":", 1)[0] != name]
        records.append(record)
    fd, temporary = tempfile.mkstemp(prefix=".smb-account-provenance-", dir=state_dir)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(provenance, handle, sort_keys=True);handle.flush();os.fsync(handle.fileno())
        os.replace(temporary, provenance_path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

def ensure_local_group(group):
    if not group:
        return
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", group):
        raise ValueError(f"Invalid local SMB group name: {group}")
    try:
        grp.getgrnam(group)
    except KeyError:
        run(["groupadd", group])
        record_created_local_identity(group=group)

def ensure_local_smb_user(user, password):
    if not user or not password:
        return
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", user):
        raise ValueError(f"Invalid local SMB user name: {user}")
    try:
        pwd.getpwnam(user)
    except KeyError:
        command = ["useradd", "-M", "-s", "/usr/sbin/nologin"]
        created_group = False
        try:
            grp.getgrnam(user)
            command.extend(["-g", user])
        except KeyError:
            created_group = True
        command.append(user)
        run(command)
        record_created_local_identity(user=user, group=user if created_group else None)
    run(["smbpasswd", "-s", "-a", user], input=f"{password}\n{password}\n", text=True)
    run(["smbpasswd", "-e", user])

def safe_netbios_name(value, instance_uuid):
    raw = re.sub(r"[^A-Za-z0-9]", "", str(value or ""))
    if not raw:
        suffix = re.sub(r"[^A-Fa-f0-9]", "", str(instance_uuid or ""))[:10].ljust(10, "0")
        raw = f"STOR{suffix}"
    return raw[:15].upper()

def local_or_ad_name(principal_type, principal, workgroup, netbios_name):
    value = smb_identity(principal)
    if not value or "\\" in value:
        return value
    if principal_type in ("AD_USER", "AD_GROUP") and workgroup:
        return f"{workgroup}\\{value}"
    if principal_type in ("LOCAL_USER", "LOCAL_GROUP") and netbios_name:
        return f"{netbios_name}\\{value}"
    return value

def samba_principal(principal_type, principal, workgroup, netbios_name):
    name = local_or_ad_name(principal_type, principal, workgroup, netbios_name)
    return smb_group(name) if principal_type in ("LOCAL_GROUP", "AD_GROUP") else smb_user(name)

def identity_candidates(principal_type, principal):
    value = smb_identity(principal)
    candidates = []
    if value:
        candidates.append(value)
    if principal_type in ("AD_USER", "AD_GROUP") and value and "\\" not in value and workgroup:
        candidates.append(f"{workgroup}\\{value}")
    if principal_type in ("LOCAL_USER", "LOCAL_GROUP") and value and "\\" not in value and netbios_name:
        candidates.append(f"{netbios_name}\\{value}")
    seen = set()
    result = []
    for item in candidates:
        if item and item not in seen:
            result.append(item)
            seen.add(item)
    return result


def resolve_account_id(principal_type, principal):
    if principal_type == "LOCAL_USER":
        return "u", str(pwd.getpwnam(principal).pw_uid)
    if principal_type == "LOCAL_GROUP":
        return "g", str(grp.getgrnam(principal).gr_gid)
    if principal_type == "AD_USER":
        for candidate in identity_candidates(principal_type, principal):
            result = run_optional(["wbinfo", "--user-info", candidate], stdout=subprocess.PIPE, text=True)
            if result and result.stdout:
                parts = result.stdout.strip().split(":")
                if len(parts) > 2 and parts[2].isdigit():
                    return "u", parts[2]
            try:
                return "u", str(pwd.getpwnam(candidate).pw_uid)
            except KeyError:
                pass
    if principal_type == "AD_GROUP":
        for candidate in identity_candidates(principal_type, principal):
            result = run_optional(["wbinfo", "--group-info", candidate], stdout=subprocess.PIPE, text=True)
            if result and result.stdout:
                parts = result.stdout.strip().split(":")
                if len(parts) > 2 and parts[2].isdigit():
                    return "g", parts[2]
            try:
                return "g", str(grp.getgrnam(candidate).gr_gid)
            except KeyError:
                pass
    return None, None

def apply_posix_acl(path, principal_type, principal, permission):
    if not shutil.which("setfacl") or not principal:
        return False
    kind, account_id = resolve_account_id(principal_type, principal)
    if not kind or not account_id:
        return False
    bits = "r-x" if permission == "READ_ONLY" else "rwx"
    run(["setfacl", "-m", f"{kind}:{account_id}:{bits}", path])
    run(["setfacl", "-d", "-m", f"{kind}:{account_id}:{bits}", path])
    return True

def reset_directory_acl(path):
    if shutil.which("setfacl"):
        run_optional(["setfacl", "-b", path])
        run_optional(["setfacl", "-k", path])

def verify_common_posix_policy(path, config):
    policy_uuid = config.get("posixPolicyUuid")
    if not policy_uuid:
        return False
    with open("/etc/ablestack-storage/posix-directory-policies.json", "r", encoding="utf-8") as fp:
        policies = json.load(fp)
    stored = policies.get(str(policy_uuid))
    if not isinstance(stored, dict):
        raise RuntimeError("Referenced common POSIX policy is not applied")
    request = stored.get("request") or {}
    canonical = os.path.normpath(os.path.join(str(request.get("volumeMountPath") or "").rstrip("/"), str(request.get("relativePath") or "")))
    if os.path.realpath(path) != canonical or int(request.get("revision", -1)) != int(config.get("posixPolicyRevision", -2)):
        raise RuntimeError("Protocol directory or revision differs from the common POSIX policy")
    if os.path.islink(path):
        raise RuntimeError("Common POSIX directory is a symlink")
    return True

def apply_directory_policy(path, config, cross_protocol, previous=None):
    mode = str(config.get("directoryMode") or "0770")
    if not re.fullmatch(r"0?[0-7]{3,4}", mode) or int(mode, 8) > 0o7777:
        raise ValueError("Invalid share root directory mode")
    parsed_mode = int(mode, 8)
    previous = previous or {}
    # Creation options must not reset named/default ACLs or touch an unchanged root mode.
    if not verify_common_posix_policy(path, config) and not cross_protocol and (previous.get("path") != path or int(previous.get("directoryMode", "-1"), 8) != parsed_mode):
        os.chmod(path, parsed_mode)
    return parsed_mode

def remove_stale_managed_smb_acls(path, acls, previous):
    desired = {(acl.get("principalType"), acl.get("principal")) for acl in acls
               if acl.get("state", "Ready") not in ("Disabled", "Destroyed", "Error")}
    for acl in previous.get("aclSummary", []):
        key = (acl.get("principalType"), acl.get("principal"))
        if key in desired:
            continue
        kind, account_id = resolve_account_id(*key)
        if kind and account_id:
            # Remove only a previously managed principal; preserve unrelated named and default ACLs.
            run(["setfacl", "-x", f"{kind}:{account_id}", path])
            run(["setfacl", "-d", "-x", f"{kind}:{account_id}", path])

