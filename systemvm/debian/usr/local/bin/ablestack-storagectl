    ;;
  volume)
    if [[ "$subcommand" == "operation" && "$action" == "capabilities" ]]; then
      printf '%s\n' '{"success":true,"formatDiscardPolicies":["DEFAULT","SKIP_DISCARD"],"sparseFormatRequired":true,"formatterSuccessReceiptSupported":true,"readonlyVolumeIdentitySupported":true}'
    elif [[ "$subcommand" == "attach" && "$action" == "inspect" ]]; then
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for volume attach inspect."
        exit 2
      fi
      log_command "$command $subcommand $action" "$payload"
      volume_attach_inspect "$payload"
    elif [[ "$subcommand" == "operation" && "$action" == "resume" ]]; then
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for volume operation resume."
        exit 2
      fi
