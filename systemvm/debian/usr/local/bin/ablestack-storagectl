with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)
pending_smb = PendingNfsAuthorization(protocol="SMB")
if not os.environ.get("ABLESTACK_STORAGE_RENDERED_REPLAY"):
    pending_smb.validate_payload(payload)
elif "operationScope" in payload:
    raise ValueError("Rendered SMB replay cannot carry a legacy operation scope")

def pending_smb_service_start(unit, restart=False, enable=False):
    canonical = unit if unit.endswith(".service") else unit + ".service"
    command = ["systemctl", "restart" if restart else "start", canonical]
    if enable:
        command = ["systemctl", "enable", "--now", canonical]
    authorization = contextlib.nullcontext() if os.environ.get("ABLESTACK_STORAGE_RENDERED_REPLAY") else pending_smb.grant(payload, canonical)
    with authorization:
        return run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)


