case "$command" in
  identity)
    if [[ ( "$subcommand" == "domain" && "$action" == "inspect" ) || ( "$subcommand" == "principal" && "$action" == "resolve" ) ]]; then
      identity_metadata_command
      exit $?
    fi
    if [[ "$subcommand" != "capsule" || ! -r "$payload" ]]; then
      emit_error "A readable identity capsule request is required."
      exit 2
    fi
    log_command "$command" "$action"
    identity_capsule_command "$action" "$payload"
    ;;
  apply)
    payload="${2:-}"
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for apply."
      exit 2
    fi
    log_command "$command" "$payload"
    emit_success "Storage Service apply skeleton accepted the payload."
    ;;
  operation)
    if [[ "$subcommand" == "generation" ]]; then
      case "$action" in
        render-import|render-stage|render-activate|render-rollback|render-status|render-finalize|render-boot|render-boot-gate|render-maintenance-verify|render-maintenance-resume-source|render-root-capture-source|render-root-resume-source|render-root-replay-guard|render-root-source-quiesce-guard|render-root-quiesce-source|render-root-identity-export-source) rendered_generation_command ;;
        *) configuration_generation ;;
      esac
    elif [[ "$subcommand" == "reservation" ]]; then
      resource_reservation_command
    elif [[ "$subcommand" == "maintenance" ]]; then
      maintenance_command "$action" "$payload"
    elif [[ "$subcommand" == "root-network" && "$action" == "bootstrap" ]]; then
      root_network_bootstrap_command
    elif [[ "$subcommand" == "root-data" && "$action" == "inspect" ]]; then
