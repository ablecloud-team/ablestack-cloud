        raise ValueError("ROOT POSIX source configuration differs from its pinned capsule")
    result=PosixReceiptTransfer().restore(payload.get("posixPolicies") or {},{key:request[key] for key in ("instanceUuid","templateUpgradeUuid","operationUuid","revision")},
        request["sourceConfigurationSha256"],request["fileVolumeBindings"],identity_command(("operation","maintenance","status")),
        lambda value:identity_command(("posix","directory","inspect","/dev/stdin"),value),
        lambda binding:identity_command(("operation","root-data","inspect","/dev/stdin"),{**{key:request[key] for key in ("instanceUuid","templateUpgradeUuid","operationUuid","revision")},
                                      "volumes":[{"volumeUuid":binding["volumeUuid"],"sizeBytes":binding["sizeBytes"],"kind":"FILE_DATA"}]})["volumes"][0])
    print(json.dumps(result,sort_keys=True))
elif action=="export-root-target":
    controls={key:request[key] for key in ("instanceUuid","templateUpgradeUuid","operationUuid","revision","targetConfigurationSha256")}
    roles=[key for key in ("importedRootAuthorization","retainedRootAuthorization") if key in request]
    if len(roles)!=1:raise ValueError("ROOT TARGET has no single opaque SOURCE role")
    controls[roles[0]]=request[roles[0]]
    if not set(request)<=set(controls)|{"publicKey","names","nvmeHosts","includePosixPolicyReceipts"} or request.get("includePosixPolicyReceipts") is not True:
        raise ValueError("ROOT TARGET RAW request contains unsupported or incomplete fields")
    cached=identity_command(("operation","generation","render-root-target-cached-cipher","/dev/stdin"),{**controls,"publicKey":request["publicKey"]}).get("cachedTarget")
    if cached is not None:
        print(json.dumps({"success":True,**cached},sort_keys=True))
    else:
        target=identity_command(("operation","generation","render-root-identity-export-target","/dev/stdin"),controls)
        key_proof=identity_command(("operation","generation","render-root-target-key-guard","/dev/stdin"),{**controls,"publicKey":request["publicKey"]})
        if target.get("rootTargetStoppedVerified") is not True or target.get("scope")!={key:controls[key] for key in ("instanceUuid","templateUpgradeUuid","operationUuid","revision")}:raise ValueError("ROOT TARGET lacks actual stopped authority")
        payload=collect(request.get("names") or [],request.get("nvmeHosts") or [])
        payload["sourceConfigurationSha256"]=target["targetConfigurationSha256"];payload["adIdentity"]=target["adIdentity"]
        payload["posixPolicies"]=target["posixPolicies"];payload["rootSourceConfiguration"]=target["rootSourceConfiguration"]
        validate_payload(payload)
