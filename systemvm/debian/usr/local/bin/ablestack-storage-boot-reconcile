#!/bin/bash

set -euo pipefail

STORAGECTL="${ABLESTACK_STORAGECTL:-/usr/local/bin/ablestack-storagectl}"
MONITOR="${ABLESTACK_STORAGE_MONITOR:-/usr/local/bin/ablestack-storage-monitor}"
DESIRED_STATE_DIR="${ABLESTACK_STORAGE_DESIRED_STATE_DIR:-/etc/ablestack-storage/desired-state}"
NFS_PAYLOAD="${ABLESTACK_STORAGE_NFS_DESIRED_STATE_FILE:-${DESIRED_STATE_DIR}/nfs-export-apply.json}"
SMB_PAYLOAD="${ABLESTACK_STORAGE_SMB_DESIRED_STATE_FILE:-${DESIRED_STATE_DIR}/smb-share-apply.json}"
ISCSI_PAYLOAD="${ABLESTACK_STORAGE_ISCSI_DESIRED_STATE_FILE:-/etc/ablestack-storage/iscsi-targets.json}"
NVMEOF_PAYLOAD="${ABLESTACK_STORAGE_NVMEOF_DESIRED_STATE_FILE:-/etc/ablestack-storage/nvmeof-subsystems.json}"
POSIX_POLICIES="${ABLESTACK_STORAGE_POSIX_POLICY_FILE:-/etc/ablestack-storage/posix-directory-policies.json}"
LOG_FILE="${ABLESTACK_STORAGE_BOOT_RECONCILE_LOG:-/var/log/ablestack-storage-boot-reconcile.log}"
MAX_ATTEMPTS="${ABLESTACK_STORAGE_BOOT_RECONCILE_ATTEMPTS:-12}"
SLEEP_SECONDS="${ABLESTACK_STORAGE_BOOT_RECONCILE_SLEEP:-5}"

log() {
  mkdir -p "$(dirname "$LOG_FILE")"
  printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG_FILE"
}

ensure_ganesha_runtime_dirs() {
  mkdir -p /run/ablestack-storage/ganesha /etc/ganesha/ablestack-storage /run/ganesha
  if [[ -f /run/ganesha/ganesha.pid ]]; then
    local pid
    pid="$(cat /run/ganesha/ganesha.pid 2>/dev/null || true)"
    if [[ -z "$pid" || ! -d "/proc/$pid" ]]; then
      rm -f /run/ganesha/ganesha.pid
    fi
  fi
}


ensure_nvmeof_runtime() {
  mkdir -p /sys/kernel/config
  mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config >/dev/null 2>&1 || true
  modprobe nvmet >/dev/null 2>&1 || true
  modprobe nvmet-tcp >/dev/null 2>&1 || true
}

if [[ ! -s "$NFS_PAYLOAD" && ! -s "$SMB_PAYLOAD" && ! -s "$ISCSI_PAYLOAD" && ! -s "$NVMEOF_PAYLOAD" && ! -s "$POSIX_POLICIES" ]]; then
  log "no saved Storage Service desired state; skipping boot reconcile"
  exit 0
fi

if [[ ! -x "$STORAGECTL" ]]; then
  log "storagectl is not executable: $STORAGECTL"
  exit 1
fi

if [[ -s /etc/ablestack-storage/sharedfs-network.json ]]; then
  /usr/local/sbin/ablestack-sharedfs-network /etc/ablestack-storage/sharedfs-network.json >> "$LOG_FILE" 2>&1
else
  if systemctl cat cloud-dhclient@eth0.service >/dev/null 2>&1; then
    systemctl start cloud-dhclient@eth0.service >> "$LOG_FILE" 2>&1
  elif ! ip -4 -o addr show dev eth0 scope global | grep -q ' inet '; then
    timeout 90 dhclient -4 -1 -pf /run/dhclient.eth0.pid -lf /var/lib/dhcp/dhclient.eth0.leases eth0 >> "$LOG_FILE" 2>&1
  fi
fi

log "starting boot reconcile nfs=$NFS_PAYLOAD smb=$SMB_PAYLOAD iscsi=$ISCSI_PAYLOAD nvmeof=$NVMEOF_PAYLOAD"
ensure_ganesha_runtime_dirs
systemctl daemon-reload >/dev/null 2>&1 || true

attempt=1
while (( attempt <= MAX_ATTEMPTS )); do
  log "attempt $attempt/$MAX_ATTEMPTS"
  mount -a >> "$LOG_FILE" 2>&1 || true
  ensure_ganesha_runtime_dirs
  "$STORAGECTL" network endpoints reconcile >> "$LOG_FILE" 2>&1 || true
  success=1
  if [[ -s "$POSIX_POLICIES" ]]; then
    if python3 - "$STORAGECTL" "$POSIX_POLICIES" <<'PYPOSIXBOOT' >> "$LOG_FILE" 2>&1
import json
import os
import subprocess
import sys
import tempfile
with open(sys.argv[2], encoding="utf-8") as fp:
    policies = json.load(fp)
for item in policies.values():
    request = item.get("request")
    if not isinstance(request, dict):
        raise ValueError("Invalid persisted POSIX directory request")
    fd, path = tempfile.mkstemp(prefix="epic-posix-reconcile-", dir="/run")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fp:
            json.dump(request, fp)
        subprocess.run([sys.argv[1], "posix", "directory", "apply", path], check=True, timeout=60)
    finally:
        os.unlink(path)
PYPOSIXBOOT
    then
      log "Common POSIX directory policies reapplied successfully"
    else
      log "Common POSIX directory policy reapply failed"
      success=0
    fi
  fi
  if [[ -s "$NFS_PAYLOAD" ]]; then
    if "$STORAGECTL" nfs export apply "$NFS_PAYLOAD" >> "$LOG_FILE" 2>&1; then
      log "NFS desired state reapplied successfully"
    else
      log "NFS desired state reapply failed"
      success=0
    fi
  fi
  if [[ -s "$SMB_PAYLOAD" ]]; then
    if "$STORAGECTL" smb share apply "$SMB_PAYLOAD" >> "$LOG_FILE" 2>&1; then
      log "SMB desired state reapplied successfully"
    else
      log "SMB desired state reapply failed"
      success=0
    fi
  fi
  if [[ -s "$ISCSI_PAYLOAD" ]]; then
    if ABLESTACK_STORAGE_ISCSI_AUTHORITATIVE_REBUILD=1 "$STORAGECTL" iscsi target apply "$ISCSI_PAYLOAD" >> "$LOG_FILE" 2>&1; then
      log "iSCSI desired state reapplied successfully"
    else
      log "iSCSI desired state reapply failed"
      success=0
    fi
  fi
  if [[ -s "$NVMEOF_PAYLOAD" ]]; then
    ensure_nvmeof_runtime
    if "$STORAGECTL" nvmeof subsystem apply "$NVMEOF_PAYLOAD" >> "$LOG_FILE" 2>&1; then
      log "NVMe-oF desired state reapplied successfully"
    else
      log "NVMe-oF desired state reapply failed"
      success=0
    fi
  fi
  if (( success == 1 )); then
    if [[ -x "$MONITOR" ]]; then
      "$MONITOR" --once >> "$LOG_FILE" 2>&1 || true
    fi
    exit 0
  fi
  sleep "$SLEEP_SECONDS"
  attempt=$((attempt + 1))
done

log "boot reconcile failed after $MAX_ATTEMPTS attempts"
exit 1
