[Unit]
Description=ABLESTACK Storage Service monitor cache
After=cloud-early-config.service ablestack-sharedfs-network.service ablestack-storage-reconcile.service qemu-guest-agent.service
Wants=ablestack-sharedfs-network.service

[Service]
Type=simple
Environment=ABLESTACK_STORAGE_MONITOR_INTERVAL=10
Environment=ABLESTACK_STORAGE_MONITOR_STALE_AFTER=30
ExecStart=/usr/local/bin/ablestack-storage-monitor
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
