[Unit]
Description=ABLESTACK Storage Service boot reconcile
After=local-fs.target cloud-early-config.service ablestack-storage-runtime-bootstrap.service ablestack-sharedfs-network.service qemu-guest-agent.service rtslib-fb-targetctl.service
Requires=ablestack-storage-runtime-bootstrap.service ablestack-sharedfs-network.service
Wants=qemu-guest-agent.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ablestack-storage-boot-reconcile
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
