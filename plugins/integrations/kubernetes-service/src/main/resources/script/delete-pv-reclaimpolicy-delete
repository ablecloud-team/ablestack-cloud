"""Bounded, UID-conditional cleanup of Mold CSI Delete volumes."""
import argparse
import http.client
import json
import os
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from urllib.parse import quote, urlencode

DRIVER = "csi.cloudstack.apache.org"
WORKLOADS = (
    ("apps/v1", "deployments"), ("apps/v1", "statefulsets"),
    ("apps/v1", "daemonsets"), ("apps/v1", "replicasets"),
    ("batch/v1", "jobs"), ("batch/v1", "cronjobs"), ("v1", "pods"),
)


class CleanupError(Exception):
    pass


def base(version):
    return "/api/" + version if version == "v1" else "/apis/" + version


def resource_path(version, resource, obj):
    meta = obj["metadata"]
    scope = "/namespaces/" + quote(meta["namespace"], safe="") if meta.get("namespace") else ""
    return base(version) + scope + "/" + resource + "/" + quote(meta["name"], safe="")


def claim_names(resource, obj):
    spec = obj.get("spec", {})
    if resource == "cronjobs":
        spec = spec.get("jobTemplate", {}).get("spec", {}).get("template", {}).get("spec", {})
    elif resource != "pods":
        spec = spec.get("template", {}).get("spec", {})
    return {v["persistentVolumeClaim"]["claimName"] for v in spec.get("volumes", [])
            if v.get("persistentVolumeClaim", {}).get("claimName")}


def deletion_plan(pvs, pvcs, workloads):
    claims = {(c["metadata"]["namespace"], c["metadata"]["name"]): c for c in pvcs}
    volumes, target_claims = [], set()
    for pv in pvs:
        spec = pv.get("spec", {})
        if (spec.get("csi", {}).get("driver") != DRIVER or spec.get("persistentVolumeReclaimPolicy") != "Delete"
                or pv.get("metadata", {}).get("annotations", {}).get("pv.kubernetes.io/provisioned-by") != DRIVER):
            continue
        handle = spec["csi"].get("volumeHandle", "")
        if not handle:
            raise CleanupError("Mold CSI PV has no volume handle: " + pv["metadata"]["name"])
        ref = spec.get("claimRef", {})
        claim = claims.get((ref.get("namespace"), ref.get("name")))
        if claim:
            if ref.get("uid") != claim["metadata"]["uid"] or claim.get("spec", {}).get("volumeName") != pv["metadata"]["name"]:
                raise CleanupError("PV claim identity changed: " + pv["metadata"]["name"])
            target_claims.add((ref["namespace"], ref["name"]))
        volumes.append({"pv": pv, "claim": claim, "handle": handle})
    selected = []
    for version, resource, objects in workloads:
        for obj in objects:
            ns = obj["metadata"].get("namespace", "")
            if any((ns, name) in target_claims for name in claim_names(resource, obj)):
                selected.append((version, resource, obj))
    return volumes, selected


class UnixConnection(http.client.HTTPConnection):
    def __init__(self, path):
        super().__init__("localhost", timeout=20)
        self.path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.path)


class API:
    def __init__(self, path, deadline):
        self.path, self.deadline = path, deadline

    def request(self, method, path, body=None):
        if time.monotonic() >= self.deadline:
            raise CleanupError("PV cleanup timeout; controller nodes must be retained")
        conn = UnixConnection(self.path)
        try:
            data = json.dumps(body).encode() if body is not None else None
            conn.request(method, path, body=data, headers={"Content-Type": "application/json"})
            response = conn.getresponse()
            result = response.read()
            if response.status == 404:
                return None
            if response.status not in (200, 201, 202):
                raise CleanupError("Kubernetes " + method + " " + path + " failed: HTTP " + str(response.status))
            return json.loads(result) if result else {}
        except (OSError, http.client.HTTPException, ValueError) as exc:
            raise CleanupError("Kubernetes API unavailable during PV cleanup") from exc
        finally:
            conn.close()

    def list(self, version, resource):
        result, token = [], ""
        while True:
            obj = self.request("GET", base(version) + "/" + resource + "?" + urlencode({"limit": 200, "continue": token}))
            if obj is None:
                raise CleanupError("Required Kubernetes resource API is unavailable: " + resource)
            result.extend(obj.get("items", []))
            token = obj.get("metadata", {}).get("continue", "")
            if not token:
                return result

    def delete(self, version, resource, obj):
        self.request("DELETE", resource_path(version, resource, obj), {
            "apiVersion": "v1", "kind": "DeleteOptions", "propagationPolicy": "Foreground",
            "preconditions": {"uid": obj["metadata"]["uid"]},
        })

    def wait_absent(self, version, resource, obj):
        path, uid = resource_path(version, resource, obj), obj["metadata"]["uid"]
        while True:
            current = self.request("GET", path)
            if current is None:
                return
            if current["metadata"]["uid"] != uid:
                raise CleanupError("Resource name reused during cleanup: " + path)
            time.sleep(1)


def save_receipt(path, receipt):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(receipt), encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def cleanup(api, journal, plan_only=False):
    pvs, pvcs = api.list("v1", "persistentvolumes"), api.list("v1", "persistentvolumeclaims")
    workloads = [(v, r, api.list(v, r)) for v, r in WORKLOADS]
    volumes, selected = deletion_plan(pvs, pvcs, workloads)
    prior = json.loads(journal.read_text()) if journal.exists() else {"volumes": []}
    receipts = {v["uid"]: v for v in prior["volumes"]}
    for v in volumes:
        meta = v["pv"]["metadata"]
        receipts[meta["uid"]] = {"uid": meta["uid"], "name": meta["name"], "handle": v["handle"],
            "claimUid": v["claim"]["metadata"]["uid"] if v["claim"] else ""}
    receipt = {"volumes": list(receipts.values()), "completed": False}
    # Persist identities before the first mutation. Retries retain deleted-PV handles.
    save_receipt(journal, receipt)
    print("MOLD_PV_CLEANUP_RECEIPT " + json.dumps(receipt, separators=(",", ":")), flush=True)
    if plan_only:
        return
    for version, resource, obj in selected:
        api.delete(version, resource, obj)
    for version, resource, obj in selected:
        if resource == "pods":
            api.wait_absent(version, resource, obj)
    for v in volumes:
        if v["claim"]:
            api.delete("v1", "persistentvolumeclaims", v["claim"])
            api.wait_absent("v1", "persistentvolumeclaims", v["claim"])
        # Released/unbound Delete volumes need the same UID-guarded deletion.
        api.delete("v1", "persistentvolumes", v["pv"])
        api.wait_absent("v1", "persistentvolumes", v["pv"])
    remaining, _ = deletion_plan(api.list("v1", "persistentvolumes"), api.list("v1", "persistentvolumeclaims"), [])
    if remaining:
        raise CleanupError("New or remaining Mold CSI Delete volumes; retry with controller nodes retained")
    receipt["completed"] = True
    save_receipt(journal, receipt)
    print("MOLD_PV_CLEANUP_RECEIPT " + json.dumps(receipt, separators=(",", ":")))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--plan-only", action="store_true")
    parser.add_argument("--timeout-seconds", type=int, default=480)
    args = parser.parse_args()
    if not 10 <= args.timeout_seconds <= 480:
        raise CleanupError("Cleanup timeout must be between 10 and 480 seconds")
    deadline = time.monotonic() + args.timeout_seconds
    journal = Path("/var/lib/mold/kubernetes-pv-cleanup.json")
    with tempfile.TemporaryDirectory(prefix="mold-pv-cleanup-") as temporary:
        path = temporary + "/proxy.sock"
        proxy = subprocess.Popen(["/opt/bin/kubectl", "--kubeconfig=/etc/kubernetes/admin.conf", "proxy", "--unix-socket=" + path],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            for _ in range(100):
                if os.path.exists(path):
                    break
                if proxy.poll() is not None:
                    raise CleanupError("Cannot start Kubernetes cleanup proxy")
                time.sleep(0.1)
            if not os.path.exists(path):
                raise CleanupError("Kubernetes cleanup proxy did not become ready")
            cleanup(API(path, deadline), journal, args.plan_only)
        finally:
            proxy.terminate()
            try:
                proxy.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proxy.kill()
                proxy.wait(timeout=5)


if __name__ == "__main__":
    try:
        main()
    except (CleanupError, OSError, ValueError) as error:
        print("MOLD_PV_CLEANUP_FAILED " + str(error), file=sys.stderr)
        sys.exit(1)
