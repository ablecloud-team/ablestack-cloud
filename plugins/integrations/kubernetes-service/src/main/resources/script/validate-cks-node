if [ "$(awk 'END {print NR}' /proc/swaps)" -gt 1 ]; then
  echo "External node swap is enabled; disable swap persistently before adding it"
  exit 1
fi

# Installed packages alone do not make user-data executable on the next boot.
if [ -e /etc/cloud/cloud-init.disabled ]; then
  echo "External node cloud-init is disabled; prepare the guest image before adding it"
  exit 1
fi
CLOUD_INIT_STATUS=$(cloud-init status --long 2>&1)
if [[ "$CLOUD_INIT_STATUS" == *"status: disabled"* || "$CLOUD_INIT_STATUS" == *"status: error"* ]]; then
  echo "External node cloud-init datasource is disabled; verify CloudStack metadata and reboot persistence"
  exit 1
fi
for unit in cloud-init.service cloud-final.service; do
  if ! systemctl is-enabled "$unit" >/dev/null 2>&1; then
    echo "External node cloud-init boot services are not enabled"
    exit 1
  fi
done

OS=`awk -F= '/^NAME/{print $2}' /etc/os-release`
REQUIRED_PACKAGES=(cloud-init cloud-guest-utils conntrack apt-transport-https ca-certificates curl gnupg gnupg-agent \
                    software-properties-common gnupg lsb-release python3-json-pointer python3-jsonschema cloud-init containerd.io)
declare -a MISSING_PACKAGES
if [[ $OS == *"Ubuntu"* || $OS == *"Debian"* ]]; then
  for package in ${REQUIRED_PACKAGES[@]}; do
    dpkg -s $package >/dev/null 2>&1
    if [ $? -eq 1 ]; then
      MISSING_PACKAGES+="$package"
    fi
  done
else
  for package in ${REQUIRED_PACKAGES[@]}; do
    rpm -qa | grep $package >/dev/null 2>&1
    if [ $? -eq 1 ]; then
      MISSING_PACKAGES[${#MISSING_PACKAGES[@]}]=$package
    fi
  done
fi

echo ${#MISSING_PACKAGES[@]}
if (( ${#MISSING_PACKAGES[@]} )); then
  echo "Following packages are missing in the node template: ${MISSING_PACKAGES[@]}"
  exit 1
else
  echo 0
fi
