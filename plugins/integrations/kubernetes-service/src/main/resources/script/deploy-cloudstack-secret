function usage() {
    cat << USAGE
Usage: ./deploy-cloudstack-secret [OPTIONS]...
To deploy the keys needed for the cloudstack kubernetes provider.
Arguments:
  -u, --url string         URL of the CloudStack API
  -k, --key string         API Key
  -s, --secret string      Secret Key
  -p, --project string     Project ID
Other arguments:
  -h, --help              Display this help message and exit
Examples:
  ./deploy-cloudstack-secret -u http://10.10.10.10:8080/client/api -k abcd -s efgh
USAGE
    exit 0
}
API_URL=""
API_KEY=""
SECRET_KEY=""
PROJECT_ID=""
PROJECT=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            ;;
        -u | --url)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            API_URL=$2
            shift 2
            ;;
        -k | --key)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            API_KEY=$2
            shift 2
            ;;
        -s | --secret)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            SECRET_KEY=$2
            shift 2
            ;;
        -p | --project)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            PROJECT_ID=$2
            shift 2
            PROJECT="project-id = $PROJECT_ID"
            ;;
        -*|*)
            echo "ERROR: no such option $1. -h or --help for help"
            exit 1
            ;;
    esac
done
[ -n "$API_URL" ] && [ -n "$API_KEY" ] && [ -n "$SECRET_KEY" ] || { echo "ERROR: API URL/key/secret are required" >&2; exit 1; }
for value in "$API_URL" "$API_KEY" "$SECRET_KEY" "$PROJECT_ID"; do
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || { echo "ERROR: newline in configuration value" >&2; exit 1; }
done
umask 077
config_dir=$(mktemp -d)
trap 'rm -f "$config_dir/cloud-config"; rmdir "$config_dir"' EXIT
cat > "$config_dir/cloud-config" <<EOF
[Global]
api-url = $API_URL
api-key = $API_KEY
secret-key = $SECRET_KEY
$PROJECT
EOF
# Applying an existing secret also supports APIKeyPair rotation.
/opt/bin/kubectl -n kube-system create secret generic cloudstack-secret --from-file="$config_dir/cloud-config" --dry-run=client -o yaml | /opt/bin/kubectl apply -f -
