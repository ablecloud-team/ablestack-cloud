KUBECTL="${MOLD_KUBECTL:-/opt/bin/kubectl}"

function usage() {
    cat << USAGE
Usage: ./deploy-cloudstack-secret [OPTIONS]...
To deploy the keys needed for the cloudstack kubernetes provider.
Arguments:
  -u, --url string         URL of the CloudStack API
  -k, --key string         API Key
  -s, --secret string      Secret Key
  -p, --project string     Project ID
Other arguments:
  -h, --help              Display this help message and exit
Examples:
  ./deploy-cloudstack-secret -u http://10.10.10.10:8080/client/api -k abcd -s efgh
USAGE
    exit 0
}
API_URL=""
API_KEY=""
SECRET_KEY=""
PROJECT_ID=""
PROJECT=""
CLUSTER_UID=""
CLUSTER=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            ;;
        -u | --url)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            API_URL=$2
            shift 2
            ;;
        -k | --key)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            API_KEY=$2
            shift 2
            ;;
        -s | --secret)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            SECRET_KEY=$2
            shift 2
            ;;
        -c | --cluster-uuid)
            [ "$#" -ge 2 ] && [[ "$2" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || { echo "ERROR: invalid cluster UUID" >&2; exit 1; }
            CLUSTER_UID=$2
            shift 2
            ;;
        -p | --project)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            PROJECT_ID=$2
            shift 2
            PROJECT="project-id = $PROJECT_ID"
            ;;
        -*|*)
            echo "ERROR: no such option $1. -h or --help for help"
            exit 1
            ;;
    esac
done
[ -n "$API_URL" ] && [ -n "$API_KEY" ] && [ -n "$SECRET_KEY" ] || { echo "ERROR: API URL/key/secret are required" >&2; exit 1; }
for value in "$API_URL" "$API_KEY" "$SECRET_KEY" "$PROJECT_ID"; do
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || { echo "ERROR: newline in configuration value" >&2; exit 1; }
done
if [ -n "$CLUSTER_UID" ] && [ -f /opt/mold-provider-ownership-v1 ]; then
    CLUSTER="cluster-uuid = $CLUSTER_UID"
fi
umask 077
config_dir=$(mktemp -d)
trap 'rm -f "$config_dir/cloud-config"; rmdir "$config_dir"' EXIT
cat > "$config_dir/cloud-config" <<EOF
[Global]
api-url = $API_URL
api-key = $API_KEY
secret-key = $SECRET_KEY
$PROJECT
$CLUSTER
EOF
# Applying an existing secret also supports APIKeyPair rotation.
"$KUBECTL" -n kube-system create secret generic cloudstack-secret --from-file="$config_dir/cloud-config" --dry-run=client -o yaml | "$KUBECTL" apply -f -

# Secret-mounted configuration is read at controller startup. A content annotation
# makes interrupted rotation retryable without restarting unchanged consumers.
python3 - "$KUBECTL" "$config_dir/cloud-config" <<'PYCODE'
import hashlib
import json
import pathlib
import subprocess
import sys

kubectl, config = sys.argv[1:]
digest = hashlib.sha256(pathlib.Path(config).read_bytes()).hexdigest()
annotation = "mold.ablecloud.io/cloud-config-sha256"
result = subprocess.run([kubectl, "-n", "kube-system", "get", "deployment,daemonset", "-o", "json"],
                        check=True, capture_output=True, text=True)
for workload in json.loads(result.stdout).get("items", []):
    template = workload.get("spec", {}).get("template", {})
    volumes = template.get("spec", {}).get("volumes", [])
    if not any(v.get("secret", {}).get("secretName") == "cloudstack-secret" for v in volumes):
        continue
    if template.get("metadata", {}).get("annotations", {}).get(annotation) == digest:
        continue
    kind, name = workload["kind"].lower(), workload["metadata"]["name"]
    patch = {"spec": {"template": {"metadata": {"annotations": {annotation: digest}}}}}
    subprocess.run([kubectl, "-n", "kube-system", "patch", kind, name,
                    "--type=merge", "-p", json.dumps(patch)], check=True, stdout=subprocess.DEVNULL)
print("MOLD_CONTROLLER_CONFIG_RECONCILED")
PYCODE

if [ -n "$CLUSTER" ]; then echo "MOLD_PROVIDER_OWNERSHIP_V1_READY"; fi
