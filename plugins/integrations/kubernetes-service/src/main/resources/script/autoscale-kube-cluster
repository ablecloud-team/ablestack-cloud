function usage() {
    cat << USAGE
Usage: ./autoscale-kube-cluster [OPTIONS]...
Enables autoscaling for the kubernetes cluster.
Arguments:
  -i, --id string         ID of the cluster
  -e, --enable            Enables autoscaling
  -d, --disable           Disables autoscaling
  -M, --maxsize number    Maximum size of the cluster
  -m, --minsize number    Minimum size of the cluster
Other arguments:
  -h, --help              Display this help message and exit
Examples:
  ./autoscale-kube-cluster -e -M 3 -m 1
  ./autoscale-kube-cluster -d
USAGE
    exit 0
}
ID=""
ENABLE=""
MINSIZE=""
MAXSIZE=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            ;;
        -i | --id)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            ID=$2
            shift 2
            ;;
        -e | --enable)
            ENABLE="true"
            shift 1
            ;;
        -d | --disable)
            ENABLE="false"
            shift 1
            ;;
        -M | --maxsize)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            MAXSIZE=$2
            shift 2
            ;;
        -m | --minsize)
            [ "$#" -ge 2 ] && [ -n "$2" ] || { echo "ERROR: option requires a value" >&2; exit 1; }
            MINSIZE=$2
            shift 2
            ;;
        -*|*)
            echo "ERROR: no such option $1. -h or --help for help"
            exit 1
            ;;
    esac
done
case "$ENABLE" in
true)
    [[ "$ID" =~ ^[A-Za-z0-9-]+$ ]] || { echo "ERROR: invalid cluster ID" >&2; exit 1; }
    [[ "$MINSIZE" =~ ^[1-9][0-9]*$ && "$MAXSIZE" =~ ^[1-9][0-9]*$ ]] || { echo "ERROR: positive min/max sizes are required" >&2; exit 1; }
    [ "$MINSIZE" -le "$MAXSIZE" ] || { echo "ERROR: minsize exceeds maxsize" >&2; exit 1; }
    [ -s /opt/autoscaler/autoscaler_tmpl.yaml ] || { echo "ERROR: validated Mold AutoScaler payload is missing" >&2; exit 1; }
    sed -e "s/<cluster-id>/$ID/g" -e "s/<min>/$MINSIZE/g" -e "s/<max>/$MAXSIZE/g" /opt/autoscaler/autoscaler_tmpl.yaml > /opt/autoscaler/autoscaler_now.yaml
    /opt/bin/kubectl apply -f /opt/autoscaler/autoscaler_now.yaml
    ;;
false)
    /opt/bin/kubectl delete deployment -n kube-system cluster-autoscaler --ignore-not-found=true
    ;;
*) echo "ERROR: select --enable or --disable" >&2; exit 1 ;;
esac
