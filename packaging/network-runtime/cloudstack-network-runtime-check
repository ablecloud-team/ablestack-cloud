# Read-only installation check; never creates namespaces or starts services.
set -uo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
failed=0
for binary in ip iptables iptables-save arping dnsmasq haproxy httpd radvd python3 flock sshd; do
    if command -v "$binary" >/dev/null 2>&1; then
        printf 'OK binary %s\n' "$binary"
    else
        printf 'MISSING binary %s\n' "$binary"
        failed=1
    fi
done
wrapper=/etc/cloudstack/extensions/network-namespace/network-namespace-wrapper.sh
if [[ -x "$wrapper" ]] && bash -n "$wrapper"; then
    echo 'OK wrapper'
else
    echo 'MISSING or invalid wrapper'
    failed=1
fi
for module in mod_mpm_event.so mod_authz_core.so mod_unixd.so mod_alias.so mod_cgi.so; do
    if [[ -f /usr/lib64/httpd/modules/$module || -f /usr/lib/httpd/modules/$module ]]; then
        printf 'OK Apache module %s\n' "$module"
    else
        printf 'MISSING Apache module %s\n' "$module"
        failed=1
    fi
done
exit "$failed"
