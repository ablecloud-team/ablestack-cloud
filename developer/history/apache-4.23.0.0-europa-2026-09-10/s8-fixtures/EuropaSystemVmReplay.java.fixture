import java.io.FileInputStream;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.Objects;
import java.util.LinkedHashMap;
import java.util.Map;
import java.util.Properties;

import com.cloud.upgrade.dao.EuropaSystemVmSchemaUpgrade;

/** Run only against the disposable S8 fixture database. */
public class EuropaSystemVmReplay {
    public static void main(String[] args) throws Exception {
        Properties props = new Properties();
        try (FileInputStream input = new FileInputStream(args[0])) {
            props.load(input);
        }
        String host = props.getProperty("db.cloud.host");
        if (!host.startsWith("epic998-mysql-")) {
            throw new IllegalArgumentException("Disposable fixture required");
        }
        try (Connection conn = DriverManager.getConnection("jdbc:mysql://" + host + "/cloud",
                props.getProperty("db.cloud.username"), props.getProperty("db.cloud.password"))) {
            conn.setAutoCommit(false);
            Map<String, String> original = new LinkedHashMap<>();
            try (PreparedStatement query = conn.prepareStatement("SELECT name,value FROM configuration WHERE name IN "
                    + "('consoleproxy.url.domain','secstorage.ssl.cert.domain','secstorage.copy.password')");
                    ResultSet result = query.executeQuery()) {
                while (result.next()) {
                    original.put(result.getString(1), result.getString(2));
                }
            }
            int cases = 0;
            try {
            for (String value : new String[]{"realhostip.com", "*.realhostip.com", "ssl.example.test", "*.ssl.example.test", "", null}) {
                try (PreparedStatement update = conn.prepareStatement("UPDATE configuration SET value=? WHERE name IN "
                        + "('consoleproxy.url.domain','secstorage.ssl.cert.domain','secstorage.copy.password')")) {
                    update.setString(1, value);
                    if (update.executeUpdate() != 3) {
                        throw new AssertionError("Expected three fixture settings");
                    }
                }
                EuropaSystemVmSchemaUpgrade.migrate(conn);
                EuropaSystemVmSchemaUpgrade.migrate(conn);
                try (PreparedStatement query = conn.prepareStatement("SELECT name,value FROM configuration WHERE name IN "
                        + "('consoleproxy.url.domain','secstorage.ssl.cert.domain','secstorage.copy.password')");
                        ResultSet result = query.executeQuery()) {
                    while (result.next()) {
                        String expected = value;
                        if (!result.getString(1).equals("secstorage.copy.password")
                                && (Objects.equals(value, "realhostip.com") || Objects.equals(value, "*.realhostip.com"))) {
                            expected = null;
                        }
                        if (!Objects.equals(expected, result.getString(2))) {
                            throw new AssertionError("Unexpected cleanup for " + result.getString(1));
                        }
                        cases++;
                    }
                }

            }
            } finally {
                try (PreparedStatement restore = conn.prepareStatement("UPDATE configuration SET value=? WHERE name=?")) {
                    for (Map.Entry<String, String> setting : original.entrySet()) {
                        restore.setString(1, setting.getValue());
                        restore.setString(2, setting.getKey());
                        restore.executeUpdate();
                    }
                    conn.commit();
                }
            }
            System.out.println("PASS " + cases + " settings cases, repeated production migration and fixture restoration");
        }
    }
}
