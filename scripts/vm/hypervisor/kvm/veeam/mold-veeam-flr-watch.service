# Watches /tmp/mold/veeam-agent for Veeam UI FLR file drops and triggers Mold
# restore immediately (seconds), without waiting for the 3-minute poll timer.
[Unit]
Description=Mold Veeam FLR immediate watch (agent payload → Mold restore)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/ablestack/veeam/mold-backup.env
Environment=FLR_WATCH_INTERVAL_SEC=1
Environment=FLR_WATCH_QUIET_SEC=2
Environment=FLR_WATCH_PUBLISH_GRACE_SEC=120
ExecStart=/etc/ablestack/veeam/mold-veeam-flr-watch.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
