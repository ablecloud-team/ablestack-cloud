# Mold backup env — installed to /etc/ablestack/veeam/mold-backup.env by install.sh
# Do not commit mold-backup.env (contains secrets).

MS_HOST=root@10.10.31.20
KVM_HOST=root@10.10.31.2
MS_PLUGIN_DIR=/usr/share/cloudstack-management/lib

MOLD_API_URL=http://10.10.31.20:8080/client/api
MOLD_API_KEY=
MOLD_API_SECRET=
ZONE_ID=

# Veeam Agent Job 이름 (Veeam UI와 동일 — UI에서 Job/Pre/Post 등록)
JOB_NAME="Mold ablecube31-2"
VEEAM_JOB_NAME="Mold ablecube31-2"
KVM_HOSTNAME="ablecube31-2"
VEEAM_BACKUP_TARGET="host"
KVM_SSH_USER=root
KVM_SSH_PASSWORD=
BACKUP_OFFERING_NAME="VeeamBackup"

# Mold→Veeam Job 트리거 (선택)
VEEAM_TRIGGER_ENABLED=false
VEEAM_TRIGGER_TTL=1800
VEEAM_TRIGGER_METHOD=auto
VEEAM_API_URL=https://10.10.254.246:9419
VEEAM_API_VERSION=1.2-rev0
VEEAM_API_USER=administrator
VEEAM_API_PASSWORD=

# Veeam B&R SSH (FLR restore-watch 세션 조회용 — Preferred IP)
VEEAM_SSH_HOST=10.10.254.246
VEEAM_SSH_USER=administrator
VEEAM_SSH_KEY=
VEEAM_URL=https://10.10.254.246:9398/api/
VEEAM_USER=administrator
VEEAM_PASSWORD=
KVM_HOSTNAME=ablecube31-2
KVM_IP=10.10.31.2
# Mold stage root (RBD .raw/.rbdiff for restore). Must match backup.plugin.ablestack-veeam.stage.root.path
VEEAM_HOST_BACKUP_PATH=/tmp/mold/veeam
# Veeam Agent Job SelectedFiles — markers / qcow2 publish only (never SyncDirs RBD sparse .raw)
VEEAM_AGENT_PAYLOAD_PATH=/tmp/mold/veeam-agent

# Host-wide backup: * = all running libvirt domains on this KVM (no guest name list)
VM_INCLUDE=*
VM_EXCLUDE=
# Auto-skip scvm*, r/s/v-*-VM (router/systemVM), *ablestack-template* (set false to disable)
VM_AUTO_EXCLUDE=true
BACKUP_MODE=host

# Mold Global backup.chain.size (+ Job VEEAM_MAX_CHAIN). Default matches Mold (10).
BACKUP_CHAIN_SIZE=10
VEEAM_MAX_CHAIN=10
MAX_CHAIN=10

# Mold datadisk (로컬 경로 — Mold addBackupRepository / Veeam Win repo 사용 안 함)
BACKUP_STORAGE_ENGINE=auto
BACKUP_STORAGE_MODE=datadisk
MOLD_DATADISK_PATH=/data/backup
BACKUP_REPO_ADDRESS=/data/backup
BACKUP_REPO_NAME=Ablestack Data Disk
BACKUP_REPO_TYPE=local
BACKUP_REPO_PROVIDER=localfs

VEEAM_UI_RESTORE_SOURCE=mold-only
RESTORE_SOURCE=mold-only
RESTORE_WATCH_TRIGGER_MOLD=true

RUN_BACKUP=true
RUN_BUILD=false
RESTART_MS=true
SKIP_CONFIGURE=false
SKIP_DEPLOY=false
RUN_OPERATION=
